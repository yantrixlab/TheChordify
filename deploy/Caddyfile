# One origin for everything: the static site at /, the chord API at /api, uploaded audio at /media.
#
# No domain yet: keep ":80" and browse to http://<VPS_IP>/.
# Once you own one, replace ":80" with the domain (e.g. thechordify.com) and Caddy gets a
# Let's Encrypt certificate automatically (point the domain's A record at the VPS first).
:80 {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /media/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /var/www/thechordify
		file_server
	}
}
