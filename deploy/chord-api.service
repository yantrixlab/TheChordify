# /etc/systemd/system/chord-api.service
# Assumes the repo is checked out at /opt/thechordify and the venv lives in backend/venv.
[Unit]
Description=TheChordify chord extraction API
After=network.target

[Service]
User=www-data
WorkingDirectory=/opt/thechordify/backend
# Same-origin behind Caddy, so no CORS_ORIGINS needed. Keep exactly one worker: job state is in memory.
Environment=CHORD_WORKERS=2
ExecStart=/opt/thechordify/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=on-failure

[Install]
WantedBy=multi-user.target
