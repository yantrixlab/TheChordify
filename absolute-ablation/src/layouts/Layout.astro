---
import "../styles/global.css";
import { business } from "../lib/business";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean; // keep the page out of search engines (the admin page)
  analytics?: boolean; // count visits to this page in Google Analytics (the admin pages turn it off)
}

const {
  noindex = false,
  analytics = true,
  title = "Chord Suno — Hear Every Chord. Play Every Song.",
  description = "Chord Suno listens to any YouTube link or audio file and writes out every chord, synced to the beat, for guitar, piano, ukulele and mandolin. Suno means listen.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, "https://chordsuno.com").href} />
    <meta name="application-name" content="Chord Suno" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      analytics && business.analyticsId && (
        <>
          {/* Google Analytics: page views for every visitor; the events (sign-ins, searches, checkout) come from lib/analytics.ts */}
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${business.analyticsId}`}></script>
          <script is:inline define:vars={{ id: business.analyticsId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function gtag() {
              window.dataLayer.push(arguments);
            };
            window.gtag("js", new Date());
            // work on a developer's own computer is not counted as visits
            if (!/^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) window.gtag("config", id);
          </script>
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google Fonts: Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://chordsuno.com" />
    <meta property="og:site_name" content="Chord Suno" />
    <!-- Theme color -->
    <meta name="theme-color" content="#1a0533" />
  </head>
  <body>
    <slot />
  </body>
</html>
