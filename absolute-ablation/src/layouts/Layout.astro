---
import "../styles/global.css";
import { business } from "../lib/business";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean; // keep the page out of search engines (the admin page)
  analytics?: boolean; // count visits to this page in Google Analytics (the admin pages turn it off)
  image?: string; // the picture shown when the page is shared (a path on this site); the Chord Suno card by default
  jsonLd?: object | object[]; // structured data for search engines
}

const {
  noindex = false,
  analytics = true,
  title = "Guitar Chord Finder from Any YouTube Song — Chord Suno",
  description = "Paste a YouTube link or upload a song and get every chord synced to the beat, for guitar, piano, ukulele and mandolin. Free to start, no card needed.",
  image = "/og-image.png",
  jsonLd,
} = Astro.props;
const pageUrl = new URL(Astro.url.pathname, "https://chordsuno.com").href;
const imageUrl = new URL(image, "https://chordsuno.com").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={pageUrl} />
    <meta name="application-name" content="Chord Suno" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      analytics && business.analyticsId && (
        <>
          {/* Google Analytics: page views for every visitor; the events (sign-ins, searches, checkout) come from lib/analytics.ts */}
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${business.analyticsId}`}></script>
          <script is:inline define:vars={{ id: business.analyticsId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = function gtag() {
              window.dataLayer.push(arguments);
            };
            window.gtag("js", new Date());
            // work on a developer's own computer is not counted as visits
            if (!/^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) window.gtag("config", id);
          </script>
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google Fonts: Inter + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Chord Suno" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Theme color -->
    <meta name="theme-color" content="#1a0533" />
  </head>
  <body>
    <slot />
  </body>
</html>
