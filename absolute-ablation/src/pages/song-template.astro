---
// Not a page people visit. The server fills it in to make every public song page and the songs list (backend/app/songpages.py):
// it swaps the __SP_ markers for that song's title, description, picture and content, so the header, footer and styles are the site's own.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="__SP_TITLE__" description="__SP_DESC__" image="https://img.invalid/__SP_IMAGE__" noindex>
  <Nav />
  <main id="main-content" class="sp-main">__SP_BODY__</main>
  <Footer />
</Layout>

<style is:global>
  .sp-main { background: #faf9fc; padding: 40px 24px 96px; min-height: 70vh; }
  .sp-wrap { max-width: 920px; margin: 0 auto; }
  .sp-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 26px; font-size: 13.5px; color: var(--color-mute); }
  .sp-crumb a { color: var(--color-body); text-decoration: none; }
  .sp-crumb a:hover { color: var(--color-violet-deep); text-decoration: underline; }
  .sp-eyebrow { margin: 0 0 10px; font: 600 12px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-violet-deep); }
  .sp-hero { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 34px; align-items: center; margin-bottom: 30px; }
  .sp-hero img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 20px; box-shadow: 0 24px 50px -28px rgb(26 5 51 / 0.5); }
  .sp-hero h1, .sp-head h1 { margin: 0 0 8px; font-size: clamp(30px, 4.6vw, 46px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.08; color: var(--color-ink); text-wrap: balance; }
  .sp-by { margin: 0 0 22px; font-size: 18px; color: var(--color-body); }
  .sp-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  .sp-ghost { display: inline-flex; align-items: center; height: 50px; padding: 0 22px; border-radius: 999px; background: #fff; border: 1px solid #ddd3f0; color: var(--color-violet-deep); font: 650 15px var(--font-sans); text-decoration: none; transition: background-color 0.15s, border-color 0.15s; }
  .sp-ghost:hover { background: #f4f1fb; border-color: #c9bbe8; }
  .sp-sub { margin: -6px 0 20px; max-width: 640px; font-size: 15px; line-height: 1.6; color: var(--color-mute); }
  .sp-play { display: inline-flex; align-items: center; gap: 10px; height: 50px; padding: 0 26px; border-radius: 999px; background: var(--color-ink); color: #fff; font: 650 15.5px var(--font-sans); text-decoration: none; box-shadow: 0 14px 30px -14px rgb(13 0 31 / 0.6); transition: transform 0.15s, box-shadow 0.15s; }
  .sp-play:hover { transform: translateY(-2px); box-shadow: 0 18px 34px -14px rgb(13 0 31 / 0.7); }
  .sp-hero small { display: block; margin-top: 12px; font-size: 13px; color: var(--color-mute); }
  .sp-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0; margin: 0 0 14px; padding: 6px 0; background: #fff; border: 1px solid #ebe7f3; border-radius: 18px; box-shadow: 0 1px 2px rgb(26 5 51 / 0.04); }
  .sp-facts div { padding: 14px 20px; }
  .sp-facts div + div { border-left: 1px solid #f0ecf7; }
  .sp-facts dt { margin: 0 0 4px; font: 600 11px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-mute); }
  .sp-facts dd { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -0.02em; color: var(--color-ink); }
  .sp-block { margin-top: 40px; }
  .sp-block h2 { margin: 0 0 16px; font-size: 22px; font-weight: 700; letter-spacing: -0.025em; color: var(--color-ink); }
  .sp-block p { margin: 0 0 14px; font-size: 16px; line-height: 1.7; color: var(--color-body); }
  .sp-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .sp-chips span { display: inline-grid; place-items: center; min-width: 54px; height: 44px; padding: 0 14px; border-radius: 12px; background: #fff; border: 1px solid #e4dcf3; font: 700 17px var(--font-mono); color: var(--color-violet-deep); box-shadow: 0 1px 2px rgb(26 5 51 / 0.04); }
  .sp-prog { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .sp-prog li { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 16px; align-items: baseline; padding: 14px 18px; background: #fff; border: 1px solid #ebe7f3; border-radius: 14px; }
  .sp-prog strong { font-size: 14px; color: var(--color-ink); }
  .sp-prog span { display: flex; flex-wrap: wrap; gap: 6px; }
  .sp-block p.sp-chart-cta { max-width: none; margin: 26px 0 0; text-align: center; }
  /* the chord chart: sections as tabs on the left, rows of bars, one cell per beat */
  .sg { display: grid; gap: 12px; }
  .sg-sec { display: grid; grid-template-columns: 34px minmax(0, 1fr); overflow: hidden; background: #fff; border: 1px solid #e4dcf3; border-radius: 16px; box-shadow: 0 1px 2px rgb(26 5 51 / 0.04); }
  .sg-tag { display: grid; place-items: center; margin: 0; padding: 8px 0; background: #ede9fb; color: var(--color-violet-deep); font: 700 12px var(--font-sans); letter-spacing: 0.04em; text-transform: uppercase; writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; }
  .sg-sec.is-intro .sg-tag, .sg-sec.is-outro .sg-tag, .sg-sec.is-break .sg-tag { background: #eceaf1; color: #5f5875; }
  .sg-sec.is-chorus .sg-tag { background: #d9d0f7; color: #4a1fa8; }
  .sg-sec.is-bridge .sg-tag, .sg-sec.is-instrumental .sg-tag { background: #e6def9; color: #5b21b6; }
  .sg-sec:not(:has(.sg-tag)) { grid-template-columns: minmax(0, 1fr); }
  .sg-body { display: grid; min-width: 0; }
  .sg-row { display: grid; grid-template-columns: repeat(var(--rb), minmax(0, 1fr)); border-bottom: 1px solid #efeaf8; }
  .sg-row:last-child { border-bottom: 0; }
  .sg-bar { display: grid; grid-template-columns: repeat(var(--bpb), minmax(0, 1fr)); border-left: 2px solid #4b4560; background: #fcfbfe; }
  .sg-bar:first-child { border-left: 0; }
  .sg-c { display: grid; align-items: center; min-height: 42px; padding: 0 8px; overflow: hidden; border-left: 1px solid #f1edf8; font: 700 15px var(--font-mono); letter-spacing: -0.02em; color: var(--color-ink); white-space: nowrap; }
  .sg-c:first-child { border-left: 0; }
  .sg-c.has { color: var(--color-violet-deep); }
  .sg-c.is-empty { background: #f4f2f8; }
  .sp-prog i { display: inline-grid; place-items: center; min-width: 40px; height: 30px; padding: 0 9px; border-radius: 8px; background: #f4f1fb; font: 700 14.5px var(--font-mono); font-style: normal; color: var(--color-violet-deep); }
  .sp-dgs { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
  .sp-dg { position: relative; margin: 0; padding: 14px 12px 12px; text-align: center; background: #fff; border: 1px solid #ebe7f3; border-radius: 18px; box-shadow: 0 1px 2px rgb(26 5 51 / 0.04); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
  .sp-dg:hover { transform: translateY(-2px); border-color: #d8ccf0; box-shadow: 0 18px 30px -22px rgb(91 33 182 / 0.4); }
  .sp-dg-art { display: grid; place-items: center; min-height: 128px; }
  .sp-dg-art svg { display: block; width: 100%; max-width: 116px; height: auto; font-family: var(--font-sans); }
  .sp-dg figcaption { display: grid; gap: 2px; margin-top: 6px; }
  .sp-dg figcaption strong { font-size: 20px; font-weight: 750; letter-spacing: -0.02em; color: var(--color-ink); }
  .sp-dg-notes { font: 500 12px var(--font-mono); color: var(--color-mute); }
  .sp-dg-nav { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 8px; font: 600 12px var(--font-mono); color: var(--color-mute); }
  .sp-dg-nav[hidden] { display: none; }
  .sp-dg-nav button { display: grid; place-items: center; width: 26px; height: 26px; padding: 0; border: 1px solid #e4dcf3; border-radius: 50%; background: #fff; font-size: 16px; line-height: 1; color: var(--color-violet-deep); cursor: pointer; }
  .sp-dg-nav button:hover { background: #f4f1fb; }
  /* the strumming pattern: a compact row of square tiles that light up with the music */
  .sm-card { position: relative; overflow: hidden; padding: 20px 22px 18px; border-radius: 20px; background: radial-gradient(120% 150% at 0% 0%, #2b1264 0%, #170b33 46%, #0f0623 100%); border: 1px solid #ffffff17; box-shadow: 0 30px 60px -34px #000c, inset 0 1px 0 #ffffff14; color: #e4dcf5; }
  .sm-card::before { content: ""; position: absolute; top: -170px; right: -110px; width: 360px; height: 360px; border-radius: 50%; background: radial-gradient(circle, #7c3aed4d, transparent 66%); pointer-events: none; animation: sm-drift 10s ease-in-out infinite alternate; }
  .sm-card > * { position: relative; }
  .sm-card[hidden] { display: none; }
  .sm-head { display: flex; align-items: center; justify-content: space-between; gap: 10px 14px; flex-wrap: wrap; }
  .sm-ttl { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sm-head h2, .sp-block .sm-ttl h2 { margin: 0; font-size: 18px; font-weight: 700; letter-spacing: -0.02em; color: #fff; }
  .sm-pill { padding: 3px 10px; border-radius: 999px; background: #ffffff14; border: 1px solid #ffffff1c; font: 600 11px var(--font-mono); letter-spacing: 0.03em; color: #cdbdf5; }
  .sm-pill.is-heard { background: #fcd34d22; border-color: #fcd34d55; color: #fde68a; }
  .sm-seg { display: inline-flex; padding: 3px; border-radius: 999px; background: #ffffff12; }
  .sm-seg button { height: 28px; padding: 0 13px; border: 0; border-radius: 999px; background: transparent; font: 650 12px var(--font-sans); color: #c9bbf0; cursor: pointer; transition: background-color 0.15s, color 0.15s; }
  .sm-seg button:hover { color: #fff; }
  .sm-seg button.is-on { background: #fff; color: #1a0d33; }
  .sm-label { margin: 14px 0 0 !important; font: 600 12.5px var(--font-mono) !important; letter-spacing: 0.06em; color: #b9a8e8 !important; }
  .sm-tiles { display: grid; grid-template-columns: repeat(var(--cols, 8), minmax(0, 60px)); gap: 8px; justify-content: start; margin: 12px 0 16px; padding: 4px 0 8px; }
  .sm-tile { position: relative; overflow: hidden; aspect-ratio: 1 / 1; display: grid; place-items: center; align-content: center; gap: 4px; border-radius: 14px; background: linear-gradient(160deg, #7e3ff1 0%, #5421b8 100%); border: 1px solid #ffffff2b; box-shadow: inset 0 1px 0 #ffffff3d, 0 8px 16px -10px #5b21b6; color: #fff; transition: transform 0.28s cubic-bezier(0.3, 1.6, 0.5, 1), box-shadow 0.28s ease, filter 0.28s ease; }
  .sm-tile .sm-ar { display: grid; place-items: center; line-height: 0; }
  .sm-tile svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .sm-tile small { font: 600 10.5px/1 var(--font-mono); color: #ffffffb3; }
  .sm-tile.is-rest { background: #1a1037; border: 1px dashed #ffffff1f; box-shadow: none; color: #6f5fa8; }
  .sm-tile.is-rest small { color: #6f5fa8; }
  .sm-tile.is-now { z-index: 1; transform: translateY(-3px) scale(1.08); filter: brightness(1.2); box-shadow: 0 0 0 2px #fcd34d, 0 0 26px #f59e0b99, 0 16px 22px -10px #000; animation: sm-hit 0.45s ease-out; }
  .sm-tile.is-now::after { content: ""; position: absolute; inset: 0; background: linear-gradient(115deg, transparent 30%, #ffffff66 50%, transparent 70%); transform: translateX(-130%); animation: sm-shine 0.55s ease-out forwards; }
  .sm-tile.is-rest.is-now { filter: none; box-shadow: 0 0 0 2px #fcd34d66, 0 0 18px #f59e0b33; }
  .sm-tile.is-rest.is-now::after { display: none; }
  .sm-tile.is-now.is-down .sm-ar { animation: sm-down 0.45s ease-out; }
  .sm-tile.is-now.is-up .sm-ar { animation: sm-up 0.45s ease-out; }
  .sm-text { margin: 0 !important; font-size: 14.5px !important; line-height: 1.65 !important; color: #d6cbef !important; }
  .sm-text b, .sm-how b { color: #fff; }
  .sm-how { margin-top: 10px; }
  .sm-how summary { display: inline-flex; align-items: center; gap: 6px; font: 650 13px var(--font-sans); color: #c7b5ff; cursor: pointer; list-style: none; }
  .sm-how summary::-webkit-details-marker { display: none; }
  .sm-how summary::after { content: "+"; display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #ffffff14; font-size: 14px; line-height: 1; transition: transform 0.2s; }
  .sm-how[open] summary::after { content: "–"; }
  .sm-how > div { margin-top: 8px; font-size: 14px; line-height: 1.7; color: #cbbfe8; }
  .sm-how > div p { margin: 0 0 8px !important; font-size: 14px !important; line-height: 1.7 !important; color: #cbbfe8 !important; }
  .sm-note { margin: 12px 0 0 !important; font-size: 12px !important; line-height: 1.5; color: #8f81b8 !important; }
  @keyframes sm-hit { 0% { box-shadow: 0 0 0 0 #fcd34dcc, 0 0 0 2px #fcd34d, 0 0 26px #f59e0b99, 0 16px 22px -10px #000; } 100% { box-shadow: 0 0 0 14px #fcd34d00, 0 0 0 2px #fcd34d, 0 0 26px #f59e0b99, 0 16px 22px -10px #000; } }
  @keyframes sm-shine { to { transform: translateX(130%); } }
  @keyframes sm-down { 0% { transform: translateY(-6px); } 45% { transform: translateY(4px); } 100% { transform: translateY(0); } }
  @keyframes sm-up { 0% { transform: translateY(6px); } 45% { transform: translateY(-4px); } 100% { transform: translateY(0); } }
  @keyframes sm-drift { to { transform: translate(-36px, 26px) scale(1.12); } }
  @media (max-width: 640px) { .sm-card { padding: 16px 14px 14px; border-radius: 18px; } .sm-tiles { gap: 6px; } .sm-tile { border-radius: 11px; } .sm-tile svg { width: 17px; height: 17px; } .sm-tile small { font-size: 9.5px; } }
  @media (prefers-reduced-motion: reduce) { .sm-card::before, .sm-tile.is-now, .sm-tile.is-now::after, .sm-tile.is-now .sm-ar { animation: none !important; } .sm-tile { transition: none; } .sm-tile.is-now { transform: none; } }
  .sp-custom-wrap { margin-top: 40px; }
  .sp-custom { min-width: 0; overflow-wrap: anywhere; }
  :where(.sp-custom) img { max-width: 100%; height: auto; }
  .sp-rich { font-size: 16px; line-height: 1.75; color: var(--color-body); }
  .sp-rich > *:first-child { margin-top: 0; }
  .sp-rich h2, .sp-rich h3, .sp-rich h4 { margin: 1.6em 0 0.5em; color: var(--color-ink); letter-spacing: -0.02em; line-height: 1.25; }
  .sp-rich h2 { font-size: 21px; } .sp-rich h3 { font-size: 18px; } .sp-rich h4 { font-size: 16px; }
  .sp-rich p { margin: 0 0 14px; }
  .sp-rich a { color: var(--color-violet-deep); text-decoration: underline; text-underline-offset: 3px; }
  .sp-rich ul, .sp-rich ol { margin: 0 0 14px; padding-left: 22px; } .sp-rich ul { list-style: disc; } .sp-rich ol { list-style: decimal; }
  .sp-rich li { margin: 4px 0; }
  .sp-rich blockquote { margin: 18px 0; padding: 4px 0 4px 18px; border-left: 3px solid #cdbff0; color: var(--color-ink); font-style: italic; }
  .sp-rich img { display: block; max-width: 100%; height: auto; margin: 18px 0; border-radius: 14px; }
  .sp-rich table { width: 100%; margin: 18px 0; border-collapse: collapse; font-size: 14.5px; }
  .sp-rich th, .sp-rich td { padding: 9px 12px; text-align: left; border-bottom: 1px solid #ebe7f3; }
  .sp-rich th { color: var(--color-ink); background: #faf8fe; }
  .sp-rich code { padding: 1px 6px; border-radius: 6px; background: #f1ecfc; font: 600 13.5px var(--font-mono); }
  .sp-rich pre { overflow-x: auto; padding: 14px 16px; border-radius: 12px; background: #1a0d33; color: #efe9fb; font: 13.5px/1.6 var(--font-mono); }
  .sp-rich pre code { padding: 0; background: none; color: inherit; }
  .sp-rich hr { margin: 28px 0; border: 0; border-top: 1px solid #ebe7f3; }
  .sp-rich figure { margin: 18px 0; } .sp-rich figcaption { margin-top: 6px; font-size: 13px; color: var(--color-mute); }
  .sp-rich details { margin: 12px 0; padding: 12px 16px; background: #fff; border: 1px solid #ebe7f3; border-radius: 12px; }
  .sp-rich summary { font-weight: 650; color: var(--color-ink); cursor: pointer; }
  .sp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 18px; }
  .sp-card { display: block; overflow: hidden; background: #fff; border: 1px solid #ebe7f3; border-radius: 18px; color: inherit; text-decoration: none; box-shadow: 0 1px 2px rgb(26 5 51 / 0.04); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
  .sp-card:hover { transform: translateY(-3px); border-color: #d8ccf0; box-shadow: 0 22px 36px -22px rgb(91 33 182 / 0.35); }
  .sp-card img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .sp-card-body { display: grid; gap: 2px; padding: 14px 16px 16px; }
  .sp-card-body strong { font-size: 15.5px; color: var(--color-ink); }
  .sp-card-body small { font-size: 13px; color: var(--color-mute); }
  .sp-mini { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
  .sp-mini i { padding: 2px 7px; border-radius: 6px; background: #f4f1fb; font: 600 11.5px var(--font-mono); font-style: normal; color: var(--color-violet-deep); }
  .sp-head { max-width: 640px; margin: 20px 0 36px; }
  .sp-head p { margin: 0; font-size: 17px; line-height: 1.65; color: var(--color-body); }
  .sp-empty { padding: 48px 0; text-align: center; color: var(--color-mute); }
  .sp-note { margin-top: 44px; padding: 16px 20px; font-size: 13.5px; line-height: 1.6; color: var(--color-mute); background: #fff; border: 1px dashed #d9d0ec; border-radius: 14px; }
  @media (max-width: 760px) {
    .sp-dgs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .sg { --rb: 2 !important; }
    .sg[data-wide] { --rb: 1 !important; }
    .sg-sec { grid-template-columns: 26px minmax(0, 1fr); }
    .sg-c { min-height: 38px; padding: 0 5px; font-size: 13px; }
    .sp-main { padding: 26px 18px 72px; }
    .sp-hero { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .sp-hero img { max-width: 360px; }
    .sp-prog li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .sp-facts div { padding: 12px 14px; }
  }
</style>

<script>
  // Draws the chord diagrams on a song page with the same shapes the player uses, and lets a chord show its other voicings.
  import { getGuitarShapes, chordNotes } from "../lib/chordShapes";
  import { diagramSvg } from "../lib/tools/diagram";

  document.querySelectorAll<HTMLElement>(".sp-dg").forEach((card) => {
    const chord = card.dataset.chord ?? "";
    const art = card.querySelector<HTMLElement>(".sp-dg-art")!;
    const notes = card.querySelector<HTMLElement>(".sp-dg-notes")!;
    const nav = card.querySelector<HTMLElement>(".sp-dg-nav")!;
    const label = nav.querySelector("span")!;
    let shapes: ReturnType<typeof getGuitarShapes> = [];
    try {
      shapes = getGuitarShapes(chord);
      notes.textContent = chordNotes(chord).join(" ");
    } catch {
      // a chord with no shape just shows its name
    }
    let at = 0;
    const draw = () => {
      art.innerHTML = shapes.length ? diagramSvg(shapes[at]) : "";
      label.textContent = `${at + 1} / ${shapes.length}`;
    };
    if (!shapes.length) return;
    draw();
    if (shapes.length > 1) {
      nav.hidden = false;
      nav.querySelectorAll<HTMLButtonElement>("button").forEach((button) =>
        button.addEventListener("click", () => {
          at = (at + Number(button.dataset.step) + shapes.length) % shapes.length;
          draw();
        }),
      );
    }
  });
</script>
