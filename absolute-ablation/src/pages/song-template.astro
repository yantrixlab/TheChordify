---
// Not a page people visit. The server fills it in to make every public song page and the songs list (backend/app/songpages.py):
// it swaps the __SP_ markers for that song's title, description, picture and content, so the header, footer and styles are the site's own.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="__SP_TITLE__" description="__SP_DESC__" image="https://img.invalid/__SP_IMAGE__" noindex>
  <Nav />
  <main id="main-content" class="sp-main">__SP_BODY__</main>
  <Footer />
</Layout>

<style is:global>
  .sp-main { background: #faf9fc; padding: 40px 24px 96px; min-height: 70vh; }
  .sp-wrap { max-width: 920px; margin: 0 auto; }
  .sp-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 26px; font-size: 13.5px; color: var(--color-mute); }
  .sp-crumb a { color: var(--color-body); text-decoration: none; }
  .sp-crumb a:hover { color: var(--color-violet-deep); text-decoration: underline; }
  .sp-eyebrow { margin: 0 0 10px; font: 600 12px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-violet-deep); }
  .sp-hero { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 34px; align-items: center; margin-bottom: 30px; }
  .sp-hero img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 20px; box-shadow: 0 24px 50px -28px rgb(26 5 51 / 0.5); }
  .sp-hero h1, .sp-head h1 { margin: 0 0 8px; font-size: clamp(30px, 4.6vw, 46px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.08; color: var(--color-ink); text-wrap: balance; }
  .sp-by { margin: 0 0 22px; font-size: 18px; color: var(--color-body); }
  .sp-play { display: inline-flex; align-items: center; gap: 10px; height: 50px; padding: 0 26px; border-radius: 999px; background: var(--color-ink); color: #fff; font: 650 15.5px var(--font-sans); text-decoration: none; box-shadow: 0 14px 30px -14px rgb(13 0 31 / 0.6); transition: transform 0.15s, box-shadow 0.15s; }
  .sp-play:hover { transform: translateY(-2px); box-shadow: 0 18px 34px -14px rgb(13 0 31 / 0.7); }
  .sp-hero small { display: block; margin-top: 12px; font-size: 13px; color: var(--color-mute); }
  .sp-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0; margin: 0 0 14px; padding: 6px 0; background: #fff; border: 1px solid #ebe7f3; border-radius: 18px; box-shadow: 0 1px 2px rgb(26 5 51 / 0.04); }
  .sp-facts div { padding: 14px 20px; }
  .sp-facts div + div { border-left: 1px solid #f0ecf7; }
  .sp-facts dt { margin: 0 0 4px; font: 600 11px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-mute); }
  .sp-facts dd { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -0.02em; color: var(--color-ink); }
  .sp-block { margin-top: 40px; }
  .sp-block h2 { margin: 0 0 16px; font-size: 22px; font-weight: 700; letter-spacing: -0.025em; color: var(--color-ink); }
  .sp-block p { max-width: 720px; margin: 0 0 14px; font-size: 16px; line-height: 1.7; color: var(--color-body); }
  .sp-chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .sp-chips span { display: inline-grid; place-items: center; min-width: 54px; height: 44px; padding: 0 14px; border-radius: 12px; background: #fff; border: 1px solid #e4dcf3; font: 700 17px var(--font-mono); color: var(--color-violet-deep); box-shadow: 0 1px 2px rgb(26 5 51 / 0.04); }
  .sp-prog { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .sp-prog li { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 16px; align-items: baseline; padding: 14px 18px; background: #fff; border: 1px solid #ebe7f3; border-radius: 14px; }
  .sp-prog strong { font-size: 14px; color: var(--color-ink); }
  .sp-prog span { font: 600 15.5px var(--font-mono); line-height: 1.7; color: var(--color-violet-deep); }
  .sp-prog b { margin: 0 4px; font-weight: 400; color: #b9aed2; }
  .sp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 18px; }
  .sp-card { display: block; overflow: hidden; background: #fff; border: 1px solid #ebe7f3; border-radius: 18px; color: inherit; text-decoration: none; box-shadow: 0 1px 2px rgb(26 5 51 / 0.04); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
  .sp-card:hover { transform: translateY(-3px); border-color: #d8ccf0; box-shadow: 0 22px 36px -22px rgb(91 33 182 / 0.35); }
  .sp-card img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .sp-card-body { display: grid; gap: 2px; padding: 14px 16px 16px; }
  .sp-card-body strong { font-size: 15.5px; color: var(--color-ink); }
  .sp-card-body small { font-size: 13px; color: var(--color-mute); }
  .sp-mini { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
  .sp-mini i { padding: 2px 7px; border-radius: 6px; background: #f4f1fb; font: 600 11.5px var(--font-mono); font-style: normal; color: var(--color-violet-deep); }
  .sp-head { max-width: 640px; margin: 20px 0 36px; }
  .sp-head p { margin: 0; font-size: 17px; line-height: 1.65; color: var(--color-body); }
  .sp-empty { padding: 48px 0; text-align: center; color: var(--color-mute); }
  .sp-note { margin-top: 44px; padding: 16px 20px; font-size: 13.5px; line-height: 1.6; color: var(--color-mute); background: #fff; border: 1px dashed #d9d0ec; border-radius: 14px; }
  @media (max-width: 760px) {
    .sp-main { padding: 26px 18px 72px; }
    .sp-hero { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .sp-hero img { max-width: 360px; }
    .sp-prog li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .sp-facts div { padding: 12px 14px; }
  }
</style>
