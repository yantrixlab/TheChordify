</style>

<script>
  import { chordDrawing, chordNotes, chordKeyLabel, transposeChord, type GuitarShape, type PianoVoicing, type InstrumentId } from "../lib/chordShapes";
  import { diagramSvg } from "../lib/tools/diagram";
  import { pianoSvg } from "../lib/pianoDiagram";
  import { instrumentFor, setInstrument } from "../lib/instrument";
  import { API_BASE, registerJam, type ExtractResult, type ChordSegment, type Bar, type Section, type StrumPattern, type StrumOne } from "../lib/api";
  import { heartButton, recordPlay } from "../lib/library";
  import { cachedUser } from "../lib/auth";
  import { openSignIn } from "../lib/authUi";
  import { nextStroke, resample, slotNames, defaultPattern, type Stroke } from "../lib/songEdit";
  import { can, loadPlan, nudge } from "../lib/plan";
  import { toast } from "../lib/toast";
  import { downloadMidi, downloadPdf, type ExportSong } from "../lib/exportSong";

  const params = new URLSearchParams(window.location.search);
  const sessionId = params.get("session");

  const loadingState = document.getElementById("loading-state")!;
  const errorState = document.getElementById("error-state")!;
  const errorMessage = document.getElementById("error-message")!;
  const playerState = document.getElementById("player-state")!;
  const youtubeMount = document.getElementById("youtube-mount")!;
  const audioEl = document.getElementById("audio-el") as HTMLAudioElement;
  const viewTabDiagrams = document.getElementById("view-tab-diagrams") as HTMLButtonElement;
  const viewTabGrid = document.getElementById("view-tab-grid") as HTMLButtonElement;
  const panelDiagrams = document.getElementById("panel-diagrams")!;
  const panelGrid = document.getElementById("panel-grid")!;
  const chordGridEl = document.getElementById("chord-grid")!;

  const volumeSlider = document.getElementById("volume-slider") as HTMLInputElement;
  const loopToggle = document.getElementById("loop-toggle") as HTMLButtonElement;
  const tempoDown = document.getElementById("tempo-down") as HTMLButtonElement;
  const tempoUp = document.getElementById("tempo-up") as HTMLButtonElement;
  const tempoValueEl = document.getElementById("tempo-value")!;
  const capoDown = document.getElementById("capo-down") as HTMLButtonElement;
  const capoUp = document.getElementById("capo-up") as HTMLButtonElement;
  const capoValueEl = document.getElementById("capo-value")!;
  const transposeDown = document.getElementById("transpose-down") as HTMLButtonElement;
  const transposeUp = document.getElementById("transpose-up") as HTMLButtonElement;
  const transposeValueEl = document.getElementById("transpose-value")!;
  const meterDown = document.getElementById("meter-down") as HTMLButtonElement;
  const meterUp = document.getElementById("meter-up") as HTMLButtonElement;
  const meterValueEl = document.getElementById("meter-value")!;
  const pulseDown = document.getElementById("pulse-down") as HTMLButtonElement;
  const pulseUp = document.getElementById("pulse-up") as HTMLButtonElement;
  const pulseValueEl = document.getElementById("pulse-value")!;
  const barStartDown = document.getElementById("barstart-down") as HTMLButtonElement;
  const barStartUp = document.getElementById("barstart-up") as HTMLButtonElement;
  const barStartValueEl = document.getElementById("barstart-value")!;
  const countInToggle = document.getElementById("countin-toggle") as HTMLButtonElement;
  const sectionsToggle = document.getElementById("sections-toggle") as HTMLButtonElement;
  const detailToggle = document.getElementById("detail-toggle") as HTMLButtonElement;

  // Features a plan can leave out. The buttons stay where they are; a locked one explains instead of acting.
  const LOCKS: [selector: string, key: string, label: string][] = [
    ["#capo-down, #capo-up, #transpose-down, #transpose-up", "transpose_capo", "Transpose and capo"],
    ["#detail-toggle", "chord_detail", "Full chord detail"],
    [".instrument-tab[data-inst='piano'], .instrument-tab[data-inst='ukulele'], .instrument-tab[data-inst='mandolin']", "instruments_more", "The piano, ukulele and mandolin views"],
    ["#export-pdf", "pdf_export", "The chord sheet PDF"],
    ["#export-midi, #export-midi-strum", "midi_export", "The chords as a MIDI file"],
  ];
  document.addEventListener(
    "click",
    (event) => {
      const target = event.target as Element | null;
      for (const [selector, key, label] of LOCKS) {
        if (target?.closest(selector) && !can(key)) {
          event.stopPropagation(); // before the button's own handler sees it
          event.preventDefault();
          nudge(label);
          return;
        }
      }
    },
    true,
  );
  function applyLocks() {
    for (const [selector, key] of LOCKS) {
      document.querySelectorAll<HTMLElement>(selector).forEach((button) => {
        button.classList.toggle("is-locked", !can(key));
        button.setAttribute("aria-disabled", String(!can(key)));
      });
    }
  }
  window.addEventListener("plan-change", () => {
    applyLocks();
    // a plan without the other instruments shows the guitar (the choice is kept, for when the plan allows it)
    const shown = instrumentFor(can);
    const fellBack = shown !== activeInstrument;
    if (fellBack) chooseInstrument(shown);
    if (fellBack || !can("chord_voicings")) refreshViews(); // draw the diagrams again, for the instrument or without the arrows
  });
  void loadPlan();

  const headerEl = document.getElementById("player-header")!;
  const songTitleEl = document.getElementById("song-title")!;
  const songArtistEl = document.getElementById("song-artist")!;
  const songNoteEl = document.getElementById("song-note")!;
  const btnPlay = document.getElementById("btn-play") as HTMLButtonElement;
  const btnRestart = document.getElementById("btn-restart") as HTMLButtonElement;
  const timeNowEl = document.getElementById("time-now")!;
  const timeTotalEl = document.getElementById("time-total")!;
  const progressEl = document.getElementById("progress")!;
  const sectionSelect = document.getElementById("section-select") as HTMLSelectElement;
  const btnShare = document.getElementById("btn-share") as HTMLButtonElement;
  const sdChipsEl = document.getElementById("sd-chords")!;
  const sdKeyEl = document.getElementById("sd-key")!;
  const sdTempoEl = document.getElementById("sd-tempo")!;
  const sdSectionsEl = document.getElementById("sd-sections")!;
  const dgAnimated = document.getElementById("dg-animated") as HTMLButtonElement;
  const dgSummary = document.getElementById("dg-summary") as HTMLButtonElement;
  const dgAnimatedPanel = document.getElementById("dg-animated-panel")!;
  const dgSummaryPanel = document.getElementById("dg-summary-panel")!;
  const summaryGridEl = document.getElementById("summary-grid")!;

  const SEMITONE_NAMES = ["0", "+1", "+2", "+3", "+4", "+5", "+6", "-5", "-4", "-3", "-2", "-1"];
  let BARS_PER_ROW = 4; // bars per row in the chords grid (fewer when a bar has many beats)

  let activeInstrument: InstrumentId = instrumentFor(can); // what the person chose (the account's, or this device's), if the plan allows it
  let chords: ChordSegment[] = []; // the set being shown: simple (core chords) or detailed
  let chordsSimple: ChordSegment[] = [];
  let chordsDetailed: ChordSegment[] = [];
  let sections: Section[] = [];
  let bars: Bar[] = [];
  let duration = 0;
  let tempo = 120;
  let songKey = ""; // estimated key of the song, e.g. "G" or "F#m"
  let loopEnabled = false;
  let tempoPct = 100;
  let capo = 0;
  let transposeSteps = 0;

  // A chord can be played in a few places on the neck. The way a player picks for a chord (0 = the usual one) is used for
  // that chord everywhere in the song, and kept for next time. It only changes the diagrams, never the detected chords.
  const VOICING_KEY = "chordsuno-voicings";
  let voicingPick: Record<string, number> = {};
  try {
    voicingPick = JSON.parse(localStorage.getItem(VOICING_KEY) || "{}") || {};
  } catch {
    // no storage, or damaged: everyone starts with the usual shapes
  }

  /** One way of playing a chord on the instrument being shown: a fret diagram, or the keys of a piano chord. */
  type Way = { kind: "frets"; shape: GuitarShape } | { kind: "keys"; voicing: PianoVoicing };

  /** Every way of playing a chord on the instrument being shown (the guitar's, ukulele's or mandolin's fingerings, or the piano's keys). */
  function waysFor(fChord: string): Way[] {
    const drawing = chordDrawing(activeInstrument, fChord);
    return drawing.kind === "keys" ? drawing.voicings.map((voicing) => ({ kind: "keys" as const, voicing })) : drawing.shapes.map((shape) => ({ kind: "frets" as const, shape }));
  }
  /** What a chosen way of playing is remembered under: each instrument's choices are kept apart ("u:" ukulele, "m:" mandolin, "p:" piano). */
  const pickKey = (fChord: string) => (activeInstrument === "guitar" ? fChord : `${activeInstrument[0]}:${fChord}`);

  function shapeChoice(fChord: string): { way: Way; index: number; count: number } | undefined {
    const ways = waysFor(fChord);
    if (ways.length === 0) return undefined;
    const index = Math.min(Math.max(Number(voicingPick[pickKey(fChord)]) || 0, 0), ways.length - 1);
    return { way: ways[index], index, count: ways.length };
  }

  /** The diagram of a chord with its arrows, or a note card for a chord with no shape. */
  function chordDiagram(fChord: string, label: string, scale = 1, keyboardArrows = true): HTMLElement {
    const choice = shapeChoice(fChord);
    if (!choice) return buildNoteFallbackCard(label);
    const pick = choice.count > 1 && can("chord_voicings") ? { index: choice.index, count: choice.count, step: (delta: number) => stepVoicing(fChord, delta), keyboardArrows } : undefined;
    const diagram = choice.way.kind === "keys" ? buildPianoDiagram(label, choice.way.voicing, scale, pick) : buildFretDiagram(label, choice.way.shape, scale, pick);
    diagram.dataset.fchord = fChord;
    return diagram;
  }

  /** Moves a chord to its next (or previous) way of playing, everywhere it appears. */
  function stepVoicing(fChord: string, delta: number) {
    const count = waysFor(fChord).length;
    if (count < 2) return;
    const next = ((Number(voicingPick[pickKey(fChord)]) || 0) + delta + count) % count;
    if (next === 0) delete voicingPick[pickKey(fChord)];
    else voicingPick[pickKey(fChord)] = next;
    try {
      localStorage.setItem(VOICING_KEY, JSON.stringify(voicingPick));
    } catch {
      // the choice just is not remembered
    }
    // Swap the diagram in place wherever this chord is drawn (the playing strip keeps its position and widths).
    document.querySelectorAll<HTMLElement>(`.cr-item[data-fchord="${CSS.escape(fChord)}"]`).forEach((item) => {
      const card = item.querySelector<HTMLElement>(".cr-card");
      if (card) card.replaceChildren(chordDiagram(fChord, item.dataset.label || fChord, 1, false));
    });
    summaryGridEl.querySelectorAll<HTMLElement>(`[data-fchord="${CSS.escape(fChord)}"]`).forEach((card) => {
      const fresh = chordDiagram(fChord, fChord, 1);
      fresh.title = card.title;
      card.replaceWith(fresh);
    });
  }
  let activeView: "diagrams" | "grid" = "diagrams"; // the chord diagrams are what people come for

  function semitoneLabel(n: number): string {
    const wrapped = ((n % 12) + 12) % 12;
    return SEMITONE_NAMES[wrapped];
  }

  /** The chord as the player should sing/call it (after Transpose). */
  function displayChord(rawChord: string): string {
    return transposeChord(rawChord, transposeSteps);
  }

  /** The shape to actually finger on the instrument (after Transpose, undone by Capo). */
  function fingeringChord(rawChord: string): string {
    return transposeChord(rawChord, transposeSteps - capo);
  }

  function fail(message: string) {
    loadingState.classList.add("hidden");
    errorState.classList.remove("hidden");
    errorMessage.textContent = message;
  }

  /** Find which chord segment is sounding at time `t` (binary-search-free, fine at this size). */
  function chordAt(t: number): string {
    const seg = chords.find((s) => t >= s.start && t < s.end);
    return seg ? seg.chord : "N";
  }

  function formatClock(t: number): string {
    return `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, "0")}`;
  }

  function buildNoteFallbackCard(fChord: string): HTMLElement {
    const card = document.createElement("div");
    card.style.boxSizing = "border-box";
    card.style.width = "114px";
    card.style.display = "flex";
    card.style.flexDirection = "column";
    card.style.alignItems = "center";
    card.style.justifyContent = "center";
    card.style.background = "var(--color-canvas)";
    card.style.border = "1px solid var(--color-hairline)";
    card.style.borderRadius = "10px";
    card.style.padding = "16px 10px";
    card.style.textAlign = "center";
    card.innerHTML = `<div style="font-weight:700;font-size:14px;color:var(--color-ink);margin-bottom:6px;">${fChord}</div><div style="font-size:11px;color:var(--color-mute);">${chordNotes(fChord).join(", ")}</div>`;
    return card;
  }

  // ---- Player header: title, play/pause and a progress bar that is split into the song's sections --------
  const ICON_PLAY = '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>';
  const ICON_PAUSE = '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"/></svg>';
  let progressSegs: { fill: HTMLElement; start: number; end: number; shown: number }[] = [];
  let currentSectionIdx = -1;

  // A "jam session" is counted once per visit, when playback first starts (YouTube songs only).
  let jamVideoId = "";
  function countJamOnce() {
    if (!jamVideoId) return;
    const id = jamVideoId;
    jamVideoId = "";
    void registerJam(id);
  }

  // For a signed-in person, a visit to a song goes in their history and earns XP, once, when playback first starts.
  let playRecorded = false;
  function recordMyPlayOnce() {
    if (playRecorded || !sessionId) return;
    playRecorded = true;
    void recordPlay(sessionId);
  }

  function setPlayingUi(playing: boolean) {
    if (playing) {
      countJamOnce();
      recordMyPlayOnce();
      lastFollowedRow = null; // re-centre the grid on the playing row as soon as playback starts
      if (gridActive >= 0) {
        gridCells[gridActive].el.classList.remove("is-active"); // the lit cell is forgotten, so it must go dark too
        gridCells[gridActive].bar.classList.remove("is-current");
      }
      gridActive = -1;
    }
    if (playing) {
      stripBusyUntil = 0; // back to the playing beat, wherever the strip was scrolled to
      followStrip(true);
    }
    btnPlay.innerHTML = playing ? ICON_PAUSE : ICON_PLAY;
    btnPlay.setAttribute("aria-label", playing ? "Pause" : "Play");
    strumCard.classList.toggle("is-live", playing && !liteMode);
  }

  /** One progress segment (and one "jump to" option) per section; a single one when there are none. */
  function renderProgress() {
    progressEl.innerHTML = "";
    sectionSelect.innerHTML = "";
    progressSegs = [];
    currentSectionIdx = -1;
    lastClock = "";
    lastSecond = -1;
    const parts = sections.length > 0 ? sections : [{ label: "Song", start: 0, end: duration }];

    parts.forEach((part, i) => {
      const seg = document.createElement("div");
      seg.className = "pb-seg";
      seg.style.flex = `${Math.max(part.end - part.start, 0.5)} 1 0`;
      seg.title = part.label;
      const fill = document.createElement("div");
      fill.className = "pb-fill";
      seg.appendChild(fill);
      progressEl.appendChild(seg);
      progressSegs.push({ fill, start: part.start, end: part.end, shown: -1 });

      const option = document.createElement("option");
      option.value = String(i);
      option.textContent = part.label;
      sectionSelect.appendChild(option);
    });
    sectionSelect.hidden = sections.length === 0;
    progressEl.setAttribute("aria-valuemax", String(Math.round(duration)));
    timeTotalEl.textContent = formatClock(duration);
  }

  /** Time label, progress fills and the section picker. Runs every frame, so it writes to the page only what has changed. */
  let lastClock = "";
  let lastSecond = -1;
  function updateTransport(t: number) {
    const clock = formatClock(t);
    if (clock !== lastClock) {
      lastClock = clock;
      timeNowEl.textContent = clock;
    }
    const whole = Math.round(t);
    if (whole !== lastSecond) {
      lastSecond = whole;
      progressEl.setAttribute("aria-valuenow", String(whole));
    }
    let current = -1;
    for (let i = 0; i < progressSegs.length; i++) {
      const seg = progressSegs[i];
      if (t >= seg.start && t < seg.end) current = i;
      const fraction = t >= seg.end ? 1 : t <= seg.start ? 0 : (t - seg.start) / Math.max(seg.end - seg.start, 0.001);
      const shown = Math.round(fraction * 300) / 300; // a third of a percent: finer than a pixel on any phone
      if (shown !== seg.shown) {
        seg.shown = shown;
        seg.fill.style.transform = `scaleX(${shown})`; // a transform: no layout while the bar grows
      }
    }
    if (current !== -1 && current !== currentSectionIdx) {
      currentSectionIdx = current;
      sectionSelect.value = String(current);
    }
  }

  /** Click or tap on the progress bar: jump to that point inside whichever section was hit. */
  function seekFromProgress(event: PointerEvent) {
    const segEls = Array.from(progressEl.children) as HTMLElement[];
    const index = segEls.findIndex((el) => {
      const r = el.getBoundingClientRect();
      return event.clientX >= r.left - 1.5 && event.clientX <= r.right + 1.5;
    });
    if (index === -1) return;
    const r = segEls[index].getBoundingClientRect();
    const fraction = Math.min(1, Math.max(0, (event.clientX - r.left) / Math.max(r.width, 1)));
    const seg = progressSegs[index];
    seekTo(seg.start + fraction * (seg.end - seg.start));
  }

  // ---- Chords grid: every bar of the song, grouped into sections ---------------------------------------
  let BEAT_CELLS = 4; // beats in a bar: set from the song (see applyMeter), 4 until it is known
  interface GridCell {
    el: HTMLElement;
    start: number;
    bar: HTMLElement;
    row: HTMLElement;
  }
  let gridCells: GridCell[] = [];
  let gridActive = -1;
  let gridFollowPausedUntil = 0; // while the person scrolls the page themselves, don't fight them

  const SECTION_COLORS: Record<string, string> = {
    silence: "#e5e7eb",
    intro: "#fde68a",
    verse: "#bfdbfe",
    chorus: "#bbf7d0",
    bridge: "#fed7aa",
    outro: "#e9d5ff",
    instrumental: "#fbcfe8",
    break: "#e5e7eb",
  };
  const PART_COLORS = ["#c7d2fe", "#fbcfe8", "#a7f3d0", "#fde68a", "#bae6fd", "#fecaca"];

  function sectionColor(label: string): string {
    const kind = label.split(" ")[0].toLowerCase();
    if (SECTION_COLORS[kind]) return SECTION_COLORS[kind];
    const letter = label.startsWith("Part ") ? label.charCodeAt(5) - 65 : 0;
    return PART_COLORS[((letter % PART_COLORS.length) + PART_COLORS.length) % PART_COLORS.length];
  }

  function firstNumber(values: (number | null)[]): number | null {
    for (const v of values) if (v !== null) return v;
    return null;
  }

  /** A song that starts part-way through a bar has beats that come before the music: the analysis fills them in backwards from the
   *  first beat, and a beat cannot be earlier than 0:00, so several of them pile up at 0:00. They are not beats of the song, so those
   *  cells are left empty (as a lead-in is on a chord chart) and the song starts on the first cell that has a beat: the first one lit,
   *  and the first one to hold the first chord, with no jump over cells that were never played. */
  function trimPickup(all: Bar[]): Bar[] {
    if (all.length === 0) return all;
    const first = all[0].beats.slice();
    let trimmed = 0;
    // The pile-up sits at exactly 0:00 (the fill-in is clamped there); a real beat is never at exactly 0.
    while (trimmed < first.length - 1 && first[trimmed] !== null && (first[trimmed] as number) <= 1e-9 && Math.max(0, ...first.slice(trimmed + 1).map((t) => t ?? 0)) > 1e-9) {
      first[trimmed] = null;
      trimmed++;
    }
    if (trimmed === 0) return all; // no beats before the music: nothing to do
    const start = firstNumber(first) ?? all[0].start;
    return [{ ...all[0], start, beats: first }, ...all.slice(1)];
  }

  /** The chord written in each beat cell, as [bar][beat]: a chord name, "N" for a rest, or null while the previous chord
   *  keeps ringing (and for the empty cells of a pickup bar). Chords go in the cell the analysis chose for them
   *  (gridStart), not necessarily the one nearest their detected time: that keeps a syncopated or slightly-early
   *  change on the same beat from bar to bar. */
  function placeChordsOnBeats(): (string | null)[][] {
    const firstSound = chords.findIndex((seg) => seg.chord !== "N");
    const placed = chords
      .filter((seg, i) => seg.gridStart !== null && !(seg.chord === "N" && i < firstSound)) // nothing sounds before the song starts
      .map((seg) => ({ chord: seg.chord, start: meter.pulse === 1 ? (seg.gridStart ?? seg.start) : seg.start }));
    let next = 0; // next chord not yet written; cells and chords are both in time order
    let seenBeat = false; // the first cell with a beat is where the song starts: a chord heard before it belongs to it
    return bars.map((bar) =>
      Array.from({ length: BEAT_CELLS }, (_, k) => {
        const t0 = bar.beats[k];
        if (t0 === null) return null;
        const t1 = firstNumber(bar.beats.slice(k + 1)) ?? duration;
        const half = Math.max(t1 - t0, 0.05) / 2;
        if (seenBeat) while (next < placed.length && placed[next].start < t0 - half) next++;
        seenBeat = true;
        return next < placed.length && placed[next].start < t0 + half ? placed[next++].chord : null;
      }),
    );
  }

  /** The chords on the beats, with the rest sign ("N") on every beat of a pause, not just the first: after a rest the blank cells are
   *  silence, not a chord ringing on. A long silence (a fade-out, a break) is shown for two bars at most. */
  function placeChordsWithRests(): (string | null)[][] {
    const written = placeChordsOnBeats();
    let resting = 0; // beats of silence still to mark
    const limit = BEAT_CELLS * 2;
    let run = 0;
    return written.map((beats, b) =>
      beats.map((chord, k) => {
        if (bars[b]?.beats[k] === null || bars[b]?.beats[k] === undefined) return chord; // no beat here (a pickup, a short last bar)
        if (chord === "N") {
          resting = 1;
          run = 1;
          return chord;
        }
        if (chord) {
          resting = 0;
          return chord;
        }
        if (resting && run < limit) {
          run++;
          return "N";
        }
        return chord;
      }),
    );
  }

  // ---- "Chord diagrams" tab: a beat strip over a row of chord diagrams ------------------------------------
  // The playing position stays at one fixed spot (about a quarter in) while the music moves left beneath it: the
  // strip steps one beat at a time, the diagrams slide one chord at a time with the playing chord enlarged.
  const ANCHOR = 0.28; // where the playing beat / chord sits, as a share of the width
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches; // scroll without animating
  // Slow phones: when the page cannot keep up (many slow frames in a row), or the phone is known to be modest, the decoration is dropped
  // (glows, drifting light, flashes) and the strip jumps a beat instead of gliding. It is remembered for the next visit.
  let liteMode = false;
  function setLite(on: boolean, remember = false) {
    liteMode = on;
    document.documentElement.classList.toggle("perf-lite", on);
    if (on) document.getElementById("strum-card")?.classList.remove("is-live");
    if (on && remember) {
      try {
        localStorage.setItem("chordsuno-lite", "1");
      } catch {
        // not remembered
      }
    }
  }
  try {
    const modest = (navigator.hardwareConcurrency || 8) <= 4 || ((navigator as any).deviceMemory ?? 8) <= 3;
    if (modest || localStorage.getItem("chordsuno-lite") === "1") setLite(true);
  } catch {
    // no storage: only the first check applies
  }
  // Performance mode is a setting (on the device and the account): signing in, or changing it in Settings, changes it here too
  window.addEventListener("settings-change", (event) => {
    const chosen = !!(event as CustomEvent<{ lite: boolean }>).detail?.lite;
    const modest = (navigator.hardwareConcurrency || 8) <= 4 || ((navigator as any).deviceMemory ?? 8) <= 3;
    setLite(chosen || modest);
  });
  const LEAD_CELLS = 8; // empty cells before the silent bar, so the playing beat can sit a quarter in from the very start
  let SILENT_CELLS = 4; // the silent bar before the song: blank cells and a rest sign, one bar long
  const TAIL_CELLS = 30; // empty cells after the last beat, so the strip can scroll the last beat into place
  let FIRST_CELL = LEAD_CELLS + SILENT_CELLS; // the first beat of the song

  /** A song counts its bars in 3, 4 or 6 beats, not always four: the grid, the strip and the silent bar follow. */
  function applyMeter(perBar: number) {
    const n = Number.isFinite(perBar) ? Math.min(12, Math.max(2, Math.round(perBar))) : 4;
    BEAT_CELLS = n;
    SILENT_CELLS = n;
    FIRST_CELL = LEAD_CELLS + SILENT_CELLS;
    BARS_PER_ROW = n >= 6 ? 2 : 4;
    chordGridEl.style.setProperty("--bpb", String(n));
    chordGridEl.style.setProperty("--rb", String(BARS_PER_ROW));
    chordGridEl.style.setProperty("--rbm", String(n >= 5 ? 1 : 2)); // bars per row on a phone
    chordGridEl.classList.toggle("wide-bars", n >= 6);
  }

  // ---- Bar length: what the analysis found, or what the player sets for this song -----------------------------
  // The analysis groups the beats into bars of 3, 4, 5, 6 or 7, but a loose live recording (or a tracker that locked on
  // every other beat) can fool it. So the player can regroup the beats: beats per bar, a beat in between each beat
  // ("pulse" x2), and the beat a bar starts on. The choice is kept per song.
  interface MeterSetting {
    perBar: number;
    pulse: 1 | 2;
    shift: number | null; // beats before the first bar line (a pickup); null = where the chords change
  }
  const METER_KEY = "chordsuno-meter:";
  const METER_MIN = 2;
  const METER_MAX = 9;
  let baseBars: Bar[] = [];
  let baseSections: Section[] = [];
  let baseBeatsPerBar = 4;
  let baseTempo = 120;
  let meter: MeterSetting = { perBar: 4, pulse: 1, shift: null };
  let meterShift = 0; // the shift in use (the worked-out one when `meter.shift` is null)

  function isSongsOwnMeter(): boolean {
    return meter.perBar === baseBeatsPerBar && meter.pulse === 1 && meter.shift === null;
  }

  /** Every beat the analysis found, in order (pickup beats included). */
  function songBeats(pulse: 1 | 2): number[] {
    const flat: number[] = [];
    for (const bar of baseBars) {
      for (let k = 0; k < baseBeatsPerBar; k++) {
        const t = bar.beats[k];
        if (t !== null && t !== undefined) flat.push(t);
      }
    }
    if (pulse === 1) return flat;
    const doubled: number[] = [];
    flat.forEach((t, i) => {
      doubled.push(t);
      const gap = i + 1 < flat.length ? flat[i + 1] - t : i > 0 ? t - flat[i - 1] : 0.5;
      if (t + gap < duration) doubled.push(t + gap / 2);
    });
    return doubled;
  }

  function nearestBeat(beats: number[], t: number): number {
    let lo = 0;
    let hi = beats.length - 1;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      if (beats[mid] < t) lo = mid + 1;
      else hi = mid;
    }
    return lo > 0 && Math.abs(beats[lo - 1] - t) < Math.abs(beats[lo] - t) ? lo - 1 : lo;
  }

  /** The beat of the bar where chords change most often: that is where bars start. */
  function chordShift(beats: number[], perBar: number): number {
    if (beats.length === 0) return 0;
    const votes = new Array(perBar).fill(0);
    chordsSimple.forEach((seg, i) => {
      if (seg.chord === "N" || i === 0) return;
      votes[nearestBeat(beats, seg.start) % perBar]++;
    });
    return votes.indexOf(Math.max(...votes));
  }

  /** Bars of `perBar` beats; the `shift` beats before the first bar line make a pickup bar. Missing beats are null. */
  function groupBeats(beats: number[], perBar: number, shift: number): Bar[] {
    const out: Bar[] = [];
    const add = (cells: (number | null)[], end: number) => {
      out.push({ start: firstNumber(cells) as number, beats: [...cells, end] });
    };
    let i = 0;
    if (shift > 0 && beats.length > shift) {
      add([...new Array(perBar - shift).fill(null), ...beats.slice(0, shift)], beats[shift]);
      i = shift;
    }
    while (i < beats.length) {
      const cells: (number | null)[] = beats.slice(i, i + perBar);
      while (cells.length < perBar) cells.push(null);
      add(cells, beats[i + perBar] ?? duration);
      i += perBar;
    }
    return out;
  }

  /** The sections again, on the new bars: each starts at the bar nearest its start time. */
  function regroupSections(raw: Section[], to: Bar[]): Section[] {
    const out = raw.map((sec) => ({ ...sec }));
    let prev = -1;
    out.forEach((sec) => {
      if (sec.startBar === null) return;
      let best = 0;
      to.forEach((bar, b) => {
        if (Math.abs(bar.start - sec.start) < Math.abs(to[best].start - sec.start)) best = b;
      });
      sec.startBar = Math.min(Math.max(best, prev + 1), to.length - 1);
      prev = sec.startBar;
    });
    const real = out.filter((sec) => sec.startBar !== null);
    real.forEach((sec, i) => {
      sec.endBar = i + 1 < real.length ? Math.max((real[i + 1].startBar as number) - 1, sec.startBar as number) : to.length - 1;
    });
    return out;
  }

  /** Works out bars, sections and tempo from the song's beats and the current setting. */
  function rebuildMeter() {
    if (isSongsOwnMeter()) {
      bars = baseBars;
      sections = baseSections;
      meterShift = 0;
    } else {
      const beats = songBeats(meter.pulse);
      meterShift = Math.min(meter.shift ?? chordShift(beats, meter.perBar), meter.perBar - 1);
      bars = groupBeats(beats, meter.perBar, meterShift);
      sections = regroupSections(baseSections, bars);
    }
    tempo = baseTempo * meter.pulse;
    applyMeter(meter.perBar);
    meterValueEl.textContent = String(meter.perBar);
    meterValueEl.style.color = meter.perBar === baseBeatsPerBar ? "var(--color-ink)" : "var(--color-violet-text, var(--color-violet))";
    pulseValueEl.textContent = `×${meter.pulse}`;
    pulseValueEl.style.color = meter.pulse === 1 ? "var(--color-ink)" : "var(--color-violet-text, var(--color-violet))";
    barStartValueEl.textContent = meter.shift === null ? "auto" : meter.shift === 0 ? "0" : `+${meter.shift}`;
    barStartValueEl.style.color = meter.shift === null ? "var(--color-ink)" : "var(--color-violet-text, var(--color-violet))";
  }

  function saveMeter() {
    try {
      if (isSongsOwnMeter()) localStorage.removeItem(METER_KEY + sessionId);
      else localStorage.setItem(METER_KEY + sessionId, JSON.stringify(meter));
    } catch {
      // the choice just does not stay for next time
    }
  }

  function loadMeter() {
    try {
      const saved = JSON.parse(localStorage.getItem(METER_KEY + sessionId) || "null");
      if (
        saved &&
        Number.isInteger(saved.perBar) && saved.perBar >= METER_MIN && saved.perBar <= METER_MAX &&
        (saved.pulse === 1 || saved.pulse === 2) &&
        (saved.shift === null || (Number.isInteger(saved.shift) && saved.shift >= 0 && saved.shift < saved.perBar))
      ) {
        meter = { perBar: saved.perBar, pulse: saved.pulse, shift: saved.shift };
      }
    } catch {
      // nothing saved, or storage is off
    }
  }

  function changeMeter(next: Partial<MeterSetting>) {
    const before = { ...meter };
    meter = { ...meter, ...next };
    if (meter.perBar !== before.perBar || meter.pulse !== before.pulse) meter.shift = next.shift ?? null; // the old pickup no longer fits
    rebuildMeter();
    saveMeter();
    refreshViews();
    renderProgress();
  }

  const stripEl = document.getElementById("beat-strip")!;
  const stripScrollEl = document.getElementById("bs-scroll")!;
  const stripTrackEl = document.getElementById("bs-track")!;
  const stripMarkerEl = document.getElementById("bs-marker")!;
  const carouselEl = document.getElementById("chord-carousel")!;
  const carouselTrackEl = document.getElementById("cr-track")!;

  let stripCells: HTMLElement[] = []; // every cell of the strip, in order (leading empties included)
  let stripTimed: { cell: number; start: number }[] = []; // the cells that have a time, to find the playing one
  let stripActive = -1;
  let stripMarkerX = 0;
  let stripCellWidth = 0;
  let carouselItems: { el: HTMLElement; width: number }[] = [];
  let carouselOfCell: number[] = []; // the carousel item playing at each strip cell
  let carouselOffsets: number[] = []; // where each item starts when none is enlarged
  let carouselGrowth = 0; // how much wider the playing chord's slot is
  let carouselActive = -2;
  let stripBusyUntil = 0; // while the person scrolls the strip themselves, playback does not pull it back
  let stripFree = false; // scrolled away by hand: the marker steps aside until playback (or a seek) brings the strip back
  let stripOursUntil = 0; // scroll events before this time come from our own scrolling, not the person's

  function instantly(el: HTMLElement, change: () => void) {
    el.style.transition = "none";
    change();
    void el.offsetWidth; // apply it without the animation, then let the next change animate again
    el.style.transition = "";
  }

  function renderBeatStrip() {
    stripTrackEl.innerHTML = "";
    stripCells = [];
    stripTimed = [];
    stripActive = -1;
    if (bars.length === 0) return;

    const written = placeChordsWithRests();
    // `start` is when the cell plays (cells without one never light up); `seek` is where a click on it goes.
    const addCell = (chord: string | null, kind: string, start: number | null, seek: number | null = start) => {
      const cell = document.createElement("div");
      cell.className = `bs-cell ${kind}`.trim();
      cell.textContent = chord === "N" ? "𝄽" : chord ? displayChord(chord) : "";
      cell.dataset.len = String(Math.min(cell.textContent.length, 5)); // CSS shrinks long names to fit the square
      if (chord === "N") cell.classList.add("is-rest");
      if (chord) cell.classList.add("has-chord");
      if (seek !== null) cell.addEventListener("click", () => seekTo(Math.max(0, seek)));
      if (start !== null) stripTimed.push({ cell: stripCells.length, start });
      stripCells.push(cell);
      stripTrackEl.appendChild(cell);
    };

    for (let i = 0; i < LEAD_CELLS; i++) addCell(null, "", null, null);
    for (let k = 0; k < SILENT_CELLS; k++) addCell(k === SILENT_CELLS - 1 ? "N" : null, k === 0 ? "is-bar" : "", null, 0);
    bars.forEach((bar, b) => {
      for (let k = 0; k < BEAT_CELLS; k++) addCell(written[b][k], k === 0 ? "is-bar" : "", bar.beats[k]);
    });
    for (let i = 0; i < TAIL_CELLS; i++) addCell(null, "", null, null);
  }

  /** One diagram per chord (a rest is a rest sign), in the order the strip writes them. */
  function renderCarousel() {
    carouselTrackEl.innerHTML = "";
    carouselItems = [];
    carouselOfCell = [];
    carouselOffsets = [];
    carouselActive = -2;
    if (bars.length === 0) return;

    for (let i = 0; i < FIRST_CELL; i++) carouselOfCell.push(-1);
    placeChordsOnBeats().forEach((beats, b) =>
      beats.forEach((chord, k) => {
        if (chord) {
          const start = bars[b].beats[k] as number;
          const item = document.createElement("div");
          item.className = "cr-item";
          item.setAttribute("role", "listitem");
          const card = document.createElement("div");
          card.className = "cr-card";
          if (chord === "N") {
            item.classList.add("is-rest");
            card.textContent = "𝄽";
          } else {
            const fChord = fingeringChord(chord);
            item.dataset.fchord = fChord;
            item.dataset.label = displayChord(chord);
            card.appendChild(chordDiagram(fChord, displayChord(chord), 1, false)); // arrows off the tab order: focusing one would scroll this strip
          }
          item.appendChild(card);
          item.addEventListener("click", () => seekTo(start));
          carouselTrackEl.appendChild(item);
          carouselItems.push({ el: item, width: 0 });
        }
        carouselOfCell.push(carouselItems.length - 1); // the last chord written at or before this cell
      }),
    );
    for (let i = 0; i < TAIL_CELLS; i++) carouselOfCell.push(carouselItems.length - 1);
    measureCarousel();
  }

  /** Item widths come from the stylesheet (they differ on a phone), so read them back once laid out. Every slot is the same width whether
   *  or not its chord is playing (the playing one is only scaled up), so this is one pass of reads with nothing written in between. */
  function measureCarousel() {
    if (carouselItems.length === 0 || carouselEl.clientWidth === 0) return;
    carouselGrowth = 0;
    const widths = carouselItems.map((item) => item.el.getBoundingClientRect().width);
    let offset = 0;
    widths.forEach((width, i) => {
      carouselItems[i].width = width;
      carouselOffsets[i] = offset;
      offset += width;
    });
  }

  /** Beat-cell width and the playing spot depend on the width on screen, so they are measured, not assumed. */
  function layoutDiagrams() {
    if (stripEl.clientWidth === 0 || stripCells.length === 0) return; // the tab is hidden, or there is nothing to show
    stripCellWidth = stripCells[FIRST_CELL].getBoundingClientRect().width || 46;
    stripMarkerX = Math.round(stripScrollEl.clientWidth * ANCHOR); // the playing cell's left edge, from the strip's left edge
    stripMarkerEl.style.left = `${stripMarkerX}px`;
    measureCarousel();
    stripActive = -1;
    carouselActive = -2;
    updateDiagrams(playerTime(), true);
  }

  /** Scrolls the strip so the playing beat sits at its fixed spot, under the marker. */
  function followStrip(smooth: boolean) {
    if (stripActive < 0) return;
    stripFree = false;
    stripEl.classList.remove("is-free");
    stripOursUntil = performance.now() + 600;
    stripScrollEl.scrollTo({
      left: stripCells[stripActive].offsetLeft - stripMarkerX,
      behavior: smooth && !reducedMotion && !liteMode ? "smooth" : "auto",
    });
  }

  // The strip can be scrolled by hand (while paused, or to look ahead); touching it holds off the automatic follow.
  ["wheel", "pointerdown", "mousedown", "touchstart", "keydown"].forEach((type) =>
    stripScrollEl.addEventListener(
      type,
      () => {
        stripBusyUntil = performance.now() + 2500;
        stripOursUntil = 0; // whatever scrolls from here on is the person's doing
      },
      { passive: true },
    ),
  );
  stripScrollEl.addEventListener(
    "scroll",
    () => {
      if (performance.now() < stripOursUntil || stripFree) return;
      stripFree = true;
      stripEl.classList.add("is-free");
    },
    { passive: true },
  );

  /** Steps the strip and the diagrams to the playing beat / chord. Cheap enough to run every frame. */
  function updateDiagrams(t: number, jump = false) {
    if (stripCellWidth === 0) return;

    let lo = 0;
    let hi = stripTimed.length - 1;
    let found = -1;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (stripTimed[mid].start <= t) {
        found = mid;
        lo = mid + 1;
      } else {
        hi = mid - 1;
      }
    }
    while (found > 0 && stripTimed[found].start - stripTimed[found - 1].start < 1e-3) found--; // see highlightChordGrid
    const cell = found >= 0 ? stripTimed[found].cell : (stripTimed[0]?.cell ?? FIRST_CELL); // before the first beat: the first cell that has one

    if (cell !== stripActive) {
      const far = jump || stripActive < 0 || Math.abs(cell - stripActive) > 2; // a seek, not the next beat
      if (stripActive >= 0) stripCells[stripActive].classList.remove("is-active");
      stripActive = cell;
      stripCells[cell].classList.add("is-active");
      stripMarkerEl.textContent = stripCells[cell].textContent;
      stripMarkerEl.dataset.len = stripCells[cell].dataset.len ?? "0";
      stripMarkerEl.classList.toggle("is-rest", stripCells[cell].classList.contains("is-rest"));
      // Playing, the strip follows the beat (unless it is being scrolled by hand); after a jump it follows at once.
      if (far || (isPlaying() && performance.now() >= stripBusyUntil)) followStrip(!far);
    }

    const pos = carouselOfCell[cell] ?? -1;
    if (pos !== carouselActive && carouselItems.length > 0 && carouselItems[0].width > 0) {
      const far = jump || carouselActive < -1 || Math.abs(pos - carouselActive) > 1;
      carouselActive = pos;
      carouselItems.forEach((item, i) => item.el.classList.toggle("is-current", i === pos));
      const at = Math.max(pos, 0);
      const grown = pos >= 0 && !carouselItems[at].el.classList.contains("is-rest") ? carouselGrowth : 0;
      const move = () =>
        (carouselTrackEl.style.transform = `translateX(${carouselEl.clientWidth * ANCHOR - carouselOffsets[at] - (carouselItems[at].width + grown) / 2}px)`);
      if (far) instantly(carouselTrackEl, move);
      else move();
    }
  }

  let resizeWidth = window.innerWidth;
  let resizeTimer = 0;
  window.addEventListener("resize", () => {
    if (window.innerWidth === resizeWidth) return;
    resizeWidth = window.innerWidth;
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      if (activeView === "diagrams") layoutDiagrams();
    }, 120);
  });

  /** Sections as colour-coded blocks; each row is four bars (two when a bar has six beats), each bar one cell per beat. A chord is written in the
   *  cell of the beat it starts on and left blank while it keeps ringing; the playing beat is filled in. */
  function renderChordGrid() {
    chordGridEl.innerHTML = "";
    gridCells = [];
    gridActive = -1;
    if (bars.length === 0) return;

    const music: Section[] =
      sections.length > 0
        ? sections
        : [{ label: "", start: bars[0].start, end: duration, startBar: 0, endBar: bars.length - 1 }];
    // A silent bar (three blank cells and a rest sign) opens the chart. When the song starts right away it is only
    // a visual lead-in: it has no time of its own, so playback still begins on the first cell of the first section.
    const blocks: Section[] =
      music[0].startBar === null ? music : [{ label: "Silence", start: 0, end: 0, startBar: null, endBar: null }, ...music];
    const firstReal = blocks.findIndex((sec) => sec.startBar !== null);
    let lastReal = -1;
    blocks.forEach((sec, i) => {
      if (sec.startBar !== null) lastReal = i;
    });

    const written = placeChordsWithRests();
    const makeCell = (label: string, kind: string): HTMLButtonElement => {
      const cell = document.createElement("button");
      cell.type = "button";
      cell.className = `gc ${kind}`.trim();
      if (label) {
        cell.textContent = label;
        cell.title = label;
        cell.dataset.len = String(Math.min(label.length, 6)); // CSS shrinks long names to fit the cell
      }
      return cell;
    };

    blocks.forEach((section, si) => {
      const block = document.createElement("section");
      block.className = "gs";
      if (section.label) {
        const tag = document.createElement("button");
        tag.type = "button";
        tag.className = "gs-tag";
        tag.textContent = section.label;
        tag.style.background = sectionColor(section.label);
        tag.setAttribute("aria-label", `Go to ${section.label}`);
        tag.addEventListener("click", () => seekTo(section.start));
        block.appendChild(tag);
      }
      const body = document.createElement("div");
      body.className = "gs-body";
      block.appendChild(body);

      if (section.startBar === null) {
        const row = document.createElement("div");
        row.className = "gr";
        const bar = document.createElement("div");
        bar.className = "gb";
        for (let k = 0; k < BEAT_CELLS - 1; k++) {
          const empty = makeCell("", "is-empty");
          empty.disabled = true;
          bar.appendChild(empty);
        }
        const rest = makeCell("𝄽", "is-silence");
        rest.addEventListener("click", () => seekTo(section.start));
        bar.appendChild(rest);
        row.appendChild(bar);
        body.appendChild(row);
        if (section.end > section.start) gridCells.push({ el: rest, start: section.start, bar, row }); // real silence plays
        chordGridEl.appendChild(block);
        return;
      }

      // Bars before the first / after the last section (a pickup, a short final bar) belong to those sections.
      const hasSilence = blocks[0].startBar === null;
      const from = si === firstReal && !hasSilence ? 0 : (section.startBar as number);
      const to = si === lastReal ? bars.length - 1 : (section.endBar as number);

      for (let rowStart = from; rowStart <= to; rowStart += BARS_PER_ROW) {
        const row = document.createElement("div");
        row.className = "gr";
        for (let b = rowStart; b < Math.min(rowStart + BARS_PER_ROW, to + 1); b++) {
          const bar = document.createElement("div");
          bar.className = "gb";
          const beats = bars[b].beats;
          for (let k = 0; k < BEAT_CELLS; k++) {
            const t0 = beats[k];
            if (t0 === null) {
              const empty = makeCell("", "is-empty");
              empty.disabled = true;
              bar.appendChild(empty);
              continue;
            }
            const chord = written[b][k];
            const cell = chord === "N" ? makeCell("𝄽", "is-rest is-silence") : makeCell(chord ? displayChord(chord) : "", "");
            cell.addEventListener("click", () => seekTo(t0));
            bar.appendChild(cell);
            gridCells.push({ el: cell, start: t0, bar, row });
          }
          row.appendChild(bar);
        }
        body.appendChild(row);
      }
      chordGridEl.appendChild(block);
    });
  }

  /** Keeps the playing row at one fixed spot just under the header (like a teleprompter): the grid scrolls up
   *  by a row each time playback moves to the next one. */
  let lastFollowedRow: HTMLElement | null = null;
  function followGridRow(row: HTMLElement) {
    if (row === lastFollowedRow) return;
    lastFollowedRow = row;
    const target = headerEl.getBoundingClientRect().bottom + 72;
    const delta = row.getBoundingClientRect().top - target;
    if (Math.abs(delta) < 4) return;
    window.scrollTo({ top: window.scrollY + delta, behavior: reducedMotion ? "auto" : "smooth" });
  }

  ["wheel", "touchmove"].forEach((type) =>
    window.addEventListener(type, () => (gridFollowPausedUntil = performance.now() + 4000), { passive: true }),
  );
  window.addEventListener("keydown", (e) => {
    if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End"].includes(e.code)) {
      gridFollowPausedUntil = performance.now() + 4000;
    }
  });

  /** Fills in the beat cell that is playing. */
  let gridFrom = 1; // the lit cell holds from this time...
  let gridUntil = 0; // ...to this one
  function highlightChordGrid(t: number) {
    if (gridCells.length === 0) return;
    if (gridActive >= 0 && t >= gridFrom && t < gridUntil) return;
    let lo = 0;
    let hi = gridCells.length - 1;
    let index = -1;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (gridCells[mid].start <= t) {
        index = mid;
        lo = mid + 1;
      } else {
        hi = mid - 1;
      }
    }
    gridFrom = index < 0 ? -Infinity : gridCells[index].start;
    gridUntil = index + 1 < gridCells.length ? gridCells[index + 1].start : Infinity;
    if (index < 0) index = 0; // before the first beat the first cell is already the one to play
    // The pickup beats before the first real beat all sit at the very start (a beat cannot be earlier than 0:00): the song begins
    // on the first of those cells, not the last.
    while (index > 0 && gridCells[index].start - gridCells[index - 1].start < 1e-3) index--;
    if (index === gridActive) return;
    if (gridActive >= 0) {
      gridCells[gridActive].el.classList.remove("is-active");
      gridCells[gridActive].bar.classList.remove("is-current");
    }
    gridActive = index;
    const cell = gridCells[index];
    cell.el.classList.add("is-active");
    cell.bar.classList.add("is-current");
    if (activeView === "grid" && isPlaying() && performance.now() >= gridFollowPausedUntil) followGridRow(cell.row);
  }

  /**
   * A fretboard diagram for a guitar, ukulele or mandolin chord in a card with the chord's name under it. The drawing itself is the site's
   * one chord diagram (lib/tools/diagram.ts): coloured fingers, a barre as one bar, the bass string picked out, and "3fr" for a shape up the neck.
   */
  function buildFretDiagram(
    label: string,
    shape: GuitarShape,
    scale = 1,
    pick?: { index: number; count: number; step: (delta: number) => void; keyboardArrows: boolean },
  ): HTMLElement {
    const wrap = document.createElement("div");
    wrap.className = "vc";
    wrap.style.boxSizing = "border-box";
    wrap.style.display = "flex";
    wrap.style.flexDirection = "column";
    wrap.style.alignItems = "center";
    wrap.style.justifyContent = "center";
    wrap.style.width = `${128 * scale}px`;
    wrap.style.height = "100%";
    wrap.style.background = "var(--color-canvas)";
    wrap.style.border = "1px solid var(--color-hairline)";
    wrap.style.borderRadius = "10px";
    wrap.style.boxShadow = "0 1px 2px rgba(13, 0, 31, 0.06)";
    wrap.style.padding = `${8 * scale}px ${6 * scale}px`;

    const board = document.createElement("div");
    board.style.lineHeight = "0";
    board.innerHTML = diagramSvg(shape, { compact: true, title: `${label} chord diagram` });
    const svg = board.firstElementChild as SVGElement | null;
    if (svg) {
      svg.style.width = `${116 * scale}px`;
      svg.style.height = "auto";
      svg.style.display = "block";
    }
    wrap.appendChild(board);
    addNameAndPick(wrap, label, scale, pick);
    return wrap;
  }

  type Pick = { index: number; count: number; step: (delta: number) => void; keyboardArrows: boolean };

  /** The chord's name under its diagram, with arrows either side (and dots below) to step through the other ways of playing it. */
  function addNameAndPick(wrap: HTMLElement, label: string, scale: number, pick?: Pick) {
    const labelEl = document.createElement("div");
    labelEl.textContent = label;
    labelEl.style.fontWeight = "700";
    labelEl.style.fontSize = `${14 * scale}px`;
    labelEl.style.color = "var(--color-ink)";

    const labelRow = document.createElement("div");
    labelRow.className = "vc-label";
    labelRow.style.marginTop = `${4 * scale}px`;
    if (pick) {
      // ‹ G › : arrows either side of the name step through the other ways of playing the chord.
      const arrow = (delta: number) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "vc-arrow";
        if (!pick.keyboardArrows) button.tabIndex = -1;
        button.setAttribute("aria-label", `${delta < 0 ? "Previous" : "Next"} way to play ${label} (now ${pick.index + 1} of ${pick.count})`);
        button.innerHTML = `<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="${delta < 0 ? "M8 2 4 6l4 4" : "m4 2 4 4-4 4"}" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
        button.addEventListener("click", (event) => {
          event.stopPropagation(); // not a click on the chord (which would jump the song to it)
          pick.step(delta);
        });
        return button;
      };
      labelRow.append(arrow(-1), labelEl, arrow(1));
    } else {
      labelRow.append(labelEl);
    }
    wrap.appendChild(labelRow);

    if (pick) {
      const dots = document.createElement("div");
      dots.className = "vc-dots";
      dots.title = `Way ${pick.index + 1} of ${pick.count} to play ${label}`;
      for (let i = 0; i < pick.count; i++) {
        const dot = document.createElement("span");
        if (i === pick.index) dot.className = "on";
        dots.appendChild(dot);
      }
      wrap.appendChild(dots);
    }
  }

  /** A piano chord: the keyboard with the keys of the chord pressed (and named), and what the way of playing it is called. */
  function buildPianoDiagram(label: string, voicing: PianoVoicing, scale = 1, pick?: Pick): HTMLElement {
    const wrap = document.createElement("div");
    wrap.className = "vc vc-keys";
    wrap.style.boxSizing = "border-box";
    wrap.style.display = "flex";
    wrap.style.flexDirection = "column";
    wrap.style.alignItems = "center";
    wrap.style.justifyContent = "center";
    wrap.style.height = "100%";
    wrap.style.background = "var(--color-canvas)";
    wrap.style.border = "1px solid var(--color-hairline)";
    wrap.style.borderRadius = "10px";
    wrap.style.boxShadow = "0 1px 2px rgba(13, 0, 31, 0.06)";
    wrap.style.padding = `${12 * scale}px ${12 * scale}px ${10 * scale}px`;
    const keys = document.createElement("div");
    keys.innerHTML = pianoSvg(voicing, { scale: 0.95 * scale });
    keys.style.lineHeight = "0";
    wrap.appendChild(keys);
    addNameAndPick(wrap, label, scale, pick);
    const how = document.createElement("div");
    how.className = "vc-how";
    how.textContent = voicing.name;
    how.style.marginTop = `${3 * scale}px`;
    how.style.fontSize = `${10.5 * scale}px`;
    how.style.color = "var(--color-mute)";
    how.style.whiteSpace = "nowrap";
    wrap.appendChild(how);
    return wrap;
  }

  /** Song details card: the chords used (most time first), key, tempo and number of sections. */
  function renderDetails() {
    const totals = new Map<string, number>();
    chords.forEach((seg) => {
      if (seg.chord !== "N") totals.set(seg.chord, (totals.get(seg.chord) ?? 0) + seg.end - seg.start);
    });
    sdChipsEl.innerHTML = "";
    [...totals.entries()]
      .sort((a, b) => b[1] - a[1])
      .slice(0, 10)
      .forEach(([raw]) => {
        const chip = document.createElement("span");
        chip.className = "sd-chip";
        chip.textContent = displayChord(raw);
        sdChipsEl.appendChild(chip);
      });
    sdKeyEl.textContent = songKey ? chordKeyLabel(transposeChord(songKey, transposeSteps)) : "—";
    sdTempoEl.textContent = `${Math.round(tempo)} BPM`;
    const named = sections.filter((sec) => sec.startBar !== null).length;
    sdSectionsEl.textContent = named > 0 ? String(named) : "—";
  }

  /** The Transpose control shows the song's key (after transposing), or the semitone offset when it is unknown. */
  function updateTransposeLabel() {
    transposeValueEl.textContent = songKey ? transposeChord(songKey, transposeSteps) : semitoneLabel(transposeSteps);
    transposeValueEl.title = `Transposed ${semitoneLabel(transposeSteps)} semitones`;
  }

  /** "Summary" view: a diagram of every chord in the song, most used first. */
  function renderSummary() {
    summaryGridEl.innerHTML = "";
    const totals = new Map<string, number>();
    chords.forEach((seg) => {
      if (seg.chord !== "N") totals.set(seg.chord, (totals.get(seg.chord) ?? 0) + seg.end - seg.start);
    });
    const all = [...totals.values()].reduce((a, b) => a + b, 0) || 1;
    [...totals.entries()]
      .sort((a, b) => b[1] - a[1])
      .forEach(([raw, seconds]) => {
        const fChord = fingeringChord(raw);
        const card = chordDiagram(fChord, fChord, 1);
        card.title = `${displayChord(raw)} — ${Math.round((100 * seconds) / all)}% of the song`;
        summaryGridEl.appendChild(card);
      });
  }

  function setDiagramMode(mode: "animated" | "summary") {
    const animated = mode === "animated";
    dgAnimatedPanel.classList.toggle("hidden", !animated);
    dgSummaryPanel.classList.toggle("hidden", animated);
    dgAnimated.classList.toggle("is-active", animated);
    dgAnimated.setAttribute("aria-pressed", String(animated));
    dgSummary.classList.toggle("is-active", !animated);
    dgSummary.setAttribute("aria-pressed", String(!animated));
  }

  /** Re-renders every view after a Transpose/Capo/chord-detail change (chord names and shapes shift). */
  function refreshViews() {
    renderBeatStrip();
    renderCarousel();
    layoutDiagrams();
    renderChordGrid();
    renderSummary();
    renderDetails();
    updateTransposeLabel();
    const t = playerTime();
    highlightChordGrid(t);
  }

  /** Swaps in new sections (the structure model's, once they arrive) without touching the chords. */
  function applySections(next: Section[]) {
    baseSections = next;
    sections = isSongsOwnMeter() ? next : regroupSections(next, bars);
    renderProgress();
    renderChordGrid();
    renderDetails();
    const t = playerTime();
    updateTransport(t);
    highlightChordGrid(t);
  }

  /** The structure model's sections come a few minutes after the chords: check back until they do. */
  function watchForBetterSections() {
    const started = Date.now();
    songNoteEl.hidden = false;
    const check = async () => {
      try {
        const res = await fetch(`${API_BASE}/api/result/${sessionId}`);
        if (res.ok) {
          const latest: ExtractResult = await res.json();
          if (!latest.sectionsPending) {
            if (latest.sectionsSource === "model") applySections(latest.sections ?? []);
            songNoteEl.hidden = true;
            return;
          }
        }
      } catch {
        // offline for a moment: try again
      }
      if (Date.now() - started < 15 * 60 * 1000) setTimeout(check, 6000);
      else songNoteEl.hidden = true;
    };
    setTimeout(check, 6000);
  }

  // ---- Strumming pattern: the song's pattern as arrows, with the slot that is playing lit -----------------------------------
  const strumCard = document.getElementById("strum-card")!;
  const strumTiles = document.getElementById("sm-tiles")!;
  const strumLabel = document.getElementById("sm-label")!;
  const strumText = document.getElementById("sm-text")!;
  const strumNote = document.getElementById("sm-note")!;
  const strumSeg = document.getElementById("sm-seg")!;
  let strum: StrumPattern | null = null;
  let strumList: StrumOne[] = [];
  let strumIdx = 0;
  let strumEasyOn = false;
  let strumTileEls: HTMLElement[] = [];
  let strumBeatEls: HTMLElement[] = []; // the beat each slot belongs to
  let strumBeatLit = -1;
  let strumBarShown = -1; // the bar the counter shows
  let strumLit = -1;
  let strumSub = 2;
  let strumBar = 0; // the bar the clock was last in (the clock mostly moves forward, so the search starts here)

  const ARROW_DOWN = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6"/></svg>';
  const ARROW_UP = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V5M6 11l6-6 6 6"/></svg>';
  const SUB_NAMES = ["", "", ["", "&"], "", ["", "e", "&", "a"]] as unknown as string[][];

  /** The few words after "Pattern 1": where in the song it is played ("Verse", "Verse and Chorus"). */
  function whereText(p: StrumOne): string {
    return p.where.length ? p.where.join(" and ") : "";
  }

  function buildStrumTabs() {
    strumSeg.replaceChildren();
    const make = (text: string, on: boolean, click: () => void) => {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = text;
      b.className = on ? "is-on" : "";
      b.setAttribute("aria-pressed", String(on));
      b.addEventListener("click", click);
      strumSeg.append(b);
    };
    if (strumList.length > 1) {
      strumList.forEach((p, i) => make(`Pattern ${i + 1}${p.where.length ? ` · ${whereText(p)}` : ""}`, !strumEasyOn && i === strumIdx, () => {
        strumIdx = i;
        strumEasyOn = false;
        renderStrum();
      }));
      make("Easy", strumEasyOn, () => {
        strumEasyOn = true;
        renderStrum();
      });
    } else {
      make("Full pattern", !strumEasyOn, () => {
        strumEasyOn = false;
        renderStrum();
      });
      make("Easy version", strumEasyOn, () => {
        strumEasyOn = true;
        renderStrum();
      });
    }
  }

  function renderStrum() {
    strumCard.hidden = !strum || strumList.length === 0;
    strumEditBtn.hidden = !strumEditable || strumCard.hidden; // the admin can switch editing off for a song
    if (strumCard.hidden || !strumEditable) closeStrumEditor();
    strumTiles.replaceChildren();
    strumTileEls = [];
    strumBeatEls = [];
    strumLit = -1;
    strumBeatLit = -1;
    strumBarShown = -1;
    strumFrom = 1;
    strumUntil = 0;
    if (!strum || strumList.length === 0) return;
    const cur = strumList[Math.min(strumIdx, strumList.length - 1)];
    buildStrumTabs();
    const slots = strumEasyOn ? cur.easy : cur.pattern;
    strumSub = cur.sub === 4 ? 4 : 2;
    const shown = slots.map((s) => (s === "-" ? "–" : s)).join(" ");
    const pill = document.getElementById("sm-pill")!;
    const kind = cur.kind;
    pill.textContent = kind === "heard" ? "Heard in the song" : kind === "edited" ? "Checked by hand" : kind === "guess" ? "Best guess" : "Suggested";
    pill.classList.toggle("is-heard", kind === "heard" || kind === "edited");
    const where = whereText(cur);
    strumLabel.textContent = `${strumEasyOn ? "EASY VERSION" : kind === "heard" || kind === "edited" ? "MAIN PATTERN" : kind === "guess" ? "BEST GUESS" : "SUGGESTED PATTERN"}${where && !strumEasyOn ? ` · ${where.toUpperCase()}` : ""}  ·  ${shown}`;
    // the bar, beat by beat: each beat is a small panel of its own slots (2 to a beat for eighths, 4 for sixteenths)
    const beatCount = Math.max(1, Math.ceil(slots.length / strumSub));
    strumTiles.style.setProperty("--beats", String(beatCount));
    strumTiles.style.setProperty("--sub", String(strumSub));
    for (let beat = 0; beat < beatCount; beat++) {
      const group = el_("div", "sm-beat");
      group.setAttribute("role", "group");
      group.setAttribute("aria-label", `Beat ${beat + 1}`);
      const head = el_("span", "sm-beat-n");
      head.textContent = `Beat ${beat + 1}`;
      head.setAttribute("aria-hidden", "true");
      const row = el_("div", "sm-slots");
      row.setAttribute("role", "list");
      for (let within = 0; within < strumSub; within++) {
        const i = beat * strumSub + within;
        if (i >= slots.length) break;
        const kindOf = slots[i];
        const tile = el_("div", `sm-tile${kindOf === "-" ? " is-rest" : kindOf === "D" ? " is-down" : " is-up"}`);
        tile.setAttribute("role", "listitem");
        const count = within === 0 ? String(beat + 1) : SUB_NAMES[strumSub][within];
        tile.innerHTML = `<span class="sm-ar">${kindOf === "D" ? ARROW_DOWN : kindOf === "U" ? ARROW_UP : '<span aria-hidden="true">·</span>'}</span><small>${count}</small>`;
        tile.setAttribute("aria-label", `Beat ${beat + 1}, ${count}: ${kindOf === "D" ? "down-strum" : kindOf === "U" ? "up-strum" : "no strum"}`);
        row.append(tile);
        strumTileEls.push(tile);
        strumBeatEls.push(group);
      }
      group.append(head, row);
      strumTiles.append(group);
    }
    showStrumBar(0);

    const bpm = Math.round(strum.bpm || tempo);
    const feel = bpm < 80 ? "slow, relaxed" : bpm < 110 ? "easy" : bpm < 140 ? "upbeat" : "fast";
    const beats = Array.from({ length: strum.perBar }, (_, i) => i + 1).join(", ");
    const several = strumList.length > 1;
    strumText.innerHTML = strumEasyOn
      ? `One down-strum on every beat (${beats}): the simplest way to play this song, at its ${feel} ${bpm} BPM.`
      : kind === "heard" || kind === "edited"
        ? several
          ? `${where ? `Played in the ${where}` : "One of the ways this song is played"}, at the song’s ${feel} ${bpm} BPM groove. The song does not strum the same way all through, so switch patterns to see the others.`
          : kind === "edited"
            ? `The strumming for this song, checked by hand, at the song’s ${feel} ${bpm} BPM groove.`
            : `The pattern the recording keeps coming back to, at the song’s ${feel} ${bpm} BPM groove.`
        : kind === "guess"
          ? `The strumming here is not steady enough to be sure, so this is our best guess from the beats that stand out, at the song’s ${feel} ${bpm} BPM feel.`
          : `We could not hear one clear strum, so this is a typical ${strum.perBar}-beat pattern for the song’s ${feel} ${bpm} BPM feel.`;
    const how = document.getElementById("sm-how")!;
    how.innerHTML =
      `<p>↓ is a down-strum, ↑ an up-strum, and a dim tile is a beat you let ring or skip. Count along: the numbers are the beats${strumSub === 4 ? ", “e” and “a” the quick strokes either side of the “&”" : " and “&” is the half beat between them"}.</p>` +
      `<p><b>Just starting out?</b> Play steady down-strums on every beat (${beats}) until the chord changes feel comfortable, then add the other strokes. Strum lightly in the verses and open up for the chorus.</p>`;
    strumNote.textContent =
      kind === "typical"
        ? "A suggestion for this time signature, not a pattern heard in the song."
        : `${kind === "guess" ? "A rough reading of the recording. " : kind === "edited" ? "Checked and set by hand. " : "Worked out from the recording. "}Down and up strokes cannot be heard, so the usual picture is shown: the hand keeps moving down and up, so strokes on the beat are down-strums and strokes on the “&” up-strums. Lighter strokes and muted ones may be missing.`;
  }

  // ---- Editing the strumming ------------------------------------------------------------------------------------------------
  // A signed-in person can change the song's strumming patterns (and only those) while the admin has not switched editing off for the
  // song. The change is saved for everybody; the server keeps the version before it, so the admin can go back.
  const strumEditBtn = document.getElementById("sm-edit") as HTMLButtonElement;
  const strumEditor = document.getElementById("sm-editor")!;
  type DraftPattern = { pattern: Stroke[]; sub: 2 | 4; where: string[] };
  let strumEditable = false; // the server's answer for this song
  let strumToken = ""; // the fingerprint of the song as loaded; a save made on top of somebody else's change is refused
  let draft: DraftPattern[] = [];
  let editorMessage = "";
  let editorBad = false;
  let editorBusy = false;
  const MAX_PATTERNS = 8;

  const stroke = (s: string): Stroke => (s === "D" || s === "U" ? s : "-");
  const strokeShown = (s: Stroke) => (s === "D" ? "↓" : s === "U" ? "↑" : "–");
  const strokeWord = (s: Stroke) => (s === "D" ? "down" : s === "U" ? "up" : "nothing");

  /** Where in the song a pattern can be played: the kinds of section the song has (Verse, Chorus...), plus what the patterns already say. */
  function sectionKinds(): string[] {
    const kinds = new Set<string>();
    for (const s of sections) if (s.label && s.label !== "Silence") kinds.add(String(s.label).replace(/\s*\d+$/, ""));
    for (const p of draft) p.where.forEach((w) => kinds.add(w));
    return [...kinds];
  }

  function openStrumEditor() {
    if (!cachedUser()) {
      void openSignIn(); // editing is for people with an account, so the change can be kept with a name and not abused
      return;
    }
    if (!strum) return;
    draft = strumList.map((p) => ({ pattern: p.pattern.map(stroke), sub: p.sub === 4 ? 4 : 2, where: [...p.where] }));
    editorMessage = "";
    editorBad = false;
    strumEditor.hidden = false;
    strumEditBtn.setAttribute("aria-expanded", "true");
    renderStrumEditor();
    strumEditor.scrollIntoView({ block: "nearest", behavior: "smooth" });
  }

  function closeStrumEditor() {
    strumEditor.hidden = true;
    strumEditBtn.setAttribute("aria-expanded", "false");
    strumEditor.replaceChildren();
  }

  function renderStrumEditor() {
    if (!strum) return;
    const perBar = strum.perBar;
    const kinds = sectionKinds();
    const here = document.activeElement as HTMLElement | null;
    const keep = here && strumEditor.contains(here) ? here.dataset.keep : undefined; // so a keyboard user stays where they were after a change
    strumEditor.replaceChildren();

    const title = document.createElement("h3");
    title.textContent = "Edit the strumming";
    const hint = document.createElement("p");
    hint.className = "sme-hint";
    hint.textContent = "Tap a stroke to change it: ↓ down, ↑ up, – nothing. When you save, everybody who plays this song sees your strumming. Only the strumming can be edited here, and the earlier version is kept.";
    strumEditor.append(title, hint);

    const button = (cls: string, text: string, on: () => void, opts: { disabled?: boolean; label?: string; keep?: string } = {}) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = cls;
      b.textContent = text;
      b.disabled = !!opts.disabled;
      if (opts.label) b.setAttribute("aria-label", opts.label);
      if (opts.keep) b.dataset.keep = opts.keep;
      b.addEventListener("click", on);
      return b;
    };
    const redraw = () => renderStrumEditor();

    draft.forEach((p, n) => {
      const card = el_("div", "sme-pat");
      card.dataset.sub = String(p.sub);
      const head = el_("div", "sme-pat-head");
      const name = document.createElement("strong");
      name.textContent = n === 0 ? "Main pattern" : `Pattern ${n + 1}`;
      head.append(
        name,
        button("sme-mini", "Up", () => { [draft[n - 1], draft[n]] = [draft[n], draft[n - 1]]; redraw(); }, { disabled: n === 0, label: `Move ${name.textContent} up` }),
        button("sme-mini", "Down", () => { [draft[n + 1], draft[n]] = [draft[n], draft[n + 1]]; redraw(); }, { disabled: n === draft.length - 1, label: `Move ${name.textContent} down` }),
        button("sme-mini", "Duplicate", () => { draft.splice(n + 1, 0, { pattern: [...p.pattern], sub: p.sub, where: [...p.where] }); redraw(); }, { disabled: draft.length >= MAX_PATTERNS, label: `Duplicate ${name.textContent}` }),
        button("sme-mini is-danger", "Delete", () => { draft.splice(n, 1); redraw(); }, { disabled: draft.length <= 1, label: `Delete ${name.textContent}` }),
      );
      card.append(head);

      const beatsEl = el_("div", "sme-beats");
      const names = slotNames(p.sub);
      for (let beat = 0; beat < perBar; beat++) {
        const group = el_("div", "sme-beat");
        for (let s = 0; s < p.sub; s++) {
          const i = beat * p.sub + s;
          const slot = el_("div", "sme-slot");
          const b = button("sme-stroke", strokeShown(p.pattern[i]), () => {
            p.pattern[i] = nextStroke(p.pattern[i]);
            redraw();
          }, { label: `Beat ${beat + 1}${names[s] ? ` ${names[s]}` : ""}: ${strokeWord(p.pattern[i])}. Tap to change.`, keep: `s${n}-${i}` });
          b.dataset.s = p.pattern[i];
          const small = document.createElement("small");
          small.textContent = s === 0 ? String(beat + 1) : names[s];
          if (s === 0) small.className = "on";
          slot.append(b, small);
          group.append(slot);
        }
        beatsEl.append(group);
      }
      card.append(beatsEl);

      const line = el_("div", "sme-line");
      const res = document.createElement("select");
      res.setAttribute("aria-label", "Strokes to a beat");
      for (const [value, text] of [["2", "Eighths (2 to a beat)"], ["4", "Sixteenths (4 to a beat)"]]) {
        const o = document.createElement("option");
        o.value = value;
        o.textContent = text;
        res.append(o);
      }
      res.value = String(p.sub);
      res.dataset.keep = `r${n}`;
      res.addEventListener("change", () => {
        const to = Number(res.value) === 4 ? 4 : 2;
        p.pattern = resample(p.pattern, p.sub, to);
        p.sub = to;
        redraw();
      });
      line.append(res);
      if (kinds.length > 0) {
        const lead = document.createElement("span");
        lead.textContent = "Plays in:";
        line.append(lead);
        for (const kind of kinds) {
          const label = document.createElement("label");
          const box = document.createElement("input");
          box.type = "checkbox";
          box.checked = p.where.includes(kind);
          box.addEventListener("change", () => {
            const set = new Set(p.where);
            box.checked ? set.add(kind) : set.delete(kind);
            p.where = [...set];
          });
          label.append(box, kind);
          line.append(label);
        }
      }
      card.append(line);
      strumEditor.append(card);
    });

    const actions = el_("div", "sme-actions");
    const save = button("sme-btn sme-save", editorBusy ? "Saving…" : "Save for everyone", () => void saveStrumEdit(), { disabled: editorBusy });
    save.dataset.keep = "save";
    actions.append(
      save,
      button("sme-btn sme-cancel", "Cancel", () => { closeStrumEditor(); strumEditBtn.focus(); }, { disabled: editorBusy }),
      button("sme-btn sme-add", "Add a pattern", () => { draft.push({ pattern: defaultPattern(perBar, 2), sub: 2, where: [] }); redraw(); }, { disabled: draft.length >= MAX_PATTERNS || editorBusy }),
    );
    strumEditor.append(actions);
    const msg = el_("p", `sme-msg${editorBad ? " is-bad" : ""}`);
    msg.setAttribute("role", "status");
    msg.textContent = editorMessage;
    strumEditor.append(msg);
    if (keep) strumEditor.querySelector<HTMLElement>(`[data-keep="${keep}"]`)?.focus();
  }

  async function saveStrumEdit() {
    if (!strum || editorBusy || !sessionId) return;
    const empty = draft.findIndex((p) => !p.pattern.some((s) => s === "D" || s === "U"));
    if (empty >= 0) {
      editorMessage = `${empty === 0 ? "The main pattern" : `Pattern ${empty + 1}`} has no strokes. Tap a slot to add a down or up stroke, or delete the pattern.`;
      editorBad = true;
      renderStrumEditor();
      return;
    }
    editorBusy = true;
    editorMessage = "";
    renderStrumEditor();
    try {
      let res: Response;
      try {
        res = await fetch(`${API_BASE}/api/songs/${encodeURIComponent(sessionId)}/strumming`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ token: strumToken, strum: { perBar: strum.perBar, bpm: strum.bpm, patterns: draft.map((p) => ({ pattern: p.pattern, sub: p.sub, where: p.where })) } }),
        });
      } catch {
        throw new Error("Could not reach the server. Check your connection and try again.");
      }
      const body = await res.json().catch(() => ({}));
      if (res.status === 401) {
        void openSignIn();
        throw new Error("Please sign in to save your change.");
      }
      if (!res.ok) throw new Error(typeof body.detail === "string" ? body.detail : `Could not save (${res.status}).`);
      if (body.changed && body.strum) {
        strum = body.strum;
        strumList = body.strum.patterns?.length ? body.strum.patterns : strumList;
        strumIdx = Math.min(strumIdx, strumList.length - 1);
        strumEasyOn = false;
        renderStrum();
      }
      strumToken = body.token ?? strumToken;
      editorBusy = false;
      closeStrumEditor();
      toast({ icon: "✓", title: body.changed ? "Strumming saved" : "Nothing changed", text: body.changed ? "Everybody who plays this song now sees your strumming." : undefined });
    } catch (err) {
      editorBusy = false;
      editorMessage = err instanceof Error ? err.message : "Could not save that. Please try again.";
      editorBad = true;
      renderStrumEditor();
    }
  }

  strumEditBtn.addEventListener("click", () => {
    if (strumEditor.hidden) openStrumEditor();
    else closeStrumEditor();
  });

  /** Lights the slot (an eighth or sixteenth note) that is playing, from the bars the grid is drawn from. */
  let strumFrom = 1; // the lit slot holds from this time...
  let strumUntil = 0; // ...to this one
  /** The counter above the bar: which bar of the song is sounding (the bar itself is always one bar of the pattern). */
  function showStrumBar(index: number) {
    if (index === strumBarShown) return;
    strumBarShown = index;
    const chip = document.getElementById("sm-bar");
    if (chip) chip.textContent = `Bar ${index + 1}${bars.length > 0 ? ` of ${bars.length}` : ""} · ${strum?.perBar ?? 4} beats`;
  }
  function highlightStrum(t: number) {
    if (t >= strumFrom && t < strumUntil) return;
    if (strumTileEls.length === 0 || bars.length === 0) return;
    if (strumBar >= bars.length || t < (bars[strumBar].start ?? 0)) strumBar = 0;
    while (strumBar + 1 < bars.length && t >= (bars[strumBar + 1].start ?? Infinity)) strumBar++;
    const bar = bars[strumBar];
    showStrumBar(strumBar);
    let slot = 0;
    if (t >= (bar.start ?? 0)) {
      let k = 0;
      for (let i = 0; i < BEAT_CELLS; i++) if (bar.beats[i] !== null && bar.beats[i] !== undefined && (bar.beats[i] as number) <= t) k = i;
      const t0 = bar.beats[k] as number;
      let next = t0 + 0.5;
      for (let i = k + 1; i < bar.beats.length; i++) {
        const value = bar.beats[i];
        if (value !== null && value !== undefined) {
          next = value;
          break;
        }
      }
      const span = Math.max(next - t0, 0.05);
      const within = Math.min(Math.floor(((t - t0) / span) * strumSub), strumSub - 1);
      slot = k * strumSub + within;
      strumFrom = t0 + (within * span) / strumSub;
      strumUntil = strumFrom + span / strumSub;
    } else {
      strumFrom = 1;
      strumUntil = 0;
    }
    const lit = slot % strumTileEls.length;
    if (lit === strumLit) return;
    strumTileEls[strumLit]?.classList.remove("is-now");
    strumTileEls[lit].classList.add("is-now");
    strumLit = lit;
    const beatEl = strumBeatEls[lit];
    const previousBeat = strumBeatLit >= 0 ? strumBeatEls[strumBeatLit] : undefined;
    if (beatEl && beatEl !== previousBeat) {
      previousBeat?.classList.remove("is-now");
      beatEl.classList.add("is-now");
    }
    strumBeatLit = lit;
  }

  function el_(tag: string, className: string): HTMLElement {
    const node = document.createElement(tag);
    node.className = className;
    return node;
  }

  function onTimeUpdate(currentTime: number) {
    highlightStrum(currentTime);
    updateDiagrams(currentTime);
    highlightChordGrid(currentTime);
    updateTransport(currentTime);
    applyLoop(currentTime);

  }

  /** The player's clock in seconds, whichever player is in use. */
  function playerTime(): number {
    if (usingAudio()) return audioEl.currentTime;
    return ytPlayer && typeof ytPlayer.getCurrentTime === "function" ? ytPlayer.getCurrentTime() : 0;
  }

  // `timeupdate` (and a 250 ms timer) only refresh ~4 times a second, so a chord change could show up to
  // a quarter-second late. While playing, read the clock on every display frame instead.
  let syncFrame = 0;
  function startSyncLoop() {
    if (syncFrame) return;
    let before = 0;
    let frames = 0;
    let slow = 0;
    const tick = (now: number) => {
      // Frames longer than 34 ms (under 30 a second) in 90 of them: the phone cannot keep up, so go light.
      if (before && !liteMode && document.visibilityState === "visible") {
        frames++;
        if (now - before > 34 && now - before < 500) slow++; // (a pause of half a second or more is the tab being away, not slowness)
        if (frames >= 90) {
          if (slow >= 27) setLite(true, true);
          frames = 0;
          slow = 0;
        }
      }
      before = now;
      onTimeUpdate(playerTime());
      syncFrame = requestAnimationFrame(tick);
    };
    syncFrame = requestAnimationFrame(tick);
  }
  function stopSyncLoop() {
    cancelAnimationFrame(syncFrame);
    syncFrame = 0;
    onTimeUpdate(playerTime());
  }

  /** True when an uploaded file is playing through <audio>; false for the YouTube player. */
  function usingAudio(): boolean {
    return audioEl.dataset.mode === "audio";
  }

  function isPlaying(): boolean {
    if (usingAudio()) return !audioEl.paused;
    return !!ytPlayer && typeof ytPlayer.getPlayerState === "function" && ytPlayer.getPlayerState() === 1;
  }

  function seekQuiet(time: number) {
    if (usingAudio()) audioEl.currentTime = time;
    else if (ytPlayer) ytPlayer.seekTo(time, true);
    onTimeUpdate(time);
  }

  function seekTo(time: number) {
    seekQuiet(time);
    if (usingAudio()) void audioEl.play();
    else if (ytPlayer) ytPlayer.playVideo();
  }

  function rawPause() {
    if (usingAudio()) audioEl.pause();
    else if (ytPlayer) ytPlayer.pauseVideo();
  }

  // Count-in: three clicks at the song's tempo before playback starts.
  let countInEnabled = false;
  let audioCtx: AudioContext | null = null;
  function clickSound(accent: boolean) {
    audioCtx = audioCtx ?? new AudioContext();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.frequency.value = accent ? 1568 : 1046;
    gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);
    osc.connect(gain).connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.09);
  }
  async function runCountIn() {
    const beatMs = 60000 / (tempo * (tempoPct / 100));
    timeNowEl.style.color = "var(--color-violet-text, var(--color-violet))";
    for (let n = 3; n >= 1; n--) {
      timeNowEl.textContent = String(n); // 3, 2, 1 in the clock beside the play button
      clickSound(n === 3);
      await new Promise((resolve) => setTimeout(resolve, beatMs));
    }
    timeNowEl.style.color = "";
    timeNowEl.textContent = formatClock(playerTime());
  }

  let counting = false;
  async function togglePlay() {
    if (counting) return;
    if (isPlaying()) {
      rawPause();
      return;
    }
    if (countInEnabled) {
      counting = true;
      await runCountIn();
      counting = false;
    }
    if (usingAudio()) void audioEl.play();
    else if (ytPlayer) ytPlayer.playVideo();
  }

  // Loop: off -> whole song -> the section that was playing when it was switched on.
  let loopMode: "off" | "song" | "section" = "off";
  let loopSection = -1;
  function applyLoop(t: number) {
    if (loopMode !== "section" || loopSection < 0 || !isPlaying()) return;
    const seg = progressSegs[loopSection];
    if (seg && t >= seg.end - 0.04) seekQuiet(seg.start);
  }

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  let ytPlayer: any = null;

  function extractYoutubeId(url: string): string | null {
    const match = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{6,})/);
    return match ? match[1] : null;
  }

  function setupYoutubePlayer(videoId: string) {
    youtubeMount.classList.remove("hidden");
    const div = document.createElement("div");
    div.id = "yt-player-target";
    youtubeMount.appendChild(div);

    const script = document.createElement("script");
    script.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(script);

    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    (window as any).onYouTubeIframeAPIReady = () => {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      ytPlayer = new (window as any).YT.Player("yt-player-target", {
        videoId,
        playerVars: { rel: 0 },
        events: {
          onReady: () => {
            // slow poll keeps the display right after seeks while paused; the frame loop runs while playing
            setInterval(() => onTimeUpdate(playerTime()), 500);
          },
          // 1 = playing, 2 = paused, 0 = ended, 3 = buffering
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          onStateChange: (event: any) => {
            setPlayingUi(event.data === 1);
            if (event.data === 1) startSyncLoop();
            else stopSyncLoop();
            if (event.data === 0 && loopMode === "song") seekTo(0);
          },
        },
      });
    };
  }

  async function init() {
    if (!sessionId) {
      fail("No song selected. Go back and search for a song or upload one.");
      return;
    }

    let result: ExtractResult;
    try {
      const res = await fetch(`${API_BASE}/api/result/${sessionId}`);
      if (!res.ok) throw new Error(`Could not load this song (${res.status})`);
      result = await res.json();
    } catch (err) {
      fail(err instanceof Error ? err.message : "Could not load this song.");
      return;
    }

    jamVideoId = result.source === "youtube" ? (result.videoId ?? "") : "";
    chordsSimple = result.chords;
    chordsDetailed = result.chordsDetailed ?? result.chords;
    chords = chordsSimple;
    songKey = result.key ?? "";
    duration = result.duration;
    baseBars = trimPickup(result.bars);
    baseSections = result.sections ?? [];
    baseBeatsPerBar = result.beatsPerBar ?? (baseBars[0]?.beats.length ? baseBars[0].beats.length - 1 : 4);
    baseTempo = result.tempo || 120;
    meter = { perBar: baseBeatsPerBar, pulse: 1, shift: null };
    loadMeter();
    rebuildMeter(); // bars, sections and tempo, as the song counts them (or as this player set them)

    const title = result.title || "Your song";
    songTitleEl.textContent = title;
    songArtistEl.textContent = result.artist ? `by ${result.artist}` : "";
    document.title = `${title} chords — Chord Suno`;
    if (result.sessionId && !document.getElementById("ph-heart")) {
      // the favourite heart, beside Share
      const heart = heartButton(
        {
          sessionId: result.sessionId,
          title,
          artist: result.artist ?? "",
          thumbnail: result.videoId ? `https://i.ytimg.com/vi/${result.videoId}/mqdefault.jpg` : "",
          duration: result.duration,
        },
        "hb hb-head",
      );
      heart.id = "ph-heart";
      document.getElementById("ph-actions")?.prepend(heart);
    }
    detailToggle.hidden = chordsDetailed === chordsSimple;

    loadingState.classList.add("hidden");
    playerState.classList.remove("hidden");
    renderProgress();
    setPlayingUi(false);
    renderBeatStrip();
    renderCarousel();
    renderChordGrid();
    renderSummary();
    renderDetails();
    strumEditable = result.strumEdit === true;
    strumToken = result.strumToken ?? "";
    strum = result.strum && (result.strum.v ?? 1) >= 4 && Array.isArray(result.strum.pattern) && result.strum.pattern.length >= 4 ? result.strum : null;
    strumList = strum
      ? (strum.patterns && strum.patterns.length
          ? strum.patterns
          : [{ pattern: strum.pattern, sub: strum.sub ?? 2, kind: strum.kind ?? (strum.detected ? "heard" : "typical"), confidence: strum.confidence, where: [], bars: 0, label: strum.label, easy: strum.easy }])
      : [];
    renderStrum();
    updateTransposeLabel();
    syncHeaderSize();
    layoutDiagrams(); // the diagrams are the visible view, so they can be measured now

    if (result.source === "youtube" && result.sourceUrl) {
      const videoId = extractYoutubeId(result.sourceUrl);
      if (videoId) {
        setupYoutubePlayer(videoId);
      } else {
        fail("Could not determine the YouTube video to play.");
        return;
      }
    } else {
      audioEl.dataset.mode = "audio";
      audioEl.src = `${API_BASE}${result.audioUrl}`;
      audioEl.addEventListener("play", () => setPlayingUi(true));
      audioEl.addEventListener("pause", () => setPlayingUi(false));
      audioEl.addEventListener("timeupdate", () => onTimeUpdate(audioEl.currentTime));
      audioEl.addEventListener("seeked", () => onTimeUpdate(audioEl.currentTime));
      audioEl.addEventListener("play", startSyncLoop);
      audioEl.addEventListener("pause", stopSyncLoop);
      audioEl.addEventListener("ended", stopSyncLoop);
      audioEl.addEventListener("ended", () => setPlayingUi(false));
    }

    if (result.sectionsPending) watchForBetterSections();
  }

  // Instrument tabs: guitar, piano, ukulele and mandolin. The choice is the person's, kept on their account and this device
  // (lib/instrument.ts), so it is the same on the home page, the song pages and the app; a change made anywhere arrives here too.
  const instrumentTabs = document.querySelectorAll<HTMLButtonElement>(".instrument-tab");
  function chooseInstrument(id: string) {
    activeInstrument = id as InstrumentId;
    instrumentTabs.forEach((b) => {
      const active = b.dataset.inst === id;
      b.style.background = active ? "var(--color-accent)" : "transparent";
      b.style.color = active ? "var(--color-on-accent)" : "#c4b5fd";
      b.style.borderColor = active ? "var(--color-accent)" : "#7c3aed44";
      b.setAttribute("aria-pressed", String(active));
    });
  }
  instrumentTabs.forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = (btn.dataset.inst || "guitar") as InstrumentId;
      if (id === activeInstrument) return;
      setInstrument(id); // remembered (device and account) and announced; "instrument-change" below draws it
    });
  });
  // the chosen instrument arrives from anywhere: this page's tabs, the account on sign-in, another tab
  window.addEventListener("instrument-change", () => {
    const shown = instrumentFor(can);
    if (shown === activeInstrument) return;
    chooseInstrument(shown);
    refreshViews(); // draw every diagram again, for this instrument
  });
  chooseInstrument(activeInstrument); // the tabs show what was chosen before this page opened

  // Toolbar: volume
  volumeSlider.addEventListener("input", () => {
    const v = Number(volumeSlider.value) / 100;
    audioEl.volume = v;
    if (ytPlayer && typeof ytPlayer.setVolume === "function") ytPlayer.setVolume(v * 100);
  });

  // Toolbar: loop (off -> whole song -> current section)
  loopToggle.addEventListener("click", () => {
    loopMode = loopMode === "off" ? "song" : loopMode === "song" && sections.length > 0 ? "section" : "off";
    loopSection = loopMode === "section" ? Math.max(0, currentSectionIdx) : -1;
    audioEl.loop = loopMode === "song";
    loopToggle.textContent = loopMode === "off" ? "Off" : loopMode === "song" ? "Song" : "Section";
    loopToggle.style.color = loopMode === "off" ? "var(--color-body)" : "var(--color-violet-text, var(--color-violet))";
    loopToggle.setAttribute("aria-pressed", String(loopMode !== "off"));
  });

  // Toolbar: tempo (playback speed, 50%-150%)
  function applyTempo() {
    tempoValueEl.textContent = `${tempoPct}%`;
    const rate = tempoPct / 100;
    audioEl.playbackRate = rate;
    if (ytPlayer && typeof ytPlayer.setPlaybackRate === "function") ytPlayer.setPlaybackRate(rate);
  }
  tempoDown.addEventListener("click", () => {
    tempoPct = Math.max(50, tempoPct - 10);
    applyTempo();
  });
  tempoUp.addEventListener("click", () => {
    tempoPct = Math.min(150, tempoPct + 10);
    applyTempo();
  });

  // Toolbar: capo (shifts which guitar shape is shown, not the sounding pitch)
  capoDown.addEventListener("click", () => {
    capo = Math.max(0, capo - 1);
    capoValueEl.textContent = String(capo);
    refreshViews();
  });
  capoUp.addEventListener("click", () => {
    capo = Math.min(7, capo + 1);
    capoValueEl.textContent = String(capo);
    refreshViews();
  });

  // Toolbar: transpose (shifts the chord names everywhere — sing/play in a different key)
  transposeDown.addEventListener("click", () => {
    transposeSteps -= 1;
    updateTransposeLabel();
    refreshViews();
  });
  transposeUp.addEventListener("click", () => {
    transposeSteps += 1;
    updateTransposeLabel();
    refreshViews();
  });

  // Toolbar: bar length (beats per bar, pulse, where bars start): for songs the analysis counts differently from a player
  meterDown.addEventListener("click", () => meter.perBar > METER_MIN && changeMeter({ perBar: meter.perBar - 1 }));
  meterUp.addEventListener("click", () => meter.perBar < METER_MAX && changeMeter({ perBar: meter.perBar + 1 }));
  meterValueEl.style.cursor = "pointer";
  meterValueEl.addEventListener("click", () => changeMeter({ perBar: baseBeatsPerBar, pulse: 1, shift: null }));
  pulseDown.addEventListener("click", () => meter.pulse !== 1 && changeMeter({ pulse: 1 }));
  pulseUp.addEventListener("click", () => meter.pulse !== 2 && changeMeter({ pulse: 2 }));
  barStartDown.addEventListener("click", () => changeMeter({ shift: (meterShift + meter.perBar - 1) % meter.perBar }));
  barStartUp.addEventListener("click", () => changeMeter({ shift: (meterShift + 1) % meter.perBar }));
  barStartValueEl.style.cursor = "pointer";
  barStartValueEl.addEventListener("click", () => meter.shift !== null && changeMeter({ shift: null }));

  // View switcher: Chords grid / Chord diagrams
  function setActiveView(view: "diagrams" | "grid") {
    activeView = view;
    const isDiagrams = view === "diagrams";
    panelDiagrams.classList.toggle("hidden", !isDiagrams);
    panelGrid.classList.toggle("hidden", isDiagrams);
    viewTabDiagrams.classList.toggle("is-active", isDiagrams);
    viewTabDiagrams.setAttribute("aria-pressed", String(isDiagrams));
    viewTabGrid.classList.toggle("is-active", !isDiagrams);
    viewTabGrid.setAttribute("aria-pressed", String(!isDiagrams));
    // the strip can't be measured while hidden, so lay it out and bring the playing chord back into view on return
    if (isDiagrams) layoutDiagrams();
  }
  viewTabDiagrams.addEventListener("click", () => setActiveView("diagrams"));
  viewTabGrid.addEventListener("click", () => setActiveView("grid"));

  // Header: share, compact-on-scroll, transport, progress bar, section picker
  btnShare.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      btnShare.textContent = "Link copied";
    } catch {
      window.prompt("Copy this link", window.location.href);
    }
    setTimeout(() => (btnShare.textContent = "Share"), 1800);
  });
  // Export: the chord sheet (PDF) and the chords as a MIDI file, made from what is on screen (key, capo and bar length included).
  const exportButton = document.getElementById("btn-export") as HTMLButtonElement;
  const exportMenu = document.getElementById("export-menu")!;
  function setExportMenu(open: boolean) {
    exportMenu.hidden = !open;
    exportButton.setAttribute("aria-expanded", String(open));
  }
  exportButton.addEventListener("click", () => setExportMenu(exportMenu.hidden));
  document.addEventListener("click", (event) => {
    if (!exportMenu.hidden && !(event.target as Element | null)?.closest("#ph-export")) setExportMenu(false);
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !exportMenu.hidden) {
      setExportMenu(false);
      exportButton.focus();
    }
  });

  /** The strumming pattern of each bar: the one made for the kind of section the bar is in, else the one chosen on the card. */
  function strumPerBar(): ({ pattern: string[]; sub: number } | null)[] {
    if (!strum || strumList.length === 0) return bars.map(() => null);
    const chosen = strumList[Math.min(strumIdx, strumList.length - 1)];
    const kindOfBar: string[] = [];
    sections.forEach((sec) => {
      if (sec.startBar === null) return;
      const kind = sec.label.replace(/\s*\d+$/, "");
      for (let b = sec.startBar; b <= (sec.endBar ?? sec.startBar); b++) kindOfBar[b] = kind;
    });
    return bars.map((_, b) => {
      const own = strumList.find((p) => p.where.length > 0 && kindOfBar[b] !== undefined && p.where.includes(kindOfBar[b])) ?? chosen;
      return { pattern: own.pattern, sub: own.sub === 4 ? 4 : 2 };
    });
  }

  /** The song as the player shows it now, ready to write out. */
  function songForExport(): ExportSong {
    const written = placeChordsOnBeats();
    const rows = (from: number, to: number) =>
      written.slice(from, to + 1).map((bar, i) =>
        bar.map((chord, k) => (bars[from + i].beats[k] === null ? null : chord === "N" ? "—" : chord ? displayChord(chord) : "")),
      );
    const real = sections.filter((sec) => sec.startBar !== null);
    const blocks =
      real.length === 0
        ? [{ label: "", bars: rows(0, bars.length - 1) }]
        : real.map((sec, i) => ({
            label: sec.label,
            // bars before the first section (a pickup) and after the last belong to those sections
            bars: rows(i === 0 ? 0 : (sec.startBar as number), i === real.length - 1 ? bars.length - 1 : (sec.endBar as number)),
          }));
    const beatTimes: number[] = [];
    for (const bar of bars) for (let k = 0; k < BEAT_CELLS; k++) if (bar.beats[k] !== null && bar.beats[k] !== undefined) beatTimes.push(bar.beats[k] as number);
    const pickup = bars.length ? Math.max(0, bars[0].beats.slice(0, BEAT_CELLS).findIndex((t) => t !== null)) : 0;
    return {
      title: songTitleEl.textContent || "Your song",
      artist: (songArtistEl.textContent || "").replace(/^by /, ""),
      key: songKey ? chordKeyLabel(transposeChord(songKey, transposeSteps)) : "",
      tempo,
      perBar: BEAT_CELLS,
      capo,
      transposed: ((transposeSteps + 6) % 12 + 12) % 12 - 6,
      blocks,
      beatTimes,
      pickup,
      chords: chords.map((seg) => ({ start: seg.start, end: seg.end, chord: seg.chord === "N" ? "N" : displayChord(seg.chord) })),
      barBeats: bars.map((bar) => bar.beats),
      strumBars: strumPerBar(),
      duration,
    };
  }
  document.getElementById("export-pdf")!.addEventListener("click", () => {
    if (!can("pdf_export") || bars.length === 0) return;
    setExportMenu(false);
    downloadPdf(songForExport());
  });
  document.getElementById("export-midi")!.addEventListener("click", () => {
    if (!can("midi_export") || chords.length === 0) return;
    setExportMenu(false);
    downloadMidi(songForExport());
  });
  const exportStrumItem = document.getElementById("export-midi-strum") as HTMLButtonElement;
  exportStrumItem.addEventListener("click", () => {
    if (!can("midi_export") || chords.length === 0) return;
    setExportMenu(false);
    downloadMidi(songForExport(), true);
  });
  // the strummed file is offered once the song has a strumming pattern
  exportButton.addEventListener("click", () => {
    exportStrumItem.hidden = !(strum && strumList.length > 0);
  });

  // The header shrinks once the page is scrolled. It must not grow back at the same point it shrank at: shrinking makes the page
  // shorter, which can pull the scroll position back past that point, and the header would grow, shrink, grow... (the whole page
  // flickering). So it shrinks well down the page and grows only near the top, and the page is always tall enough to scroll that far.
  const syncHeaderSize = () => {
    const y = window.scrollY;
    const compact = headerEl.classList.contains("is-compact");
    if (!compact && y > 100) headerEl.classList.add("is-compact");
    else if (compact && y < 24) headerEl.classList.remove("is-compact");
    document.documentElement.style.setProperty("--ph-h", `${headerEl.offsetHeight}px`);
  };
  window.addEventListener("scroll", syncHeaderSize, { passive: true });
  window.addEventListener("resize", syncHeaderSize);
  new ResizeObserver(syncHeaderSize).observe(headerEl);
  dgAnimated.addEventListener("click", () => setDiagramMode("animated"));
  dgSummary.addEventListener("click", () => setDiagramMode("summary"));
  btnPlay.addEventListener("click", () => void togglePlay());
  btnRestart.addEventListener("click", () => seekQuiet(0));
  progressEl.addEventListener("pointerdown", seekFromProgress);
  progressEl.addEventListener("keydown", (e) => {
    if (e.code === "ArrowRight") seekQuiet(Math.min(duration, playerTime() + 5));
    else if (e.code === "ArrowLeft") seekQuiet(Math.max(0, playerTime() - 5));
    else return;
    e.preventDefault();
  });
  sectionSelect.addEventListener("change", () => {
    const seg = progressSegs[Number(sectionSelect.value)];
    if (seg) seekTo(seg.start);
  });
  window.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    if (e.code === "Space" && (target === document.body || target === playerState)) {
      e.preventDefault();
      void togglePlay();
    }
  });

  // Toolbar: count-in, section labels, simple/detailed chords
  countInToggle.addEventListener("click", () => {
    countInEnabled = !countInEnabled;
    countInToggle.textContent = countInEnabled ? "On" : "Off";
    countInToggle.style.color = countInEnabled ? "var(--color-violet-text, var(--color-violet))" : "var(--color-body)";
    countInToggle.setAttribute("aria-pressed", String(countInEnabled));
  });
  sectionsToggle.addEventListener("click", () => {
    const showing = chordGridEl.classList.toggle("grid-hide-tags") === false;
    sectionsToggle.textContent = showing ? "On" : "Off";
    sectionsToggle.style.color = showing ? "var(--color-violet-text, var(--color-violet))" : "var(--color-body)";
    sectionsToggle.setAttribute("aria-pressed", String(showing));
  });
  detailToggle.addEventListener("click", () => {
    const detailed = chords === chordsSimple;
    chords = detailed ? chordsDetailed : chordsSimple;
    detailToggle.textContent = detailed ? "Detailed" : "Simple";
    detailToggle.style.color = detailed ? "var(--color-violet-text, var(--color-violet))" : "var(--color-body)";
    detailToggle.setAttribute("aria-pressed", String(detailed));
    refreshViews();
    onTimeUpdate(playerTime());
  });

  init();

  // The side column (video, instrument, song details) stays in view while the page scrolls. When it is taller than the window it would be cut
  // off, so it is given a negative "top": it scrolls with the page until its bottom edge reaches the bottom of the window, and stays there. No
  // scrollbar of its own, and every part of it can be reached.
  (() => {
    const side = document.querySelector<HTMLElement>(".pl-side");
    if (!side) return;
    const fit = () => {
      const room = innerHeight - side.offsetHeight - 16;
      side.style.setProperty("--side-top", `${Math.round(Math.min(88, room))}px`);
    };
    new ResizeObserver(fit).observe(side);
    addEventListener("resize", fit);
    fit();
  })();
</script>
