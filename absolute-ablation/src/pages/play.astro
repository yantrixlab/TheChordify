---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SimilarSongs from "../components/SimilarSongs.astro";
import SongRating from "../components/SongRating.astro";
---

<Layout title="Play along — Chord Suno" noindex themeable>
  <Nav />
  <main id="main-content" class="gradient-mesh" style="min-height:100vh;padding:var(--main-top, 28px) var(--main-x, var(--space-lg)) var(--space-3xl);">
    <div class="mx-auto" style="max-width:1180px;color:white;">
      <div id="loading-state" style="text-align:center;padding:80px 0;color:#c4b5fd;">
        Loading your song…
      </div>

      <div id="error-state" class="hidden" style="text-align:center;padding:80px 0;">
        <p style="color:var(--color-error);font-size:16px;margin-bottom:16px;" id="error-message"></p>
        <a href="/" style="color:var(--color-accent);text-decoration:underline;">Back to home</a>
      </div>

      <div id="player-state" class="hidden pl">
        <div class="pl-main">
          <!-- Player header: title, transport, section-aware progress bar and the toolbar, all sticky together -->
          <div id="player-header" class="ph">
            <div class="ph-head">
              <div class="ph-titles">
                <div class="ph-title">
                  <h1 id="song-title">Your song</h1>
                  <span id="song-artist" class="ph-by"></span>
                </div>
                <div id="song-sub" class="ph-sub"><span class="ph-sub-main">Transcription by Chord Suno</span><span id="song-note" class="ph-note" hidden>Refining the sections…</span></div>
              </div>
              <div class="ph-actions" id="ph-actions">
                <div class="ph-export" id="ph-export">
                  <button id="btn-export" type="button" class="ph-share" aria-haspopup="true" aria-expanded="false">Export</button>
                  <div id="export-menu" class="ph-menu" role="menu" hidden>
                    <button id="export-pdf" type="button" role="menuitem"><b>Chord sheet</b><span>Printable PDF</span></button>
                    <button id="export-midi" type="button" role="menuitem"><b>Chords as MIDI</b><span>Held chords, for your music software</span></button>
                    <button id="export-midi-strum" type="button" role="menuitem" hidden><b>Strummed chords as MIDI</b><span>Played with the strumming pattern</span></button>
                  </div>
                </div>
                <button id="btn-share" type="button" class="ph-share">Share</button>
              </div>
            </div>
            <div class="ph-controls">
              <button id="btn-restart" type="button" class="ph-btn" aria-label="Back to the start">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" fill="currentColor" /></svg>
              </button>
              <button id="btn-play" type="button" class="ph-play" aria-label="Play">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
              </button>
              <div class="ph-track">
                <div class="ph-row">
                  <span id="time-now">0:00</span>
                  <span aria-hidden="true">•</span>
                  <select id="section-select" aria-label="Jump to a section"></select>
                </div>
                <div id="progress" class="pb" role="slider" tabindex="0" aria-label="Song position" aria-valuemin="0" aria-valuenow="0"></div>
              </div>
              <div id="time-total" class="ph-total">0:00</div>
            </div>
          <div class="ph-tools">
            {
              [
                { id: "countin", label: "Count-in" },
                { id: "volume", label: "Volume" },
                { id: "loop", label: "Loop" },
                { id: "tempo", label: "Tempo" },
                { id: "capo", label: "Capo" },
                { id: "transpose", label: "Transpose" },
                { id: "meter", label: "Beats / bar" },
                { id: "pulse", label: "Pulse" },
                { id: "barstart", label: "Bar start" },
                { id: "sections", label: "Sections" },
                { id: "detail", label: "Chords" },
              ].map((tool, i) => (
                <div class="ph-tool flex flex-col items-center justify-center" data-tool={tool.id}>
                  <div class="ph-tool-icon" aria-hidden="true">
                    {tool.id === "volume" && "🔊"}
                    {tool.id === "loop" && "∞"}
                    {tool.id === "tempo" && "🐢"}
                    {tool.id === "capo" && "🪕"}
                    {tool.id === "transpose" && "♯"}
                    {tool.id === "meter" && "𝄴"}
                    {tool.id === "pulse" && "◉"}
                    {tool.id === "barstart" && "⇥"}
                    {tool.id === "countin" && "③"}
                    {tool.id === "sections" && "☰"}
                    {tool.id === "detail" && "♬"}
                  </div>
                  {tool.id === "volume" && (
                    <input
                      id="volume-slider"
                      type="range"
                      min="0"
                      max="100"
                      value="100"
                      style="width:64px;height:14px;"
                      aria-label="Volume"
                    />
                  )}
                  {tool.id === "loop" && (
                    <button
                      id="loop-toggle"
                      type="button"
                      aria-pressed="false"
                      style="font-size:11px;color:var(--color-body);background:none;border:none;cursor:pointer;font-weight:600;"
                    >
                      Off
                    </button>
                  )}
                  {tool.id === "tempo" && (
                    <div class="flex items-center gap-1">
                      <button id="tempo-down" type="button" aria-label="Slower" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">◂</button>
                      <span id="tempo-value" style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink);font-weight:600;min-width:34px;text-align:center;">100%</span>
                      <button id="tempo-up" type="button" aria-label="Faster" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">▸</button>
                    </div>
                  )}
                  {tool.id === "capo" && (
                    <div class="flex items-center gap-1">
                      <button id="capo-down" type="button" aria-label="Capo down" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">◂</button>
                      <span id="capo-value" style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink);font-weight:600;min-width:20px;text-align:center;">0</span>
                      <button id="capo-up" type="button" aria-label="Capo up" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">▸</button>
                    </div>
                  )}
                  {tool.id === "transpose" && (
                    <div class="flex items-center gap-1">
                      <button id="transpose-down" type="button" aria-label="Transpose down" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">◂</button>
                      <span id="transpose-value" style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink);font-weight:600;min-width:24px;text-align:center;">0</span>
                      <button id="transpose-up" type="button" aria-label="Transpose up" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">▸</button>
                    </div>
                  )}
                  {tool.id === "meter" && (
                    <div class="flex items-center gap-1">
                      <button id="meter-down" type="button" aria-label="Fewer beats in a bar" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">◂</button>
                      <span id="meter-value" title="Beats in a bar. Click to go back to what the song was analysed as." style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink);font-weight:600;min-width:20px;text-align:center;">4</span>
                      <button id="meter-up" type="button" aria-label="More beats in a bar" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">▸</button>
                    </div>
                  )}
                  {tool.id === "pulse" && (
                    <div class="flex items-center gap-1">
                      <button id="pulse-down" type="button" aria-label="Count every beat" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">◂</button>
                      <span id="pulse-value" title="Count every beat the tracker found, or twice as many (a beat in between each)." style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink);font-weight:600;min-width:24px;text-align:center;">×1</span>
                      <button id="pulse-up" type="button" aria-label="Count twice as fast" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">▸</button>
                    </div>
                  )}
                  {tool.id === "barstart" && (
                    <div class="flex items-center gap-1">
                      <button id="barstart-down" type="button" aria-label="Start bars one beat earlier" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">◂</button>
                      <span id="barstart-value" title="Which beat a bar starts on. Auto follows where the chords change." style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink);font-weight:600;min-width:34px;text-align:center;">auto</span>
                      <button id="barstart-up" type="button" aria-label="Start bars one beat later" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">▸</button>
                    </div>
                  )}
                  {tool.id === "countin" && (
                    <button id="countin-toggle" type="button" aria-pressed="false" style="font-size:11px;color:var(--color-body);background:none;border:none;cursor:pointer;font-weight:600;">Off</button>
                  )}
                  {tool.id === "sections" && (
                    <button id="sections-toggle" type="button" aria-pressed="true" style="font-size:11px;color:var(--color-violet-text, var(--color-violet));background:none;border:none;cursor:pointer;font-weight:600;">On</button>
                  )}
                  {tool.id === "detail" && (
                    <button id="detail-toggle" type="button" aria-pressed="false" style="font-size:11px;color:var(--color-body);background:none;border:none;cursor:pointer;font-weight:600;">Simple</button>
                  )}
                  <div class="ph-tool-label">{tool.label}</div>
                </div>
              ))
            }
          </div>

          </div>

          <!-- Views: Chords grid (every bar, grouped into sections) / Chord diagrams (timeline + sliding window) -->
          <div class="rounded-2xl tl-card">
            <div class="tl-tabs">
              <div class="tl-seg" role="group" aria-label="Chord view">
                <button id="view-tab-diagrams" type="button" class="tl-tab is-active" aria-pressed="true"><span class="full">Chord diagrams</span><span class="short">Diagrams</span></button>
                <button id="view-tab-grid" type="button" class="tl-tab" aria-pressed="false"><span class="full">Chords grid</span><span class="short">Grid</span></button>
              </div>
            </div>

            <div id="panel-grid" class="grid-panel hidden">
              <div id="chord-grid"></div>
            </div>

            <!-- Chord diagrams: animated (timeline + sliding window) or a summary of every chord in the song -->
            <div id="panel-diagrams">
              <div class="dg-bar">
                <div class="tl-seg" role="group" aria-label="Diagram style">
                  <button id="dg-animated" type="button" class="tl-tab is-active" aria-pressed="true">Animated</button>
                  <button id="dg-summary" type="button" class="tl-tab" aria-pressed="false">Summary</button>
                </div>
              </div>
              <div id="dg-animated-panel">
                <div id="beat-strip" class="bs" role="group" aria-label="Chord timeline, one cell per beat">
                  <div id="bs-scroll" class="bs-scroll">
                    <div id="bs-track" class="bs-track"></div>
                  </div>
                  <div id="bs-marker" class="bs-marker" aria-hidden="true"></div>
                </div>
                <div id="chord-carousel" class="cr" aria-label="Chord diagrams">
                  <div id="cr-track" class="cr-track" role="list"></div>
                </div>
              </div>
              <div id="dg-summary-panel" class="hidden">
                <div id="summary-grid" class="sum-grid"></div>
              </div>
            </div>
          </div>

          <!-- The strumming pattern of the song, with the playing slot lit as the music goes -->
          <section id="strum-card" class="sm-card" hidden aria-labelledby="sm-title">
            <div class="sm-head">
              <div class="sm-ttl">
                <h2 id="sm-title">Strumming pattern</h2>
                <span id="sm-pill" class="sm-pill"></span>
              </div>
              <div class="sm-tools">
                <button id="sm-edit" class="sm-edit" type="button" aria-expanded="false" aria-controls="sm-editor" hidden>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"></path></svg>
                  <span>Edit strumming</span>
                </button>
                <div id="sm-seg" class="sm-seg" role="group" aria-label="Which pattern"></div>
              </div>
            </div>
            <p id="sm-label" class="sm-label"></p>
            <div class="sm-legend">
              <span class="sm-key is-down"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v15M6 13l6 6 6-6"/></svg></i>Down</span>
              <span class="sm-key is-up"><i><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20V5M6 11l6-6 6 6"/></svg></i>Up</span>
              <span class="sm-key is-rest"><i></i>Rest</span>
              <span id="sm-bar" class="sm-barchip"></span>
            </div>
            <div id="sm-tiles" class="sm-tiles" role="group" aria-label="The strums in one bar, beat by beat"></div>
            <p id="sm-text" class="sm-text"></p>
            <details class="sm-how">
              <summary>How to play it</summary>
              <div id="sm-how"></div>
            </details>
            <p id="sm-note" class="sm-note"></p>
            <div id="sm-editor" class="sme" hidden></div>
          </section>

          <SimilarSongs />
        </div>

        <aside class="pl-side" aria-label="Video and song details">
          <div id="youtube-mount" class="side-card video-card hidden"></div>
          <div class="side-card inst-card">
            <div class="flex items-center justify-center gap-2 flex-wrap" role="group" aria-label="Instrument">
              {
                [
                  { id: "guitar", label: "Guitar", icon: "🎸", soon: false },
                  { id: "piano", label: "Piano", icon: "🎹", soon: false },
                  { id: "ukulele", label: "Ukulele", icon: "🪗", soon: false },
                  { id: "mandolin", label: "Mandolin", icon: "🎵", soon: false },
                ].map((inst, i) => (
                  <button
                    type="button"
                    class="instrument-tab rounded-full font-medium"
                    data-inst={inst.id}
                    data-soon={inst.soon ? "true" : undefined}
                    aria-pressed={i === 0 ? "true" : "false"}
                    style={`
                      height:32px;padding:0 14px;font-size:13px;cursor:pointer;
                      border:1px solid ${i === 0 ? "var(--color-accent)" : "#7c3aed44"};
                      background:${i === 0 ? "var(--color-accent)" : "transparent"};
                      color:${i === 0 ? "var(--color-on-accent)" : "#c4b5fd"};
                    `}
                  >
                    <span aria-hidden="true">{inst.icon}</span> {inst.label}
                    {inst.soon && <span class="inst-soon">soon</span>}
                  </button>
                ))
              }
            </div>
          </div>
          <div class="side-card details-card">
            <h2 class="sd-title">Song details</h2>
            <dl class="sd-list">
              <div><dt>Rating</dt><dd id="sd-rating">—</dd></div>
              <div><dt>Chords</dt><dd id="sd-chords" class="sd-chips"></dd></div>
              <div><dt>Key</dt><dd id="sd-key">—</dd></div>
              <div><dt>Tempo</dt><dd id="sd-tempo">—</dd></div>
              <div><dt>Sections</dt><dd id="sd-sections">—</dd></div>
              <div><dt>Transcription</dt><dd>Chord Suno (automatic)</dd></div>
            </dl>
            <SongRating />
          </div>
        </aside>
        <audio id="audio-el" class="hidden" preload="metadata"></audio>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* the strumming pattern: a compact row of square tiles that light up with the music */
  .sm-card { position: relative; overflow: hidden; padding: 20px 22px 18px; border-radius: 20px; background: radial-gradient(120% 150% at 0% 0%, #2b1264 0%, #170b33 46%, #0f0623 100%); border: 1px solid #ffffff17; box-shadow: 0 30px 60px -34px #000c, inset 0 1px 0 #ffffff14; color: #e4dcf5; }
  .sm-card::before { content: ""; position: absolute; top: -170px; right: -110px; width: 360px; height: 360px; border-radius: 50%; background: radial-gradient(circle, #7c3aed4d, transparent 66%); pointer-events: none; will-change: transform; }
  .sm-card.is-live::before { animation: sm-drift 10s ease-in-out infinite alternate; }
  .sm-card > * { position: relative; }
  .sm-card[hidden] { display: none; }
  .sm-head { display: flex; align-items: center; justify-content: space-between; gap: 10px 14px; flex-wrap: wrap; }
  .sm-ttl { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sm-head h2, .sp-block .sm-ttl h2 { margin: 0; font-size: 18px; font-weight: 700; letter-spacing: -0.02em; color: #fff; }
  .sm-pill { padding: 3px 10px; border-radius: 999px; background: #ffffff14; border: 1px solid #ffffff1c; font: 600 11px var(--font-mono); letter-spacing: 0.03em; color: #cdbdf5; }
  .sm-pill.is-heard { background: #fcd34d22; border-color: #fcd34d55; color: #fde68a; }
  .sm-seg { display: inline-flex; padding: 3px; border-radius: 999px; background: #ffffff12; }
  .sm-seg button { height: 28px; padding: 0 13px; border: 0; border-radius: 999px; background: transparent; font: 650 12px var(--font-sans); color: #c9bbf0; cursor: pointer; transition: background-color 0.15s, color 0.15s; }
  .sm-seg button:hover { color: #fff; }
  .sm-seg button.is-on { background: #fff; color: #1a0d33; }
  .sm-tools { display: flex; align-items: center; gap: 8px 10px; flex-wrap: wrap; }
  .sm-edit { display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 14px; border: 1px solid #ffffff2b; border-radius: 999px; background: #ffffff12; font: 650 12.5px var(--font-sans); color: #e9defc; cursor: pointer; transition: background-color 0.15s, border-color 0.15s; }
  .sm-edit:hover { background: #ffffff1f; border-color: #ffffff45; color: #fff; }
  .sm-edit[aria-expanded="true"] { background: #fcd34d26; border-color: #fcd34d66; color: #fde68a; }
  .sm-edit:focus-visible, .sme button:focus-visible, .sme select:focus-visible, .sme input:focus-visible { outline: 2px solid #fcd34d; outline-offset: 2px; }

  /* the strumming editor (signed-in listeners): patterns as rows of strokes, tapped to change */
  .sme { margin-top: 16px; padding: 16px 16px 14px; border-radius: 16px; background: #ffffff0d; border: 1px solid #ffffff1c; }
  .sme[hidden] { display: none; }
  .sme h3 { margin: 0 0 4px; font-size: 16px; font-weight: 700; color: #fff; }
  .sme .sme-hint { margin: 0 0 14px; font-size: 13.5px; line-height: 1.55; color: #c9bbf0; }
  .sme-pat { margin: 0 0 12px; padding: 12px 14px; border-radius: 14px; background: #0f0623b3; border: 1px solid #ffffff17; }
  .sme-pat-head { display: flex; align-items: center; flex-wrap: wrap; gap: 6px 8px; margin-bottom: 10px; }
  .sme-pat-head strong { margin-right: auto; font-size: 14px; color: #fff; }
  .sme-mini { height: 28px; padding: 0 11px; border: 1px solid #ffffff24; border-radius: 999px; background: transparent; font: 650 12px var(--font-sans); color: #d9ccff; cursor: pointer; }
  .sme-mini:hover:not(:disabled) { background: #ffffff1a; color: #fff; }
  .sme-mini:disabled { opacity: 0.35; cursor: not-allowed; }
  .sme-mini.is-danger { color: #fca5a5; border-color: #f8717155; }
  .sme-beats { display: flex; flex-wrap: wrap; gap: 8px 12px; }
  .sme-beat { display: flex; gap: 4px; padding: 6px; border-radius: 12px; background: #ffffff0a; }
  .sme-slot { display: grid; justify-items: center; gap: 4px; }
  .sme-slot small { font: 600 10px/1 var(--font-mono); color: #a898d6; }
  .sme-slot small.on { color: #fff; font-size: 11px; }
  .sme-stroke { width: 34px; height: 40px; padding: 0; border: 1.5px dashed #ffffff30; border-radius: 10px; background: transparent; font: 800 18px/1 var(--font-sans); color: #7c6fa8; cursor: pointer; transition: transform 0.1s, background-color 0.12s; }
  .sme-stroke:active { transform: scale(0.94); }
  .sme-stroke[data-s="D"] { border: 1.5px solid #8b5cf6; background: linear-gradient(160deg, #7e3ff1, #5421b8); color: #fff; }
  .sme-stroke[data-s="U"] { border: 1.5px solid #5eead4; background: linear-gradient(160deg, #2dd4bf, #0f766e); color: #fff; }
  .sme-pat[data-sub="4"] .sme-stroke { width: 28px; height: 38px; font-size: 16px; }
  .sme-line { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-top: 10px; font-size: 13px; color: #c9bbf0; }
  .sme-line select { height: 32px; padding: 0 28px 0 10px; border-radius: 10px; border: 1px solid #ffffff2b; background: #1a1037; color: #fff; font: 600 13px var(--font-sans); }
  .sme-line label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
  .sme-line input[type="checkbox"] { width: 16px; height: 16px; accent-color: #8b5cf6; }
  .sme-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; margin-top: 6px; }
  .sme-btn { height: 40px; padding: 0 20px; border: 0; border-radius: 999px; font: 700 14px var(--font-sans); cursor: pointer; transition: transform 0.12s, opacity 0.12s; }
  .sme-btn:hover:not(:disabled) { transform: translateY(-1px); }
  .sme-btn:disabled { opacity: 0.55; cursor: progress; }
  .sme-save { background: #fcd34d; color: #2a1500; }
  .sme-cancel { background: #ffffff14; color: #e9defc; }
  .sme-add { background: transparent; border: 1px dashed #ffffff40; color: #d9ccff; }
  .sme-msg { margin: 10px 0 0; font-size: 13.5px; line-height: 1.5; color: #c9bbf0; }
  .sme-msg.is-bad { color: #fca5a5; }
  @media (max-width: 640px) { .sme { padding: 12px 10px; } .sme-stroke { width: 30px; height: 38px; } .sme-pat[data-sub="4"] .sme-stroke { width: 24px; } }
  @media (prefers-reduced-motion: reduce) { .sme-stroke, .sme-btn { transition: none; } }
  .sm-label { margin: 14px 0 0 !important; font: 600 12.5px var(--font-mono) !important; letter-spacing: 0.06em; color: #b9a8e8 !important; }
  .sm-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin: 12px 0 0; }
  .sm-key { display: inline-flex; align-items: center; gap: 7px; font: 650 12px var(--font-sans); color: #cbbfe8; }
  .sm-key i { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 7px; box-shadow: inset 0 1px 0 #ffffff40; }
  .sm-key svg { width: 13px; height: 13px; fill: none; stroke: #fff; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .sm-key.is-down i { background: linear-gradient(160deg, #8b5cf6, #5b21b6); }
  .sm-key.is-up i { background: linear-gradient(160deg, #2dd4bf, #0f766e); }
  .sm-key.is-rest i { border: 1px dashed #ffffff4d; box-shadow: none; }
  .sm-barchip { margin-left: auto; padding: 3px 11px; border-radius: 999px; background: #ffffff14; border: 1px solid #ffffff1f; font: 650 11.5px var(--font-mono); letter-spacing: 0.02em; color: #e4dcf5; white-space: nowrap; }
  /* one bar: its beats side by side, between two bar lines, each beat holding its own slots (two to a beat for eighths, four for sixteenths) */
  .sm-tiles { position: relative; display: grid; grid-template-columns: repeat(var(--beats, 4), minmax(0, 1fr)); gap: 8px; margin: 12px 0 16px; padding: 12px 18px; border-radius: 18px; background: #0d0620; border: 1px solid #ffffff14; box-shadow: inset 0 1px 0 #ffffff0d; }
  .sm-tiles::before, .sm-tiles::after { content: ""; position: absolute; top: 12px; bottom: 12px; width: 3px; border-radius: 2px; background: #ffffff4d; }
  .sm-tiles::before { left: 6px; }
  .sm-tiles::after { right: 6px; }
  .sm-beat { min-width: 0; padding: 7px 7px 8px; border-radius: 14px; background: #ffffff09; border: 1px solid #ffffff12; transition: background-color 0.15s, border-color 0.15s; }
  .sm-beat-n { display: block; margin: 0 0 6px 2px; font: 700 10px/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #a898d6; transition: color 0.15s; }
  .sm-beat.is-now { background: #fcd34d14; border-color: #fcd34d66; }
  .sm-beat.is-now .sm-beat-n { color: #fde68a; }
  .sm-slots { display: grid; grid-template-columns: repeat(var(--sub, 2), minmax(0, 1fr)); gap: 5px; }
  .sm-tile { position: relative; overflow: hidden; aspect-ratio: 1 / 1.18; display: grid; place-items: center; align-content: center; gap: 4px; border-radius: 12px; background: linear-gradient(160deg, #8b5cf6 0%, #5421b8 100%); border: 1px solid #ffffff2b; box-shadow: inset 0 1px 0 #ffffff3d, 0 8px 16px -10px #5b21b6; color: #fff; transition: transform 0.24s cubic-bezier(0.3, 1.6, 0.5, 1); }
  .sm-tile.is-up { background: linear-gradient(160deg, #2dd4bf 0%, #0f766e 100%); box-shadow: inset 0 1px 0 #ffffff3d, 0 8px 16px -10px #0d9488; }
  .sm-tile::before { content: ""; position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
  .sm-tile .sm-ar { display: grid; place-items: center; line-height: 0; }
  .sm-tile svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .sm-tile small { font: 650 10.5px/1 var(--font-mono); color: #ffffffe6; }
  .sm-tile.is-rest { background: #160d2e; border: 1px dashed #ffffff22; box-shadow: none; color: #8b7bbb; }
  .sm-tile.is-rest small { color: #8b7bbb; }
  .sm-tile.is-now { z-index: 1; transform: translateY(-3px) scale(1.08); box-shadow: 0 0 0 2px #fcd34d, 0 0 14px #f59e0b88; }
  .sm-tile.is-now::before { animation: sm-flash 0.3s ease-out; }
  .sm-tile.is-rest.is-now { box-shadow: 0 0 0 2px #fcd34d66; }
  .sm-tile.is-rest.is-now::before { display: none; }
  .sm-tile.is-now.is-down .sm-ar { animation: sm-down 0.45s ease-out; }
  .sm-tile.is-now.is-up .sm-ar { animation: sm-up 0.45s ease-out; }
  .sm-text { margin: 0 !important; font-size: 14.5px !important; line-height: 1.65 !important; color: #d6cbef !important; }
  .sm-text b, .sm-how b { color: #fff; }
  .sm-how { margin-top: 10px; }
  .sm-how summary { display: inline-flex; align-items: center; gap: 6px; font: 650 13px var(--font-sans); color: #c7b5ff; cursor: pointer; list-style: none; }
  .sm-how summary::-webkit-details-marker { display: none; }
  .sm-how summary::after { content: "+"; display: grid; place-items: center; width: 18px; height: 18px; border-radius: 50%; background: #ffffff14; font-size: 14px; line-height: 1; transition: transform 0.2s; }
  .sm-how[open] summary::after { content: "–"; }
  .sm-how > div { margin-top: 8px; font-size: 14px; line-height: 1.7; color: #cbbfe8; }
  .sm-how > div p { margin: 0 0 8px !important; font-size: 14px !important; line-height: 1.7 !important; color: #cbbfe8 !important; }
  .sm-note { margin: 12px 0 0 !important; font-size: 12px !important; line-height: 1.5; color: #a396cb !important; }
  @keyframes sm-flash { from { opacity: 0.38; } to { opacity: 0; } }
  @keyframes sm-down { 0% { transform: translateY(-6px); } 45% { transform: translateY(4px); } 100% { transform: translateY(0); } }
  @keyframes sm-up { 0% { transform: translateY(6px); } 45% { transform: translateY(-4px); } 100% { transform: translateY(0); } }
  @keyframes sm-drift { to { transform: translate(-36px, 26px) scale(1.12); } }
  @media (max-width: 640px) { .sm-card { padding: 16px 14px 14px; border-radius: 18px; } .sm-tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; padding: 10px 14px; } .sm-tiles::before { left: 4px; } .sm-tiles::after { right: 4px; } .sm-beat { padding: 6px 6px 7px; } .sm-slots { gap: 4px; } .sm-tile { border-radius: 10px; } .sm-tile svg { width: 17px; height: 17px; } .sm-tile small { font-size: 9.5px; } .sm-barchip { margin-left: 0; } }
  @media (prefers-reduced-motion: reduce) { .sm-card::before, .sm-tile.is-now, .sm-tile.is-now::before, .sm-tile.is-now .sm-ar { animation: none !important; } .sm-tile, .sm-beat, .sm-beat-n { transition: none; } .sm-tile.is-now { transform: none; } }
  /* A slow phone (see setLite): the decoration goes, the moving parts stay, and nothing but a transform or an opacity ever animates. */
  html.perf-lite .sm-card::before, html.perf-lite .sm-tile.is-now::before, html.perf-lite .sm-tile.is-now .sm-ar { animation: none !important; }
  html.perf-lite .sm-tile, html.perf-lite .sm-beat, html.perf-lite .sm-beat-n { transition: none; }
  html.perf-lite .sm-tile.is-now { box-shadow: 0 0 0 2px #fcd34d; transform: none; }
  html.perf-lite .cr-track { transition-duration: 0.2s; }
  html.perf-lite .cr-card { transition: none; }
  html.perf-lite .ph { box-shadow: 0 2px 6px rgba(13, 0, 31, 0.25); }
  .tl-card { background: var(--color-canvas); border: 1px solid var(--color-hairline); overflow: clip;
    box-shadow: 0 1px 2px rgba(13, 0, 31, 0.04), 0 12px 32px -12px rgba(91, 33, 182, 0.18); }
  /* The view switch floats over the top-left of the content and stays put, just under the sticky header. */
  .tl-tabs { position: sticky; top: calc(72px + var(--ph-h, 190px) + 8px); z-index: 25; padding: 8px 10px; height: 0; overflow: visible; pointer-events: none; }
  .tl-tabs .tl-seg { pointer-events: auto; background: rgba(237, 233, 254, 0.92); backdrop-filter: blur(6px); box-shadow: 0 2px 8px -2px rgba(13, 0, 31, 0.25); }
  .dg-bar { padding: 10px 12px; display: flex; justify-content: flex-end; border-bottom: 1px solid var(--color-hairline); background: var(--color-canvas-soft); }
  .tl-seg { display: inline-flex; gap: 2px; padding: 3px; border-radius: 999px; background: var(--color-violet-soft); }
  .tl-tab { height: 32px; padding: 0 16px; border: 0; border-radius: 999px; background: transparent;
    color: var(--color-violet-deep); font-size: 13px; font-weight: 600; cursor: pointer;
    transition: background-color 0.15s, color 0.15s, box-shadow 0.15s; }
  .tl-tab:hover { color: var(--color-ink); }
  .tl-tab.is-active { background: var(--color-canvas); color: var(--color-ink); box-shadow: 0 1px 3px rgba(13, 0, 31, 0.14); }
  .tl-tab:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 2px; }

  /* Chord diagrams: a beat strip whose playing beat stays at a fixed spot (the strip steps left one beat at a time),
     above a row of chord diagrams that slides left at each chord change, the playing chord enlarged at the same spot. */
  .bs { --bw: 44px; --gap: 4px; --pad: 7px; position: relative; background: var(--color-canvas); }
  /* Native horizontal scrolling: drag or swipe the strip while paused; playback brings it back to the playing beat. */
  .bs-scroll { overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain; scrollbar-width: thin;
    scrollbar-color: var(--color-violet) var(--color-hairline); background: var(--color-hairline); }
  .bs-scroll::-webkit-scrollbar { height: 10px; }
  .bs-scroll::-webkit-scrollbar-track { background: var(--color-hairline); }
  .bs-scroll::-webkit-scrollbar-thumb { background: var(--color-violet); border-radius: 5px; border: 2px solid var(--color-hairline); }
  .bs-track { position: relative; display: flex; align-items: center; gap: var(--gap); width: max-content;
    padding: var(--pad) 10px; background: var(--color-canvas); }
  /* one beat = one square cell with its own outline; a bar starts after a wider gap marked by a dark line */
  .bs-cell { position: relative; flex: 0 0 var(--bw); width: var(--bw); height: var(--bw); box-sizing: border-box; display: grid; place-items: center;
    padding: 0; border: 1.5px solid #d9cdf0; border-radius: 9px; background: #f6f2ff; color: var(--color-ink);
    font-size: 18px; font-weight: 700; line-height: 1; white-space: nowrap; cursor: pointer; }
  .bs-cell[data-len="3"] { font-size: 15px; }
  .bs-cell[data-len="4"] { font-size: 13px; }
  .bs-cell[data-len="5"] { font-size: 11px; }
  .bs-cell.has-chord { background: #fff; border-color: #bda9ea; }
  .bs-cell.is-bar { margin-left: 9px; }
  .bs-cell.is-bar::before { content: ""; position: absolute; left: -9px; top: calc(var(--pad) * -1); bottom: calc(var(--pad) * -1);
    width: 3px; border-radius: 2px; background: var(--color-body); }
  .bs-cell.is-rest { color: var(--color-mute); font-weight: 400; font-family: "Segoe UI Symbol", "Noto Music", "Apple Symbols", sans-serif; }
  /* The playing beat is a marker that never moves: the strip glides beneath it. Only when the strip has been scrolled by
     hand (it is "free") does the marker step aside and the playing cell itself light up, wherever it has got to. */
  .bs-marker { position: absolute; top: var(--pad); left: 0; width: var(--bw); height: var(--bw); box-sizing: border-box; display: grid; place-items: center;
    border-radius: 9px; background: var(--color-ink); color: var(--color-canvas); font-size: 18px; font-weight: 700; line-height: 1;
    white-space: nowrap; box-shadow: 0 6px 14px -6px rgba(13, 0, 31, 0.6); z-index: 3; pointer-events: none; transition-property: none; }
  .bs-marker[data-len="3"] { font-size: 15px; }
  .bs-marker[data-len="4"] { font-size: 13px; }
  .bs-marker[data-len="5"] { font-size: 11px; }
  .bs-marker.is-rest { font-weight: 400; font-family: "Segoe UI Symbol", "Noto Music", "Apple Symbols", sans-serif; }
  .bs.is-free .bs-marker { display: none; }
  .bs.is-free .bs-cell.is-active { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-canvas); }

  .cr { position: relative; overflow: hidden; padding: 22px 0 18px; background: var(--color-canvas); }
  .cr-track { display: flex; align-items: center; width: max-content; will-change: transform;
    transition: transform 0.32s cubic-bezier(0.3, 0.6, 0.2, 1); }
  /* every diagram gets its own margin left and right, so neighbours (and their fret numbers) never touch */
  .cr-item { flex: 0 0 auto; display: flex; justify-content: center; align-items: center; padding: 0 28px; cursor: pointer; } /* room for the playing chord, drawn 1.3x */
  .cr-item.is-rest { padding: 0 18px; font-size: 38px; color: var(--color-ink); }
  .cr-card { transition: transform 0.32s cubic-bezier(0.3, 0.6, 0.2, 1); transform-origin: center; }
  .cr-item.is-current .cr-card { transform: scale(1.3); }
  .is-locked { opacity: 0.4 !important; cursor: not-allowed !important; }

  /* Other ways of playing a chord: arrows either side of its name (on hover on a computer, always on a phone) and dots for which one is showing */
  .vc-label { display: flex; align-items: center; justify-content: center; gap: 2px; }
  .vc-arrow { display: grid; place-items: center; flex: none; width: 22px; height: 22px; padding: 0; border: 0; border-radius: 50%; cursor: pointer;
    background: var(--color-violet-soft); color: var(--color-violet-deep); opacity: 0; transition: opacity 0.15s, background-color 0.15s, color 0.15s; }
  .vc:hover .vc-arrow, .cr-item:hover .vc-arrow, .vc:focus-within .vc-arrow, .vc-arrow:focus-visible { opacity: 1; }
  .vc-arrow:hover { background: var(--color-violet); color: #fff; }
  .vc-arrow:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 1px; }
  .vc-dots { display: flex; justify-content: center; gap: 4px; height: 6px; margin-top: 3px; }
  .vc-dots span { width: 5px; height: 5px; border-radius: 50%; background: var(--color-hairline-strong); }
  .vc-dots span.on { background: var(--color-violet); }
  @media (hover: none), (max-width: 640px) {
    .vc-arrow { opacity: 1; width: 26px; height: 26px; }
  }
  @media (prefers-reduced-motion: reduce) { .vc-arrow { transition: none; } }
  /* the shared diagram builder draws a bordered card; here the diagram stands on the page */
  .cr-card > div { background: transparent !important; border: 0 !important; box-shadow: none !important; }

  @media (max-width: 520px) {
    .dg-bar { padding-top: 56px; } /* clear of the floating view switch, which is wider than the space beside it */
    .bs { --bw: 38px; --gap: 3px; --pad: 6px; }
    .bs-cell, .bs-marker { font-size: 16px; }
    .bs-cell[data-len="3"], .bs-marker[data-len="3"] { font-size: 13px; }
    .bs-cell[data-len="4"], .bs-marker[data-len="4"] { font-size: 11px; }
    .bs-cell[data-len="5"], .bs-marker[data-len="5"] { font-size: 9.5px; }
    .cr-item { padding: 0 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cr-track, .cr-item, .cr-card, .tl-tab { transition: none; }
  }

  /* Page layout: the player on the left, video + current chord + song details on the right */
  #player-state:not(.hidden) { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 24px; align-items: start;
    min-height: calc(100vh + 260px); /* always room to scroll past the point where the header shrinks, however short the song's page is */ }
  .pl-main { min-width: 0; }
  .pl-side { position: sticky; top: var(--side-top, 88px); display: flex; flex-direction: column; gap: 16px; } /* --side-top: see the script at the end */
  .side-card { border-radius: 16px; overflow: hidden; flex: 0 0 auto; }
  .video-card { aspect-ratio: 16 / 9; background: #000; }
  .video-card iframe { width: 100% !important; height: 100% !important; display: block; }
  .inst-card { background: #0d0019; border: 1px solid #7c3aed33; padding: 12px 12px; }
  .details-card { background: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline); padding: 16px 18px; }
  .sd-title { margin: 0 0 12px; font-size: 15px; font-weight: 700; }
  .sd-list { margin: 0; display: grid; gap: 10px; }
  .sd-list > div { display: grid; grid-template-columns: 92px minmax(0, 1fr); align-items: center; gap: 8px; font-size: 14px; }
  .sd-list dt { font: 600 10px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-mute); }
  .sd-list dd { margin: 0; font-weight: 600; }
  .sd-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .sd-chip { padding: 3px 10px; border-radius: 999px; background: var(--color-violet-soft); color: var(--color-violet-deep); font-size: 13px; font-weight: 700; }

  /* Player header (sticky): title, transport, toolbar */
  .ph { position: sticky; top: 72px; z-index: 30; margin-bottom: 16px; padding: 14px 18px 8px; border-radius: 14px;
    background: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline);
    box-shadow: 0 14px 34px -16px rgba(13, 0, 31, 0.55); }
  .ph-head { display: flex; align-items: flex-start; gap: 12px; }
  .ph-titles { min-width: 0; flex: 1 1 auto; }
  .ph-title { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .ph-title h1 { margin: 0; font-size: 22px; font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; }
  .ph-by { font-size: 14px; color: var(--color-mute); }
  .ph-sub { margin-top: 3px; font-size: 13px; color: var(--color-mute); }
  .ph-actions { display: flex; align-items: center; gap: 8px; flex: 0 0 auto; }
  .hb.hb-head { width: 32px; height: 32px; background: var(--color-violet-soft); box-shadow: none; }
  .hb.hb-head:hover { background: #fde7f3; }
  .ph-share { flex: 0 0 auto; height: 32px; padding: 0 14px; border: 0; border-radius: 999px; background: var(--color-violet-soft);
    color: var(--color-violet-deep); font-size: 13px; font-weight: 600; cursor: pointer; }
  .ph-share:hover { background: #ddd2fb; }
  .inst-soon { margin-left: 4px; padding: 1px 6px; border-radius: 999px; background: #ffffff14; font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase; color: #a89cc8; }
  .ph-export { position: relative; }
  .ph-menu { position: absolute; right: 0; top: calc(100% + 8px); z-index: 40; display: grid; gap: 2px; min-width: 210px; padding: 6px;
    border-radius: 12px; background: var(--color-canvas); border: 1px solid var(--color-hairline); box-shadow: 0 18px 40px -14px rgba(13, 0, 31, 0.5); }
  .ph-menu[hidden] { display: none; }
  .ph-menu button { display: grid; gap: 1px; padding: 9px 12px; border: 0; border-radius: 8px; background: none; text-align: left; cursor: pointer; color: var(--color-ink); }
  .ph-menu button:hover { background: var(--color-violet-soft); }
  .ph-menu b { font-size: 13.5px; font-weight: 650; }
  .ph-menu span { font-size: 12px; color: var(--color-mute); }
  .ph.is-compact { padding-top: 10px; }
  .ph.is-compact .ph-sub { display: none; }
  .ph.is-compact .ph-title h1 { font-size: 17px; }
  .ph-controls { display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; align-items: center; gap: 12px; margin-top: 10px; }
  .ph-tools { display: flex; overflow-x: auto; margin: 10px -6px 0; padding-top: 8px; border-top: 1px solid var(--color-hairline); scrollbar-width: none; }
  .ph-tool { padding: 6px 14px; min-width: 78px; }
  .ph-tool + .ph-tool { border-left: 1px solid var(--color-hairline); }
  .ph-tool-icon { font-size: 16px; line-height: 1; margin-bottom: 4px; }
  .ph-tool-label { margin-top: 2px; font-size: 9px; color: var(--color-mute); text-transform: uppercase; letter-spacing: 0.05em; }
  .ph-note::before { content: " · "; }
  .ph-note { color: var(--color-violet-text, var(--color-violet)); }
  .tl-tab .short { display: none; }
  .ph-tools::-webkit-scrollbar { display: none; }
  .ph-btn, .ph-play { display: grid; place-items: center; border: 0; border-radius: 50%; cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s, background-color 0.12s; }
  .ph-btn { width: 40px; height: 40px; background: var(--color-violet-soft); color: var(--color-violet-deep); }
  .ph-btn:hover { background: #ddd2fb; }
  .ph-play { width: 50px; height: 50px; color: var(--color-on-accent);
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep)); box-shadow: 0 10px 20px -8px rgba(245, 158, 11, 0.7); }
  .ph-play:hover { transform: scale(1.05); }
  .ph-btn:focus-visible, .ph-play:focus-visible, .ph-share:focus-visible, .pb:focus-visible, .gc:focus-visible, .gs-tag:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 2px; }
  .ph-track { min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .ph-row { display: flex; align-items: center; gap: 8px; font: 600 13px var(--font-mono); color: var(--color-body); }
  .ph-row select { max-width: 55%; padding: 3px 10px; border: 1px solid var(--color-hairline-strong); border-radius: 8px; background: var(--color-canvas);
    color: var(--color-ink); font: 600 12px/1.5 inherit; cursor: pointer; }
  .pb { display: flex; align-items: center; gap: 3px; height: 14px; cursor: pointer; touch-action: none; }
  .pb-seg { position: relative; height: 6px; border-radius: 3px; background: var(--color-hairline); overflow: hidden; transition: height 0.12s; }
  .pb:hover .pb-seg, .pb:focus-visible .pb-seg { height: 10px; }
  .pb-fill { position: absolute; inset: 0; transform: scaleX(0); transform-origin: left center; will-change: transform; background: linear-gradient(90deg, var(--color-violet), var(--color-violet-deep)); }
  .ph-total { font: 600 13px var(--font-mono); color: var(--color-mute); }

  /* Chords grid: flat cells, dark bar lines, the playing beat filled in, sections as slim coloured tabs */
  .grid-panel { background: #e9e6f0; }
  #chord-grid { padding: 46px 10px 55vh; }
  .gs { display: flex; margin-bottom: 10px; }
  .gs-tag { flex: 0 0 22px; padding: 8px 0; border: 0; border-radius: 0; color: var(--color-ink); cursor: pointer;
    writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; font: 600 11px/1 inherit; letter-spacing: 0.03em; }
  .gs-tag:hover { filter: brightness(0.95); }
  .grid-hide-tags .gs-tag { display: none; }
  .gs-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
  .gr { display: grid; grid-template-columns: repeat(var(--rb, 4), minmax(0, 1fr)); border-bottom: 1px solid #e3deee; }
  .gb { display: grid; grid-template-columns: repeat(var(--bpb, 4), minmax(0, 1fr)); background: #faf9fd; }
  .gb + .gb { border-left: 3px solid #4b4560; }
  .gb.is-current { background: #f3f0fc; }
