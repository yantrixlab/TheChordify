---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Play along — The Chordify">
  <Nav />
  <main id="main-content" class="gradient-mesh" style="min-height:100vh;padding:96px var(--space-lg) var(--space-3xl);">
    <div class="mx-auto" style="max-width:1180px;color:white;">
      <div id="loading-state" style="text-align:center;padding:80px 0;color:#c4b5fd;">
        Loading your song…
      </div>

      <div id="error-state" class="hidden" style="text-align:center;padding:80px 0;">
        <p style="color:var(--color-error);font-size:16px;margin-bottom:16px;" id="error-message"></p>
        <a href="/" style="color:var(--color-accent);text-decoration:underline;">Back to home</a>
      </div>

      <div id="player-state" class="hidden pl">
        <div class="pl-main">
          <!-- Player header: title, transport, section-aware progress bar and the toolbar, all sticky together -->
          <div id="player-header" class="ph">
            <div class="ph-head">
              <div class="ph-titles">
                <div class="ph-title">
                  <h1 id="song-title">Your song</h1>
                  <span id="song-artist" class="ph-by"></span>
                </div>
                <div id="song-sub" class="ph-sub">Transcription by TheChordify</div>
              </div>
              <button id="btn-share" type="button" class="ph-share">Share</button>
            </div>
            <div class="ph-controls">
              <button id="btn-restart" type="button" class="ph-btn" aria-label="Back to the start">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 5h2v14H6zM20 5v14L9 12z" fill="currentColor" /></svg>
              </button>
              <button id="btn-play" type="button" class="ph-play" aria-label="Play">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
              </button>
              <div class="ph-track">
                <div class="ph-row">
                  <span id="time-now">0:00</span>
                  <span aria-hidden="true">•</span>
                  <select id="section-select" aria-label="Jump to a section"></select>
                </div>
                <div id="progress" class="pb" role="slider" tabindex="0" aria-label="Song position" aria-valuemin="0" aria-valuenow="0"></div>
              </div>
              <div id="time-total" class="ph-total">0:00</div>
            </div>
          <div class="ph-tools">
            {
              [
                { id: "countin", label: "Count-in" },
                { id: "volume", label: "Volume" },
                { id: "loop", label: "Loop" },
                { id: "tempo", label: "Tempo" },
                { id: "capo", label: "Capo" },
                { id: "transpose", label: "Transpose" },
                { id: "sections", label: "Sections" },
                { id: "detail", label: "Chords" },
              ].map((tool, i) => (
                <div
                  class="flex flex-col items-center justify-center"
                  style={`padding:6px 14px;${i > 0 ? "border-left:1px solid var(--color-hairline);" : ""}min-width:78px;`}
                >
                  <div style="font-size:16px;line-height:1;margin-bottom:4px;" aria-hidden="true">
                    {tool.id === "volume" && "🔊"}
                    {tool.id === "loop" && "∞"}
                    {tool.id === "tempo" && "🐢"}
                    {tool.id === "capo" && "🪕"}
                    {tool.id === "transpose" && "♯"}
                    {tool.id === "countin" && "③"}
                    {tool.id === "sections" && "☰"}
                    {tool.id === "detail" && "♬"}
                  </div>
                  {tool.id === "volume" && (
                    <input
                      id="volume-slider"
                      type="range"
                      min="0"
                      max="100"
                      value="100"
                      style="width:64px;height:14px;"
                      aria-label="Volume"
                    />
                  )}
                  {tool.id === "loop" && (
                    <button
                      id="loop-toggle"
                      type="button"
                      aria-pressed="false"
                      style="font-size:11px;color:var(--color-body);background:none;border:none;cursor:pointer;font-weight:600;"
                    >
                      Off
                    </button>
                  )}
                  {tool.id === "tempo" && (
                    <div class="flex items-center gap-1">
                      <button id="tempo-down" type="button" aria-label="Slower" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">◂</button>
                      <span id="tempo-value" style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink);font-weight:600;min-width:34px;text-align:center;">100%</span>
                      <button id="tempo-up" type="button" aria-label="Faster" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">▸</button>
                    </div>
                  )}
                  {tool.id === "capo" && (
                    <div class="flex items-center gap-1">
                      <button id="capo-down" type="button" aria-label="Capo down" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">◂</button>
                      <span id="capo-value" style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink);font-weight:600;min-width:20px;text-align:center;">0</span>
                      <button id="capo-up" type="button" aria-label="Capo up" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">▸</button>
                    </div>
                  )}
                  {tool.id === "transpose" && (
                    <div class="flex items-center gap-1">
                      <button id="transpose-down" type="button" aria-label="Transpose down" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">◂</button>
                      <span id="transpose-value" style="font-family:var(--font-mono);font-size:11px;color:var(--color-ink);font-weight:600;min-width:24px;text-align:center;">0</span>
                      <button id="transpose-up" type="button" aria-label="Transpose up" style="background:none;border:none;cursor:pointer;color:var(--color-mute);font-size:12px;">▸</button>
                    </div>
                  )}
                  {tool.id === "countin" && (
                    <button id="countin-toggle" type="button" aria-pressed="false" style="font-size:11px;color:var(--color-body);background:none;border:none;cursor:pointer;font-weight:600;">Off</button>
                  )}
                  {tool.id === "sections" && (
                    <button id="sections-toggle" type="button" aria-pressed="true" style="font-size:11px;color:var(--color-violet);background:none;border:none;cursor:pointer;font-weight:600;">On</button>
                  )}
                  {tool.id === "detail" && (
                    <button id="detail-toggle" type="button" aria-pressed="false" style="font-size:11px;color:var(--color-body);background:none;border:none;cursor:pointer;font-weight:600;">Simple</button>
                  )}
                  <div style="font-size:9px;color:var(--color-mute);text-transform:uppercase;letter-spacing:0.05em;margin-top:2px;">{tool.label}</div>
                </div>
              ))
            }
          </div>

          </div>

          <!-- Views: Chords grid (every bar, grouped into sections) / Chord diagrams (timeline + sliding window) -->
          <div class="rounded-2xl tl-card">
            <div class="tl-tabs">
              <div class="tl-seg" role="group" aria-label="Chord view">
                <button id="view-tab-grid" type="button" class="tl-tab is-active" aria-pressed="true">Chords grid</button>
                <button id="view-tab-diagrams" type="button" class="tl-tab" aria-pressed="false">Chord diagrams</button>
              </div>
            </div>

            <div id="panel-grid" class="grid-panel">
              <div id="chord-grid"></div>
            </div>

            <!-- Chord diagrams: animated (timeline + sliding window) or a summary of every chord in the song -->
            <div id="panel-diagrams" class="hidden">
              <div class="dg-bar">
                <div class="tl-seg" role="group" aria-label="Diagram style">
                  <button id="dg-animated" type="button" class="tl-tab is-active" aria-pressed="true">Animated</button>
                  <button id="dg-summary" type="button" class="tl-tab" aria-pressed="false">Summary</button>
                </div>
              </div>
              <div id="dg-animated-panel">
              <div class="tl">
                <div class="tl-now">
                  <span class="tl-now-label">Now</span>
                  <strong id="timeline-now-chord">—</strong>
                </div>
                <div id="diagram-row-scroll" class="tl-scroll">
                  <div id="diagram-row" class="tl-track" role="list" aria-label="Chord timeline"></div>
                </div>
              </div>
              <div style="padding:24px;overflow-x:auto;">
                <div id="diagram-window" class="flex items-center gap-4" style="min-height:170px;"></div>
              </div>
              </div>
              <div id="dg-summary-panel" class="hidden">
                <div id="summary-grid" class="sum-grid"></div>
              </div>
            </div>
          </div>

        </div>

        <aside class="pl-side" aria-label="Video and song details">
          <div id="youtube-mount" class="side-card video-card hidden"></div>
          <div class="side-card now-card">
          <div class="flex items-center justify-center gap-2 mb-4 flex-wrap" role="group" aria-label="Instrument">
            {
              [
                { id: "guitar", label: "Guitar", icon: "🎸" },
                { id: "piano", label: "Piano", icon: "🎹" },
                { id: "ukulele", label: "Ukulele", icon: "🪗" },
                { id: "mandolin", label: "Mandolin", icon: "🎵" },
              ].map((inst, i) => (
                <button
                  type="button"
                  class="instrument-tab rounded-full font-medium"
                  data-inst={inst.id}
                  aria-pressed={i === 0 ? "true" : "false"}
                  style={`
                    height:32px;padding:0 14px;font-size:13px;cursor:pointer;
                    border:1px solid ${i === 0 ? "var(--color-accent)" : "#7c3aed44"};
                    background:${i === 0 ? "var(--color-accent)" : "transparent"};
                    color:${i === 0 ? "var(--color-on-accent)" : "#c4b5fd"};
                  `}
                >
                  <span aria-hidden="true">{inst.icon}</span> {inst.label}
                </button>
              ))
            }
          </div>

            <div style="font-family:var(--font-mono);font-size:11px;color:#8b7fa8;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:8px;">
              Now playing
            </div>
            <div id="current-chord" style="font-size:48px;font-weight:700;color:var(--color-accent);line-height:1;">—</div>
            <div id="current-chord-key" style="font-size:14px;color:#c4b5fd;margin-top:8px;"></div>

            <!-- Guitar diagram -->
            <div id="guitar-diagram" class="flex items-center justify-center gap-8 mt-4"></div>
            <!-- Notes fallback for piano/ukulele/mandolin -->
            <div id="notes-display" class="hidden mt-4" style="font-family:var(--font-mono);font-size:15px;color:#e0d7f5;"></div>
          </div>
          <div class="side-card details-card">
            <h2 class="sd-title">Song details</h2>
            <dl class="sd-list">
              <div><dt>Chords</dt><dd id="sd-chords" class="sd-chips"></dd></div>
              <div><dt>Key</dt><dd id="sd-key">—</dd></div>
              <div><dt>Tempo</dt><dd id="sd-tempo">—</dd></div>
              <div><dt>Sections</dt><dd id="sd-sections">—</dd></div>
              <div><dt>Transcription</dt><dd>TheChordify (automatic)</dd></div>
            </dl>
          </div>
        </aside>
        <audio id="audio-el" class="hidden" preload="metadata"></audio>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .tl-card { background: var(--color-canvas); border: 1px solid var(--color-hairline); overflow: clip;
    box-shadow: 0 1px 2px rgba(13, 0, 31, 0.04), 0 12px 32px -12px rgba(91, 33, 182, 0.18); }
  /* The view switch floats over the top-left of the content and stays put, just under the sticky header. */
  .tl-tabs { position: sticky; top: calc(72px + var(--ph-h, 190px) + 8px); z-index: 25; padding: 8px 10px; height: 0; overflow: visible; pointer-events: none; }
  .tl-tabs .tl-seg { pointer-events: auto; background: rgba(237, 233, 254, 0.92); backdrop-filter: blur(6px); box-shadow: 0 2px 8px -2px rgba(13, 0, 31, 0.25); }
  .dg-bar { padding: 10px 12px; display: flex; justify-content: flex-end; border-bottom: 1px solid var(--color-hairline); background: var(--color-canvas-soft); }
  .tl-seg { display: inline-flex; gap: 2px; padding: 3px; border-radius: 999px; background: var(--color-violet-soft); }
  .tl-tab { height: 32px; padding: 0 16px; border: 0; border-radius: 999px; background: transparent;
    color: var(--color-violet-deep); font-size: 13px; font-weight: 600; cursor: pointer;
    transition: background-color 0.15s, color 0.15s, box-shadow 0.15s; }
  .tl-tab:hover { color: var(--color-ink); }
  .tl-tab.is-active { background: var(--color-canvas); color: var(--color-ink); box-shadow: 0 1px 3px rgba(13, 0, 31, 0.14); }
  .tl-tab:focus-visible, .tl-chip:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 2px; }

  .tl { display: flex; align-items: stretch; border-bottom: 1px solid var(--color-hairline); background: var(--color-canvas); }
  .tl-now { flex: 0 0 auto; min-width: 96px; max-width: 150px; padding: 10px 16px; display: flex; flex-direction: column;
    justify-content: center; gap: 4px; position: relative; z-index: 1; color: var(--color-on-primary);
    background: linear-gradient(160deg, var(--color-primary), var(--color-primary-deep));
    box-shadow: 8px 0 18px -10px rgba(13, 0, 31, 0.6); }
  .tl-now-label { font: 600 10px/1 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: #a78bfa; }
  .tl-now strong { font-size: 26px; line-height: 1.1; color: var(--color-accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .tl-scroll { flex: 1 1 auto; min-width: 0; overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain;
    scrollbar-width: thin; scrollbar-color: var(--color-hairline-strong) transparent;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 40px), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 40px), transparent 100%); }
  .tl-track { position: relative; display: flex; gap: 6px; width: max-content; padding: 14px 40px 14px 16px; }

  .tl-chip { position: relative; flex: 0 0 auto; height: 62px; box-sizing: border-box; padding: 0 10px; display: flex;
    align-items: flex-end; padding-bottom: 12px; border: 1px solid var(--color-hairline); border-radius: 12px;
    background: var(--color-canvas); color: var(--color-ink); font-weight: 700; white-space: nowrap; cursor: pointer; overflow: hidden;
    transition: background-color 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.2s, opacity 0.2s; }
  .tl-chip:hover { border-color: var(--color-violet); }
  .tl-chip.is-past { opacity: 0.5; }
  .tl-chip.is-rest { border-style: dashed; background: transparent; color: var(--color-mute); }
  .tl-chip.is-active { opacity: 1; transform: translateY(-1px); border-color: var(--color-accent-deep); color: var(--color-on-accent);
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep));
    box-shadow: 0 8px 18px -6px rgba(245, 158, 11, 0.6); }
  .tl-bar { position: absolute; top: 6px; left: 9px; font: 600 10px/1 var(--font-mono); color: var(--color-mute); }
  .tl-chip.is-active .tl-bar { color: rgba(26, 5, 51, 0.65); }
  .tl-fill { position: absolute; left: 0; bottom: 0; height: 3px; width: calc(var(--p, 0) * 100%); background: rgba(26, 5, 51, 0.55);
    transition: width 0.25s linear; display: none; }
  .tl-chip.is-active .tl-fill { display: block; }

  @media (max-width: 520px) {
    .tl-now { min-width: 76px; padding: 8px 12px; }
    .tl-now strong { font-size: 21px; }
    .tl-chip { height: 56px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tl-chip, .tl-fill, .tl-tab { transition: none; }
  }

  /* Page layout: the player on the left, video + current chord + song details on the right */
  #player-state:not(.hidden) { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 24px; align-items: start; }
  .pl-main { min-width: 0; }
  .pl-side { position: sticky; top: 88px; max-height: calc(100vh - 104px); overflow-y: auto; scrollbar-width: thin;
    display: flex; flex-direction: column; gap: 16px; }
  .side-card { border-radius: 16px; overflow: hidden; flex: 0 0 auto; }
  .video-card { aspect-ratio: 16 / 9; background: #000; }
  .video-card iframe { width: 100% !important; height: 100% !important; display: block; }
  .now-card { background: #0d0019; border: 1px solid #7c3aed33; padding: 16px 14px 18px; text-align: center; }
  .details-card { background: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline); padding: 16px 18px; }
  .sd-title { margin: 0 0 12px; font-size: 15px; font-weight: 700; }
  .sd-list { margin: 0; display: grid; gap: 10px; }
  .sd-list > div { display: grid; grid-template-columns: 92px minmax(0, 1fr); align-items: center; gap: 8px; font-size: 14px; }
  .sd-list dt { font: 600 10px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-mute); }
  .sd-list dd { margin: 0; font-weight: 600; }
  .sd-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .sd-chip { padding: 3px 10px; border-radius: 999px; background: var(--color-violet-soft); color: var(--color-violet-deep); font-size: 13px; font-weight: 700; }

  /* Player header (sticky): title, transport, toolbar */
  .ph { position: sticky; top: 72px; z-index: 30; margin-bottom: 16px; padding: 14px 18px 8px; border-radius: 14px;
    background: var(--color-canvas); color: var(--color-ink); border: 1px solid var(--color-hairline);
    box-shadow: 0 14px 34px -16px rgba(13, 0, 31, 0.55); }
  .ph-head { display: flex; align-items: flex-start; gap: 12px; }
  .ph-titles { min-width: 0; flex: 1 1 auto; }
  .ph-title { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .ph-title h1 { margin: 0; font-size: 22px; font-weight: 700; line-height: 1.2; letter-spacing: -0.01em; }
  .ph-by { font-size: 14px; color: var(--color-mute); }
  .ph-sub { margin-top: 3px; font-size: 13px; color: var(--color-mute); }
  .ph-share { flex: 0 0 auto; height: 32px; padding: 0 14px; border: 0; border-radius: 999px; background: var(--color-violet-soft);
    color: var(--color-violet-deep); font-size: 13px; font-weight: 600; cursor: pointer; }
  .ph-share:hover { background: #ddd2fb; }
  .ph.is-compact { padding-top: 10px; }
  .ph.is-compact .ph-sub { display: none; }
  .ph.is-compact .ph-title h1 { font-size: 17px; }
  .ph-controls { display: grid; grid-template-columns: auto auto minmax(0, 1fr) auto; align-items: center; gap: 12px; margin-top: 10px; }
  .ph-tools { display: flex; overflow-x: auto; margin: 10px -6px 0; padding-top: 8px; border-top: 1px solid var(--color-hairline); scrollbar-width: none; }
  .ph-tools::-webkit-scrollbar { display: none; }
  .ph-btn, .ph-play { display: grid; place-items: center; border: 0; border-radius: 50%; cursor: pointer;
    transition: transform 0.12s, box-shadow 0.12s, background-color 0.12s; }
  .ph-btn { width: 40px; height: 40px; background: var(--color-violet-soft); color: var(--color-violet-deep); }
  .ph-btn:hover { background: #ddd2fb; }
  .ph-play { width: 50px; height: 50px; color: var(--color-on-accent);
    background: linear-gradient(135deg, var(--color-accent), var(--color-accent-deep)); box-shadow: 0 10px 20px -8px rgba(245, 158, 11, 0.7); }
  .ph-play:hover { transform: scale(1.05); }
  .ph-btn:focus-visible, .ph-play:focus-visible, .ph-share:focus-visible, .pb:focus-visible, .gc:focus-visible, .gs-tag:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 2px; }
  .ph-track { min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .ph-row { display: flex; align-items: center; gap: 8px; font: 600 13px var(--font-mono); color: var(--color-body); }
  .ph-row select { max-width: 55%; padding: 3px 10px; border: 1px solid var(--color-hairline-strong); border-radius: 8px; background: var(--color-canvas);
    color: var(--color-ink); font: 600 12px/1.5 inherit; cursor: pointer; }
  .pb { display: flex; align-items: center; gap: 3px; height: 14px; cursor: pointer; touch-action: none; }
  .pb-seg { position: relative; height: 6px; border-radius: 3px; background: var(--color-hairline); overflow: hidden; transition: height 0.12s; }
  .pb:hover .pb-seg, .pb:focus-visible .pb-seg { height: 10px; }
  .pb-fill { position: absolute; inset: 0 auto 0 0; width: 0; background: linear-gradient(90deg, var(--color-violet), var(--color-violet-deep)); }
  .ph-total { font: 600 13px var(--font-mono); color: var(--color-mute); }

  /* Chords grid: flat cells, dark bar lines, the playing beat filled in, sections as slim coloured tabs */
  .grid-panel { background: #e9e6f0; }
  #chord-grid { padding: 46px 10px 55vh; }
  .gs { display: flex; margin-bottom: 10px; }
  .gs-tag { flex: 0 0 22px; padding: 8px 0; border: 0; border-radius: 0; color: var(--color-ink); cursor: pointer;
    writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; font: 600 11px/1 inherit; letter-spacing: 0.03em; }
  .gs-tag:hover { filter: brightness(0.95); }
  .grid-hide-tags .gs-tag { display: none; }
  .gs-body { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
  .gr { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid #e3deee; }
  .gb { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); background: #faf9fd; }
  .gb + .gb { border-left: 3px solid #4b4560; }
  .gb.is-current { background: #f3f0fc; }
  .gc { min-width: 0; height: 44px; display: flex; align-items: center; padding: 0 3px 0 6px; border: 0; border-left: 1px solid #ece8f5;
    border-radius: 0; background: transparent; color: var(--color-ink); font-weight: 500; font-size: 20px; text-align: left;
    white-space: nowrap; overflow: hidden; cursor: pointer; transition: background-color 0.12s, color 0.12s; }
  .gb > .gc:first-child { border-left: 0; }
  .gc[data-len="3"] { font-size: 17px; }
  .gc[data-len="4"] { font-size: 14px; }
  .gc[data-len="5"] { font-size: 12px; }
  .gc[data-len="6"] { font-size: 10.5px; }
  .gc:hover { background: #ebe6fa; }
  .gc.is-empty { background: transparent; cursor: default; }
  .gc.is-rest { color: var(--color-mute); font-weight: 400; }
  .gc.is-active { background: #2d2a3a; color: #fff; border-radius: 3px; }
  .gc.is-silence { font-family: "Segoe UI Symbol", "Noto Music", "Apple Symbols", sans-serif; font-size: 22px; font-weight: 400; color: var(--color-mute); }

  /* Chord diagrams: summary of every chord used in the song */
  .sum-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 14px; padding: 20px; justify-items: center; }

  @media (max-width: 1000px) {
    #player-state:not(.hidden) { grid-template-columns: minmax(0, 1fr); }
    .pl-side { position: static; max-height: none; overflow: visible; }
    .video-card { max-width: 560px; width: 100%; }
  }
  @media (max-width: 640px) {
    .ph { top: 64px; padding: 10px 12px 6px; border-radius: 12px; }
    .ph-title h1 { font-size: 18px; }
    .ph-share { height: 30px; padding: 0 10px; font-size: 12px; }
    .ph-controls { gap: 8px; }
    .ph-btn { width: 36px; height: 36px; }
    .ph-play { width: 44px; height: 44px; }
    .ph.is-compact .ph-tools { display: none; }
    .tl-tabs { top: calc(64px + var(--ph-h, 150px) + 6px); }
    #chord-grid { padding: 44px 6px 55vh; }
    .gs { flex-direction: column; gap: 0; }
    .gs-tag { flex: 0 0 auto; align-self: flex-start; padding: 4px 12px; writing-mode: horizontal-tb; transform: none; }
    .gr { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .gb:nth-child(odd) { border-left: 0; }
    .gc { height: 40px; padding: 0 2px 0 4px; font-size: 16px; }
    .gc[data-len="3"] { font-size: 13px; }
    .gc[data-len="4"] { font-size: 11.5px; }
    .gc[data-len="5"] { font-size: 10.5px; }
    .gc[data-len="6"] { font-size: 9.5px; }
  }
</style>

<script>
  import { getGuitarShape, chordNotes, chordKeyLabel, transposeChord, type GuitarShape } from "../lib/chordShapes";
  import { API_BASE, type ExtractResult, type ChordSegment, type Bar, type Section } from "../lib/api";

  const params = new URLSearchParams(window.location.search);
  const sessionId = params.get("session");

  const loadingState = document.getElementById("loading-state")!;
  const errorState = document.getElementById("error-state")!;
  const errorMessage = document.getElementById("error-message")!;
  const playerState = document.getElementById("player-state")!;
  const youtubeMount = document.getElementById("youtube-mount")!;
  const audioEl = document.getElementById("audio-el") as HTMLAudioElement;
  const currentChordEl = document.getElementById("current-chord")!;
  const currentChordKeyEl = document.getElementById("current-chord-key")!;
  const guitarDiagramEl = document.getElementById("guitar-diagram")!;
  const notesDisplayEl = document.getElementById("notes-display")!;
  const viewTabDiagrams = document.getElementById("view-tab-diagrams") as HTMLButtonElement;
  const viewTabGrid = document.getElementById("view-tab-grid") as HTMLButtonElement;
  const panelDiagrams = document.getElementById("panel-diagrams")!;
  const panelGrid = document.getElementById("panel-grid")!;
  const diagramRowEl = document.getElementById("diagram-row")!;
  const diagramRowScrollEl = document.getElementById("diagram-row-scroll")!;
  const diagramWindowEl = document.getElementById("diagram-window")!;
  const chordGridEl = document.getElementById("chord-grid")!;

  const volumeSlider = document.getElementById("volume-slider") as HTMLInputElement;
  const loopToggle = document.getElementById("loop-toggle") as HTMLButtonElement;
  const tempoDown = document.getElementById("tempo-down") as HTMLButtonElement;
  const tempoUp = document.getElementById("tempo-up") as HTMLButtonElement;
  const tempoValueEl = document.getElementById("tempo-value")!;
  const capoDown = document.getElementById("capo-down") as HTMLButtonElement;
  const capoUp = document.getElementById("capo-up") as HTMLButtonElement;
  const capoValueEl = document.getElementById("capo-value")!;
  const transposeDown = document.getElementById("transpose-down") as HTMLButtonElement;
  const transposeUp = document.getElementById("transpose-up") as HTMLButtonElement;
  const transposeValueEl = document.getElementById("transpose-value")!;
  const countInToggle = document.getElementById("countin-toggle") as HTMLButtonElement;
  const sectionsToggle = document.getElementById("sections-toggle") as HTMLButtonElement;
  const detailToggle = document.getElementById("detail-toggle") as HTMLButtonElement;

  const headerEl = document.getElementById("player-header")!;
  const songTitleEl = document.getElementById("song-title")!;
  const songArtistEl = document.getElementById("song-artist")!;
  const songSubEl = document.getElementById("song-sub")!;
  const btnPlay = document.getElementById("btn-play") as HTMLButtonElement;
  const btnRestart = document.getElementById("btn-restart") as HTMLButtonElement;
  const timeNowEl = document.getElementById("time-now")!;
  const timeTotalEl = document.getElementById("time-total")!;
  const progressEl = document.getElementById("progress")!;
  const sectionSelect = document.getElementById("section-select") as HTMLSelectElement;
  const btnShare = document.getElementById("btn-share") as HTMLButtonElement;
  const sdChipsEl = document.getElementById("sd-chords")!;
  const sdKeyEl = document.getElementById("sd-key")!;
  const sdTempoEl = document.getElementById("sd-tempo")!;
  const sdSectionsEl = document.getElementById("sd-sections")!;
  const dgAnimated = document.getElementById("dg-animated") as HTMLButtonElement;
  const dgSummary = document.getElementById("dg-summary") as HTMLButtonElement;
  const dgAnimatedPanel = document.getElementById("dg-animated-panel")!;
  const dgSummaryPanel = document.getElementById("dg-summary-panel")!;
  const summaryGridEl = document.getElementById("summary-grid")!;

  const SEMITONE_NAMES = ["0", "+1", "+2", "+3", "+4", "+5", "+6", "-5", "-4", "-3", "-2", "-1"];
  const BARS_PER_ROW = 4; // bars per row in the chords grid
  const WINDOW_BEFORE = 1; // chords shown before "now playing" in the sliding window
  const WINDOW_AFTER = 4; // chords shown after

  let activeInstrument = "guitar";
  let chords: ChordSegment[] = []; // the set being shown: simple (core chords) or detailed
  let chordsSimple: ChordSegment[] = [];
  let chordsDetailed: ChordSegment[] = [];
  let sections: Section[] = [];
  let chordEvents: { chordIndex: number; chord: string; start: number }[] = [];
  let bars: Bar[] = [];
  let duration = 0;
  let tempo = 120;
  let songKey = ""; // estimated key of the song, e.g. "G" or "F#m"
  let lastActiveIndex = -1;
  let loopEnabled = false;
  let tempoPct = 100;
  let capo = 0;
  let transposeSteps = 0;
  let activeView: "diagrams" | "grid" = "grid";

  function semitoneLabel(n: number): string {
    const wrapped = ((n % 12) + 12) % 12;
    return SEMITONE_NAMES[wrapped];
  }

  /** The chord as the player should sing/call it (after Transpose). */
  function displayChord(rawChord: string): string {
    return transposeChord(rawChord, transposeSteps);
  }

  /** The shape to actually finger on the instrument (after Transpose, undone by Capo). */
  function fingeringChord(rawChord: string): string {
    return transposeChord(rawChord, transposeSteps - capo);
  }

  function fail(message: string) {
    loadingState.classList.add("hidden");
    errorState.classList.remove("hidden");
    errorMessage.textContent = message;
  }

  /** Find which chord segment is sounding at time `t` (binary-search-free, fine at this size). */
  function chordAt(t: number): string {
    const seg = chords.find((s) => t >= s.start && t < s.end);
    return seg ? seg.chord : "N";
  }

  /** Rebuilds the ordered list of actual chord changes (skipping silence), each
   *  pointing back at its index in `chords` so we can seek/highlight correctly. */
  function buildChordEvents() {
    chordEvents = [];
    chords.forEach((seg, i) => {
      if (seg.chord === "N") return;
      chordEvents.push({ chordIndex: i, chord: seg.chord, start: seg.start });
    });
  }

  /** "Chord diagrams" tab, lower section: a larger sliding window — just-played
   *  chord dimmed, the chord now playing highlighted, then upcoming chords. */
  function renderDiagramWindow() {
    diagramWindowEl.innerHTML = "";
    if (chordEvents.length === 0) return;

    const eventPos = Math.max(
      0,
      chordEvents.findIndex((e) => e.chordIndex === lastActiveIndex),
    );
    const from = Math.max(0, eventPos - WINDOW_BEFORE);
    const to = Math.min(chordEvents.length, eventPos + WINDOW_AFTER + 1);

    for (let pos = from; pos < to; pos++) {
      const event = chordEvents[pos];
      const isCurrent = pos === eventPos;
      const isPast = pos < eventPos;

      const fChord = fingeringChord(event.chord);
      const shape = getGuitarShape(fChord);
      const card = shape ? buildFretDiagram(fChord, shape, 1) : buildNoteFallbackCard(fChord);
      card.dataset.chordIndex = String(event.chordIndex);
      card.style.flexShrink = "0";
      card.style.cursor = "pointer";
      card.style.opacity = isPast ? "0.45" : "1";
      card.style.outline = isCurrent ? "3px solid var(--color-accent)" : "3px solid transparent";
      card.style.boxShadow = isCurrent
        ? "0 0 0 1px var(--color-accent), 0 4px 12px var(--color-accent)44"
        : "none";
      card.addEventListener("click", () => seekTo(event.start));
      diagramWindowEl.appendChild(card);
    }
  }

  // ---- Chord timeline: the strip at the top of the "Chord diagrams" tab ----------------------------
  const PX_PER_BEAT = 46;
  const timelineNowEl = document.getElementById("timeline-now-chord")!;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let timelineChips: HTMLButtonElement[] = [];
  let timelineActive = -1;
  let timelineUserBusyUntil = 0; // while the person is scrolling the strip themselves, don't fight them

  function formatClock(t: number): string {
    return `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, "0")}`;
  }

  /** One card per chord, as wide as the chord lasts, with the bar number where a bar begins. */
  function renderDiagramRow() {
    diagramRowEl.innerHTML = "";
    timelineChips = [];
    timelineActive = -1;
    if (chords.length === 0) return;

    const pxPerSec = (PX_PER_BEAT * tempo) / 60;
    const barStarts = bars.map((b) => b.start);
    let nextBar = 0;

    chords.forEach((seg) => {
      const isRest = seg.chord === "N";
      const label = isRest ? "" : displayChord(seg.chord);

      while (nextBar < barStarts.length && barStarts[nextBar] < seg.start - 0.12) nextBar++;
      const startsBar = nextBar < barStarts.length && Math.abs(barStarts[nextBar] - seg.start) <= 0.12;
      const barNumber = startsBar ? nextBar + 1 : 0;

      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = isRest ? "tl-chip is-rest" : "tl-chip";
      chip.setAttribute("role", "listitem");
      chip.setAttribute("aria-label", isRest ? `Rest at ${formatClock(seg.start)}` : `${label} at ${formatClock(seg.start)}`);
      chip.style.width = `${Math.max(isRest ? 34 : 58, (seg.end - seg.start) * pxPerSec - 6)}px`;
      chip.style.fontSize = label.length > 7 ? "12px" : label.length > 4 ? "15px" : "19px";

      if (barNumber) {
        const bar = document.createElement("span");
        bar.className = "tl-bar";
        bar.textContent = String(barNumber);
        chip.appendChild(bar);
      }
      const name = document.createElement("span");
      name.textContent = isRest ? "·" : label;
      chip.appendChild(name);
      const fill = document.createElement("span");
      fill.className = "tl-fill";
      chip.appendChild(fill);

      chip.addEventListener("click", () => seekTo(seg.start));
      diagramRowEl.appendChild(chip);
      timelineChips.push(chip);
    });
  }

  // Manual scrolling pauses auto-follow for a moment (programmatic scrolls fire none of these).
  ["wheel", "pointerdown", "touchstart", "keydown"].forEach((type) =>
    diagramRowScrollEl.addEventListener(type, () => (timelineUserBusyUntil = performance.now() + 2500), { passive: true }),
  );

  /** Scrolls the strip so the playing chord sits about a quarter in, with what's coming next to its right. */
  function followActiveChip(chip: HTMLElement) {
    diagramRowScrollEl.scrollTo({
      left: Math.max(0, chip.offsetLeft - diagramRowScrollEl.clientWidth * 0.22),
      behavior: reducedMotion ? "auto" : "smooth",
    });
  }

  /** Is the chip's start comfortably on screen, with room to its right to see what comes next? */
  function chipInComfortZone(chip: HTMLElement): boolean {
    const left = chip.offsetLeft - diagramRowScrollEl.scrollLeft;
    return left >= 8 && left <= diagramRowScrollEl.clientWidth * 0.55;
  }

  /** Marks the playing chord, fills its progress bar and keeps it on screen. Called every tick. */
  function highlightDiagramRow(currentTime: number) {
    const index = chords.findIndex((s) => currentTime >= s.start && currentTime < s.end);
    if (index === -1 || timelineChips.length === 0) return;
    const chip = timelineChips[index];
    const seg = chords[index];

    if (index !== timelineActive) {
      timelineChips.forEach((c, i) => {
        c.classList.toggle("is-active", i === index);
        c.classList.toggle("is-past", i < index);
        if (i === index) c.setAttribute("aria-current", "true");
        else c.removeAttribute("aria-current");
      });
      timelineActive = index;
      timelineNowEl.textContent = seg.chord === "N" ? "—" : displayChord(seg.chord);
    }

    const fraction = (currentTime - seg.start) / Math.max(seg.end - seg.start, 0.001);
    chip.style.setProperty("--p", String(Math.min(1, Math.max(0, fraction))));

    // The check runs every tick (not just on chord changes), so a chord that slips out of view for any
    // reason — a seek, a resize, the end of a manual scroll — is brought back.
    if (performance.now() >= timelineUserBusyUntil && !chipInComfortZone(chip)) followActiveChip(chip);
  }

  function buildNoteFallbackCard(fChord: string): HTMLElement {
    const card = document.createElement("div");
    card.style.boxSizing = "border-box";
    card.style.width = "114px";
    card.style.display = "flex";
    card.style.flexDirection = "column";
    card.style.alignItems = "center";
    card.style.justifyContent = "center";
    card.style.background = "var(--color-canvas)";
    card.style.border = "1px solid var(--color-hairline)";
    card.style.borderRadius = "10px";
    card.style.padding = "16px 10px";
    card.style.textAlign = "center";
    card.innerHTML = `<div style="font-weight:700;font-size:14px;color:var(--color-ink);margin-bottom:6px;">${fChord}</div><div style="font-size:11px;color:var(--color-mute);">${chordNotes(fChord).join(", ")}</div>`;
    return card;
  }

  // ---- Player header: title, play/pause and a progress bar that is split into the song's sections --------
  const ICON_PLAY = '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>';
  const ICON_PAUSE = '<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z" fill="currentColor"/></svg>';
  let progressSegs: { fill: HTMLElement; start: number; end: number }[] = [];
  let currentSectionIdx = -1;

  function setPlayingUi(playing: boolean) {
    if (playing) {
      lastFollowedRow = null; // re-centre the grid on the playing row as soon as playback starts
      gridActive = -1;
    }
    btnPlay.innerHTML = playing ? ICON_PAUSE : ICON_PLAY;
    btnPlay.setAttribute("aria-label", playing ? "Pause" : "Play");
  }

  /** One progress segment (and one "jump to" option) per section; a single one when there are none. */
  function renderProgress() {
    progressEl.innerHTML = "";
    sectionSelect.innerHTML = "";
    progressSegs = [];
    currentSectionIdx = -1;
    const parts = sections.length > 0 ? sections : [{ label: "Song", start: 0, end: duration }];

    parts.forEach((part, i) => {
      const seg = document.createElement("div");
      seg.className = "pb-seg";
      seg.style.flex = `${Math.max(part.end - part.start, 0.5)} 1 0`;
      seg.title = part.label;
      const fill = document.createElement("div");
      fill.className = "pb-fill";
      seg.appendChild(fill);
      progressEl.appendChild(seg);
      progressSegs.push({ fill, start: part.start, end: part.end });

      const option = document.createElement("option");
      option.value = String(i);
      option.textContent = part.label;
      sectionSelect.appendChild(option);
    });
    sectionSelect.hidden = sections.length === 0;
    progressEl.setAttribute("aria-valuemax", String(Math.round(duration)));
    timeTotalEl.textContent = formatClock(duration);
  }

  /** Time label, progress fills and the section picker. Cheap enough to run every frame. */
  function updateTransport(t: number) {
    timeNowEl.textContent = formatClock(t);
    progressEl.setAttribute("aria-valuenow", String(Math.round(t)));
    let current = -1;
    progressSegs.forEach((seg, i) => {
      const fraction = Math.min(1, Math.max(0, (t - seg.start) / Math.max(seg.end - seg.start, 0.001)));
      seg.fill.style.width = `${fraction * 100}%`;
      if (t >= seg.start && t < seg.end) current = i;
    });
    if (current !== -1 && current !== currentSectionIdx) {
      currentSectionIdx = current;
      sectionSelect.value = String(current);
    }
  }

  /** Click or tap on the progress bar: jump to that point inside whichever section was hit. */
  function seekFromProgress(event: PointerEvent) {
    const segEls = Array.from(progressEl.children) as HTMLElement[];
    const index = segEls.findIndex((el) => {
      const r = el.getBoundingClientRect();
      return event.clientX >= r.left - 1.5 && event.clientX <= r.right + 1.5;
    });
    if (index === -1) return;
    const r = segEls[index].getBoundingClientRect();
    const fraction = Math.min(1, Math.max(0, (event.clientX - r.left) / Math.max(r.width, 1)));
    const seg = progressSegs[index];
    seekTo(seg.start + fraction * (seg.end - seg.start));
  }

  // ---- Chords grid: every bar of the song, grouped into sections ---------------------------------------
  const BEAT_CELLS = 4;
  interface GridCell {
    el: HTMLElement;
    start: number;
    bar: HTMLElement;
    row: HTMLElement;
  }
  let gridCells: GridCell[] = [];
  let gridActive = -1;
  let gridFollowPausedUntil = 0; // while the person scrolls the page themselves, don't fight them

  const SECTION_COLORS: Record<string, string> = {
    silence: "#e5e7eb",
    intro: "#fde68a",
    verse: "#bfdbfe",
    chorus: "#bbf7d0",
    bridge: "#fed7aa",
    outro: "#e9d5ff",
  };
  const PART_COLORS = ["#c7d2fe", "#fbcfe8", "#a7f3d0", "#fde68a", "#bae6fd", "#fecaca"];

  function sectionColor(label: string): string {
    const kind = label.split(" ")[0].toLowerCase();
    if (SECTION_COLORS[kind]) return SECTION_COLORS[kind];
    const letter = label.startsWith("Part ") ? label.charCodeAt(5) - 65 : 0;
    return PART_COLORS[((letter % PART_COLORS.length) + PART_COLORS.length) % PART_COLORS.length];
  }

  function firstNumber(values: (number | null)[]): number | null {
    for (const v of values) if (v !== null) return v;
    return null;
  }

  /** Sections as colour-coded blocks; each row is four bars, each bar four beat cells. A chord is written in the
   *  cell of the beat it starts on and left blank while it keeps ringing; the playing beat is filled in. */
  function renderChordGrid() {
    chordGridEl.innerHTML = "";
    gridCells = [];
    gridActive = -1;
    if (bars.length === 0) return;

    const blocks: Section[] =
      sections.length > 0
        ? sections
        : [{ label: "", start: bars[0].start, end: duration, startBar: 0, endBar: bars.length - 1 }];
    const firstReal = blocks.findIndex((sec) => sec.startBar !== null);
    let lastReal = -1;
    blocks.forEach((sec, i) => {
      if (sec.startBar !== null) lastReal = i;
    });

    let next = 0; // next chord segment not yet placed; cells and chords are both in time order
    const makeCell = (label: string, kind: string): HTMLButtonElement => {
      const cell = document.createElement("button");
      cell.type = "button";
      cell.className = `gc ${kind}`.trim();
      if (label) {
        cell.textContent = label;
        cell.title = label;
        cell.dataset.len = String(Math.min(label.length, 6)); // CSS shrinks long names to fit the cell
      }
      return cell;
    };

    blocks.forEach((section, si) => {
      const block = document.createElement("section");
      block.className = "gs";
      if (section.label) {
        const tag = document.createElement("button");
        tag.type = "button";
        tag.className = "gs-tag";
        tag.textContent = section.label;
        tag.style.background = sectionColor(section.label);
        tag.setAttribute("aria-label", `Go to ${section.label}`);
        tag.addEventListener("click", () => seekTo(section.start));
        block.appendChild(tag);
      }
      const body = document.createElement("div");
      body.className = "gs-body";
      block.appendChild(body);

      if (section.startBar === null) {
        // Silence before the music starts: one rest cell.
        const row = document.createElement("div");
        row.className = "gr";
        const bar = document.createElement("div");
        bar.className = "gb";
        const cell = makeCell("𝄽", "is-silence");
        cell.addEventListener("click", () => seekTo(section.start));
        bar.appendChild(cell);
        row.appendChild(bar);
        body.appendChild(row);
        gridCells.push({ el: cell, start: section.start, bar, row });
        chordGridEl.appendChild(block);
        return;
      }

      // Bars before the first / after the last section (a pickup, a short final bar) belong to those sections.
      const hasSilence = blocks[0].startBar === null;
      const from = si === firstReal && !hasSilence ? 0 : (section.startBar as number);
      const to = si === lastReal ? bars.length - 1 : (section.endBar as number);

      for (let rowStart = from; rowStart <= to; rowStart += BARS_PER_ROW) {
        const row = document.createElement("div");
        row.className = "gr";
        for (let b = rowStart; b < Math.min(rowStart + BARS_PER_ROW, to + 1); b++) {
          const bar = document.createElement("div");
          bar.className = "gb";
          const beats = bars[b].beats;
          for (let k = 0; k < BEAT_CELLS; k++) {
            const t0 = beats[k];
            if (t0 === null) {
              const empty = makeCell("", "is-empty");
              empty.disabled = true;
              bar.appendChild(empty);
              continue;
            }
            const t1 = firstNumber(beats.slice(k + 1)) ?? duration;
            const half = Math.max(t1 - t0, 0.05) / 2;
            while (next < chords.length && chords[next].start < t0 - half) next++;
            let cell: HTMLButtonElement;
            if (next < chords.length && chords[next].start < t0 + half) {
              const seg = chords[next++];
              cell = seg.chord === "N" ? makeCell("—", "is-rest") : makeCell(displayChord(seg.chord), "");
            } else {
              cell = makeCell("", "");
            }
            cell.addEventListener("click", () => seekTo(t0));
            bar.appendChild(cell);
            gridCells.push({ el: cell, start: t0, bar, row });
          }
          row.appendChild(bar);
        }
        body.appendChild(row);
      }
      chordGridEl.appendChild(block);
    });
  }

  /** Keeps the playing row at one fixed spot just under the header (like a teleprompter): the grid scrolls up
   *  by a row each time playback moves to the next one. */
  let lastFollowedRow: HTMLElement | null = null;
  function followGridRow(row: HTMLElement) {
    if (row === lastFollowedRow) return;
    lastFollowedRow = row;
    const target = headerEl.getBoundingClientRect().bottom + 72;
    const delta = row.getBoundingClientRect().top - target;
    if (Math.abs(delta) < 4) return;
    window.scrollTo({ top: window.scrollY + delta, behavior: reducedMotion ? "auto" : "smooth" });
  }

  ["wheel", "touchmove"].forEach((type) =>
    window.addEventListener(type, () => (gridFollowPausedUntil = performance.now() + 4000), { passive: true }),
  );
  window.addEventListener("keydown", (e) => {
    if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End"].includes(e.code)) {
      gridFollowPausedUntil = performance.now() + 4000;
    }
  });

  /** Fills in the beat cell that is playing. */
  function highlightChordGrid(t: number) {
    if (gridCells.length === 0) return;
    let lo = 0;
    let hi = gridCells.length - 1;
    let index = -1;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (gridCells[mid].start <= t) {
        index = mid;
        lo = mid + 1;
      } else {
        hi = mid - 1;
      }
    }
    if (index === gridActive) return;
    if (gridActive >= 0) {
      gridCells[gridActive].el.classList.remove("is-active");
      gridCells[gridActive].bar.classList.remove("is-current");
    }
    gridActive = index;
    if (index < 0) return;
    const cell = gridCells[index];
    cell.el.classList.add("is-active");
    cell.bar.classList.add("is-current");
    if (activeView === "grid" && isPlaying() && performance.now() >= gridFollowPausedUntil) followGridRow(cell.row);
  }

  function renderInstrumentView(rawChord: string) {
    guitarDiagramEl.innerHTML = "";
    notesDisplayEl.classList.add("hidden");
    guitarDiagramEl.classList.add("hidden");

    if (rawChord === "N") {
      return;
    }

    const fChord = fingeringChord(rawChord);

    if (activeInstrument === "guitar") {
      const shape = getGuitarShape(fChord);
      guitarDiagramEl.classList.remove("hidden");
      if (!shape) {
        notesDisplayEl.classList.remove("hidden");
        notesDisplayEl.textContent = `No diagram available. Notes: ${chordNotes(fChord).join(", ")}`;
        return;
      }
      guitarDiagramEl.appendChild(buildFretDiagram(fChord, shape, 1.2));
    } else {
      notesDisplayEl.classList.remove("hidden");
      const label = activeInstrument.charAt(0).toUpperCase() + activeInstrument.slice(1);
      notesDisplayEl.textContent = `${label} notes: ${chordNotes(fChord).join(" – ")}`;
    }
  }

  /**
   * Builds a real fretboard diagram (strings, frets, barre bars, finger dots) out of
   * plain divs — no SVG. Detects barres by finding 2+ strings sharing the same
   * finger at the same fret row and drawing one bar across them instead of
   * separate dots, matching standard chord-chart conventions.
   */
  function buildFretDiagram(label: string, shape: GuitarShape, scale = 1): HTMLElement {
    const W = 90 * scale;
    const GRID_H = 100 * scale;
    const ROWS = 4;
    const colX = (i: number) => (W * i) / 5;
    const rowY = (r: number) => (GRID_H * r) / ROWS;

    const wrap = document.createElement("div");
    wrap.style.boxSizing = "border-box";
    wrap.style.display = "flex";
    wrap.style.flexDirection = "column";
    wrap.style.alignItems = "center";
    wrap.style.justifyContent = "center";
    wrap.style.width = `${W + 24 * scale}px`;
    wrap.style.height = "100%";
    wrap.style.background = "var(--color-canvas)";
    wrap.style.border = "1px solid var(--color-hairline)";
    wrap.style.borderRadius = "10px";
    wrap.style.boxShadow = "0 1px 2px rgba(13, 0, 31, 0.06)";
    wrap.style.padding = `${10 * scale}px`;

    const baseFret = shape.baseFret ?? 1;

    const markerRow = document.createElement("div");
    markerRow.style.position = "relative";
    markerRow.style.width = `${W}px`;
    markerRow.style.height = `${14 * scale}px`;
    markerRow.style.marginLeft = `${12 * scale}px`;
    shape.frets.forEach((fret, i) => {
      if (fret !== "x" && fret !== "0") return;
      const marker = document.createElement("div");
      marker.textContent = fret === "x" ? "×" : "○";
      marker.style.position = "absolute";
      marker.style.left = `${colX(i)}px`;
      marker.style.top = "0";
      marker.style.transform = "translateX(-50%)";
      marker.style.fontSize = `${11 * scale}px`;
      marker.style.color = fret === "x" ? "var(--color-error)" : "var(--color-ink)";
      markerRow.appendChild(marker);
    });
    wrap.appendChild(markerRow);

    const gridWrap = document.createElement("div");
    gridWrap.style.position = "relative";
    gridWrap.style.width = `${W + 24 * scale}px`;
    gridWrap.style.height = `${GRID_H}px`;

    const grid = document.createElement("div");
    grid.style.position = "absolute";
    grid.style.left = `${12 * scale}px`;
    grid.style.top = "0";
    grid.style.width = `${W}px`;
    grid.style.height = `${GRID_H}px`;
    gridWrap.appendChild(grid);

    // Nut (thick top line) when the diagram starts at fret 1, otherwise a thin
    // top line plus the starting fret number written beside row 1.
    const nut = document.createElement("div");
    nut.style.position = "absolute";
    nut.style.left = "0";
    nut.style.top = "0";
    nut.style.width = `${W}px`;
    nut.style.height = baseFret === 1 ? "3px" : "1px";
    nut.style.background = "var(--color-ink)";
    grid.appendChild(nut);

    if (baseFret > 1) {
      const posLabel = document.createElement("div");
      posLabel.textContent = String(baseFret);
      posLabel.style.position = "absolute";
      posLabel.style.left = `-${10 * scale}px`;
      posLabel.style.top = `${rowY(0) + (GRID_H / ROWS) / 2 - 6 * scale}px`;
      posLabel.style.fontSize = `${11 * scale}px`;
      posLabel.style.color = "var(--color-mute)";
      grid.appendChild(posLabel);
    }

    // String (vertical) lines.
    for (let i = 0; i < 6; i++) {
      const line = document.createElement("div");
      line.style.position = "absolute";
      line.style.left = `${colX(i)}px`;
      line.style.top = "0";
      line.style.width = "1px";
      line.style.height = `${GRID_H}px`;
      line.style.background = "var(--color-hairline-strong)";
      grid.appendChild(line);
    }
    // Fret (horizontal) lines.
    for (let r = 1; r <= ROWS; r++) {
      const line = document.createElement("div");
      line.style.position = "absolute";
      line.style.left = "0";
      line.style.top = `${rowY(r)}px`;
      line.style.width = `${W}px`;
      line.style.height = "1px";
      line.style.background = "var(--color-hairline)";
      grid.appendChild(line);
    }

    // Collect fretted positions, then group by (row, finger) to detect barres.
    type Pos = { string: number; row: number; finger: string };
    const positions: Pos[] = [];
    shape.frets.forEach((fret, i) => {
      if (fret === "x" || fret === "0") return;
      const row = parseInt(fret, 10) - baseFret + 1;
      if (row < 1 || row > ROWS) return;
      positions.push({ string: i, row, finger: shape.fingers[i] || "" });
    });

    const groups = new Map<string, Pos[]>();
    positions.forEach((p) => {
      const key = `${p.row}-${p.finger}`;
      const arr = groups.get(key) || [];
      arr.push(p);
      groups.set(key, arr);
    });

    const dotSize = 18 * scale;
    groups.forEach((group) => {
      const rowCenter = rowY(group[0].row) - (GRID_H / ROWS) / 2;
      if (group.length >= 2 && group[0].finger) {
        const minString = Math.min(...group.map((p) => p.string));
        const maxString = Math.max(...group.map((p) => p.string));
        const bar = document.createElement("div");
        bar.style.position = "absolute";
        bar.style.left = `${colX(minString)}px`;
        bar.style.top = `${rowCenter - dotSize / 2}px`;
        bar.style.width = `${colX(maxString) - colX(minString)}px`;
        bar.style.height = `${dotSize}px`;
        bar.style.background = "var(--color-ink)";
        bar.style.borderRadius = `${dotSize / 2}px`;
        grid.appendChild(bar);

        [minString, maxString].forEach((stringIdx) => {
          const finger = document.createElement("div");
          finger.textContent = group[0].finger;
          finger.style.position = "absolute";
          finger.style.left = `${colX(stringIdx)}px`;
          finger.style.top = `${rowCenter}px`;
          finger.style.transform = "translate(-50%, -50%)";
          finger.style.color = "white";
          finger.style.fontSize = `${10 * scale}px`;
          finger.style.fontWeight = "700";
          grid.appendChild(finger);
        });
      } else {
        group.forEach((p) => {
          const dot = document.createElement("div");
          dot.textContent = p.finger;
          dot.style.position = "absolute";
          dot.style.left = `${colX(p.string)}px`;
          dot.style.top = `${rowCenter}px`;
          dot.style.transform = "translate(-50%, -50%)";
          dot.style.width = `${dotSize}px`;
          dot.style.height = `${dotSize}px`;
          dot.style.borderRadius = "50%";
          dot.style.background = "var(--color-ink)";
          dot.style.color = "white";
          dot.style.fontSize = `${10 * scale}px`;
          dot.style.fontWeight = "700";
          dot.style.display = "flex";
          dot.style.alignItems = "center";
          dot.style.justifyContent = "center";
          grid.appendChild(dot);
        });
      }
    });

    wrap.appendChild(gridWrap);

    const labelEl = document.createElement("div");
    labelEl.textContent = label;
    labelEl.style.marginTop = `${6 * scale}px`;
    labelEl.style.fontWeight = "700";
    labelEl.style.fontSize = `${14 * scale}px`;
    labelEl.style.color = "var(--color-ink)";
    wrap.appendChild(labelEl);

    return wrap;
  }

  function setCurrentChord(rawChord: string) {
    const shown = displayChord(rawChord);
    currentChordEl.textContent = rawChord === "N" ? "—" : shown;
    currentChordKeyEl.textContent = chordKeyLabel(shown);
    renderInstrumentView(rawChord);
  }

  /** Song details card: the chords used (most time first), key, tempo and number of sections. */
  function renderDetails() {
    const totals = new Map<string, number>();
    chords.forEach((seg) => {
      if (seg.chord !== "N") totals.set(seg.chord, (totals.get(seg.chord) ?? 0) + seg.end - seg.start);
    });
    sdChipsEl.innerHTML = "";
    [...totals.entries()]
      .sort((a, b) => b[1] - a[1])
      .slice(0, 10)
      .forEach(([raw]) => {
        const chip = document.createElement("span");
        chip.className = "sd-chip";
        chip.textContent = displayChord(raw);
        sdChipsEl.appendChild(chip);
      });
    sdKeyEl.textContent = songKey ? chordKeyLabel(transposeChord(songKey, transposeSteps)) : "—";
    sdTempoEl.textContent = `${Math.round(tempo)} BPM`;
    const named = sections.filter((sec) => sec.startBar !== null).length;
    sdSectionsEl.textContent = named > 0 ? String(named) : "—";
  }

  /** The Transpose control shows the song's key (after transposing), or the semitone offset when it is unknown. */
  function updateTransposeLabel() {
    transposeValueEl.textContent = songKey ? transposeChord(songKey, transposeSteps) : semitoneLabel(transposeSteps);
    transposeValueEl.title = `Transposed ${semitoneLabel(transposeSteps)} semitones`;
  }

  /** "Summary" view: a diagram of every chord in the song, most used first. */
  function renderSummary() {
    summaryGridEl.innerHTML = "";
    const totals = new Map<string, number>();
    chords.forEach((seg) => {
      if (seg.chord !== "N") totals.set(seg.chord, (totals.get(seg.chord) ?? 0) + seg.end - seg.start);
    });
    const all = [...totals.values()].reduce((a, b) => a + b, 0) || 1;
    [...totals.entries()]
      .sort((a, b) => b[1] - a[1])
      .forEach(([raw, seconds]) => {
        const fChord = fingeringChord(raw);
        const shape = activeInstrument === "guitar" ? getGuitarShape(fChord) : undefined;
        const card = shape ? buildFretDiagram(fChord, shape, 1) : buildNoteFallbackCard(fChord);
        card.title = `${displayChord(raw)} — ${Math.round((100 * seconds) / all)}% of the song`;
        summaryGridEl.appendChild(card);
      });
  }

  function setDiagramMode(mode: "animated" | "summary") {
    const animated = mode === "animated";
    dgAnimatedPanel.classList.toggle("hidden", !animated);
    dgSummaryPanel.classList.toggle("hidden", animated);
    dgAnimated.classList.toggle("is-active", animated);
    dgAnimated.setAttribute("aria-pressed", String(animated));
    dgSummary.classList.toggle("is-active", !animated);
    dgSummary.setAttribute("aria-pressed", String(!animated));
  }

  /** Re-renders every view after a Transpose/Capo/chord-detail change (chord names and shapes shift). */
  function refreshViews() {
    renderDiagramRow();
    renderDiagramWindow();
    renderChordGrid();
    renderSummary();
    renderDetails();
    updateTransposeLabel();
    if (lastActiveIndex >= 0 && chords[lastActiveIndex]) setCurrentChord(chords[lastActiveIndex].chord);
    const t = playerTime();
    highlightDiagramRow(t);
    highlightChordGrid(t);
  }

  function onTimeUpdate(currentTime: number) {
    highlightDiagramRow(currentTime);
    highlightChordGrid(currentTime);
    updateTransport(currentTime);
    applyLoop(currentTime);

    const index = chords.findIndex((s) => currentTime >= s.start && currentTime < s.end);
    if (index === -1 || index === lastActiveIndex) return;
    lastActiveIndex = index;
    const seg = chords[index];
    setCurrentChord(seg.chord);
    renderDiagramWindow();
  }

  /** The player's clock in seconds, whichever player is in use. */
  function playerTime(): number {
    if (usingAudio()) return audioEl.currentTime;
    return ytPlayer && typeof ytPlayer.getCurrentTime === "function" ? ytPlayer.getCurrentTime() : 0;
  }

  // `timeupdate` (and a 250 ms timer) only refresh ~4 times a second, so a chord change could show up to
  // a quarter-second late. While playing, read the clock on every display frame instead.
  let syncFrame = 0;
  function startSyncLoop() {
    if (syncFrame) return;
    const tick = () => {
      onTimeUpdate(playerTime());
      syncFrame = requestAnimationFrame(tick);
    };
    syncFrame = requestAnimationFrame(tick);
  }
  function stopSyncLoop() {
    cancelAnimationFrame(syncFrame);
    syncFrame = 0;
    onTimeUpdate(playerTime());
  }

  /** True when an uploaded file is playing through <audio>; false for the YouTube player. */
  function usingAudio(): boolean {
    return audioEl.dataset.mode === "audio";
  }

  function isPlaying(): boolean {
    if (usingAudio()) return !audioEl.paused;
    return !!ytPlayer && typeof ytPlayer.getPlayerState === "function" && ytPlayer.getPlayerState() === 1;
  }

  function seekQuiet(time: number) {
    if (usingAudio()) audioEl.currentTime = time;
    else if (ytPlayer) ytPlayer.seekTo(time, true);
    onTimeUpdate(time);
  }

  function seekTo(time: number) {
    seekQuiet(time);
    if (usingAudio()) void audioEl.play();
    else if (ytPlayer) ytPlayer.playVideo();
  }

  function rawPause() {
    if (usingAudio()) audioEl.pause();
    else if (ytPlayer) ytPlayer.pauseVideo();
  }

  // Count-in: three clicks at the song's tempo before playback starts.
  let countInEnabled = false;
  let audioCtx: AudioContext | null = null;
  function clickSound(accent: boolean) {
    audioCtx = audioCtx ?? new AudioContext();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.frequency.value = accent ? 1568 : 1046;
    gain.gain.setValueAtTime(0.25, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);
    osc.connect(gain).connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.09);
  }
  async function runCountIn() {
    const beatMs = 60000 / (tempo * (tempoPct / 100));
    const shownChord = currentChordEl.textContent;
    const shownKey = currentChordKeyEl.textContent;
    for (let n = 3; n >= 1; n--) {
      currentChordEl.textContent = String(n);
      currentChordKeyEl.textContent = "Get ready";
      clickSound(n === 3);
      await new Promise((resolve) => setTimeout(resolve, beatMs));
    }
    currentChordEl.textContent = shownChord;
    currentChordKeyEl.textContent = shownKey;
  }

  let counting = false;
  async function togglePlay() {
    if (counting) return;
    if (isPlaying()) {
      rawPause();
      return;
    }
    if (countInEnabled) {
      counting = true;
      await runCountIn();
      counting = false;
    }
    if (usingAudio()) void audioEl.play();
    else if (ytPlayer) ytPlayer.playVideo();
  }

  // Loop: off -> whole song -> the section that was playing when it was switched on.
  let loopMode: "off" | "song" | "section" = "off";
  let loopSection = -1;
  function applyLoop(t: number) {
    if (loopMode !== "section" || loopSection < 0 || !isPlaying()) return;
    const seg = progressSegs[loopSection];
    if (seg && t >= seg.end - 0.04) seekQuiet(seg.start);
  }

  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  let ytPlayer: any = null;

  function extractYoutubeId(url: string): string | null {
    const match = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/)|youtu\.be\/)([a-zA-Z0-9_-]{6,})/);
    return match ? match[1] : null;
  }

  function setupYoutubePlayer(videoId: string) {
    youtubeMount.classList.remove("hidden");
    const div = document.createElement("div");
    div.id = "yt-player-target";
    youtubeMount.appendChild(div);

    const script = document.createElement("script");
    script.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(script);

    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    (window as any).onYouTubeIframeAPIReady = () => {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      ytPlayer = new (window as any).YT.Player("yt-player-target", {
        videoId,
        playerVars: { rel: 0 },
        events: {
          onReady: () => {
            // slow poll keeps the display right after seeks while paused; the frame loop runs while playing
            setInterval(() => onTimeUpdate(playerTime()), 500);
          },
          // 1 = playing, 2 = paused, 0 = ended, 3 = buffering
          // eslint-disable-next-line @typescript-eslint/no-explicit-any
          onStateChange: (event: any) => {
            setPlayingUi(event.data === 1);
            if (event.data === 1) startSyncLoop();
            else stopSyncLoop();
            if (event.data === 0 && loopMode === "song") seekTo(0);
          },
        },
      });
    };
  }

  async function init() {
    if (!sessionId) {
      fail("No song selected. Go back and paste a link or upload a song.");
      return;
    }

    let result: ExtractResult;
    try {
      const res = await fetch(`${API_BASE}/api/result/${sessionId}`);
      if (!res.ok) throw new Error(`Could not load this song (${res.status})`);
      result = await res.json();
    } catch (err) {
      fail(err instanceof Error ? err.message : "Could not load this song.");
      return;
    }

    chordsSimple = result.chords;
    chordsDetailed = result.chordsDetailed ?? result.chords;
    chords = chordsSimple;
    bars = result.bars;
    sections = result.sections ?? [];
    songKey = result.key ?? "";
    duration = result.duration;
    tempo = result.tempo || 120;

    const title = result.title || "Your song";
    songTitleEl.textContent = title;
    songArtistEl.textContent = result.artist ? `by ${result.artist}` : "";
    songSubEl.textContent = "Transcription by TheChordify";
    document.title = `${title} chords — The Chordify`;
    detailToggle.hidden = chordsDetailed === chordsSimple;

    buildChordEvents();
    loadingState.classList.add("hidden");
    playerState.classList.remove("hidden");
    renderProgress();
    setPlayingUi(false);
    renderDiagramRow();
    renderDiagramWindow();
    renderChordGrid();
    renderSummary();
    renderDetails();
    updateTransposeLabel();
    syncHeaderSize();

    if (result.source === "youtube" && result.sourceUrl) {
      const videoId = extractYoutubeId(result.sourceUrl);
      if (videoId) {
        setupYoutubePlayer(videoId);
      } else {
        fail("Could not determine the YouTube video to play.");
        return;
      }
    } else {
      audioEl.dataset.mode = "audio";
      audioEl.src = `${API_BASE}${result.audioUrl}`;
      audioEl.addEventListener("play", () => setPlayingUi(true));
      audioEl.addEventListener("pause", () => setPlayingUi(false));
      audioEl.addEventListener("timeupdate", () => onTimeUpdate(audioEl.currentTime));
      audioEl.addEventListener("seeked", () => onTimeUpdate(audioEl.currentTime));
      audioEl.addEventListener("play", startSyncLoop);
      audioEl.addEventListener("pause", stopSyncLoop);
      audioEl.addEventListener("ended", stopSyncLoop);
      audioEl.addEventListener("ended", () => setPlayingUi(false));
    }

    if (chords.length > 0) setCurrentChord(chords[0].chord);
  }

  document.querySelectorAll<HTMLButtonElement>(".instrument-tab").forEach((btn) => {
    btn.addEventListener("click", () => {
      activeInstrument = btn.dataset.inst || "guitar";
      document.querySelectorAll<HTMLButtonElement>(".instrument-tab").forEach((b) => {
        const active = b === btn;
        b.style.background = active ? "var(--color-accent)" : "transparent";
        b.style.color = active ? "var(--color-on-accent)" : "#c4b5fd";
        b.style.borderColor = active ? "var(--color-accent)" : "#7c3aed44";
        b.setAttribute("aria-pressed", String(active));
      });
      if (lastActiveIndex >= 0) renderInstrumentView(chords[lastActiveIndex].chord);
      renderSummary();
    });
  });

  // Toolbar: volume
  volumeSlider.addEventListener("input", () => {
    const v = Number(volumeSlider.value) / 100;
    audioEl.volume = v;
    if (ytPlayer && typeof ytPlayer.setVolume === "function") ytPlayer.setVolume(v * 100);
  });

  // Toolbar: loop (off -> whole song -> current section)
  loopToggle.addEventListener("click", () => {
    loopMode = loopMode === "off" ? "song" : loopMode === "song" && sections.length > 0 ? "section" : "off";
    loopSection = loopMode === "section" ? Math.max(0, currentSectionIdx) : -1;
    audioEl.loop = loopMode === "song";
    loopToggle.textContent = loopMode === "off" ? "Off" : loopMode === "song" ? "Song" : "Section";
    loopToggle.style.color = loopMode === "off" ? "var(--color-body)" : "var(--color-violet)";
    loopToggle.setAttribute("aria-pressed", String(loopMode !== "off"));
  });

  // Toolbar: tempo (playback speed, 50%-150%)
  function applyTempo() {
    tempoValueEl.textContent = `${tempoPct}%`;
    const rate = tempoPct / 100;
    audioEl.playbackRate = rate;
    if (ytPlayer && typeof ytPlayer.setPlaybackRate === "function") ytPlayer.setPlaybackRate(rate);
  }
  tempoDown.addEventListener("click", () => {
    tempoPct = Math.max(50, tempoPct - 10);
    applyTempo();
  });
  tempoUp.addEventListener("click", () => {
    tempoPct = Math.min(150, tempoPct + 10);
    applyTempo();
  });

  // Toolbar: capo (shifts which guitar shape is shown, not the sounding pitch)
  capoDown.addEventListener("click", () => {
    capo = Math.max(0, capo - 1);
    capoValueEl.textContent = String(capo);
    refreshViews();
  });
  capoUp.addEventListener("click", () => {
    capo = Math.min(7, capo + 1);
    capoValueEl.textContent = String(capo);
    refreshViews();
  });

  // Toolbar: transpose (shifts the chord names everywhere — sing/play in a different key)
  transposeDown.addEventListener("click", () => {
    transposeSteps -= 1;
    updateTransposeLabel();
    refreshViews();
  });
  transposeUp.addEventListener("click", () => {
    transposeSteps += 1;
    updateTransposeLabel();
    refreshViews();
  });

  // View switcher: Chords grid / Chord diagrams
  function setActiveView(view: "diagrams" | "grid") {
    activeView = view;
    const isDiagrams = view === "diagrams";
    panelDiagrams.classList.toggle("hidden", !isDiagrams);
    panelGrid.classList.toggle("hidden", isDiagrams);
    viewTabDiagrams.classList.toggle("is-active", isDiagrams);
    viewTabDiagrams.setAttribute("aria-pressed", String(isDiagrams));
    viewTabGrid.classList.toggle("is-active", !isDiagrams);
    viewTabGrid.setAttribute("aria-pressed", String(!isDiagrams));
    // the strip can't be measured while hidden, so bring the playing chord back into view on return
    if (isDiagrams && timelineActive >= 0) followActiveChip(timelineChips[timelineActive]);
  }
  viewTabDiagrams.addEventListener("click", () => setActiveView("diagrams"));
  viewTabGrid.addEventListener("click", () => setActiveView("grid"));

  // Header: share, compact-on-scroll, transport, progress bar, section picker
  btnShare.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
      btnShare.textContent = "Link copied";
    } catch {
      window.prompt("Copy this link", window.location.href);
    }
    setTimeout(() => (btnShare.textContent = "Share"), 1800);
  });
  const syncHeaderSize = () => {
    headerEl.classList.toggle("is-compact", window.scrollY > 70);
    document.documentElement.style.setProperty("--ph-h", `${headerEl.offsetHeight}px`);
  };
  window.addEventListener("scroll", syncHeaderSize, { passive: true });
  window.addEventListener("resize", syncHeaderSize);
  new ResizeObserver(syncHeaderSize).observe(headerEl);
  dgAnimated.addEventListener("click", () => setDiagramMode("animated"));
  dgSummary.addEventListener("click", () => setDiagramMode("summary"));
  btnPlay.addEventListener("click", () => void togglePlay());
  btnRestart.addEventListener("click", () => seekQuiet(0));
  progressEl.addEventListener("pointerdown", seekFromProgress);
  progressEl.addEventListener("keydown", (e) => {
    if (e.code === "ArrowRight") seekQuiet(Math.min(duration, playerTime() + 5));
    else if (e.code === "ArrowLeft") seekQuiet(Math.max(0, playerTime() - 5));
    else return;
    e.preventDefault();
  });
  sectionSelect.addEventListener("change", () => {
    const seg = progressSegs[Number(sectionSelect.value)];
    if (seg) seekTo(seg.start);
  });
  window.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    if (e.code === "Space" && (target === document.body || target === playerState)) {
      e.preventDefault();
      void togglePlay();
    }
  });

  // Toolbar: count-in, section labels, simple/detailed chords
  countInToggle.addEventListener("click", () => {
    countInEnabled = !countInEnabled;
    countInToggle.textContent = countInEnabled ? "On" : "Off";
    countInToggle.style.color = countInEnabled ? "var(--color-violet)" : "var(--color-body)";
    countInToggle.setAttribute("aria-pressed", String(countInEnabled));
  });
  sectionsToggle.addEventListener("click", () => {
    const showing = chordGridEl.classList.toggle("grid-hide-tags") === false;
    sectionsToggle.textContent = showing ? "On" : "Off";
    sectionsToggle.style.color = showing ? "var(--color-violet)" : "var(--color-body)";
    sectionsToggle.setAttribute("aria-pressed", String(showing));
  });
  detailToggle.addEventListener("click", () => {
    const detailed = chords === chordsSimple;
    chords = detailed ? chordsDetailed : chordsSimple;
    detailToggle.textContent = detailed ? "Detailed" : "Simple";
    detailToggle.style.color = detailed ? "var(--color-violet)" : "var(--color-body)";
    detailToggle.setAttribute("aria-pressed", String(detailed));
    buildChordEvents();
    lastActiveIndex = -1;
    refreshViews();
    onTimeUpdate(playerTime());
  });

  init();
</script>
