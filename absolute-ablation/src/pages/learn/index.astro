---
// /learn/: the lessons.
import ChordShell from "../../components/chords/ChordShell.astro";
import ChHero from "../../components/chords/ChHero.astro";
import { LESSONS } from "../../lib/lessons";
import { INSTRUMENTS } from "../../lib/chordCatalog";
import { voicingsFor } from "../../lib/chordCharts";
import { INSTRUMENT_ICONS } from "../../lib/instrumentIcons";

const title = "Learn Chords: Free Guitar and Piano Lessons — Chord Suno";
const description = "Short, free lessons on chords: how to read a chord diagram, beginner guitar chords, barre chords, piano inversions, chords in a key, capo and strumming.";
const faqs: [string, string][] = [
  ["Where do I start if I have never played a chord?", "Start with how to read a chord diagram, then the first guitar chords to learn (Em, Am, D and G are a good set). Those few chords play a great many songs."],
  ["How long does it take to learn the first chords?", "Most people can make a clean sound on two or three open chords within a week of ten minutes a day. Changing between them smoothly takes longer, so practise one pair of chords at a time, slowly."],
  ["Do I need to read music or know theory?", "No. Chord diagrams show where your fingers go. The lessons on chords in a key and on capo and transposing add a little theory when you are ready for it, and each one explains the words it uses."],
  ["Which instrument should I learn chords on?", "Guitar and ukulele use fingering diagrams and piano uses keys. The ukulele has four strings, which many beginners find gentler. The lessons mark which instruments each one is for."],
  ["Can I practise with a real song?", "Yes. Search for a song on Chord Suno and play along with the chords on the beat, slow it down and loop the hard part. The Toolkit also has a tuner, a metronome and chord-change drills."],
];
const jsonLd = [
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  { "@context": "https://schema.org", "@type": "CollectionPage", name: title, description, url: "https://chordsuno.com/learn/" },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Chord Suno", item: "https://chordsuno.com/" },
      { "@type": "ListItem", position: 2, name: "Learn", item: "https://chordsuno.com/learn/" },
    ],
  },
];
const [first, ...rest] = LESSONS;
const beginner = LESSONS.filter((l) => l.level === "Beginner").length;
const art = ["Em", "Am", "D", "G"].map((c) => ({ svg: voicingsFor("guitar", c, 1)[0]?.svg ?? "", label: c })).filter((a) => a.svg);
const who = (l: (typeof LESSONS)[number]) => (l.instruments.length ? l.instruments.map((k) => INSTRUMENTS.find((i) => i.key === k)!.name) : ["Every instrument"]);
---

<ChordShell title={title} description={description} jsonLd={jsonLd}>
  <ChHero
    eyebrow="Learn"
    title="Learn chords,"
    accent="step by step"
    lead="Short, plain lessons that take you from reading your first diagram to playing songs in any key. Each one links to the chord charts, and the player lets you practise with a real song."
    art={art}
    stats={[{ n: LESSONS.length, label: "lessons" }, { n: beginner, label: "for beginners" }, { n: LESSONS.reduce((n, l) => n + l.minutes, 0), label: "minutes in all" }]}
  >
    <a class="ch-btn" href={`/learn/${first.slug}/`}>Start here: {first.title.toLowerCase()} <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
    <a class="ch-btn is-ghost" href="/chords/">Chord charts</a>
  </ChHero>

  <section class="ch-in ch-sec">
    <span class="ch-kicker" data-reveal>All lessons</span>
    <h2 data-reveal style="--i: 1">Pick up where you are</h2>
    <p data-reveal style="--i: 2">Read them in order, or jump to what you need. Each takes a few minutes.</p>
    <div class="ch-links">
      {
        LESSONS.map((l, i) => (
          <a class="ch-link" href={`/learn/${l.slug}/`} data-reveal style={`--i: ${i}`}>
            <span class="ch-num">{String(i + 1).padStart(2, "0")}</span>
            <strong>{l.title}</strong>
            <span>{l.summary}</span>
            <span class="ch-tags">
              <span class={`ch-tag${l.level === "Beginner" ? " is-amber" : ""}`}>{l.level}</span>
              <span class="ch-tag">{l.minutes} min</span>
              {who(l).map((w) => <span class="ch-tag">{w}</span>)}
            </span>
            <em class="ch-go" style="font-style: normal">Read the lesson</em>
          </a>
        ))
      }
    </div>
  </section>

  <section class="ch-in ch-sec" id="how-to-learn">
    <span class="ch-kicker" data-reveal>A way through</span>
    <h2 data-reveal style="--i: 1">How to learn chords</h2>
    <p data-reveal style="--i: 2">A chord is three or more notes played together. To play one, you put your fingers on the strings (or keys) the diagram shows and play them all at once. You do not need to read music: the diagram is the instruction.</p>
    <p data-reveal>A good order is <a href="/learn/read-chord-diagrams/">reading a diagram</a>, then <a href="/learn/beginner-guitar-chords/">the first guitar chords</a>, then <a href="/learn/strumming-patterns-for-beginners/">a strumming pattern</a> so you can play a whole song. After that, <a href="/learn/barre-chords/">barre chords</a> open up the rest of the neck, <a href="/learn/chords-in-a-key/">chords in a key</a> shows why some chords go together, and the <a href="/learn/capo-and-transposing/">capo</a> lets you play in any key with easy shapes. Pianists can go straight to <a href="/learn/piano-chords-and-inversions/">piano chords and inversions</a>.</p>
    <p data-reveal>Practise a little every day. Ten minutes beats one long session, and slow, clean changes between two chords are worth more than a fast sloppy song. The <a href="/toolkit/metronome/">metronome</a> keeps you honest, and the <a href="/toolkit/practice/">chord practice drills</a> time your changes.</p>
  </section>

  <section class="ch-in ch-sec" id="faq">
    <span class="ch-kicker" data-reveal>Good to know</span>
    <h2 data-reveal style="--i: 1">Learning chords: questions and answers</h2>
    {faqs.map(([q, a], i) => <details data-reveal style={`--i: ${i}`}><summary>{q}</summary><p>{a}</p></details>)}
  </section>

  <section class="ch-in ch-sec">
    <span class="ch-kicker" data-reveal>Go deeper</span>
    <h2 data-reveal style="--i: 1">Musical modes</h2>
    <p data-reveal style="--i: 2">The seven modes (Dorian, Lydian, Mixolydian and the rest) in all twelve keys: every note, the formulas, the chords and a keyboard that plays them.</p>
    <div class="ch-links">
      <a class="ch-link" href="/modes/" data-reveal><strong>Musical modes chart</strong><span>All 7 modes in all 12 keys on one page, with what each sounds like.</span><em class="ch-go" style="font-style: normal">Open the chart</em></a>
      <a class="ch-link" href="/modes/dorian/" data-reveal style="--i: 1"><strong>Dorian mode</strong><span>Minor with a raised 6th: warm, jazzy and hopeful.</span><em class="ch-go" style="font-style: normal">Read about Dorian</em></a>
      <a class="ch-link" href="/modes/mixolydian/" data-reveal style="--i: 2"><strong>Mixolydian mode</strong><span>Major with a flat 7th: the bluesy sound of rock and folk.</span><em class="ch-go" style="font-style: normal">Read about Mixolydian</em></a>
      <a class="ch-link" href="/modes/c/" data-reveal style="--i: 3"><strong>Modes of C</strong><span>The seven modes that start on C, the easiest place to begin.</span><em class="ch-go" style="font-style: normal">Open the modes of C</em></a>
    </div>
  </section>

  <section class="ch-in ch-sec">
    <span class="ch-kicker" data-reveal>Look a chord up</span>
    <h2 data-reveal style="--i: 1">The chord charts</h2>
    <div class="ch-links">
      {
        INSTRUMENTS.map((i, n) => (
          <a class="ch-link" href={i.chartPath} data-reveal style={`--i: ${n}`}>
            <span class="ch-ico"><svg viewBox="0 0 24 24" set:html={INSTRUMENT_ICONS[i.key]} /></span>
            <strong>{i.name} chord chart</strong>
            <span>Every {i.name.toLowerCase()} chord with a diagram.</span>
            <em class="ch-go" style="font-style: normal">Open the chart</em>
          </a>
        ))
      }
    </div>
  </section>

  <div class="ch-in ch-cta-wrap">
    <div class="ch-cta-in" data-reveal>
      <h2>Practise with a real song</h2>
      <p>Search for a song and play along: slow it down, loop the hard part and watch every chord on the beat.</p>
      <a class="ch-btn" href="/#find">Find chords for a song</a>
    </div>
  </div>
</ChordShell>
