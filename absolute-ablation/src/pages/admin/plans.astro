---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout
  title="Subscription plans"
  active="plans"
  lead="The plans people can subscribe to, how each is priced, and how it is charged through Razorpay. What each plan includes is set in Features & limits. Everything here shows on the pricing page as soon as you save."
>
  <section id="pay" class="adm-card" aria-labelledby="h-pay">
    <div class="pl-pay-head">
      <h2 id="h-pay">Payments with Razorpay</h2>
      <span id="pay-pill" class="adm-pill"></span>
    </div>
    <ul id="pay-list" class="adm-list" style="margin-top:12px"></ul>
    <details class="adm-details">
      <summary>How to set Razorpay up</summary>
      <ol class="adm-steps">
        <li>In the Razorpay dashboard open <strong>Account &amp; Settings → API Keys</strong> and generate a key. Add the key id and secret to the server as <code>RAZORPAY_KEY_ID</code> and <code>RAZORPAY_KEY_SECRET</code>. Keys starting <code>rzp_test_</code> are for trying it with no real money.</li>
        <li>Open <strong>Account &amp; Settings → Webhooks → Add new webhook</strong>. Paste the webhook address below, choose a secret, and tick these events: <code>subscription.authenticated</code>, <code>subscription.activated</code>, <code>subscription.charged</code>, <code>subscription.pending</code>, <code>subscription.halted</code>, <code>subscription.paused</code>, <code>subscription.resumed</code>, <code>subscription.cancelled</code>, <code>subscription.completed</code>.</li>
        <li>Add that secret to the server as <code>RAZORPAY_WEBHOOK_SECRET</code>, and redeploy.</li>
        <li>Below, press <strong>Create on Razorpay</strong> next to each price. Razorpay plans cannot be edited, so changing a price's amount or period makes a new one.</li>
        <li>Subscriptions on Razorpay are charged in rupees, so use INR for the prices.</li>
      </ol>
    </details>
    <div class="adm-row" style="margin-top:12px">
      <input id="hook" type="text" readonly aria-label="Webhook address" />
      <button id="copy-hook" type="button" class="adm-btn ghost small">Copy</button>
    </div>
  </section>

  <div class="adm-row" style="margin:6px 0 14px;justify-content:space-between">
    <span id="summary" class="adm-hint" style="margin:0" role="status"></span>
    <button id="new" type="button" class="adm-btn">+ New plan</button>
  </div>
  <p id="msg" class="adm-msg" role="status"></p>
  <div id="plans" class="pl-cards" aria-busy="true"></div>

  <section id="editor" class="adm-card pl-editor" hidden aria-labelledby="editor-title">
    <h2 id="editor-title">New plan</h2>
    <form id="form" novalidate>
      <div class="pl-grid">
        <label class="adm-field"><span>Name</span><input id="f-name" type="text" maxlength="60" required placeholder="Premium" /></label>
        <label class="adm-field">
          <span>Code</span>
          <input id="f-code" type="text" maxlength="40" required placeholder="premium" />
          <small>Letters, numbers, - and _. Short, and kept as it is.</small>
        </label>
        <label class="adm-field pl-wide"><span>Short description</span><input id="f-description" type="text" maxlength="200" placeholder="For serious players who want the full experience." /></label>
        <label class="adm-field"><span>Badge (optional)</span><input id="f-badge" type="text" maxlength="30" placeholder="Most popular" /></label>
        <label class="adm-field"><span>Button text</span><input id="f-cta" type="text" maxlength="40" placeholder="Go Premium" /></label>
        <label class="adm-field"><span>Order on the page</span><input id="f-order" type="number" step="1" inputmode="numeric" value="0" /><small>Smallest first.</small></label>
      </div>
      <div class="pl-checks">
        <label class="adm-check"><input id="f-featured" type="checkbox" /> Highlight this plan on the pricing page</label>
        <label class="adm-check"><input id="f-active" type="checkbox" checked /> On sale (visible to visitors)</label>
      </div>
      <div class="adm-row" style="margin-top:18px">
        <button id="save" type="submit" class="adm-btn">Save plan</button>
        <button id="cancel" type="button" class="adm-btn ghost">Cancel</button>
      </div>
      <p id="form-msg" class="adm-msg" role="status"></p>
    </form>
  </section>

  <section id="price-editor" class="adm-card pl-editor" hidden aria-labelledby="price-title">
    <h2 id="price-title">Add a price</h2>
    <form id="price-form" novalidate>
      <div class="pl-grid">
        <label class="adm-field">
          <span>Billed</span>
          <select id="p-period"></select>
        </label>
        <label class="adm-field">
          <span>Every</span>
          <input id="p-interval" type="number" min="1" step="1" inputmode="numeric" value="1" />
          <small>1 = every period. 3 with Monthly = every 3 months.</small>
        </label>
        <label class="adm-field">
          <span>Amount</span>
          <input id="p-amount" type="number" min="0" step="0.01" inputmode="decimal" placeholder="249" />
          <small>In the main unit (rupees). What the person pays each time.</small>
        </label>
        <label class="adm-field">
          <span>Currency</span>
          <input id="p-currency" type="text" maxlength="3" placeholder="INR" />
          <small>Razorpay subscriptions use INR.</small>
        </label>
        <label class="adm-field pl-wide">
          <span>Razorpay plan id</span>
          <input id="p-razorpay" type="text" maxlength="60" placeholder="Leave empty and press Create on Razorpay afterwards" />
          <small>Already made one on Razorpay? Paste its id (it starts with <code>plan_</code>) instead.</small>
        </label>
      </div>
      <div class="pl-checks">
        <label class="adm-check"><input id="p-active" type="checkbox" checked /> On sale</label>
      </div>
      <div class="adm-row" style="margin-top:18px">
        <button id="price-save" type="submit" class="adm-btn">Save price</button>
        <button id="price-cancel" type="button" class="adm-btn ghost">Cancel</button>
      </div>
      <p id="price-msg" class="adm-msg" role="status"></p>
    </form>
  </section>
</AdminLayout>

<style is:global>
  .pl-pay-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .pl-cards { display: grid; gap: 14px; }
  .pl-card { padding: 20px 22px; border-radius: 20px; background: #fff; border: 1px solid var(--color-hairline); box-shadow: 0 1px 2px #1a05330a; }
  .pl-card.is-off { opacity: 0.72; }
  .pl-top { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .pl-title { margin: 0; font-size: 18px; font-weight: 800; letter-spacing: -0.02em; color: var(--color-ink); }
  .pl-code { margin-left: 8px; font: 600 12px var(--font-mono); color: var(--color-mute); }
  .pl-desc { margin: 6px 0 0; font-size: 14px; color: var(--color-body); }
  .pl-pills { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .pl-acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .pl-prices { margin: 16px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .pl-price { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; padding: 11px 14px; border-radius: 14px; background: #fcfaff; border: 1px solid #f1eaf9; }
  .pl-amount { font-weight: 800; font-size: 15px; color: var(--color-ink); }
  .pl-amount small { margin-left: 6px; font-weight: 600; font-size: 12.5px; color: var(--color-mute); }
  .pl-rz { font-size: 13px; color: var(--color-body); }
  .pl-rz code { font-size: 12px; }
  .pl-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px; margin-top: 14px; font-size: 13.5px; color: var(--color-mute); }
  .pl-foot a { font-weight: 700; color: var(--color-violet-deep); text-decoration: none; }
  .pl-foot a:hover { text-decoration: underline; }
  .pl-editor { margin-top: 22px; scroll-margin-top: 80px; }
  .pl-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 18px; margin-top: 14px; }
  .pl-wide { grid-column: 1 / -1; }
  .pl-checks { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 16px; }
  @media (max-width: 640px) { .pl-grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { adminReady, adminFetch, el, say, statusLine, money } from "../../lib/admin";

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  type Item = Record<string, any>;
  let plans: Item[] = [];
  let features: Item[] = [];
  let periods: string[] = [];
  let editingPlan: string | null = null;
  let pricingPlan: string | null = null; // the plan a price is being added to or edited for
  let editingPrice: string | null = null;

  const PERIOD_WORD: Record<string, string> = { daily: "day", weekly: "week", monthly: "month", quarterly: "quarter", yearly: "year" };
  const priceLabel = (p: Item) => `${money(p.amountMinor, p.currency)} / ${p.intervalCount > 1 ? `${p.intervalCount} ${PERIOD_WORD[p.period]}s` : PERIOD_WORD[p.period]}`;

  // ---- Razorpay ------------------------------------------------------------------------------------------------------

  function drawPayments(r: Item) {
    const pill = $("pay-pill");
    pill.textContent = !r.configured ? "Not set up" : r.mode === "live" ? "Live" : r.mode === "test" ? "Test mode" : "Set up";
    pill.className = `adm-pill ${!r.configured ? "warn" : r.mode === "live" ? "ok" : "violet"}`;
    $("pay-list").replaceChildren(
      statusLine(r.configured, r.configured ? `API keys found${r.mode ? ` (${r.mode} keys)` : ""}` : "No API keys: set RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET on the server"),
      statusLine(r.webhookSecretSet, r.webhookSecretSet ? "Webhook secret found: renewals and cancellations are accepted" : "No webhook secret: set RAZORPAY_WEBHOOK_SECRET, or renewals and cancellations will not be recorded"),
    );
    ($("hook") as HTMLInputElement).value = r.webhookUrl;
  }

  // ---- the plan cards ------------------------------------------------------------------------------------------------

  function draw() {
    $("summary").textContent = `${plans.length} plan${plans.length === 1 ? "" : "s"}, ${plans.filter((p) => p.active).length} on sale`;
    $("plans").setAttribute("aria-busy", "false");
    $("plans").replaceChildren(...plans.map(card));
  }

  function card(plan: Item): HTMLElement {
    const box = el("article", `pl-card${plan.active ? "" : " is-off"}`);
    const top = el("div", "pl-top");
    const titles = el("div");
    const title = el("h3", "pl-title", plan.name);
    title.append(el("span", "pl-code", plan.code));
    titles.append(title);
    if (plan.description) titles.append(el("p", "pl-desc", plan.description));
    const pills = el("div", "pl-pills");
    pills.append(el("span", `adm-pill ${plan.active ? "ok" : "warn"}`, plan.active ? "On sale" : "Hidden"));
    if (plan.isFree) pills.append(el("span", "adm-pill violet", "Everyone starts here"));
    if (plan.featured) pills.append(el("span", "adm-pill violet", plan.badge || "Highlighted"));
    titles.append(pills);
    const acts = el("div", "pl-acts");
    const edit = el("button", "adm-btn ghost small", "Edit details");
    edit.type = "button";
    edit.addEventListener("click", () => openEditor(plan));
    acts.append(edit);
    if (!plan.isFree) {
      const add = el("button", "adm-btn ghost small", "+ Add a price");
      add.type = "button";
      add.addEventListener("click", () => openPriceEditor(plan));
      const remove = el("button", "adm-btn danger small", "Delete");
      remove.type = "button";
      remove.addEventListener("click", () => removePlan(plan));
      acts.append(add, remove);
    }
    top.append(titles, acts);
    box.append(top);

    if (plan.isFree) {
      box.append(el("p", "pl-desc", "The Free plan is never charged for, and everybody is on it until they subscribe to another."));
    } else if (plan.prices.length === 0) {
      box.append(el("p", "pl-desc", "No prices yet: this plan will not show on the pricing page until it has one."));
    } else {
      const list = el("ul", "pl-prices");
      plan.prices.forEach((price: Item) => list.append(priceRow(plan, price)));
      box.append(list);
    }

    const on = Object.values(plan.entitlements as Record<string, Item>).filter((r) => r.enabled).length;
    const foot = el("div", "pl-foot");
    foot.append(el("span", "", `${on} of ${features.length} features included`));
    const link = el("a", "", "Edit features →");
    link.href = "/admin/features/";
    foot.append(link);
    box.append(foot);
    return box;
  }

  function priceRow(plan: Item, price: Item): HTMLElement {
    const row = el("li", "pl-price");
    const amount = el("span", "pl-amount", priceLabel(price));
    if (!price.active) amount.append(el("small", "", "off"));
    const rz = el("span", "pl-rz");
    if (price.razorpayPlanId) {
      rz.append("On Razorpay: ", Object.assign(el("code"), { textContent: price.razorpayPlanId }));
    } else {
      rz.append(el("span", "adm-pill warn", "Not on Razorpay yet"));
    }
    const acts = el("span", "pl-acts");
    if (!price.razorpayPlanId) {
      const create = el("button", "adm-btn small", "Create on Razorpay");
      create.type = "button";
      create.addEventListener("click", async () => {
        create.disabled = true;
        create.textContent = "Creating…";
        try {
          await adminFetch(`/api/admin/prices/${encodeURIComponent(price.id)}/razorpay`, { method: "POST" });
          say("msg", `${plan.name} (${priceLabel(price)}) is now a Razorpay plan.`, "ok");
          await load();
        } catch (err) {
          say("msg", err instanceof Error ? err.message : "Could not create it on Razorpay.", "bad");
          create.disabled = false;
          create.textContent = "Create on Razorpay";
        }
      });
      acts.append(create);
    }
    const edit = el("button", "adm-btn ghost small", "Edit");
    edit.type = "button";
    edit.addEventListener("click", () => openPriceEditor(plan, price));
    const remove = el("button", "adm-btn danger small", "Remove");
    remove.type = "button";
    remove.addEventListener("click", async () => {
      if (!confirm(`Remove the ${priceLabel(price)} price from ${plan.name}?`)) return;
      try {
        await adminFetch(`/api/admin/prices/${encodeURIComponent(price.id)}`, { method: "DELETE" });
        say("msg", "Price removed.", "ok");
      } catch (err) {
        say("msg", err instanceof Error ? err.message : "Could not remove it.", "bad");
      }
      await load();
    });
    acts.append(edit, remove);
    row.append(amount, rz, acts);
    return row;
  }

  async function load() {
    try {
      const data = await adminFetch("/api/admin/billing");
      plans = data.plans;
      features = data.features;
      periods = data.periods;
      drawPayments(data.razorpay);
      draw();
    } catch (err) {
      say("msg", err instanceof Error ? err.message : "Could not load the plans.", "bad");
    }
  }

  // ---- the plan form -------------------------------------------------------------------------------------------------

  const value = (id: string) => ($(id) as HTMLInputElement).value.trim();

  function openEditor(plan?: Item) {
    editingPlan = plan ? plan.id : null;
    $("price-editor").hidden = true;
    $("editor-title").textContent = plan ? `Edit ${plan.name}` : "New plan";
    const set = (id: string, v: string) => (($(id) as HTMLInputElement).value = v);
    set("f-name", plan?.name ?? "");
    set("f-code", plan?.code ?? "");
    set("f-description", plan?.description ?? "");
    set("f-badge", plan?.badge ?? "");
    set("f-cta", plan?.cta ?? "");
    set("f-order", String(plan?.sortOrder ?? (plans.length ? Math.max(...plans.map((p) => p.sortOrder)) + 1 : 1)));
    ($("f-featured") as HTMLInputElement).checked = !!plan?.featured;
    ($("f-active") as HTMLInputElement).checked = plan ? plan.active : true;
    ($("f-active") as HTMLInputElement).disabled = !!plan?.isFree;
    say("form-msg", "", "");
    $("editor").hidden = false;
    $("editor").scrollIntoView({ behavior: "smooth", block: "start" });
    ($("f-name") as HTMLInputElement).focus({ preventScroll: true });
  }

  async function removePlan(plan: Item) {
    if (!confirm(`Delete “${plan.name}” and its prices? To only stop selling it, edit it and untick “On sale”.`)) return;
    try {
      await adminFetch(`/api/admin/plans/${encodeURIComponent(plan.id)}`, { method: "DELETE" });
      say("msg", `${plan.name} deleted.`, "ok");
    } catch (err) {
      say("msg", err instanceof Error ? err.message : "Could not delete that.", "bad");
    }
    await load();
  }

  $("new").addEventListener("click", () => openEditor());
  $("cancel").addEventListener("click", () => ($("editor").hidden = true));
  $("form").addEventListener("submit", async (event) => {
    event.preventDefault();
    const body = {
      code: value("f-code"),
      name: value("f-name"),
      description: value("f-description"),
      badge: value("f-badge"),
      cta: value("f-cta"),
      featured: ($("f-featured") as HTMLInputElement).checked,
      active: ($("f-active") as HTMLInputElement).checked,
      sortOrder: Math.floor(Number(value("f-order")) || 0),
    };
    const button = $("save") as HTMLButtonElement;
    button.disabled = true;
    try {
      await adminFetch(editingPlan ? `/api/admin/plans/${encodeURIComponent(editingPlan)}` : "/api/admin/plans", { method: editingPlan ? "PUT" : "POST", body: JSON.stringify(body) });
      say("msg", `${body.name} saved.`, "ok");
      $("editor").hidden = true;
      await load();
    } catch (err) {
      say("form-msg", err instanceof Error ? err.message : "Could not save that.", "bad");
    } finally {
      button.disabled = false;
    }
  });

  // ---- the price form ------------------------------------------------------------------------------------------------

  function openPriceEditor(plan: Item, price?: Item) {
    pricingPlan = plan.id;
    editingPrice = price ? price.id : null;
    $("editor").hidden = true;
    $("price-title").textContent = price ? `Edit a price of ${plan.name}` : `Add a price to ${plan.name}`;
    const period = $("p-period") as HTMLSelectElement;
    period.replaceChildren(...periods.map((p) => Object.assign(el("option"), { value: p, textContent: p[0].toUpperCase() + p.slice(1) })));
    period.value = price?.period ?? "monthly";
    ($("p-interval") as HTMLInputElement).value = String(price?.intervalCount ?? 1);
    ($("p-amount") as HTMLInputElement).value = price ? String(price.amountMinor / 100) : "";
    ($("p-currency") as HTMLInputElement).value = price?.currency ?? "INR";
    ($("p-razorpay") as HTMLInputElement).value = price?.razorpayPlanId ?? "";
    ($("p-active") as HTMLInputElement).checked = price ? price.active : true;
    say("price-msg", price?.razorpayPlanId ? "Changing the amount or the period means a new Razorpay plan is needed: the id is cleared for you." : "", "");
    $("price-editor").hidden = false;
    $("price-editor").scrollIntoView({ behavior: "smooth", block: "start" });
    ($("p-amount") as HTMLInputElement).focus({ preventScroll: true });
  }

  $("price-cancel").addEventListener("click", () => ($("price-editor").hidden = true));
  $("price-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    const amount = Number(value("p-amount"));
    if (!Number.isFinite(amount) || amount <= 0) return say("price-msg", "The amount must be more than zero.", "bad");
    const body = {
      period: value("p-period"),
      intervalCount: Math.max(1, Math.floor(Number(value("p-interval")) || 1)),
      amountMinor: Math.round(amount * 100),
      currency: value("p-currency") || "INR",
      razorpayPlanId: value("p-razorpay"),
      active: ($("p-active") as HTMLInputElement).checked,
    };
    const button = $("price-save") as HTMLButtonElement;
    button.disabled = true;
    try {
      const base = `/api/admin/plans/${encodeURIComponent(pricingPlan!)}/prices`;
      await adminFetch(editingPrice ? `${base}/${encodeURIComponent(editingPrice)}` : base, { method: editingPrice ? "PUT" : "POST", body: JSON.stringify(body) });
      say("msg", "Price saved. Press Create on Razorpay if it is not on Razorpay yet.", "ok");
      $("price-editor").hidden = true;
      await load();
    } catch (err) {
      say("price-msg", err instanceof Error ? err.message : "Could not save that.", "bad");
    } finally {
      button.disabled = false;
    }
  });

  $("copy-hook").addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(($("hook") as HTMLInputElement).value);
      $("copy-hook").textContent = "Copied";
      setTimeout(() => ($("copy-hook").textContent = "Copy"), 1500);
    } catch {
      ($("hook") as HTMLInputElement).select();
    }
  });

  adminReady().then(load);
</script>
