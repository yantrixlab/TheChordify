---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout perm="users.view" title="Users" active="users" lead="Everyone who has signed in or has an account. Open a person to give, renew or end their plan, or to change their role.">
  <div class="us-bar">
    <div class="us-search">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input id="search" type="search" placeholder="Search by name or email" aria-label="Search users" autocomplete="off" />
    </div>
    <select id="role-filter" aria-label="Show one role"><option value="">All roles</option></select>
    <span id="count" class="us-count" role="status"></span>
    <button id="add-open" type="button" class="adm-btn small" hidden>+ Staff account</button>
  </div>

  <div class="us-table" role="table" aria-label="People">
    <div class="us-head" role="row" aria-hidden="true">
      <span>Person</span><span>Role</span><span>Plan</span><span>Activity</span><span></span>
    </div>
    <div id="rows" role="rowgroup"></div>
    <p id="empty" class="adm-empty" hidden></p>
  </div>

  <div class="us-pager">
    <button id="prev" type="button" class="adm-btn ghost small">← Newer</button>
    <span id="page" class="us-count"></span>
    <button id="next" type="button" class="adm-btn ghost small">Older →</button>
  </div>
  <p id="msg" class="adm-msg" role="status"></p>

  <!-- one person: their plan, and their access -->
  <dialog id="us-dialog" class="adm-dialog us-dialog" aria-labelledby="us-name">
    <header class="us-d-head">
      <span id="us-avatar"></span>
      <div class="us-d-who"><h2 id="us-name"></h2><p id="us-email"></p></div>
      <button id="us-close" type="button" class="us-x" aria-label="Close">×</button>
    </header>
    <p id="us-facts" class="us-facts"></p>
    <div class="us-tabs" role="tablist">
      <button id="tab-plan" type="button" role="tab" class="is-on" aria-selected="true">Plan</button>
      <button id="tab-access" type="button" role="tab" aria-selected="false">Access</button>
    </div>
    <p id="us-msg" class="adm-msg" role="status"></p>
    <div id="pane-plan"></div>
    <div id="pane-access" hidden></div>
  </dialog>

  <dialog id="add-dialog" class="adm-dialog" aria-labelledby="add-title">
    <form id="add-form" method="dialog" autocomplete="off">
      <h2 id="add-title">Add a staff account</h2>
      <p class="adm-hint">Makes an account that can sign in to this admin with an email and a password. If its owner later signs in with Google using the same email, the two are joined and the role stays.</p>
      <label class="adm-field"><span>Email</span><input id="add-email" type="text" inputmode="email" placeholder="name@example.com" required /></label>
      <label class="adm-field"><span>Name</span><input id="add-name" type="text" placeholder="Optional" /></label>
      <label class="adm-field"><span>Password</span><input id="add-password" type="password" autocomplete="new-password" placeholder="At least 10 characters" required /></label>
      <label class="adm-field"><span>Role</span><select id="add-role" required><option value="" selected disabled>Choose a role…</option></select></label>
      <p id="add-msg" class="adm-msg" role="status"></p>
      <div class="adm-row" style="justify-content:flex-end">
        <button id="add-cancel" type="button" class="adm-btn ghost">Close</button>
        <button id="add-go" type="submit" class="adm-btn">Create account</button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<style is:global>
  .adm-main > #adm-app { max-width: 1180px; }
  .us-bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 12px; }
  .us-search { position: relative; flex: 1 1 260px; max-width: 380px; }
  .us-search svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--color-mute); pointer-events: none; }
  .adm-main .us-search input { height: 38px; padding-left: 36px; border-radius: 999px; }
  .adm-main .us-bar select { width: auto; min-width: 140px; height: 38px; border-radius: 999px; }
  .us-count { margin: 0 auto 0 4px; font-size: 13px; color: var(--color-mute); }
  .us-pager .us-count { margin: 0; }

  .us-table { overflow: hidden; border-radius: 18px; background: #fff; border: 1px solid var(--color-hairline); box-shadow: 0 1px 2px #1a05330a; }
  .us-head, .us-row { display: grid; grid-template-columns: minmax(0, 2.3fr) minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1.25fr) auto; gap: 14px; align-items: center; padding: 0 16px; }
  .us-head { height: 38px; background: #fcfaff; border-bottom: 1px solid var(--color-hairline); font: 700 11px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-mute); }
  .us-row { min-height: 54px; padding-top: 6px; padding-bottom: 6px; border-bottom: 1px solid #f1eaf9; transition: background-color 0.12s; }
  .us-row:last-of-type { border-bottom: 0; }
  .us-row:hover { background: #fbf9ff; }
  .us-row.is-off { background: #fff8f8; }
  .us-who { display: flex; align-items: center; gap: 11px; min-width: 0; }
  .us-who .adm-avatar { width: 34px; height: 34px; font-size: 13px; }
  .us-who > div { min-width: 0; }
  .us-who strong, .us-who small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .us-who strong { font-size: 14px; line-height: 1.3; color: var(--color-ink); }
  .us-who small { font-size: 12.5px; line-height: 1.3; color: var(--color-mute); }
  .us-tags { display: flex; flex-wrap: wrap; gap: 4px; align-items: center; min-width: 0; }
  .us-tags .adm-pill { font-size: 10.5px; line-height: 1.6; padding: 1px 8px; }
  .us-lock { font-size: 12px; color: var(--color-mute); }

  .us-plan { display: grid; gap: 1px; min-width: 0; max-width: 100%; padding: 5px 10px; border: 1.5px solid transparent; border-radius: 12px; background: #f6f3fc; text-align: left; font: inherit; color: var(--color-ink); }
  button.us-plan { cursor: pointer; }
  button.us-plan:hover { border-color: var(--color-violet); background: #f1ebff; }
  .us-plan b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
  .us-plan small { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11.5px; color: var(--color-mute); }
  .us-plan.is-paid { background: #efe7ff; }
  .us-plan.is-gift { background: #fff4d6; }
  .us-plan.is-gift small { color: #92400e; }
  .us-plan.is-soon small { color: #b45309; font-weight: 700; }
  .us-act { min-width: 0; font-size: 13px; line-height: 1.35; color: var(--color-body); }
  .us-act small { display: block; font-size: 12px; color: var(--color-mute); }
  .us-go { height: 32px; padding: 0 14px; border: 1.5px solid var(--color-hairline); border-radius: 10px; background: #fff; font: 700 13px var(--font-sans); color: var(--color-violet-deep); cursor: pointer; }
  .us-go:hover { border-color: var(--color-violet); background: var(--color-violet-soft); }
  .us-pager { display: flex; align-items: center; justify-content: space-between; margin-top: 12px; }

  /* the person's window */
  .us-dialog { width: min(680px, 96vw); max-height: 92vh; padding: 0; overflow: hidden; display: none; flex-direction: column; }
  .us-dialog[open] { display: flex; }
  .us-d-head { display: flex; align-items: center; gap: 12px; padding: 18px 20px 10px; }
  .us-d-head .adm-avatar { width: 44px; height: 44px; font-size: 17px; }
  .us-d-who { min-width: 0; flex: 1; }
  .us-d-who h2 { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 18px; }
  .us-d-who p { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; color: var(--color-mute); }
  .us-x { width: 34px; height: 34px; border: 0; border-radius: 50%; background: #f4f1fb; font-size: 22px; line-height: 1; color: var(--color-body); cursor: pointer; }
  .us-x:hover { background: #e9e1f8; }
  .us-facts { margin: 0; padding: 0 20px 12px; font-size: 12.5px; color: var(--color-mute); }
  .us-tabs { display: flex; gap: 4px; padding: 0 20px; border-bottom: 1px solid var(--color-hairline); }
  .us-tabs button { padding: 9px 14px; border: 0; border-bottom: 3px solid transparent; background: none; font: 700 14px var(--font-sans); color: var(--color-mute); cursor: pointer; }
  .us-tabs button.is-on { color: var(--color-violet-deep); border-bottom-color: var(--color-violet); }
  .us-dialog .adm-msg { margin: 8px 20px 0; min-height: 0; }
  #pane-plan, #pane-access { overflow-y: auto; padding: 14px 20px 20px; }

  .us-now { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 14px; background: linear-gradient(135deg, #f3ecff, #fff4d6); }
  .us-now b { display: block; font-size: 19px; color: var(--color-ink); }
  .us-now span { font-size: 13px; color: var(--color-body); }
  .us-now .adm-btn { margin-left: auto; flex: none; }
  .us-note { margin: 10px 0 0; padding: 9px 12px; border-radius: 10px; background: #fef3c7; color: #92400e; font-size: 13px; line-height: 1.5; }
  .us-modes { display: inline-flex; gap: 2px; margin: 16px 0 12px; padding: 3px; border-radius: 999px; background: var(--color-violet-soft); }
  .us-modes button { height: 30px; padding: 0 14px; border: 0; border-radius: 999px; background: none; font: 700 13px var(--font-sans); color: var(--color-violet-deep); cursor: pointer; }
  .us-modes button.is-on { background: #fff; color: var(--color-ink); box-shadow: 0 1px 3px #1a053328; }
  .us-form { display: grid; gap: 12px; }
  .us-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .us-chip { height: 32px; padding: 0 13px; border: 1.5px solid var(--color-hairline); border-radius: 999px; background: #fff; font: 700 13px var(--font-sans); color: var(--color-body); cursor: pointer; }
  .us-chip:hover { border-color: var(--color-violet); }
  .us-chip.is-on { border-color: var(--color-violet); background: var(--color-violet); color: #fff; }
  .us-custom { display: flex; gap: 8px; align-items: center; }
  .us-dialog .us-custom input, .us-dialog .us-custom select, .us-dialog .us-form select, .us-dialog .us-form input[type="date"] { height: 38px; width: auto; min-width: 110px; padding: 0 11px; border: 1.5px solid var(--color-hairline); border-radius: 10px; font: 500 14px var(--font-sans); }
  .us-dialog .us-form select { width: 100%; }
  .us-preview { margin: 0; padding: 10px 12px; border-radius: 10px; background: #f6f3fc; font-size: 13.5px; color: var(--color-ink); }
  .us-hist { margin: 18px 0 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .us-hist li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 10px; padding: 8px 12px; border-radius: 10px; background: #faf8ff; font-size: 13px; }
  .us-hist li small { color: var(--color-mute); grid-column: 1; }
  .us-hist li.is-run { background: #ecfdf5; }
  .us-h-title { margin: 20px 0 6px; font: 700 11.5px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-mute); }
  .us-section { margin: 0 0 18px; }
  .us-section h3 { margin: 0 0 8px; font-size: 14px; }
  .us-two { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .us-two select, .us-two input { flex: 1 1 200px; }

  @media (max-width: 900px) {
    .us-head { display: none; }
    .us-row { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "who go" "role plan" "act act"; gap: 8px 12px; padding: 12px 14px; }
    .us-row > :nth-child(1) { grid-area: who; }
    .us-row > :nth-child(2) { grid-area: role; }
    .us-row > :nth-child(3) { grid-area: plan; justify-self: end; }
    .us-row > :nth-child(4) { grid-area: act; }
    .us-row > :nth-child(5) { grid-area: go; justify-self: end; align-self: start; }
  }
  @media (max-width: 520px) {
    .us-now { flex-wrap: wrap; }
    .us-now .adm-btn { margin-left: 0; }
  }
</style>

<script>
  import { adminReady, adminFetch, el, say, day, when, number, can, adminInfo } from "../../lib/admin";

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const SIZE = 10; // a full page fits a laptop screen
  let page = 1;
  let query = "";
  let roleKey = "";
  let latest = 0; // so a slow answer to an old search cannot overwrite a newer one
  let roles: any[] = [];
  let canGivePlans = false;
  let shown: any[] = [];

  const fail = (err: unknown, fallback: string) => say("msg", err instanceof Error ? err.message : fallback, "bad");
  const date = (s: number) => new Date(s * 1000).toLocaleDateString([], { day: "numeric", month: "short", year: "numeric" });
  const dateLong = (d: Date) => d.toLocaleDateString([], { weekday: "short", day: "numeric", month: "long", year: "numeric" });

  function ago(seconds: number | null | undefined): string {
    if (!seconds) return "never";
    const s = Date.now() / 1000 - seconds;
    if (s < 90) return "just now";
    if (s < 3600) return `${Math.round(s / 60)} min ago`;
    if (s < 86400) return `${Math.round(s / 3600)} h ago`;
    if (s < 86400 * 14) return `${Math.round(s / 86400)} d ago`;
    return date(seconds);
  }

  function avatar(user: any): HTMLElement {
    const box = el("span", "adm-avatar");
    const initial = (user.name || user.email)[0].toUpperCase();
    if (user.picture) {
      const img = el("img");
      img.alt = "";
      img.referrerPolicy = "no-referrer";
      img.src = user.picture;
      img.addEventListener("error", () => img.replaceWith(document.createTextNode(initial)));
      box.append(img);
    } else {
      box.textContent = initial;
    }
    return box;
  }

  // ---- the list ----------------------------------------------------------------------------------------------------------
  function planChip(u: any): HTMLElement {
    const soon = u.planEnd && u.planSource !== "free" && u.planEnd - Date.now() / 1000 < 7 * 86400;
    const tone = u.planSource === "gift" ? "is-gift" : u.planSource === "paid" ? "is-paid" : "";
    const chip = el(canGivePlans ? "button" : "div", `us-plan ${tone} ${soon ? "is-soon" : ""}`.trim());
    const detail =
      u.planSource === "free"
        ? canGivePlans ? "Give a plan" : "No subscription"
        : u.planSource === "gift"
          ? u.planEnd ? `Given · until ${date(u.planEnd)}` : "Given · no end date"
          : u.planEnd ? `${u.planRenewalOff ? "Ends" : "Renews"} ${date(u.planEnd)}` : "Paid";
    chip.append(el("b", "", u.planName), el("small", "", detail));
    if (chip instanceof HTMLButtonElement) {
      chip.type = "button";
      chip.title = "Give, renew or end this person's plan";
      chip.addEventListener("click", () => openPerson(u, "plan"));
    }
    return chip;
  }

  function row(u: any): HTMLElement {
    const tr = el("div", `us-row${u.disabled ? " is-off" : ""}`);
    tr.setAttribute("role", "row");
    const who = el("div", "us-who");
    const names = el("div");
    names.append(el("strong", "", u.name || u.email), el("small", "", u.email));
    who.append(avatar(u), names);

    const tags = el("div", "us-tags");
    tags.append(el("span", `adm-pill ${u.role === "admin" ? "violet" : u.role === "user" ? "" : "warn"}`, u.roleName));
    if (u.hasPassword) tags.append(el("span", "adm-pill", "password"));
    if (u.disabled) tags.append(el("span", "adm-pill bad", "Blocked"));

    const act = el("div", "us-act");
    act.append(`Lv ${u.level} · ${number(u.xp)} XP`, el("small", "", `Last sign-in ${ago(u.lastLoginAt)}`));
    act.title = `Joined ${day(u.createdAt)} · ${number(u.logins)} sign-in${u.logins === 1 ? "" : "s"} · last ${when(u.lastLoginAt)}`;

    const go = el("button", "us-go", "Manage");
    go.type = "button";
    go.setAttribute("aria-label", `Manage ${u.email}`);
    go.addEventListener("click", () => openPerson(u, canGivePlans && !u.canManage ? "plan" : "access"));

    tr.append(who, tags, planChip(u), act, go);
    return tr;
  }

  async function load() {
    const mine = ++latest;
    try {
      const data = await adminFetch(`/api/admin/users?search=${encodeURIComponent(query)}&page=${page}&pageSize=${SIZE}&role=${encodeURIComponent(roleKey)}`);
      if (mine !== latest) return;
      canGivePlans = !!data.canGivePlans;
      shown = data.users;
      $("rows").replaceChildren(...data.users.map(row));
      const pages = Math.max(1, Math.ceil(data.total / SIZE));
      $("count").textContent = `${number(data.total)} ${query || roleKey ? "match" + (data.total === 1 ? "" : "es") : data.total === 1 ? "person" : "people"}`;
      $("page").textContent = `Page ${page} of ${pages}`;
      ($("prev") as HTMLButtonElement).disabled = page <= 1;
      ($("next") as HTMLButtonElement).disabled = page >= pages;
      $("empty").hidden = data.users.length > 0;
      $("empty").textContent = query || roleKey ? "Nobody matches." : "Nobody has signed in yet.";
    } catch (err) {
      fail(err, "Could not load the users.");
    }
  }

  // ---- one person --------------------------------------------------------------------------------------------------------
  const dialog = $<HTMLDialogElement>("us-dialog");
  let person: any = null;
  let state: any = null;
  let mode: "give" | "extend" | "end" = "give";
  let choice = { preset: "1m", amount: 1, unit: "months", until: "", plan: "" };

  function showTab(tab: "plan" | "access") {
    $("pane-plan").hidden = tab !== "plan";
    $("pane-access").hidden = tab !== "access";
    for (const t of ["plan", "access"]) {
      $(`tab-${t}`).classList.toggle("is-on", t === tab);
      $(`tab-${t}`).setAttribute("aria-selected", String(t === tab));
    }
  }
  $("tab-plan").addEventListener("click", () => showTab("plan"));
  $("tab-access").addEventListener("click", () => showTab("access"));
  $("us-close").addEventListener("click", () => dialog.close());
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close(); // a click on the backdrop
  });

  async function openPerson(u: any, tab: "plan" | "access") {
    person = u;
    say("us-msg", "", "");
    $("us-avatar").replaceChildren(avatar(u));
    $("us-name").textContent = u.name || u.email;
    $("us-email").textContent = u.email;
    $("us-facts").textContent = `Joined ${day(u.createdAt)} · ${number(u.logins)} sign-in${u.logins === 1 ? "" : "s"} · last ${when(u.lastLoginAt)} · Lv ${u.level} · ${number(u.xp)} XP`;
    $("tab-plan").hidden = !canGivePlans;
    const wanted = tab === "plan" && !canGivePlans ? "access" : tab;
    renderAccess();
    showTab(wanted);
    if (!dialog.open) dialog.showModal();
    if (canGivePlans) {
      $("pane-plan").replaceChildren(el("p", "adm-hint", "Loading…"));
      try {
        state = await adminFetch(`/api/admin/users/${encodeURIComponent(u.id)}/plan`);
        mode = state.gift ? "extend" : "give";
        choice = { preset: "1m", amount: 1, unit: "months", until: "", plan: (state.gift || state.paid)?.planId || state.plans.find((p: any) => p.active)?.id || state.plans[0]?.id || "" };
        renderPlan();
      } catch (err) {
        $("pane-plan").replaceChildren(el("p", "adm-msg bad", err instanceof Error ? err.message : "Could not load the plan."));
      }
    }
  }

  // The same calendar rule the server uses, to show the end date before anything is saved.
  function addPeriod(start: Date, unit: string, n: number): Date {
    if (unit === "days") return new Date(start.getTime() + n * 86400000);
    const months = n * (unit === "years" ? 12 : 1);
    const index = start.getUTCFullYear() * 12 + start.getUTCMonth() + months;
    const year = Math.floor(index / 12);
    const month = index % 12;
    const last = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
    const out = new Date(start);
    out.setUTCFullYear(year, month, Math.min(start.getUTCDate(), last));
    return out;
  }

  /** What the chosen length means for the request, and the date it leads to (null when it is not complete yet). */
  function length(base: Date): { body: Record<string, unknown>; end: Date | null; text: string } | null {
    if (choice.preset === "lifetime") return { body: { unit: "lifetime" }, end: null, text: "with no end date" };
    if (choice.preset === "until") {
      if (!choice.until) return null;
      const end = new Date(`${choice.until}T23:59:59`);
      return { body: { unit: "until", until: end.getTime() / 1000 }, end, text: `until ${dateLong(end)}` };
    }
    const preset: Record<string, [number, string]> = { "1m": [1, "months"], "3m": [3, "months"], "6m": [6, "months"], "12m": [12, "months"] };
    const [amount, unit] = choice.preset === "custom" ? [choice.amount, choice.unit] : preset[choice.preset];
    if (!(amount >= 1)) return null;
    const end = addPeriod(base, unit, amount);
    return { body: { unit, amount }, end, text: `for ${amount} ${amount === 1 ? unit.replace(/s$/, "") : unit}, to ${dateLong(end)}` };
  }

  async function send(body: Record<string, unknown>, ok: string, button: HTMLButtonElement) {
    button.disabled = true;
    say("us-msg", "", "");
    try {
      state = await adminFetch(`/api/admin/users/${encodeURIComponent(person.id)}/plan`, { method: "POST", body: JSON.stringify(body) });
      mode = state.gift ? "extend" : "give";
      say("us-msg", ok, "ok");
      renderPlan();
      void load();
    } catch (err) {
      say("us-msg", err instanceof Error ? err.message : "Could not do that.", "bad");
      button.disabled = false;
    }
  }

  function renderPlan() {
    const s = state;
    const out: Node[] = [];
    const sourceText = s.current.source === "free" ? "No subscription" : s.current.source === "gift" ? `Given by the team · ${s.current.end ? `until ${date(s.current.end)}` : "no end date"}` : s.paid?.renewalOff ? `Paid with Razorpay · ends ${s.paid.end ? date(s.paid.end) : ""}` : `Paid with Razorpay · renews ${s.paid?.end ? date(s.paid.end) : ""}`;
    const now = el("div", "us-now");
    const text = el("div");
    text.append(el("b", "", s.current.planName), el("span", "", sourceText));
    now.append(text);
    if (s.paid && !s.paid.renewalOff && !s.gift) {
      const stop = el("button", "adm-btn small danger", "Stop renewing");
      stop.type = "button";
      stop.title = "They keep the plan until the period they paid for ends, then nothing more is charged";
      stop.addEventListener("click", () => {
        if (confirm(`Stop ${person.email}'s paid plan renewing? They keep it until ${s.paid.end ? date(s.paid.end) : "the end of the period"}, then nothing more is charged.`)) void send({ action: "stop_renewal" }, "Renewal is off. They keep the plan until the paid period ends.", stop);
      });
      now.append(stop);
    }
    out.push(now);
    if (s.gift && s.paid) out.push(el("p", "us-note", `They also pay for ${s.paid.planName}${s.paid.end ? ` (until ${date(s.paid.end)})` : ""}. The plan you gave takes priority while it runs; when it ends, their paid plan is back.`));
    else if (!s.gift && s.paid && mode === "give") out.push(el("p", "us-note", `They pay for ${s.paid.planName} through Razorpay. A plan you give takes priority while it runs, and their paid plan is back when it ends.`));

    // what to do
    const modes: [typeof mode, string][] = [["give", s.gift ? "Change plan" : "Give a plan"]];
    if (s.gift) {
      if (s.gift.end) modes.push(["extend", "Extend"]); // a plan with no end date has nothing to extend
      modes.push(["end", "End now"]);
    }
    if (mode === "extend" && !s.gift?.end) mode = s.gift ? "end" : "give";
    const bar = el("div", "us-modes");
    for (const [key, label] of modes) {
      const b = el("button", key === mode ? "is-on" : "", label);
      b.type = "button";
      b.addEventListener("click", () => {
        mode = key;
        renderPlan();
      });
      bar.append(b);
    }
    if (modes.length > 1) out.push(bar);
    else out.push(el("p", "us-h-title", modes[0][1]));

    const form = el("div", "us-form");
    if (mode === "end") {
      form.append(el("p", "adm-hint", `${person.email} goes back to ${s.paid ? s.paid.planName : "Free"} at once. The plan you gave stays in the history below.`));
      const end = el("button", "adm-btn danger", "End the plan now");
      end.type = "button";
      end.addEventListener("click", () => {
        if (confirm(`End the ${s.gift.planName} plan you gave ${person.email}, now?`)) void send({ action: "end" }, "Plan ended.", end);
      });
      form.append(end);
    } else {
      if (mode === "give") {
        const field = el("label", "adm-field");
        field.append(el("span", "", "Plan"));
        const select = el("select");
        select.setAttribute("aria-label", "Plan to give");
        for (const p of s.plans) {
          const o = el("option", "", p.name + (p.active ? "" : " (not on sale)"));
          o.value = p.id;
          select.append(o);
        }
        select.value = choice.plan;
        select.addEventListener("change", () => {
          choice.plan = select.value;
          update();
        });
        field.append(select);
        form.append(field);
      } else {
        form.append(el("p", "adm-hint", `Adds time to the ${s.gift.planName} plan, from its current end${s.gift.end ? ` (${date(s.gift.end)})` : ""}.`));
      }

      const chips = el("div", "us-chips");
      const presets: [string, string][] = [["1m", "1 month"], ["3m", "3 months"], ["6m", "6 months"], ["12m", "1 year"], ["custom", "Custom"], ["until", "Until a date"], ["lifetime", "No end date"]];
      const submit = el("button", "adm-btn", "");
      submit.type = "button";
      const preview = el("p", "us-preview");
      const extra = el("div");
      const base = () => (mode === "extend" && s.gift?.end ? new Date(s.gift.end * 1000) : new Date());

      const update = () => {
        chips.querySelectorAll("button").forEach((b) => b.classList.toggle("is-on", b.dataset.p === choice.preset));
        extra.replaceChildren();
        if (choice.preset === "custom") {
          const wrap = el("div", "us-custom");
          const n = el("input");
          n.type = "number";
          n.min = "1";
          n.max = "3650";
          n.value = String(choice.amount);
          n.setAttribute("aria-label", "How many");
          n.addEventListener("input", () => {
            choice.amount = Number(n.value);
            refresh();
          });
          const unit = el("select");
          unit.setAttribute("aria-label", "Days, months or years");
          for (const u of ["days", "months", "years"]) {
            const o = el("option", "", u);
            o.value = u;
            unit.append(o);
          }
          unit.value = choice.unit;
          unit.addEventListener("change", () => {
            choice.unit = unit.value;
            refresh();
          });
          wrap.append(n, unit);
          extra.append(wrap);
        } else if (choice.preset === "until") {
          const d = el("input");
          d.type = "date";
          d.setAttribute("aria-label", "End date");
          const tomorrow = new Date(Date.now() + 86400000);
          d.min = tomorrow.toISOString().slice(0, 10);
          d.value = choice.until;
          d.addEventListener("input", () => {
            choice.until = d.value;
            refresh();
          });
          extra.append(d);
        }
        refresh();
      };
      const refresh = () => {
        const len = length(base());
        const planName = s.plans.find((p: any) => p.id === choice.plan)?.name ?? "";
        submit.disabled = !len || (mode === "give" && !choice.plan);
        if (!len) preview.textContent = choice.preset === "until" ? "Pick the last day." : "Enter how long.";
        else if (mode === "give") preview.textContent = `${planName} from today, ${len.text}. It does not renew by itself, and nothing is charged.`;
        else preview.textContent = len.end ? `The plan will end on ${dateLong(len.end)}.` : "The plan will have no end date.";
        submit.textContent = mode === "give" ? `Give ${planName || "the plan"}` : "Extend the plan";
      };
      for (const [key, label] of presets) {
        const b = el("button", "us-chip", label);
        b.type = "button";
        b.dataset.p = key;
        b.addEventListener("click", () => {
          choice.preset = key;
          update();
        });
        chips.append(b);
      }
      submit.addEventListener("click", () => {
        const len = length(base());
        if (!len) return;
        if (mode === "give") void send({ action: "give", planId: choice.plan, ...len.body }, "Plan given. They have it now.", submit);
        else void send({ action: "extend", ...len.body }, "Plan extended.", submit);
      });
      form.append(el("span", "adm-hint", mode === "give" ? "For how long?" : "Extend by"), chips, extra, preview, submit);
      queueMicrotask(update);
    }
    out.push(form);

    // history
    if (s.history.length) {
      out.push(el("p", "us-h-title", "History"));
      const list = el("ul", "us-hist");
      for (const h of s.history) {
        const li = el("li", h.running ? "is-run" : "");
        const kind = h.manual ? "Given by the team" : "Paid with Razorpay";
        li.append(el("span", "", `${h.planName || "Plan"} · ${kind}`), el("span", `adm-pill ${h.running ? "ok" : ""}`, h.running ? "Running" : h.status === "active" && h.manual ? "Expired" : h.status));
        li.append(el("small", "", `${h.start ? date(h.start) : "—"} → ${h.end ? date(h.end) : h.manual ? "no end date" : "—"}`));
        list.append(li);
      }
      out.push(list);
    }
    $("pane-plan").replaceChildren(...out);
  }

  // ---- access: role, password, block ------------------------------------------------------------------------------------
  function renderAccess() {
    const u = person;
    const out: HTMLElement[] = [];
    if (!u.canManage) {
      const me = adminInfo()?.user;
      out.push(el("p", "adm-hint", me && me.id === u.id ? "This is you. Your own role, password and block state are changed by another administrator." : u.isEnvAdmin ? "This account is an administrator set in the server's settings, so it cannot be changed here." : "This person can do more than your role can, so you cannot change them."));
    } else {
      if (can("users.roles")) {
        const sec = el("section", "us-section");
        sec.append(el("h3", "", "Role"));
        const line = el("div", "us-two");
        const select = el("select");
        select.setAttribute("aria-label", `Role of ${u.email}`);
        for (const r of roles.filter((r) => r.grantable || r.key === u.role)) {
          const option = el("option", "", r.name);
          option.value = r.key;
          option.disabled = !r.grantable;
          select.append(option);
        }
        select.value = u.role;
        const save = el("button", "adm-btn", "Save role");
        save.type = "button";
        save.addEventListener("click", async () => {
          if (select.value === u.role) return say("us-msg", "That is already their role.", "");
          const chosen = roles.find((r) => r.key === select.value);
          if (!confirm(`Make ${u.email} ${chosen ? chosen.name : select.value}?${select.value === "user" ? " Their password is removed and they lose all access to this admin." : ""}`)) return;
          save.disabled = true;
          try {
            await adminFetch(`/api/admin/users/${encodeURIComponent(u.id)}/role`, { method: "PUT", body: JSON.stringify({ role: select.value }) });
            say("msg", `${u.email} is now ${chosen ? chosen.name : select.value}.`, "ok");
            dialog.close();
            await load();
          } catch (err) {
            say("us-msg", err instanceof Error ? err.message : "Could not change the role.", "bad");
            save.disabled = false;
          }
        });
        line.append(select, save);
        sec.append(line);
        out.push(sec);
      }
      if (can("users.create") && u.role !== "user") {
        const sec = el("section", "us-section");
        sec.append(el("h3", "", u.hasPassword ? "Reset password" : "Set a password"));
        const line = el("div", "us-two");
        const pw = el("input");
        pw.type = "password";
        pw.autocomplete = "new-password";
        pw.placeholder = "At least 10 characters";
        pw.setAttribute("aria-label", "New password");
        const save = el("button", "adm-btn", "Save password");
        save.type = "button";
        save.addEventListener("click", async () => {
          save.disabled = true;
          try {
            await adminFetch(`/api/admin/users/${encodeURIComponent(u.id)}/password`, { method: "POST", body: JSON.stringify({ password: pw.value }) });
            pw.value = "";
            say("us-msg", `A new password is set for ${u.email}. They are signed out everywhere.`, "ok");
          } catch (err) {
            say("us-msg", err instanceof Error ? err.message : "Could not set the password.", "bad");
          } finally {
            save.disabled = false;
          }
        });
        line.append(pw, save);
        sec.append(line, el("p", "adm-hint", "Whoever had the old password is signed out."));
        out.push(sec);
      }
      if (can("users.block")) {
        const sec = el("section", "us-section");
        sec.append(el("h3", "", u.disabled ? "Blocked" : "Block"));
        sec.append(el("p", "adm-hint", u.disabled ? "They cannot sign in. Unblock them to let them back in." : "They are signed out at once and cannot sign in until you unblock them."));
        const toggle = el("button", `adm-btn ${u.disabled ? "ghost" : "danger"}`, u.disabled ? "Unblock" : "Block this person");
        toggle.type = "button";
        toggle.addEventListener("click", async () => {
          if (!u.disabled && !confirm(`Block ${u.email}? They are signed out at once and cannot sign in again until you unblock them.`)) return;
          toggle.disabled = true;
          try {
            await adminFetch(`/api/admin/users/${encodeURIComponent(u.id)}/disabled`, { method: "POST", body: JSON.stringify({ disabled: !u.disabled }) });
            say("msg", `${u.email} is now ${u.disabled ? "unblocked" : "blocked"}.`, "ok");
            dialog.close();
            await load();
          } catch (err) {
            say("us-msg", err instanceof Error ? err.message : "Could not change that.", "bad");
            toggle.disabled = false;
          }
        });
        sec.append(toggle);
        out.push(sec);
      }
      if (out.length === 0) out.push(el("p", "adm-hint", "Your role cannot change roles, passwords or blocking."));
    }
    $("pane-access").replaceChildren(...out);
  }

  // ---- roles, adding a staff account ----------------------------------------------------------------------------------
  async function loadRoles() {
    try {
      roles = (await adminFetch("/api/admin/roles")).roles;
    } catch {
      roles = [];
    }
    const filter = $<HTMLSelectElement>("role-filter");
    for (const r of roles) {
      const option = el("option", "", r.name);
      option.value = r.key;
      filter.append(option);
    }
    const addRole = $<HTMLSelectElement>("add-role");
    for (const r of roles.filter((r) => r.key !== "user" && r.grantable)) {
      const option = el("option", "", r.name + (r.permissions.length === 0 && r.key !== "admin" ? " (no permissions yet)" : ""));
      option.value = r.key;
      addRole.append(option);
    }
  }

  function setupAdd() {
    if (!can("users.create")) return;
    const open = $("add-open");
    const dlg = $<HTMLDialogElement>("add-dialog");
    open.hidden = false;
    open.addEventListener("click", () => {
      say("add-msg", "", "");
      dlg.showModal();
    });
    $("add-cancel").addEventListener("click", () => dlg.close());
    $("add-form").addEventListener("submit", async (event) => {
      event.preventDefault();
      const go = $<HTMLButtonElement>("add-go");
      const val = (id: string) => $<HTMLInputElement>(id).value;
      go.disabled = true;
      try {
        const made = await adminFetch("/api/admin/users", {
          method: "POST",
          body: JSON.stringify({ email: val("add-email"), name: val("add-name"), password: val("add-password"), role: val("add-role") }),
        });
        say("add-msg", `Created ${made.user.email} as ${made.user.roleName}. They can sign in at /admin/ with that email and password.`, "ok");
        $<HTMLFormElement>("add-form").reset();
        await load();
      } catch (err) {
        say("add-msg", err instanceof Error ? err.message : "Could not create the account.", "bad");
      } finally {
        go.disabled = false;
      }
    });
  }

  let timer: number | undefined;
  $("search").addEventListener("input", () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      query = $<HTMLInputElement>("search").value.trim();
      page = 1;
      void load();
    }, 250);
  });
  $("role-filter").addEventListener("change", () => {
    roleKey = $<HTMLSelectElement>("role-filter").value;
    page = 1;
    void load();
  });
  $("prev").addEventListener("click", () => {
    page -= 1;
    void load();
  });
  $("next").addEventListener("click", () => {
    page += 1;
    void load();
  });

  adminReady().then(async () => {
    setupAdd();
    await loadRoles();
    await load();
  });
  void shown;
</script>
