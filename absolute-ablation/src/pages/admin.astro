---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Admin — Chord Suno" noindex>
  <Nav />
  <main id="main-content" class="ad">
    <div class="wrap">
      <h1>YouTube access</h1>
      <p class="lead">
        YouTube often refuses downloads from a server's address. Cookies from logged-in accounts get past it. Add several
        accounts: downloads take turns between them, each is capped per hour, and one that YouTube blocks rests while the
        others carry on. Cookies expire, so replace them here when an account stops working — no redeploy needed.
      </p>

      <section class="card" aria-labelledby="h-token">
        <h2 id="h-token">1 · Admin token</h2>
        <p class="hint">The <code>ADMIN_TOKEN</code> you set in Coolify. It stays in this browser tab only.</p>
        <form id="token-form" class="row">
          <input id="token" type="password" autocomplete="off" placeholder="Admin token" />
          <button type="submit" class="btn">Connect</button>
        </form>
        <p id="token-msg" class="msg" role="status"></p>
      </section>

      <section id="status-card" class="card hidden" aria-labelledby="h-status">
        <h2 id="h-status">2 · What the server has</h2>
        <ul id="status" class="status"></ul>
        <div class="row">
          <button id="test" type="button" class="btn">Test every account now</button>
          <span class="hint">Asks YouTube for a short public video's details with each account (nothing is downloaded).</span>
        </div>
        <ul id="test-result" class="attempts"></ul>
        <h3>Recent download failures</h3>
        <p id="failures-empty" class="hint">None since the server last started.</p>
        <ul id="failures" class="attempts"></ul>
      </section>

      <section id="accounts-card" class="card hidden" aria-labelledby="h-accounts">
        <h2 id="h-accounts">3 · Accounts</h2>
        <ul id="accounts" class="accounts"></ul>
        <p id="accounts-empty" class="hint hidden">No accounts yet. Downloads are made anonymously, which YouTube often blocks from a server.</p>

        <h3>Add an account</h3>
        <details>
          <summary>How to export its cookies</summary>
          <ol class="steps">
            <li>Make a separate Google account for this (YouTube may restrict an account used for downloads — never use your own).</li>
            <li>In a <strong>private / incognito window</strong>, sign in to that account on youtube.com.</li>
            <li>With that tab on youtube.com, use a cookies.txt extension (for example "Get cookies.txt LOCALLY") and export. It must be the <strong>Netscape cookies.txt</strong> format.</li>
            <li>Close the private window straight away, so the browser does not refresh those cookies and invalidate them.</li>
            <li>Paste the whole file below with a name for the account, then press Add.</li>
          </ol>
        </details>
        <input id="label" type="text" maxlength="60" placeholder="Name, for example Account 2" />
        <textarea id="cookies" rows="7" spellcheck="false" placeholder="# Netscape HTTP Cookie File&#10;.youtube.com&#9;TRUE&#9;/&#9;TRUE&#9;1800000000&#9;SAPISID&#9;..."></textarea>
        <div class="row">
          <button id="add" type="button" class="btn">Add account</button>
        </div>
        <p id="accounts-msg" class="msg" role="status"></p>
      </section>
    </div>
  </main>
</Layout>

<style is:global>
  .ad { min-height: calc(100vh - 64px); padding: 48px 20px 80px; background: linear-gradient(180deg, #fbf7ff, #fff 60%); }
  .ad .wrap { max-width: 760px; margin: 0 auto; }
  .ad h1 { margin: 0 0 8px; font-size: 30px; font-weight: 800; letter-spacing: -0.03em; color: var(--color-ink); }
  .ad .lead { margin: 0 0 24px; color: var(--color-body); line-height: 1.6; }
  .ad .card { margin-bottom: 16px; padding: 20px 22px; border-radius: 18px; background: #fff; border: 1px solid var(--color-hairline); box-shadow: 0 1px 2px #1a05330a; }
  .ad .card.hidden, .ad .hidden { display: none; }
  .ad h2 { margin: 0 0 8px; font-size: 16px; font-weight: 700; color: var(--color-ink); }
  .ad h3 { margin: 18px 0 8px; font-size: 14px; font-weight: 700; color: var(--color-ink); }
  .ad .hint { margin: 0 0 12px; font-size: 13.5px; color: var(--color-mute); }
  .ad code { padding: 1px 6px; border-radius: 6px; background: #f3eeff; font: 600 12.5px var(--font-mono); }
  .ad .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .ad input[type="password"], .ad input[type="text"] { flex: 1; min-width: 200px; width: 100%; height: 44px; padding: 0 14px; border-radius: 12px; border: 1.5px solid var(--color-hairline); font: 500 15px var(--font-sans); outline: none; }
  .ad .row input[type="password"] { width: auto; }
  .ad input:focus, .ad textarea:focus { border-color: var(--color-violet); box-shadow: 0 0 0 3px #7c3aed1f; }
  .ad textarea { width: 100%; margin: 10px 0; padding: 12px 14px; border-radius: 12px; border: 1.5px solid var(--color-hairline); font: 500 12.5px/1.5 var(--font-mono); resize: vertical; outline: none; }
  .ad .btn { height: 42px; padding: 0 18px; border: 0; border-radius: 12px; cursor: pointer; color: #fff; font: 700 14px var(--font-sans); background: linear-gradient(135deg, #7c3aed, #5b21b6); }
  .ad .btn.small { height: 32px; padding: 0 12px; font-size: 13px; }
  .ad .btn.ghost { color: var(--color-violet-deep); background: var(--color-violet-soft); }
  .ad .btn.danger { color: var(--color-error); background: #fee2e2; }
  .ad .btn:disabled { opacity: 0.6; cursor: progress; }
  .ad .msg { min-height: 20px; margin: 10px 0 0; font-size: 14px; }
  .ad .msg.ok { color: var(--color-success); }
  .ad .msg.bad { color: var(--color-error); }
  .ad .status, .ad .attempts, .ad .accounts { margin: 0 0 14px; padding: 0; list-style: none; display: grid; gap: 6px; }
  .ad .status li, .ad .attempts li { display: flex; gap: 10px; align-items: baseline; font-size: 14px; color: var(--color-body); }
  .ad .dot { flex: none; width: 10px; height: 10px; margin-top: 4px; border-radius: 50%; background: var(--color-mute); }
  .ad .dot.ok { background: var(--color-success); }
  .ad .dot.bad { background: var(--color-error); }
  .ad .dot.warn { background: var(--color-warning); }
  .ad .account { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 12px 14px; border-radius: 14px; border: 1px solid var(--color-hairline); background: #fdfbff; }
  .ad .account .who { min-width: 0; }
  .ad .account strong { display: block; font-size: 14.5px; color: var(--color-ink); }
  .ad .account small { display: block; margin-top: 2px; font-size: 12.5px; color: var(--color-mute); line-height: 1.5; }
  .ad .account .acts { display: flex; gap: 8px; }
  .ad .pill { display: inline-block; margin-left: 8px; padding: 1px 8px; border-radius: 999px; font: 700 11px/1.6 var(--font-mono); text-transform: uppercase; letter-spacing: 0.04em; vertical-align: 1px; }
  .ad .pill.ready { background: #d1fae5; color: #065f46; }
  .ad .pill.resting { background: #fee2e2; color: #991b1b; }
  .ad .pill.full { background: #fef3c7; color: #92400e; }
  .ad .steps { margin: 10px 0 0; padding-left: 20px; color: var(--color-body); font-size: 14px; line-height: 1.7; }
  .ad details { margin-bottom: 10px; font-size: 14px; }
  .ad summary { cursor: pointer; font-weight: 600; color: var(--color-violet-deep); }
</style>

<script>
  import { API_BASE } from "../lib/api";

  const $ = (id: string) => document.getElementById(id)!;
  const tokenInput = $("token") as HTMLInputElement;
  const say = (id: string, text: string, kind: "ok" | "bad" | "") => {
    const node = $(id);
    node.textContent = text;
    node.className = `msg ${kind}`.trim();
  };

  let token = "";
  try {
    token = sessionStorage.getItem("cs-admin") ?? "";
  } catch {
    // no storage: the token is just asked for again
  }

  async function call(path: string, init: RequestInit = {}) {
    const res = await fetch(`${API_BASE}${path}`, { ...init, headers: { ...(init.headers ?? {}), "X-Admin-Token": token, "Content-Type": "application/json" } });
    const body = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(body.detail || `Request failed (${res.status})`);
    return body;
  }

  const item = (ok: boolean | "warn", text: string) => {
    const li = document.createElement("li");
    const dot = document.createElement("span");
    dot.className = `dot ${ok === "warn" ? "warn" : ok ? "ok" : "bad"}`;
    const label = document.createElement("span");
    label.textContent = text;
    li.append(dot, label);
    return li;
  };

  const when = (seconds: number) => new Date(seconds * 1000).toLocaleString([], { dateStyle: "medium", timeStyle: "short" });

  function showStatus(info: any) {
    const ready = info.accounts.filter((a: any) => a.status === "ready").length;
    $("status").replaceChildren(
      item(true, `yt-dlp ${info.ytDlp}`),
      item(info.playerScriptSolver, info.playerScriptSolver ? "Player-script solver installed" : "Player-script solver missing (yt-dlp-ejs): downloads will fail"),
      item(info.jsRuntime.node || info.jsRuntime.deno, info.jsRuntime.node || info.jsRuntime.deno ? `JavaScript runtime found (${info.jsRuntime.node ? "node" : "deno"})` : "No JavaScript runtime (node or deno) in this image"),
      item(info.accounts.length === 0 ? "warn" : ready > 0, info.accounts.length === 0 ? "No accounts: downloads are anonymous" : `${ready} of ${info.accounts.length} account${info.accounts.length === 1 ? "" : "s"} ready (cap ${info.hourlyCap} downloads per account per hour)`),
      item(info.proxy ? true : "warn", info.proxy ? "Proxy configured" : "No proxy"),
      item(true, `Line: ${info.queue.running} running, ${info.queue.waiting} waiting (${info.queue.workers} at a time). Visitors may start ${info.newSongsPerHour || "unlimited"} new songs per hour.`),
    );
  }

  function showFailures(failures: any[]) {
    $("failures-empty").classList.toggle("hidden", failures.length > 0);
    $("failures").replaceChildren(
      ...failures.map((f: any) => item(f.verdict.startsWith("this video") ? "warn" : false, `${when(f.at)} · ${f.song} · ${f.account} · ${f.verdict}: ${f.error}`)),
    );
  }

  function showAccounts(accounts: any[]) {
    $("accounts-empty").classList.toggle("hidden", accounts.length > 0);
    $("accounts").replaceChildren(
      ...accounts.map((a) => {
        const li = document.createElement("li");
        li.className = "account";
        const who = document.createElement("div");
        who.className = "who";
        const name = document.createElement("strong");
        name.textContent = a.label;
        const pill = document.createElement("span");
        pill.className = `pill ${a.status}`;
        pill.textContent = a.status === "resting" ? "resting" : a.status === "full" ? "at hourly cap" : "ready";
        name.append(pill);
        const detail = document.createElement("small");
        const parts = [
          `${a.cookies} cookies${a.loggedIn ? ", signed in" : ", no sign-in cookies"}`,
          a.expiresSoonest ? `first one expires ${new Date(a.expiresSoonest * 1000).toLocaleDateString()}` : "",
          `${a.usedLastHour}/${a.hourlyCap} downloads this hour`,
          a.status === "resting" && a.restingUntil ? `resting until ${when(a.restingUntil)} after YouTube refused it (${a.failures}×)` : "",
          a.lastError && a.status === "resting" ? a.lastError : "",
          `from ${a.source}`,
        ].filter(Boolean);
        detail.textContent = parts.join(" · ");
        who.append(name, detail);
        const acts = document.createElement("div");
        acts.className = "acts";
        if (a.status === "resting") {
          const retry = document.createElement("button");
          retry.className = "btn small ghost";
          retry.textContent = "Try again now";
          retry.addEventListener("click", async () => {
            await call(`/api/admin/youtube/accounts/${encodeURIComponent(a.id)}/reset`, { method: "POST" });
            await refresh();
          });
          acts.append(retry);
        }
        if (a.removable) {
          const remove = document.createElement("button");
          remove.className = "btn small danger";
          remove.textContent = "Remove";
          remove.addEventListener("click", async () => {
            if (!confirm(`Remove ${a.label}?`)) return;
            try {
              await call(`/api/admin/youtube/accounts/${encodeURIComponent(a.id)}`, { method: "DELETE" });
              say("accounts-msg", `${a.label} removed.`, "ok");
              await refresh();
            } catch (err) {
              say("accounts-msg", err instanceof Error ? err.message : "Could not remove.", "bad");
            }
          });
          acts.append(remove);
        }
        li.append(who, acts);
        return li;
      }),
    );
  }

  async function refresh(test = false) {
    const info = await call(`/api/admin/youtube${test ? "?test=1" : ""}`);
    showStatus(info);
    showAccounts(info.accounts);
    showFailures(info.recentFailures || []);
    $("status-card").classList.remove("hidden");
    $("accounts-card").classList.remove("hidden");
    if (test) {
      const list = $("test-result");
      list.replaceChildren(
        item(info.test.ok, info.test.ok ? "At least one way in works" : "YouTube is blocking every account and anonymous requests — add or replace cookies"),
        ...info.test.results.map((r: any) => item(r.ok, `${r.label}: ${r.ok ? "YouTube answered" : r.attempts[r.attempts.length - 1].result}`)),
      );
    }
  }

  $("token-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    token = tokenInput.value.trim();
    try {
      await refresh();
      try {
        sessionStorage.setItem("cs-admin", token);
      } catch {
        // fine
      }
      say("token-msg", "Connected.", "ok");
    } catch (err) {
      say("token-msg", err instanceof Error ? err.message : "Could not connect.", "bad");
    }
  });

  $("test").addEventListener("click", async () => {
    const button = $("test") as HTMLButtonElement;
    button.disabled = true;
    button.textContent = "Testing…";
    try {
      await refresh(true);
    } catch (err) {
      say("token-msg", err instanceof Error ? err.message : "Test failed.", "bad");
    } finally {
      button.disabled = false;
      button.textContent = "Test every account now";
    }
  });

  $("add").addEventListener("click", async () => {
    const text = ($("cookies") as HTMLTextAreaElement).value;
    const label = ($("label") as HTMLInputElement).value;
    try {
      const added = await call("/api/admin/youtube/accounts", { method: "POST", body: JSON.stringify({ cookies: text, label }) });
      ($("cookies") as HTMLTextAreaElement).value = "";
      ($("label") as HTMLInputElement).value = "";
      say("accounts-msg", `${added.label} added. Press “Test every account now” to check it works.`, "ok");
      await refresh();
    } catch (err) {
      say("accounts-msg", err instanceof Error ? err.message : "Could not add.", "bad");
    }
  });

  if (token) {
    tokenInput.value = token;
    refresh().then(() => say("token-msg", "Connected.", "ok")).catch(() => say("token-msg", "", ""));
  }
</script>
