    .pz-now, .pz-next { padding: 12px 6px 10px; }
    .pz-modes button { padding: 0 13px; }
    .pz-preview { flex-direction: column; text-align: center; }
    .pz-shapes, .pz-notes.dark { justify-content: center; }
