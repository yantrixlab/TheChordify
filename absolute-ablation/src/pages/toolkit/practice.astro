</style>

<script>
  import { Metronome, clampBpm, defaultAccents } from "../../lib/tools/metronome";
  import { MicError, NoiseGate, SILENT_MIC_TEXT, SilenceWatch, fillMicPicker, levelPercent, openMic, type Mic } from "../../lib/tools/audio";
  import { ChordListener, type Heard } from "../../lib/tools/listener";
  import { scoreChord } from "../../lib/tools/chroma";
  import { diagramSvg } from "../../lib/tools/diagram";
  import { strumShape } from "../../lib/tools/strum";
  import { getAllGuitarShapes, chordKeyLabel, chordNotes, type GuitarShape } from "../../lib/chordShapes";
  import { initGate } from "../../lib/tools/gate";
  import { toast } from "../../lib/toast";
  import { track } from "../../lib/analytics";

  const gate = initGate("practice_chords", "practice");
  const noiseGate = new NoiseGate(55);
  const silence = new SilenceWatch();
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const all = <T extends HTMLElement>(selector: string) => [...document.querySelectorAll<T>(selector)];

  // ---- what is remembered on this device ----
  type Mode = "explore" | "follow" | "listen" | "minute" | "progression" | "quiz";
  interface Prefs {
    mode: Mode; chords: string[]; shapes: Record<string, number>; order: "random" | "list"; bpm: number; per: number; click: boolean;
    limit: number; sens: number; prog: { key: string; steps: string }; pick: { root: string; acc: string; q: string };
    trainer: { on: boolean; every: number; step: number; target: number }; quizAny: boolean;
  }
  const KEY = "cs-practice";
  const BEST = "cs-practice-best";
  let prefs: Prefs = {
    mode: "explore", chords: ["G", "C", "D", "Em"], shapes: {}, order: "random", bpm: 70, per: 4, click: true, limit: 0, sens: 55,
    prog: { key: "C", steps: "I V vi IV" }, pick: { root: "C", acc: "", q: "" }, trainer: { on: false, every: 8, step: 5, target: 120 }, quizAny: false,
  };
  try {
    const old = JSON.parse(localStorage.getItem(KEY) || "{}");
    prefs = { ...prefs, ...old, trainer: { ...prefs.trainer, ...old.trainer }, prog: { ...prefs.prog, ...old.prog }, pick: { ...prefs.pick, ...old.pick }, shapes: { ...old.shapes } };
  } catch { /* first visit */ }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(prefs)); } catch { /* storage is off */ } };

  // ---- chord names and shapes ----
  const NAMES = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
  const FLAT: Record<string, string> = { "C#": "D♭", "D#": "E♭", "F#": "G♭", "G#": "A♭", "A#": "B♭" };
  const FLATS: Record<string, string> = { Db: "C#", Eb: "D#", Gb: "F#", Ab: "G#", Bb: "A#", Cb: "B", Fb: "E", "E#": "F", "B#": "C" };
  const pretty = (chord: string) => chord.replace("#", "♯");
  const prettyWithFlat = (chord: string) => {
    const m = /^([A-G]#?)(.*)$/.exec(chord);
    return m && FLAT[m[1]] ? `${pretty(m[1])}${m[2]} / ${FLAT[m[1]]}${m[2]}` : pretty(chord);
  };
  const shapesOf = (chord: string): GuitarShape[] => getAllGuitarShapes(chord, 8);
  const shapeIndex = (chord: string) => Math.min(Math.max(0, prefs.shapes[chord] ?? 0), Math.max(0, shapesOf(chord).length - 1));
  const shapeFor = (chord: string): GuitarShape | undefined => shapesOf(chord)[shapeIndex(chord)];
  const valid = (chord: string) => shapesOf(chord).length > 0;
  const kindName = (chord: string) => chordKeyLabel(chord).replace(/^[A-G]#? /, "");
  /** "C♯ / D♭ minor": the note under both of its names, then the kind of chord. */
  const longName = (chord: string) => {
    const root = /^[A-G]#?/.exec(chord)![0];
    return `${FLAT[root] ? `${pretty(root)} / ${FLAT[root]}` : root} ${kindName(chord)}`;
  };
  prefs.chords = prefs.chords.filter(valid);
  if (prefs.chords.length < 2) prefs.chords = ["G", "C", "D", "Em"];
  function normalise(raw: string): string | null {
    const m = /^\s*([A-Ga-g])([#b♯♭]?)\s*(.*?)\s*$/.exec(raw);
    if (!m) return null;
    let root = m[1].toUpperCase() + m[2].replace("♯", "#").replace("♭", "b");
    root = FLATS[root] ?? root;
    const suffix = ({ min: "m", "-": "m", maj: "", major: "", M: "", minor: "m", M7: "maj7", "∆7": "maj7", dom7: "7" } as Record<string, string>)[m[3]] ?? m[3];
    const name = root + suffix;
    return valid(name) ? name : null;
  }
  const kindsFor = (...chords: string[]) => ["", "m", ...chords.map((c) => c.replace(/^[A-G]#?/, ""))];
  const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;

  function shapeLabel(shape: GuitarShape): string {
    const pressed = shape.frets.map(Number).filter((f) => f > 0);
    const lowest = pressed.length ? Math.min(...pressed) : 0;
    const open = shape.frets.includes("0");
    if (lowest <= 2 && (open || lowest <= 1)) return open ? "Open position" : "Near the nut";
    return `From fret ${lowest}`;
  }

  // ---- the stage cards ----
  function restart(el: HTMLElement) {
    el.classList.remove("pz-swap");
    void el.offsetWidth;
    el.classList.add("pz-swap");
  }
  function drawCard(prefix: "now" | "next", chord: string | null, animate = true) {
    const nameEl = $(`${prefix}-name`);
    const diagram = $(`${prefix}-diagram`);
    nameEl.textContent = chord ? pretty(chord) : "–";
    const shape = chord ? shapeFor(chord) : undefined;
    diagram.innerHTML = shape ? diagramSvg(shape) : chord ? '<p class="pz-nodiagram">No diagram</p>' : "";
    if (animate && chord) {
      restart(nameEl);
      restart(diagram);
    }
  }
  const stage = (now: string | null, next: string | null, animate = true) => {
    drawCard("now", now, animate);
    drawCard("next", next, animate);
  };
  const flash = (kind: "good" | "miss", text: string, cardId = "now-card", badgeId = "badge") => {
    const card = $(cardId);
    const badge = $(badgeId);
    card.classList.remove("good", "miss");
    void card.offsetWidth;
    card.classList.add(kind);
    badge.textContent = text;
    badge.className = `pz-badge ${kind}`;
    badge.hidden = false;
    window.setTimeout(() => { card.classList.remove("good", "miss"); badge.hidden = true; }, 800);
  };
  const error = (text: string | null) => { const el = $("error"); el.hidden = !text; el.textContent = text ?? ""; };

  // ---- the chord picker ----
  function pickedChord(): string {
    const { root, acc, q } = prefs.pick;
    const base = NAMES.indexOf(root);
    const pc = acc === "#" ? (base + 1) % 12 : acc === "b" ? (base + 11) % 12 : base;
    return NAMES[pc] + q;
  }
  function drawPicker() {
    all<HTMLButtonElement>("[data-root]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.root === prefs.pick.root)));
    all<HTMLButtonElement>("[data-acc]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.acc === prefs.pick.acc)));
    all<HTMLButtonElement>("[data-qual]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.qual === prefs.pick.q)));
    const chord = pickedChord();
    const shapes = shapesOf(chord);
    const idx = shapeIndex(chord);
    $("pick-name").textContent = pretty(chord);
    $("pick-long").textContent = shapes.length ? longName(chord) : "No shape for this one";
    $("pick-notes").innerHTML = chordNotes(chord).map((n) => `<span>${pretty(n)}</span>`).join("");
    $("pick-diagram").innerHTML = shapes[idx] ? diagramSvg(shapes[idx]) : "";
    $("shape-count").textContent = shapes.length ? `${idx + 1} of ${shapes.length}` : "–";
    $<HTMLButtonElement>("shape-prev").disabled = idx <= 0;
    $<HTMLButtonElement>("shape-next").disabled = idx >= shapes.length - 1;
    const inList = prefs.chords.includes(chord);
    const add = $<HTMLButtonElement>("pick-add");
    add.textContent = inList ? "✓ In my chords" : "＋ Add to my chords";
    add.classList.toggle("on", inList);
    add.disabled = !shapes.length;
    drawGallery();
    all(".pz-chip").forEach((c) => c.classList.toggle("on", c.dataset.chord === chord));
  }
  let galleryFor = "";
  function drawGallery() {
    const chord = pickedChord();
    const shapes = shapesOf(chord);
    $("ex-name").textContent = pretty(chord);
    $("ex-long").textContent = shapes.length ? longName(chord) : "No shape for this one";
    $("ex-notes").innerHTML = chordNotes(chord).map((n) => `<span>${pretty(n)}</span>`).join("");
    const box = $("gallery");
    if (galleryFor === chord && box.childElementCount === shapes.length) {
      [...box.children].forEach((card, i) => card.classList.toggle("use", i === shapeIndex(chord)));
      return;
    }
    galleryFor = chord;
    box.replaceChildren(
      ...shapes.map((shape, i) => {
        const card = document.createElement("button");
        card.type = "button";
        card.className = "pz-shape" + (i === shapeIndex(chord) ? " use" : "");
        card.style.setProperty("--i", String(i));
        card.innerHTML = `${diagramSvg(shape)}<small>${shapeLabel(shape)}</small>`;
        card.setAttribute("aria-label", `${pretty(chord)}, ${shapeLabel(shape)}. Press to hear it and use it.`);
        card.addEventListener("click", () => {
          prefs.shapes[chord] = i;
          save();
          void strumShape(shape);
          drawPicker();
          card.classList.remove("playing");
          void card.offsetWidth;
          card.classList.add("playing");
        });
        return card;
      }),
    );
  }
  const hear = () => { const s = shapeFor(pickedChord()); if (s) void strumShape(s); };
  all<HTMLButtonElement>("[data-root]").forEach((b) => b.addEventListener("click", () => { prefs.pick.root = b.dataset.root ?? "C"; save(); drawPicker(); hear(); }));
  all<HTMLButtonElement>("[data-acc]").forEach((b) => b.addEventListener("click", () => { prefs.pick.acc = b.dataset.acc ?? ""; save(); drawPicker(); hear(); }));
  all<HTMLButtonElement>("[data-qual]").forEach((b) => b.addEventListener("click", () => { prefs.pick.q = b.dataset.qual ?? ""; save(); drawPicker(); hear(); }));
  $("shape-prev").addEventListener("click", () => { const c = pickedChord(); prefs.shapes[c] = shapeIndex(c) - 1; save(); drawPicker(); hear(); });
  $("shape-next").addEventListener("click", () => { const c = pickedChord(); prefs.shapes[c] = shapeIndex(c) + 1; save(); drawPicker(); hear(); });
  $("pick-hear").addEventListener("click", hear);
  $("pick-diagram").addEventListener("click", hear);
  $("pick-add").addEventListener("click", () => {
    const chord = pickedChord();
    if (prefs.chords.includes(chord)) {
      if (prefs.chords.length <= 2) return showAddError("Keep at least two chords to practise.");
      prefs.chords = prefs.chords.filter((c) => c !== chord);
    } else {
      if (prefs.chords.length >= 16) return showAddError("That is plenty to practise: take one out before adding another.");
      prefs.chords = [...prefs.chords, chord];
    }
    changed();
  });

  // ---- my chords ----
  function drawChords() {
    const box = $("chord-list");
    box.replaceChildren(
      ...prefs.chords.map((c, i) => {
        const chip = document.createElement("div");
        chip.className = "pz-chip" + (c === pickedChord() ? " on" : "");
        chip.dataset.chord = c;
        chip.style.animationDelay = `${i * 30}ms`;
        chip.setAttribute("role", "button");
        chip.tabIndex = 0;
        chip.innerHTML = `${pretty(c)}<span class="x" role="button" aria-label="Remove ${pretty(c)}">×</span>`;
        chip.addEventListener("click", (e) => {
          if ((e.target as HTMLElement).classList.contains("x")) {
            if (prefs.chords.length <= 2) return showAddError("Keep at least two chords to practise.");
            prefs.chords = prefs.chords.filter((x) => x !== c);
            return changed();
          }
          // pressing a chord shows it in the picker
          const m = /^([A-G])(#?)(.*)$/.exec(c)!;
          prefs.pick = { root: m[1], acc: m[2], q: m[3] };
          save();
          drawPicker();
          hear();
        });
        chip.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); chip.click(); } });
        return chip;
      }),
    );
    $("chord-count").textContent = `${prefs.chords.length} chords`;
    drawBest();
  }
  function changed() {
    seq = 0;
    save();
    drawChords();
    drawPicker();
    if (!running) idleStage();
  }
  const showAddError = (message: string) => {
    const el = $("add-error");
    el.textContent = message;
    el.hidden = false;
    window.setTimeout(() => (el.hidden = true), 3500);
  };
  $("add-form").addEventListener("submit", (e) => {
    e.preventDefault();
    const input = $<HTMLInputElement>("add-chord");
    if (!input.value.trim()) return;
    const name = normalise(input.value);
    if (!name) return showAddError(`“${input.value.trim()}” is not a chord we know. Try names like Am, F#m, G7, Cmaj7, Dsus4 or E5.`);
    if (prefs.chords.includes(name)) return showAddError(`${pretty(name)} is already in the list.`);
    if (prefs.chords.length >= 16) return showAddError("That is plenty to practise: take one out before adding another.");
    prefs.chords = [...prefs.chords, name];
    input.value = "";
    changed();
  });
  all<HTMLButtonElement>("[data-chords]").forEach((b) => b.addEventListener("click", () => { prefs.chords = (b.dataset.chords ?? "").split(" ").filter(valid); prefs.order = "random"; changed(); drawSettings(); }));

  // ---- progressions ----
  const MAJOR: Record<string, [number, string]> = { I: [0, ""], ii: [2, "m"], iii: [4, "m"], IV: [5, ""], V: [7, ""], vi: [9, "m"], I7: [0, "7"], IV7: [5, "7"], V7: [7, "7"] };
  const progChords = (): string[] => prefs.prog.steps.split(" ").map((step) => NAMES[(NAMES.indexOf(prefs.prog.key) + MAJOR[step][0]) % 12] + MAJOR[step][1]);
  function drawStrip(active = -1) {
    const list = progChords();
    const strip = $("strip");
    const id = `${prefs.prog.key}|${prefs.prog.steps}`;
    if (strip.dataset.id !== id) {
      strip.dataset.id = id;
      strip.replaceChildren(...list.map((c) => Object.assign(document.createElement("span"), { textContent: pretty(c) })));
    }
    [...strip.children].forEach((el, i) => {
      el.classList.toggle("on", i === active);
      el.classList.toggle("done", active >= 0 && i < active);
    });
  }
  all<HTMLButtonElement>("[data-steps]").forEach((b) => b.addEventListener("click", () => { prefs.prog.steps = b.dataset.steps ?? "I V vi IV"; seq = 0; save(); drawSettings(); drawStrip(); if (!running) idleStage(); }));
  $<HTMLSelectElement>("key").addEventListener("change", (e) => { prefs.prog.key = (e.target as HTMLSelectElement).value; seq = 0; save(); drawStrip(); if (!running) idleStage(); });

  // ---- modes and settings ----
  const MODES: Record<Mode, string> = {
    explore: "Pick any note, flat or sharp, and a kind of chord. See every way to play it up the neck, hear each one, and choose the shape you want to practise.",
    follow: "A beat keeps time and the chord changes every few beats. The next chord is shown ahead so you can get your fingers ready.",
    listen: "Play the chord shown. Chord Suno listens through your microphone and moves on when it hears you play it right.",
    minute: "Change between all your chords as many times as you can in one minute, shuffled or in order. Chord Suno listens through your microphone and counts each chord you play.",
    progression: "Play along with a real progression in the key you choose. The chords come round in order, with a beat to keep you steady.",
    quiz: "A chord shape appears. Name it. A quick way to learn what each shape is called.",
  };
  function moveThumb(scroll = false) {
    const on = document.querySelector<HTMLElement>('#modes [aria-selected="true"]');
    if (!on) return;
    const thumb = $("thumb");
    thumb.style.width = `${on.offsetWidth}px`;
    thumb.style.transform = `translateX(${on.offsetLeft}px)`;
    if (scroll) on.scrollIntoView({ block: "nearest", inline: "center", behavior: "smooth" });
  }
  function drawSettings() {
    all<HTMLButtonElement>("[data-mode]").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.mode === prefs.mode)));
    moveThumb(true);
    $("blurb").textContent = MODES[prefs.mode];
    const view = prefs.mode === "explore" ? "explore" : prefs.mode === "quiz" ? "quiz" : "drill";
    all("[data-view]").forEach((v) => {
      const show = v.dataset.view === view;
      if (show && v.hidden) {
        v.hidden = false;
        v.style.animation = "none";
        void v.offsetWidth;
        v.style.animation = "";
      } else v.hidden = !show;
    });
    all("[data-extra]").forEach((p) => (p.hidden = !(p.dataset.extra ?? "").split(" ").includes(prefs.mode)));
    all("[data-for]").forEach((p) => (p.hidden = !(p.dataset.for ?? "").split(" ").includes(prefs.mode)));
    $("foot").hidden = prefs.mode === "explore";
    $("skip").hidden = !(running && prefs.mode === "listen");
    all<HTMLButtonElement>("[data-per]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.per) === prefs.per)));
    all<HTMLButtonElement>("[data-limit]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.limit) === prefs.limit)));
    all<HTMLButtonElement>("[data-order]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.order === prefs.order)));
    all<HTMLButtonElement>("[data-steps]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.steps === prefs.prog.steps)));
    $<HTMLSelectElement>("key").value = prefs.prog.key;
    $<HTMLInputElement>("click-on").checked = prefs.click;
    $<HTMLInputElement>("quiz-any").checked = prefs.quizAny;
    $("bpm-out").textContent = String(metro?.settings.bpm ?? prefs.bpm);
    $<HTMLInputElement>("trainer-on").checked = prefs.trainer.on;
    $<HTMLInputElement>("trainer-step").value = String(prefs.trainer.step);
    $<HTMLInputElement>("trainer-every").value = String(prefs.trainer.every);
    $<HTMLInputElement>("trainer-target").value = String(prefs.trainer.target);
    $("trainer-fields").classList.toggle("off", !prefs.trainer.on);
    const sens = $<HTMLInputElement>("sens");
    sens.value = String(prefs.sens);
    sens.style.setProperty("--fill", `${prefs.sens}%`);
    $("sens-out").textContent = prefs.sens < 35 ? "Low" : prefs.sens < 70 ? "Medium" : "High";
    noiseGate.sensitivity = prefs.sens;
  }
  function setMode(mode: Mode) {
    if (mode === prefs.mode) return;
    if (running) stopAll();
    prefs.mode = mode;
    save();
    drawSettings();
    drawPicker();
    idleStage();
    drawStats();
    if (mode === "quiz") drawQuizIdle();
    error(null);
  }
  all<HTMLButtonElement>("[data-mode]").forEach((b) => b.addEventListener("click", () => setMode(b.dataset.mode as Mode)));
  window.addEventListener("resize", () => moveThumb());
  all<HTMLButtonElement>("[data-per]").forEach((b) => b.addEventListener("click", () => { prefs.per = Number(b.dataset.per); save(); drawSettings(); if (running && metro) restartFollow(); }));
  all<HTMLButtonElement>("[data-limit]").forEach((b) => b.addEventListener("click", () => { prefs.limit = Number(b.dataset.limit); save(); drawSettings(); }));
  all<HTMLButtonElement>("[data-order]").forEach((b) => b.addEventListener("click", () => { prefs.order = b.dataset.order as Prefs["order"]; seq = 0; save(); drawSettings(); }));
  $<HTMLInputElement>("click-on").addEventListener("change", (e) => { prefs.click = (e.target as HTMLInputElement).checked; if (metro) metro.settings.volume = prefs.click ? 0.7 : 0; save(); });
  $<HTMLInputElement>("quiz-any").addEventListener("change", (e) => { prefs.quizAny = (e.target as HTMLInputElement).checked; save(); });
  $<HTMLInputElement>("sens").addEventListener("input", (e) => { prefs.sens = Number((e.target as HTMLInputElement).value); save(); drawSettings(); });
  $<HTMLInputElement>("trainer-on").addEventListener("change", (e) => { prefs.trainer.on = (e.target as HTMLInputElement).checked; if (metro) metro.settings.trainer.on = prefs.trainer.on; save(); drawSettings(); });
  for (const [id, key, min, max] of [["trainer-step", "step", 1, 20], ["trainer-every", "every", 1, 32], ["trainer-target", "target", 40, 200]] as const)
    $<HTMLInputElement>(id).addEventListener("change", () => {
      prefs.trainer[key] = Math.min(max, Math.max(min, Math.round(Number($<HTMLInputElement>(id).value) || prefs.trainer[key])));
      if (metro) Object.assign(metro.settings.trainer, prefs.trainer);
      save();
      drawSettings();
    });
  const setBpm = (bpm: number) => { prefs.bpm = Math.min(200, Math.max(30, clampBpm(bpm))); if (metro) metro.settings.bpm = prefs.bpm; save(); drawSettings(); };
  $("bpm-minus").addEventListener("click", () => setBpm((metro?.settings.bpm ?? prefs.bpm) - 5));
  $("bpm-plus").addEventListener("click", () => setBpm((metro?.settings.bpm ?? prefs.bpm) + 5));

  // ---- the best score, kept for each set of chords ----
  const best = (): Record<string, number> => { try { return JSON.parse(localStorage.getItem(BEST) || "{}"); } catch { return {}; } };
  const setKey = () => [...prefs.chords].sort().join("|");
  function drawBest() {
    const score = best()[setKey()];
    $("best-line").textContent = score ? `Your best with ${prefs.chords.map(pretty).join(" ")}: ${score} changes in a minute.` : "No score yet for this set of chords. Give it a go.";
  }

  // ---- state shared by the drills ----
  let running = false;
  let metro: Metronome | null = null;
  let raf = 0;
  let mic: Mic | null = null;
  let listener: ChordListener | null = null;
  let seq = 0;

  const source = () => (prefs.mode === "progression" ? progChords() : prefs.chords);
  const ordered = () => prefs.mode === "progression" || prefs.order === "list";
  function pick(after?: string): string {
    const list = source();
    if (ordered()) return list[seq++ % list.length];
    let next = list[Math.floor(Math.random() * list.length)];
    for (let i = 0; i < 6 && next === after && list.length > 1; i++) next = list[Math.floor(Math.random() * list.length)];
    return next;
  }
  function idleStage() {
    if (prefs.mode === "progression") { const l = progChords(); stage(l[0], l[1], false); drawStrip(); }
    else if (prefs.mode !== "explore" && prefs.mode !== "quiz") stage(prefs.chords[0], prefs.chords[1], false);
    $("beats").replaceChildren();
  }
  function drawStats(lines: [string, string | number][] = []) {
    $("stats").innerHTML = lines.map(([k, v]) => `<span>${k}<b>${v}</b></span>`).join("");
  }
  function setGo(on: boolean, label = on ? "Stop" : "Start") {
    running = on;
    $("go-text").textContent = label;
    $("go").setAttribute("aria-pressed", String(on));
    $("skip").hidden = !(on && prefs.mode === "listen");
  }

  // ---- the microphone ----
  async function startMic(handler: (h: Heard) => void): Promise<boolean> {
    error(null);
    try {
      mic = await openMic(16384);
    } catch (err) {
      error(err instanceof MicError ? err.message : "The microphone could not be started.");
      return false;
    }
    $("mic-warn").textContent = SILENT_MIC_TEXT;
    $("mic-warn").hidden = true;
    $("mic-name").textContent = mic.label ? `Microphone: ${mic.label}` : "";
    void fillMicPicker($<HTMLSelectElement>("mic-select"), mic.deviceId, () => {
      if (!running) return;
      const mode = prefs.mode;
      stopAll();
      prefs.mode = mode;
      void startAll();
    });
    listener = new ChordListener(mic, { gate: noiseGate }, handler);
    listener.start(110);
    return true;
  }
  function stopMic() {
    listener?.stop();
    listener = null;
    mic?.stop();
    mic = null;
    $("level").style.width = "0";
    $("mic-warn").hidden = true;
    $("heard").textContent = "–";
  }
  function meterAndName(h: Heard) {
    $("level").style.width = `${levelPercent(h.level)}%`;
    $("level").classList.toggle("open", !!h.chroma);
    $("mic-warn").hidden = !silence.feed(h.level);
    $("heard").textContent = h.chord ? pretty(h.chord) : "–";
  }

  // ---- follow along, and progressions ----
  let now = "";
  let next = "";
  let played = 0;
  let startedAt = 0;
  function startFollow() {
    seq = 0;
    played = 0;
    now = "";
    metro = new Metronome({
      bpm: prefs.bpm, beats: prefs.per, accents: defaultAccents(prefs.per, 4), sub: 1, sound: "wood", volume: prefs.click ? 0.7 : 0,
      trainer: { ...prefs.trainer }, gap: { on: false, play: 3, mute: 1 },
    });
    metro.onBpm = (bpm) => {
      $("bpm-out").textContent = String(bpm);
      if (bpm >= prefs.trainer.target) toast({ icon: "🏁", title: `Reached ${bpm} BPM`, text: "The speed trainer is at the top tempo you set.", ms: 3500 });
    };
    $("beats").replaceChildren(...Array.from({ length: prefs.per }, (_, i) => Object.assign(document.createElement("i"), { className: i === 0 ? "first" : "" })));
    startedAt = performance.now();
    void metro.start().then(() => { raf = requestAnimationFrame(followFrame); });
  }
  function followFrame() {
    if (!metro?.running) return;
    for (const tick of metro.due()) {
      if (tick.sub !== 0) continue;
      all("#beats i").forEach((dot, i) => dot.classList.toggle("now", i === tick.beat));
      const card = $("now-card");
      card.classList.remove("beat");
      void card.offsetWidth;
      card.classList.add("beat");
      if (tick.beat === 0) {
        if (!now) { now = pick(); next = pick(now); }
        else { now = next; next = pick(now); }
        played++;
        stage(now, next);
        if (prefs.mode === "progression") drawStrip((played - 1) % progChords().length);
        drawStats([["Chords", played], ["Time", clock((performance.now() - startedAt) / 1000)], ["Tempo", `${metro.settings.bpm} BPM`]]);
      }
    }
    raf = requestAnimationFrame(followFrame);
  }
  function restartFollow() {
    cancelAnimationFrame(raf);
    metro?.stop();
    startFollow();
  }

  // ---- listen and check ----
  const stats = { right: 0, streak: 0, bestStreak: 0, times: [] as number[], missed: 0 };
  let target = "";
  let shownAt = 0;
  let okFrames = 0;
  let locked = false;
  let limitTimer = 0;
  function listenStats() {
    const avg = stats.times.length ? `${(stats.times.reduce((a, b) => a + b, 0) / stats.times.length / 1000).toFixed(1)} s` : "–";
    const fastest = stats.times.length ? `${(Math.min(...stats.times) / 1000).toFixed(1)} s` : "–";
    drawStats([["Right", stats.right], ["Streak", stats.streak], ["Best streak", stats.bestStreak], ["Average", avg], ["Fastest", fastest], ["Missed", stats.missed]]);
  }
  function nextTarget() {
    locked = false;
    okFrames = 0;
    target = target ? next : pick();
    next = pick(target);
    shownAt = performance.now();
    stage(target, next);
    $("limit-fill").style.width = "100%";
    if (listener) listener.options.suffixes = kindsFor(target);
  }
  function onHeard(h: Heard) {
    meterAndName(h);
    if (locked || !h.chroma || performance.now() - shownAt < 450) { if (!h.chroma) okFrames = 0; return; }
    const score = scoreChord(h.chroma, target);
    const top = h.guesses[0];
    const right = score >= 0.62 && (top?.name === target || score >= (top?.score ?? 0) - 0.04);
    okFrames = right ? okFrames + 1 : 0;
    if (okFrames >= 2) {
      locked = true;
      const ms = performance.now() - shownAt;
      stats.right++;
      stats.streak++;
      stats.bestStreak = Math.max(stats.bestStreak, stats.streak);
      stats.times.push(ms);
      flash("good", `${(ms / 1000).toFixed(1)} s`);
      listenStats();
      window.setTimeout(() => running && prefs.mode === "listen" && nextTarget(), 850);
    }
  }
  async function startListen() {
    if (!(await startMic(onHeard))) return false;
    Object.assign(stats, { right: 0, streak: 0, bestStreak: 0, times: [], missed: 0 });
    seq = 0;
    target = "";
    nextTarget();
    listenStats();
    $("limit-bar").hidden = prefs.limit === 0;
    limitTimer = window.setInterval(() => {
      if (!prefs.limit || locked) return;
      const left = 1 - (performance.now() - shownAt) / (prefs.limit * 1000);
      $("limit-fill").style.width = `${Math.max(0, left * 100)}%`;
      if (left <= 0) {
        locked = true;
        stats.missed++;
        stats.streak = 0;
        flash("miss", "Too slow");
        listenStats();
        window.setTimeout(() => running && prefs.mode === "listen" && nextTarget(), 850);
      }
    }, 100);
    return true;
  }
  $("skip").addEventListener("click", () => { if (running && prefs.mode === "listen") { stats.streak = 0; stats.missed++; listenStats(); nextTarget(); } });

  // ---- one minute, counted by the microphone ----
  let count = 0;
  let minuteTimer = 0;
  let expecting = "";
  let phase: "idle" | "ready" | "run" = "idle";
  let mShownAt = 0;
  let mOk = 0;
  let mStarted = false; // the first chord only starts the changes: playing it is not a change itself
  const RING = 276.46;
  const ring = (fraction: number) => {
    $("ring").style.strokeDashoffset = String(RING * (1 - fraction));
    $("ring").classList.toggle("low", fraction < 0.17);
  };
  function bump() {
    const el = $("count");
    el.textContent = String(count);
    el.classList.remove("bump");
    void el.offsetWidth;
    el.classList.add("bump");
  }
  function flip() {
    expecting = next;
    next = pick(expecting);
    stage(expecting, next);
    mShownAt = performance.now();
    mOk = 0;
    if (listener) listener.options.suffixes = kindsFor(...prefs.chords);
  }
  function minuteHeard(h: Heard) {
    meterAndName(h);
    if (phase !== "run" || !h.chroma || performance.now() - mShownAt < 450) {
      if (!h.chroma) mOk = 0;
      return;
    }
    const score = scoreChord(h.chroma, expecting);
    const top = h.guesses[0];
    mOk = score >= 0.62 && (top?.name === expecting || score >= (top?.score ?? 0) - 0.04) ? mOk + 1 : 0;
    if (mOk < 2) return;
    if (mStarted) {
      count++;
      bump();
      flash("good", "+1");
    } else {
      mStarted = true;
      flash("good", "Go!");
    }
    flip();
  }
  async function startMinute() {
    mStarted = false;
    const listening = await startMic(minuteHeard);
    if (!listening) {
      error(`${$("error").textContent ?? ""} You can still count your changes yourself with the button or Space.`.trim());
      mStarted = true;
    }
    $("auto-note").textContent = listening
      ? "Play the first chord to start. Each time Chord Suno hears you play the chord shown, it counts and shows the next one."
      : "Press the button, or Space, each time you switch chords cleanly.";
    if (!running) return stopMic();
    count = 0;
    $("count").textContent = "0";
    seq = 0;
    expecting = pick();
    next = pick(expecting);
    stage(expecting, next);
    mShownAt = performance.now();
    mOk = 0;
    if (listener) listener.options.suffixes = kindsFor(...prefs.chords);
    phase = "ready";
    ring(1);
    let left = 3;
    $("clock").textContent = String(left);
    $("go-text").textContent = "Get ready…";
    minuteTimer = window.setInterval(() => {
      left--;
      if (left > 0) return void ($("clock").textContent = String(left));
      window.clearInterval(minuteTimer);
      phase = "run";
      $<HTMLButtonElement>("changed").disabled = false;
      $("go-text").textContent = "Stop";
      const t0 = performance.now();
      minuteTimer = window.setInterval(() => {
        const remaining = 60 - (performance.now() - t0) / 1000;
        $("clock").textContent = clock(Math.max(0, Math.ceil(remaining)));
        ring(Math.max(0, remaining / 60));
        if (remaining <= 0) finishMinute();
      }, 100);
    }, 1000);
  }
  function tapChange() {
    if (phase !== "run") return;
    mStarted = true;
    count++;
    bump();
    flip();
  }
  function finishMinute() {
    window.clearInterval(minuteTimer);
    phase = "idle";
    $<HTMLButtonElement>("changed").disabled = true;
    stopMic();
    const scores = best();
    const old = scores[setKey()] ?? 0;
    const record = count > old;
    if (record) {
      scores[setKey()] = count;
      try { localStorage.setItem(BEST, JSON.stringify(scores)); } catch { /* storage is off */ }
    }
    drawBest();
    drawStats([["Result", `${count} changes`], ["Best", Math.max(count, old)]]);
    toast({ icon: record && count > 0 ? "🏆" : "⏱️", title: record && count > 0 ? "New best!" : "Time!", text: `${count} clean changes across ${prefs.chords.length} chords.`, ms: 5000 });
    setGo(false);
    $("clock").textContent = "1:00";
    ring(1);
  }
  $("changed").addEventListener("click", tapChange);

  // ---- the quiz ----
  const quiz = { right: 0, wrong: 0, streak: 0, bestStreak: 0, current: "", last: "", busy: false };
  let anyCache: string[] | null = null;
  const anyChords = () => (anyCache ??= NAMES.flatMap((n) => ["", "m", "7"].map((s) => n + s)).filter(valid));
  const shuffle = <T,>(a: T[]): T[] => a.map((v) => [Math.random(), v] as const).sort((x, y) => x[0] - y[0]).map((x) => x[1]);
  function drawQuizIdle() {
    $("quiz-diagram").innerHTML = '<p class="pz-nodiagram" style="color:var(--color-body)">Press Start</p>';
    $("options").replaceChildren();
  }
  function quizStats() {
    const total = quiz.right + quiz.wrong;
    drawStats([["Right", quiz.right], ["Streak", quiz.streak], ["Best streak", quiz.bestStreak], ["Accuracy", total ? `${Math.round((quiz.right / total) * 100)}%` : "–"]]);
  }
  function nextQuestion() {
    quiz.busy = false;
    const ANY = anyChords();
    const pool = prefs.quizAny || prefs.chords.length < 3 ? ANY : prefs.chords;
    let chord = pool[Math.floor(Math.random() * pool.length)];
    for (let i = 0; i < 6 && chord === quiz.last; i++) chord = pool[Math.floor(Math.random() * pool.length)];
    quiz.current = quiz.last = chord;
    const root = chord.match(/^[A-G]#?/)![0];
    const suffix = chord.slice(root.length);
    // wrong answers that look alike: the same note in other kinds, or other notes of the same kind
    const alike = shuffle(ANY.filter((c) => c !== chord && (c.startsWith(root) || c.endsWith(suffix)))).slice(0, 3);
    const options = shuffle([chord, ...alike, ...shuffle(ANY.filter((c) => c !== chord && !alike.includes(c)))].slice(0, 4));
    if (!options.includes(chord)) options[0] = chord;
    const shape = shapeFor(chord);
    const card = $("quiz-diagram");
    card.innerHTML = shape ? diagramSvg(shape) : "";
    restart(card);
    $("options").replaceChildren(
      ...options.map((c, i) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "pz-option";
        b.style.setProperty("--i", String(i));
        b.textContent = pretty(c);
        b.addEventListener("click", () => answer(c, b));
        return b;
      }),
    );
  }
  function answer(choice: string, button: HTMLButtonElement) {
    if (quiz.busy || !running) return;
    quiz.busy = true;
    const right = choice === quiz.current;
    all<HTMLButtonElement>(".pz-option").forEach((b) => {
      b.disabled = true;
      if (b.textContent === pretty(quiz.current)) b.classList.add("right");
    });
    if (right) {
      quiz.right++;
      quiz.streak++;
      quiz.bestStreak = Math.max(quiz.bestStreak, quiz.streak);
      flash("good", "Yes!", "quiz-card", "quiz-badge");
      const s = shapeFor(quiz.current);
      if (s) void strumShape(s);
    } else {
      quiz.wrong++;
      quiz.streak = 0;
      button.classList.add("wrong");
      flash("miss", pretty(quiz.current), "quiz-card", "quiz-badge");
    }
    quizStats();
    window.setTimeout(() => running && prefs.mode === "quiz" && nextQuestion(), right ? 1000 : 1700);
  }

  // ---- start and stop ----
  async function startAll() {
    if (!gate.allowed()) return;
    if (source().length < 2) return error("Add at least two chords to practise.");
    error(null);
    track("practice_start", { mode: prefs.mode, chords: prefs.chords.length });
    if (prefs.mode === "listen") {
      if (!(await startListen())) return;
      setGo(true);
    } else if (prefs.mode === "follow" || prefs.mode === "progression") {
      setGo(true);
      if (prefs.mode === "progression") drawStrip(-1);
      startFollow();
    } else if (prefs.mode === "minute") {
      setGo(true);
      void startMinute();
    } else if (prefs.mode === "quiz") {
      Object.assign(quiz, { right: 0, wrong: 0, streak: 0, bestStreak: 0, last: "" });
      setGo(true);
      quizStats();
      nextQuestion();
    }
  }
  function stopAll() {
    cancelAnimationFrame(raf);
    metro?.stop();
    metro = null;
    window.clearInterval(limitTimer);
    window.clearInterval(minuteTimer);
    stopMic();
    phase = "idle";
    $<HTMLButtonElement>("changed").disabled = true;
    $("limit-bar").hidden = true;
    $("clock").textContent = "1:00";
    ring(1);
    setGo(false);
    $("bpm-out").textContent = String(prefs.bpm);
    if (prefs.mode === "quiz") drawQuizIdle();
    else idleStage();
  }
  $("go").addEventListener("click", () => (running ? stopAll() : void startAll()));
  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    if (["INPUT", "SELECT", "TEXTAREA", "BUTTON"].includes(t.tagName) || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === " " && prefs.mode === "minute" && phase === "run") { e.preventDefault(); tapChange(); }
  });
  window.addEventListener("pagehide", stopAll);

  drawChords();
  drawSettings();
  drawPicker();
  idleStage();
  drawStats();
  if (prefs.mode === "quiz") drawQuizIdle();
  window.addEventListener("load", () => moveThumb());
  window.setTimeout(() => moveThumb(), 150);
</script>
