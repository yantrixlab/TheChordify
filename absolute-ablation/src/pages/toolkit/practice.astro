---
import ToolShell from "../../components/ToolShell.astro";

const modes = [
  { id: "explore", label: "Explore", icon: '<rect x="4" y="4" width="7" height="7" rx="1.6"/><rect x="13" y="4" width="7" height="7" rx="1.6"/><rect x="4" y="13" width="7" height="7" rx="1.6"/><rect x="13" y="13" width="7" height="7" rx="1.6"/>' },
  { id: "follow", label: "Follow along", icon: '<circle cx="12" cy="12" r="9"/><path d="M10 8.4v7.2l5.6-3.6z"/>' },
  { id: "listen", label: "Listen & check", icon: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"/>' },
  { id: "minute", label: "1-minute changes", icon: '<circle cx="12" cy="13.5" r="7.5"/><path d="M12 9.5v4l2.6 1.8M9.6 3h4.8"/>' },
  { id: "progression", label: "Progressions", icon: '<path d="M4 18.5h4.5v-4.2H13v-4.2h4.2V6H20"/>' },
  { id: "quiz", label: "Chord quiz", icon: '<circle cx="12" cy="12" r="9"/><path d="M9.4 9.6a2.6 2.6 0 1 1 3.6 2.4c-.8.4-1 .9-1 1.8M12 17h.01"/>' },
];
const roots = ["C", "D", "E", "F", "G", "A", "B"];
const qualities = [["", "maj"], ["m", "min"], ["5", "5"], ["7", "7"], ["m7", "m7"], ["maj7", "maj7"], ["sus2", "sus2"], ["sus4", "sus4"], ["6", "6"], ["m6", "m6"], ["dim", "dim"], ["aug", "aug"], ["m7b5", "m7♭5"], ["dim7", "dim7"], ["mMaj7", "mMaj7"]];
const sets = [
  ["First four", "G C D Em"],
  ["Open chords", "Em Am C G D A E Dm"],
  ["Campfire", "G C D Em Am"],
  ["Minor mood", "Am Dm Em Bm F#m Cm Gm"],
  ["Barre chords", "F Bm F#m B Cm Gm C#m Fm"],
  ["7th chords", "G7 C7 D7 A7 E7 Am7 Dm7 Em7 Cmaj7"],
  ["Power chords", "E5 A5 D5 G5 C5"],
];
const keys = [["C", "C"], ["G", "G"], ["D", "D"], ["A", "A"], ["E", "E"], ["B", "B"], ["F", "F"], ["A#", "B♭"], ["D#", "E♭"], ["G#", "A♭"], ["C#", "D♭"], ["F#", "F♯"]];
const progressions = [
  ["I – IV – V", "I IV V IV"],
  ["I – V – vi – IV", "I V vi IV"],
  ["vi – IV – I – V", "vi IV I V"],
  ["I – vi – IV – V", "I vi IV V"],
  ["ii – V – I", "ii V I I"],
  ["12-bar blues", "I7 I7 I7 I7 IV7 IV7 I7 I7 V7 IV7 I7 V7"],
];
---

<ToolShell
  title="Practice Your Chords — Chord Suno Toolkit"
  description="Learn and drill guitar chords: a library of every chord and every way to play it, chord-change drills with a beat, listen mode, one-minute changes, progressions and a chord quiz."
  heading="Practice your chords"
  sub="Find any chord and every way to play it, hear it, then drill the changes: follow a beat, race the clock, play along with a progression, or let Chord Suno listen and check you."
  feature="practice_chords"
  tool="practice"
  crumb="Practice your chords"
>
  <div class="pz">
    <div class="pz-modes" id="modes" role="tablist" aria-label="Practice mode">
      <span class="pz-thumb" id="thumb" aria-hidden="true"></span>
      {modes.map((m) => (
        <button type="button" role="tab" data-mode={m.id} aria-selected="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" set:html={m.icon} />
          <span>{m.label}</span>
        </button>
      ))}
    </div>
    <p class="pz-blurb" id="blurb"></p>

    <div class="tk-layout">
      <section class="tk-console pz-stage" aria-label="Practice area">
        <!-- Explore: every way to play the chosen chord -->
        <div class="pz-view" data-view="explore">
          <div class="pz-ex-head">
            <div class="pz-ex-name" id="ex-name">C</div>
            <div>
              <div class="pz-ex-long" id="ex-long">C major</div>
              <div class="pz-notes" id="ex-notes"></div>
            </div>
          </div>
          <div class="pz-gallery" id="gallery"></div>
          <p class="pz-hint">Tap a shape to hear it. The one marked <b>In use</b> is the one your drills will show.</p>
        </div>

        <!-- the drills -->
        <div class="pz-view" data-view="drill" hidden>
          <div class="pz-cards">
            <div class="pz-now" id="now-card">
              <div class="pz-label">Play now</div>
              <div class="pz-name" id="now-name">–</div>
              <div class="pz-diagram" id="now-diagram"></div>
              <div class="pz-badge" id="badge" hidden></div>
            </div>
            <div class="pz-next" id="next-card">
              <div class="pz-label">Next</div>
              <div class="pz-next-name" id="next-name">–</div>
              <div class="pz-diagram" id="next-diagram"></div>
            </div>
          </div>

          <div class="pz-strip" id="strip" data-extra="progression" hidden aria-label="The progression"></div>

          <div class="pz-extra" data-extra="follow progression" hidden>
            <div class="pz-beats" id="beats" aria-hidden="true"></div>
            <div class="pz-bpm">
              <button class="tk-round" id="bpm-minus" type="button" aria-label="Slower">−</button>
              <div><b id="bpm-out">80</b><span>BPM</span></div>
              <button class="tk-round" id="bpm-plus" type="button" aria-label="Faster">+</button>
            </div>
          </div>

          <div class="pz-extra" data-extra="listen" hidden>
            <div class="pz-timer" id="limit-bar" hidden aria-hidden="true"><i id="limit-fill"></i></div>
          </div>

          <div class="pz-extra" data-extra="minute" hidden>
            <div class="pz-clockrow">
              <div class="pz-ring">
                <svg viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="44" class="bg"/><circle cx="50" cy="50" r="44" class="fg" id="ring"/></svg>
                <div><b id="clock">1:00</b><span>left</span></div>
              </div>
              <div class="pz-count"><b id="count">0</b><span>clean changes</span></div>
            </div>
            <p class="pz-auto" id="auto-note">Play the first chord to start. Each time Chord Suno hears you switch to the other chord, it counts.</p>
            <button class="tk-btn on-dark pz-tapper" id="changed" type="button" disabled>Count a change myself <span class="tk-kbd" style="margin-left:8px">Space</span></button>
          </div>

          <div class="pz-extra" data-extra="listen minute" hidden>
            <div class="pz-heard">I hear <b id="heard">–</b></div>
            <div class="pz-meter" aria-hidden="true"><i id="level"></i></div>
            <p class="mic-name" id="mic-name"></p>
            <select id="mic-select" class="tk-select mic-select" aria-label="Microphone" hidden></select>
            <p class="mic-warn" id="mic-warn" hidden role="alert"></p>
          </div>
        </div>

        <!-- the quiz -->
        <div class="pz-view" data-view="quiz" hidden>
          <div class="pz-quiz-card" id="quiz-card">
            <div class="pz-label">What chord is this?</div>
            <div class="pz-diagram pz-quiz-diagram" id="quiz-diagram"></div>
            <div class="pz-badge" id="quiz-badge" hidden></div>
          </div>
          <div class="pz-options" id="options"></div>
        </div>

        <div class="pz-foot" id="foot">
          <div class="pz-stats" id="stats"></div>
          <div class="pz-actions">
            <button id="go" class="tk-btn amber pz-go" type="button" aria-pressed="false"><span id="go-text">Start</span></button>
            <button id="skip" class="tk-btn on-dark" type="button" hidden>Skip chord</button>
          </div>
          <p class="tk-error" id="error" hidden role="alert"></p>
        </div>
      </section>

      <div class="pz-side">
        <section class="tk-card pz-picker">
          <h2>Find any chord</h2>
          <div class="pz-seg pz-roots" id="roots" role="group" aria-label="Note">
            {roots.map((r) => (<button type="button" data-root={r} aria-pressed="false">{r}</button>))}
          </div>
          <div class="pz-seg pz-acc" id="acc" role="group" aria-label="Flat, natural or sharp">
            <button type="button" data-acc="b" aria-pressed="false" aria-label="Flat">♭</button>
            <button type="button" data-acc="" aria-pressed="false" aria-label="Natural">♮</button>
            <button type="button" data-acc="#" aria-pressed="false" aria-label="Sharp">♯</button>
          </div>
          <div class="pz-quals" id="quals" role="group" aria-label="Kind of chord">
            {qualities.map(([v, l]) => (<button type="button" data-qual={v} aria-pressed="false">{l}</button>))}
          </div>

          <div class="pz-preview">
            <div class="pz-prev-diagram" id="pick-diagram"></div>
            <div class="pz-prev-info">
              <div class="pz-prev-name" id="pick-name">C</div>
              <div class="pz-prev-long" id="pick-long">C major</div>
              <div class="pz-notes dark" id="pick-notes"></div>
              <div class="pz-shapes">
                <button type="button" id="shape-prev" aria-label="Previous way to play it">‹</button>
                <span id="shape-count">1 of 1</span>
                <button type="button" id="shape-next" aria-label="Next way to play it">›</button>
              </div>
            </div>
          </div>
          <div class="pz-pick-actions">
            <button class="tk-btn soft" id="pick-hear" type="button">🔊 Hear it</button>
            <button class="tk-btn soft" id="pick-add" type="button">＋ Add to my chords</button>
          </div>
        </section>

        <section class="tk-card">
          <h2>My chords <small id="chord-count"></small></h2>
          <div class="pz-chips" id="chord-list" aria-label="Chords in your drills"></div>
          <form class="tk-inline" id="add-form" autocomplete="off" style="margin-top:12px">
            <input class="tk-select" id="add-chord" type="text" maxlength="12" placeholder="Type a chord, e.g. Bm or F#m7" aria-label="Add a chord by name" style="flex:1 1 170px;width:auto" />
            <button class="tk-btn soft" type="submit">Add</button>
          </form>
          <p class="tk-error" id="add-error" hidden></p>
          <div class="tk-field" style="margin-top:16px">
            <p class="tk-label">Start from a set</p>
            <div class="tk-seg" id="sets">
              {sets.map(([label, chords]) => (<button type="button" data-chords={chords}>{label}</button>))}
            </div>
          </div>
        </section>

        <section class="tk-card" id="settings-card">
          <h2>Settings</h2>

          <div class="pz-set" data-for="progression" hidden>
            <div class="tk-field">
              <label class="tk-label" for="key">Key</label>
              <select id="key" class="tk-select">
                {keys.map(([v, l]) => (<option value={v}>{l} major</option>))}
              </select>
            </div>
            <div class="tk-field">
              <p class="tk-label">Progression</p>
              <div class="tk-seg" id="progressions" role="group" aria-label="Progression">
                {progressions.map(([label, steps]) => (<button type="button" data-steps={steps} aria-pressed="false">{label}</button>))}
              </div>
            </div>
          </div>

          <div class="pz-set" data-for="follow progression" hidden>
            <div class="tk-field">
              <p class="tk-label">Beats on each chord</p>
              <div class="tk-seg" id="per-chord" role="group" aria-label="Beats on each chord">
                {[1, 2, 4, 8].map((n) => (<button type="button" data-per={n} aria-pressed="false">{n}</button>))}
              </div>
            </div>
            <label class="tk-switch">
              <span>Click<small>Hear the beat as you play</small></span>
              <input type="checkbox" id="click-on" checked /><i></i>
            </label>
            <label class="tk-switch">
              <span>Speed trainer<small>Gets faster as you go, up to a top tempo</small></span>
              <input type="checkbox" id="trainer-on" /><i></i>
            </label>
            <div class="tk-inline pz-sub" id="trainer-fields">
              Add <input class="tk-number" id="trainer-step" type="number" min="1" max="20" value="5" aria-label="BPM to add" /> BPM every
              <input class="tk-number" id="trainer-every" type="number" min="1" max="32" value="8" aria-label="Chords between steps" /> chords, up to
              <input class="tk-number" id="trainer-target" type="number" min="40" max="200" value="120" aria-label="Top tempo" /> BPM
            </div>
          </div>

          <div class="pz-set" data-for="listen" hidden>
            <div class="tk-field">
              <p class="tk-label">Time for each chord</p>
              <div class="tk-seg" id="limit" role="group" aria-label="Time for each chord">
                <button type="button" data-limit="0" aria-pressed="false">No limit</button>
                <button type="button" data-limit="10" aria-pressed="false">10 s</button>
                <button type="button" data-limit="5" aria-pressed="false">5 s</button>
              </div>
            </div>
          </div>

          <div class="pz-set" data-for="listen minute" hidden>
            <div class="tk-field">
              <label class="tk-label" for="sens">Microphone sensitivity <output id="sens-out">Medium</output></label>
              <input id="sens" class="tk-range" type="range" min="0" max="100" value="55" />
            </div>
          </div>

          <div class="pz-set" data-for="minute" hidden>
            <div class="tk-field">
              <p class="tk-label">The chords</p>
              <p class="tk-hint" style="margin:0">Every chord in <b>My chords</b> comes up, one after another. Add or remove chords there to make it easier or harder.</p>
              <p class="tk-hint" id="best-line"></p>
            </div>
          </div>

          <div class="pz-set" data-for="follow listen minute" hidden>
            <div class="tk-field">
              <p class="tk-label">Order</p>
              <div class="tk-seg" id="order" role="group" aria-label="Order">
                <button type="button" data-order="random" aria-pressed="false">Shuffled</button>
                <button type="button" data-order="list" aria-pressed="false">In order</button>
              </div>
            </div>
          </div>

          <div class="pz-set" data-for="quiz" hidden>
            <label class="tk-switch">
              <span>Quiz me on any chord<small>Off: only the chords in My chords</small></span>
              <input type="checkbox" id="quiz-any" /><i></i>
            </label>
          </div>

          <p class="tk-hint pz-none" data-for="explore">Nothing to set here: pick a chord and tap its shapes.</p>
        </section>
      </div>
    </div>
  </div>
</ToolShell>

<style is:global>
  .pz-modes { position: relative; display: flex; gap: 4px; padding: 5px; margin-bottom: 14px; overflow-x: auto; scrollbar-width: none; background: #fff; border: 1px solid var(--color-hairline); border-radius: 20px; box-shadow: 0 1px 2px #1a053308, 0 14px 30px -20px #1a053333; }
  .pz-modes::-webkit-scrollbar { display: none; }
  .pz-modes button { position: relative; z-index: 1; flex: 1 0 auto; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 0 16px; font: 700 14px var(--font-sans); white-space: nowrap; color: var(--color-body); background: transparent; border: 0; border-radius: 15px; cursor: pointer; transition: color 0.25s; }
  .pz-modes button svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.3s cubic-bezier(.3,1.5,.5,1); }
  .pz-modes button:hover { color: var(--color-ink); }
  .pz-modes button[aria-selected="true"] { color: #fff; }
  .pz-modes button[aria-selected="true"] svg { transform: scale(1.12) rotate(-6deg); }
  .pz-thumb { position: absolute; z-index: 0; top: 5px; bottom: 5px; left: 0; width: 0; border-radius: 15px; background: linear-gradient(135deg, #7c3aed, #5b21b6); box-shadow: 0 10px 22px -10px #7c3aed; transition: transform 0.38s cubic-bezier(.3,.9,.3,1), width 0.38s cubic-bezier(.3,.9,.3,1); }
  .pz-blurb { margin: 0 4px 18px; max-width: 760px; font-size: 15px; line-height: 1.55; color: var(--color-body); min-height: 24px; }

  .pz-stage { padding: 22px; }
  .pz-view { position: relative; animation: pz-in 0.4s cubic-bezier(.2,.8,.2,1); }
  .pz-view[hidden], .pz-extra[hidden], .pz-set[hidden], .pz-none[hidden], .pz-foot[hidden] { display: none; }
  @keyframes pz-in { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes pz-slide { from { opacity: 0; transform: translateX(26px) scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes pz-pop { 0% { transform: scale(1); } 40% { transform: scale(1.28); } 100% { transform: scale(1); } }
  @keyframes pz-beat { 0% { box-shadow: 0 0 0 0 #f59e0bcc, 0 24px 50px -24px #000000aa; } 100% { box-shadow: 0 0 0 18px #f59e0b00, 0 24px 50px -24px #000000aa; } }
  @keyframes pz-shake { 0%, 100% { transform: none; } 25% { transform: translateX(-7px); } 75% { transform: translateX(7px); } }
  .pz-swap { animation: pz-slide 0.36s cubic-bezier(.2,.8,.2,1); }

  /* explore */
  .pz-ex-head { display: flex; align-items: center; gap: 18px; margin-bottom: 18px; }
  .pz-ex-name { font: 800 clamp(54px, 9vw, 84px)/1 var(--font-sans); letter-spacing: -0.05em; color: #fff; text-shadow: 0 8px 36px #7c3aedaa; min-width: 1.1em; }
  .pz-ex-long { font: 700 18px var(--font-sans); color: #e9ddff; }
  .pz-notes { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .pz-notes span { padding: 3px 11px; font: 700 13px var(--font-mono); color: #1a0533; background: #fbbf24; border-radius: 99px; }
  .pz-notes span:first-child { background: #fff; }
  .pz-notes.dark span { color: var(--color-violet-deep); background: var(--color-canvas-soft-2); }
  .pz-notes.dark span:first-child { color: #fff; background: var(--color-violet); }
  .pz-gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(132px, 1fr)); gap: 12px; }
  .pz-shape { position: relative; display: flex; flex-direction: column; align-items: center; padding: 10px 8px 12px; font: inherit; text-align: center; color: var(--color-ink); background: #fff; border: 2px solid transparent; border-radius: 20px; cursor: pointer; animation: pz-in 0.45s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--i, 0) * 55ms); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
  .pz-shape:hover { transform: translateY(-4px); box-shadow: 0 18px 30px -16px #000000aa; }
  .pz-shape:active { transform: scale(0.97); }
  .pz-shape svg { display: block; width: 100%; max-width: 112px; height: auto; }
  .pz-shape small { margin-top: 4px; font: 600 12px var(--font-sans); color: var(--color-mute); }
  .pz-shape.use { border-color: #f59e0b; box-shadow: 0 0 0 4px #f59e0b44, 0 18px 30px -16px #000000aa; }
  .pz-shape.use::after { content: "In use"; position: absolute; top: 8px; right: 8px; padding: 2px 8px; font: 700 10.5px var(--font-mono); letter-spacing: 0.06em; color: #78350f; background: #fde68a; border-radius: 99px; }
  .pz-shape.playing svg { animation: pz-pop 0.4s ease-out; }
  .pz-hint { margin: 16px 0 0; font-size: 13px; color: #b9a3df; }
  .pz-hint b { color: #fde68a; }

  /* the drills */
  .pz-cards { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 14px; margin-bottom: 16px; text-align: center; }
  .pz-now, .pz-next { position: relative; display: flex; flex-direction: column; align-items: center; padding: 14px 10px 12px; border-radius: 26px; overflow: hidden; }
  .pz-now { background: #fff; color: var(--color-ink); box-shadow: 0 24px 50px -24px #000000aa; transition: background-color 0.25s, box-shadow 0.25s, transform 0.2s; }
  .pz-now.beat { animation: pz-beat 0.3s ease-out; }
  .pz-now.good { background: #ecfdf5; box-shadow: 0 0 0 4px #34d399, 0 24px 50px -24px #10b981; transform: scale(1.02); }
  .pz-now.miss { background: #fff7ed; box-shadow: 0 0 0 4px #fb923c, 0 24px 50px -24px #000000aa; animation: pz-shake 0.35s; }
  .pz-next { background: #ffffff12; border: 1px solid #ffffff1f; color: #e9ddff; }
  .pz-label { font: 700 11px var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-violet); }
  .pz-next .pz-label { color: #b9a3df; }
  .pz-name { font: 800 clamp(48px, 8vw, 74px)/1.05 var(--font-sans); letter-spacing: -0.05em; }
  .pz-next-name { font: 800 32px/1.2 var(--font-sans); letter-spacing: -0.04em; color: #fff; }
  .pz-diagram { width: 100%; max-width: 190px; margin-top: 4px; }
  .pz-next .pz-diagram { max-width: 100px; }
  .pz-diagram svg { display: block; width: 100%; height: auto; }
  .pz-next .pz-diagram svg { filter: invert(1) hue-rotate(180deg) brightness(1.4); opacity: 0.9; }
  .pz-nodiagram { padding: 24px 0; font-size: 13px; color: var(--color-mute); }
  .pz-badge { position: absolute; top: 12px; right: 12px; padding: 3px 11px; font: 700 12px var(--font-mono); color: #065f46; background: #a7f3d0; border-radius: 99px; animation: pz-pop 0.4s ease-out; }
  .pz-badge.miss { color: #9a3412; background: #fed7aa; }
  .pz-badge[hidden] { display: none; }
  .pz-strip { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin: 0 0 16px; }
  .pz-strip[hidden] { display: none; }
  .pz-strip span { min-width: 44px; padding: 5px 11px; text-align: center; font: 700 13.5px var(--font-mono); color: #d6c7f2; background: #ffffff12; border: 1px solid #ffffff1c; border-radius: 10px; transition: transform 0.2s, background-color 0.2s, color 0.2s; }
  .pz-strip span.on { color: #1a0533; background: #fbbf24; border-color: #fbbf24; transform: translateY(-3px) scale(1.08); box-shadow: 0 10px 20px -10px #f59e0b; }
  .pz-strip span.done { opacity: 0.55; }
  .pz-extra { position: relative; text-align: center; }
  .pz-beats { display: flex; justify-content: center; gap: 9px; margin: 0 0 14px; min-height: 18px; }
