  .pz-quals button { min-height: 36px; padding: 0 13px; font: 700 13.5px var(--font-sans); color: var(--color-body); background: #fff; border: 1px solid var(--color-hairline); border-radius: 11px; cursor: pointer; transition: background-color 0.2s, color 0.2s, border-color 0.2s, transform 0.15s; }
  .pz-quals button:hover { border-color: var(--color-hairline-strong); color: var(--color-ink); }
  .pz-quals button:active { transform: scale(0.95); }
  .pz-quals button[aria-pressed="true"] { color: #fff; background: var(--color-violet); border-color: var(--color-violet); }
  .pz-preview { display: flex; align-items: center; gap: 16px; padding: 14px; background: var(--color-canvas-soft); border: 1px solid var(--color-hairline); border-radius: 20px; }
