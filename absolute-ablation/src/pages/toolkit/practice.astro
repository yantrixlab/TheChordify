  .pz-chip { display: inline-flex; align-items: center; gap: 6px; min-height: 38px; padding: 0 8px 0 14px; font: 800 15px var(--font-sans); color: var(--color-ink); background: #fff; border: 1px solid var(--color-hairline-strong); border-radius: 12px; cursor: pointer; animation: pz-in 0.3s cubic-bezier(.2,.8,.2,1) both; transition: background-color 0.2s, border-color 0.2s, transform 0.15s; }
  .pz-chip:hover { background: var(--color-canvas-soft); transform: translateY(-1px); }
  .pz-chip.on { border-color: var(--color-violet); background: var(--color-violet-soft); }
  .pz-chip .x { display: grid; place-items: center; width: 22px; height: 22px; font-size: 15px; line-height: 1; color: var(--color-mute); border-radius: 50%; transition: background-color 0.2s, color 0.2s; }
