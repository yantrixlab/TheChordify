  /* the quiz */
  .pz-quiz-card { position: relative; display: flex; flex-direction: column; align-items: center; max-width: 280px; margin: 0 auto 16px; padding: 14px 14px 10px; color: var(--color-ink); background: #fff; border-radius: 26px; box-shadow: 0 24px 50px -24px #000000aa; transition: background-color 0.25s, box-shadow 0.25s; }
