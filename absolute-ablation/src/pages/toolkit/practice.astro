  .pz-shapes button:hover:not(:disabled) { background: var(--color-canvas-soft-2); }
  .pz-shapes button:active:not(:disabled) { transform: scale(0.9); }
  .pz-shapes button:disabled { opacity: 0.35; cursor: default; }
  .pz-pick-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .pz-pick-actions .tk-btn { min-height: 42px; padding: 0 14px; font-size: 14px; }
  .pz-pick-actions .tk-btn[hidden] { display: none; }
  .pz-pick-actions .tk-btn.on { color: #fff; background: var(--color-violet); }
