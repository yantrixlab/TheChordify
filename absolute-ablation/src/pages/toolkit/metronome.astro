---
import ToolShell from "../../components/ToolShell.astro";

const signatures = ["2/4", "3/4", "4/4", "5/4", "6/4", "7/4", "3/8", "6/8", "7/8", "9/8", "12/8"];
const sounds = [["click", "Click"], ["wood", "Wood block"], ["beep", "Beep"], ["hat", "Hi-hat"]];
const subs = [["1", "Just the beat"], ["2", "Eighths"], ["3", "Triplets"], ["4", "Sixteenths"]];
const quick = [["Ballad", 66], ["Walking", 90], ["Pop", 110], ["Rock", 128], ["Fast", 160]];
---

<ToolShell
  title="Metronome — Chord Suno Toolkit"
  description="A free online metronome with tap tempo, time signatures, subdivisions, accents, a speed trainer and silent-bar practice."
  heading="Metronome"
  sub="Steady time from 20 to 300 BPM. Tap a tempo, change the time signature, add subdivisions, and let the speed trainer push you a little faster each round."
  feature="metronome"
  tool="metronome"
  crumb="Metronome"
>
  <div class="tk-layout">
    <section class="tk-console mt" aria-label="Metronome">
      <div class="mt-glow" id="glow" aria-hidden="true"></div>
      <div class="mt-top">
        <span class="mt-name" id="name">Andante</span>
        <span class="mt-sig" id="sig-label">4/4</span>
      </div>

      <div class="mt-dial">
        <button class="tk-round" id="bpm-minus" type="button" aria-label="Slower by 1 BPM">−</button>
        <label class="mt-bpm">
          <input id="bpm-input" type="number" inputmode="numeric" min="20" max="300" value="100" aria-label="Beats per minute" />
          <span>BPM</span>
        </label>
        <button class="tk-round" id="bpm-plus" type="button" aria-label="Faster by 1 BPM">+</button>
      </div>

      <input id="bpm-range" class="tk-range on-dark mt-range" type="range" min="20" max="300" value="100" aria-label="Tempo" />
      <div class="mt-nudge" role="group" aria-label="Change tempo">
        <button type="button" data-nudge="-10">−10</button>
        <button type="button" data-nudge="-5">−5</button>
        <button type="button" data-nudge="5">+5</button>
        <button type="button" data-nudge="10">+10</button>
      </div>

      <div class="mt-pendulum" aria-hidden="true">
        <div class="mt-body"></div>
        <div class="mt-arm" id="arm"><i id="weight"></i></div>
        <div class="mt-pivot"></div>
      </div>

      <div class="mt-beats" id="beats" role="group" aria-label="Beats in the bar. Press one to change how loud it is."></div>
      <p class="mt-beats-hint">Press a beat to make it louder, softer or silent</p>

      <div class="mt-actions">
        <button id="play" class="tk-btn amber mt-play" type="button" aria-pressed="false">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path id="play-icon" d="M5 3.2v11.6L15 9z" fill="currentColor"></path></svg>
          <span id="play-text">Start</span>
        </button>
        <button id="tap" class="tk-btn on-dark mt-tap" type="button">Tap tempo</button>
      </div>

      <div class="mt-stats" aria-live="off">
        <span>Bar <b id="stat-bar">–</b></span>
        <span>Time <b id="stat-time">0:00</b></span>
        <span>Tempo <b id="stat-bpm">100</b></span>
      </div>
      <p class="mt-keys">
        <span class="tk-kbd">Space</span> start or stop · <span class="tk-kbd">↑</span> <span class="tk-kbd">↓</span> ±1 · <span class="tk-kbd">←</span> <span class="tk-kbd">→</span> ±5 · <span class="tk-kbd">T</span> tap
      </p>
    </section>

    <div>
      <section class="tk-card">
        <h2>Time signature</h2>
        <div class="tk-seg" id="sigs" role="group" aria-label="Time signature">
          {signatures.map((s) => (<button type="button" data-sig={s} aria-pressed="false">{s}</button>))}
        </div>
        <p class="tk-hint">BPM counts every beat in the bar. In 6/8 or 12/8 each beat is an eighth note, and the strong beats fall in groups of three.</p>

        <div class="tk-field" style="margin-top:18px">
          <p class="tk-label">Between the beats</p>
          <div class="tk-seg" id="subs" role="group" aria-label="Subdivision">
            {subs.map(([v, l]) => (<button type="button" data-sub={v} aria-pressed="false">{l}</button>))}
          </div>
        </div>
      </section>

      <section class="tk-card">
        <h2>Sound</h2>
        <div class="tk-field">
          <div class="tk-seg" id="sounds" role="group" aria-label="Sound">
            {sounds.map(([v, l]) => (<button type="button" data-sound={v} aria-pressed="false">{l}</button>))}
          </div>
        </div>
        <div class="tk-field">
          <label class="tk-label" for="volume">Volume <output id="volume-out">80%</output></label>
          <input id="volume" class="tk-range" type="range" min="0" max="100" value="80" />
        </div>
        <div class="tk-field">
          <p class="tk-label">Quick tempos</p>
          <div class="tk-seg" id="quick">
            {quick.map(([l, v]) => (<button type="button" data-bpm={v}>{l} {v}</button>))}
          </div>
        </div>
      </section>

      <section class="tk-card">
        <h2>Practice</h2>
        <label class="tk-switch">
          <span>Speed trainer<small>Gets faster every few bars, up to a tempo you pick</small></span>
          <input type="checkbox" id="trainer-on" /><i></i>
        </label>
        <div class="tk-inline mt-sub" id="trainer-fields">
          Add <input class="tk-number" id="trainer-step" type="number" min="1" max="30" value="2" aria-label="BPM to add" /> BPM every
          <input class="tk-number" id="trainer-every" type="number" min="1" max="32" value="4" aria-label="Bars between steps" /> bars, up to
          <input class="tk-number" id="trainer-target" type="number" min="30" max="300" value="140" aria-label="Top tempo" /> BPM
        </div>
        <label class="tk-switch" style="margin-top:18px">
          <span>Silent bars<small>Keeps time without the click, so you can test your own timing</small></span>
          <input type="checkbox" id="gap-on" /><i></i>
        </label>
        <div class="tk-inline mt-sub" id="gap-fields">
          Click for <input class="tk-number" id="gap-play" type="number" min="1" max="16" value="3" aria-label="Bars with sound" /> bars, then silent for
          <input class="tk-number" id="gap-mute" type="number" min="1" max="16" value="1" aria-label="Silent bars" /> bar
        </div>
      </section>

      <section class="tk-card">
        <h2>Saved settings <small id="preset-count"></small></h2>
        <form class="tk-inline" id="preset-form" autocomplete="off">
          <input class="tk-select" id="preset-name" type="text" maxlength="24" placeholder="Name this setting, e.g. Song 3 verse" aria-label="Name for this setting" style="flex:1 1 180px;width:auto" />
          <button class="tk-btn soft" type="submit">Save</button>
        </form>
        <div class="tk-seg" id="presets" style="margin-top:12px"></div>
      </section>
    </div>
  </div>
</ToolShell>

<style is:global>
  .mt { padding: 26px 24px 22px; text-align: center; }
  .mt-glow { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(ellipse 60% 50% at 50% 38%, #f59e0b55, transparent 70%); opacity: 0; transition: opacity 0.32s ease-out; }
  .mt-glow.hit { opacity: 1; transition: none; }
  .mt-top { position: relative; display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .mt-name { font: 700 13px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #fbbf24; }
  .mt-sig { padding: 4px 12px; font: 700 14px var(--font-mono); color: #e9ddff; background: #ffffff14; border: 1px solid #ffffff22; border-radius: 99px; }
  .mt-dial { position: relative; display: flex; align-items: center; justify-content: center; gap: 18px; margin: 6px 0 4px; }
  .mt-bpm { display: flex; flex-direction: column; align-items: center; min-width: 190px; cursor: text; }
  .mt-bpm input { width: 190px; padding: 0; font: 800 88px/1 var(--font-sans); letter-spacing: -0.05em; text-align: center; color: #fff; background: transparent; border: 0; border-radius: 12px; -moz-appearance: textfield; appearance: textfield; text-shadow: 0 6px 30px #7c3aed99; font-variant-numeric: tabular-nums; }
  .mt-bpm input::-webkit-outer-spin-button, .mt-bpm input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .mt-bpm input:focus-visible { outline: 2px solid #fbbf24; outline-offset: 4px; }
  .mt-bpm span { font: 700 12px var(--font-mono); letter-spacing: 0.24em; color: #c4b0e0; }
  .mt-range { position: relative; width: calc(100% - 8px); margin: 14px 4px 6px; }
  .mt-nudge { position: relative; display: flex; justify-content: center; gap: 8px; margin-bottom: 8px; }
  .mt-nudge button { min-width: 52px; min-height: 34px; padding: 0 12px; font: 700 13px var(--font-mono); color: #e9ddff; background: #ffffff12; border: 1px solid #ffffff1f; border-radius: 10px; cursor: pointer; transition: background-color 0.15s; }
  .mt-nudge button:hover { background: #ffffff26; }

  .mt-pendulum { position: relative; height: 168px; margin: 8px auto 4px; width: 150px; }
  .mt-body { position: absolute; left: 0; right: 0; bottom: 0; height: 150px; background: linear-gradient(180deg, #ffffff1c, #ffffff0a); clip-path: polygon(30% 0, 70% 0, 100% 100%, 0 100%); border-radius: 6px; }
  .mt-body::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 47%, #ffffff12 47%, #ffffff12 53%, transparent 53%); }
  .mt-arm { position: absolute; left: 50%; bottom: 14px; width: 4px; height: 148px; margin-left: -2px; border-radius: 4px; background: linear-gradient(180deg, #fbbf24, #f59e0b); transform-origin: 50% 100%; transform: rotate(-22deg); box-shadow: 0 0 14px #f59e0b88; }
  .mt-arm i { position: absolute; left: 50%; top: 40%; width: 24px; height: 17px; margin-left: -12px; border-radius: 5px; background: #fff; box-shadow: 0 4px 10px #00000055; transition: top 0.25s; }
  .mt-pivot { position: absolute; left: 50%; bottom: 8px; width: 16px; height: 16px; margin-left: -8px; border-radius: 50%; background: #fff; box-shadow: 0 2px 8px #00000066; }

  .mt-beats { position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin: 14px 0 6px; }
  .mt-beat { width: 40px; height: 40px; padding: 0; border-radius: 50%; border: 2px solid #ffffff44; background: transparent; cursor: pointer; transition: transform 0.08s, background-color 0.08s, box-shadow 0.08s, border-color 0.15s; }
  .mt-beat[data-level="2"] { width: 46px; height: 46px; border-color: #f59e0b; background: #f59e0b33; }
  .mt-beat[data-level="1"] { border-color: #c4b0e0; background: #c4b0e022; }
  .mt-beat[data-level="0"] { border-style: dashed; border-color: #ffffff2e; }
  .mt-beat.now { transform: scale(1.18); }
  .mt-beat[data-level="2"].now { background: #f59e0b; box-shadow: 0 0 26px #f59e0bcc; }
  .mt-beat[data-level="1"].now { background: #fff; box-shadow: 0 0 22px #ffffffaa; }
  .mt-beat[data-level="0"].now { background: #ffffff24; }
  .mt-beat.silent { opacity: 0.35; }
  .mt-beats-hint { position: relative; margin: 0 0 18px; font-size: 12px; color: #a78bd0; }
  .mt-actions { position: relative; display: flex; gap: 10px; justify-content: center; }
  .mt-play { min-width: 160px; min-height: 54px; font-size: 17px; border-radius: 18px; }
  .mt-tap { min-height: 54px; min-width: 130px; border-radius: 18px; }
  .mt-tap:active { background: #ffffff40; }
  .mt-stats { position: relative; display: flex; justify-content: center; gap: 24px; margin-top: 18px; font-size: 13px; color: #b9a3df; }
  .mt-stats b { margin-left: 4px; font: 700 14px var(--font-mono); color: #fff; }
  .mt-keys { position: relative; margin: 14px 0 0; font-size: 12px; color: #a78bd0; }
  .mt-keys .tk-kbd { color: #e9ddff; background: #ffffff14; border-color: #ffffff30; }
  .mt-sub { transition: opacity 0.2s; }
  .mt-sub.off { opacity: 0.45; }
  .mt .mt-beat:focus-visible, .mt .tk-round:focus-visible { outline-color: #fbbf24; }
  @media (max-width: 480px) {
    .mt { padding: 20px 14px 18px; }
    .mt-bpm, .mt-bpm input { min-width: 0; width: 148px; }
    .mt-bpm input { font-size: 70px; }
    .mt-dial { gap: 10px; }
    .mt-beat { width: 34px; height: 34px; }
    .mt-beat[data-level="2"] { width: 40px; height: 40px; }
  }
</style>

<script>
  import { Metronome, TapTempo, clampBpm, defaultAccents, tempoName, type Settings } from "../../lib/tools/metronome";
  import { initGate } from "../../lib/tools/gate";
  import { toast } from "../../lib/toast";

  const gate = initGate("metronome", "metronome");
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  // ---- settings (kept on this device) ----
  interface Saved extends Settings {
    sig: string;
  }
  const KEY = "cs-metronome";
  const PRESETS = "cs-metronome-presets";
  const fresh = (): Saved => ({
    bpm: 100, beats: 4, accents: defaultAccents(4, 4), sub: 1, sound: "click", volume: 0.8, sig: "4/4",
    trainer: { on: false, every: 4, step: 2, target: 140 },
    gap: { on: false, play: 3, mute: 1 },
  });
  function load(): Saved {
    try {
      const s = JSON.parse(localStorage.getItem(KEY) || "null");
      if (s && typeof s.bpm === "number" && Array.isArray(s.accents)) return { ...fresh(), ...s, trainer: { ...fresh().trainer, ...s.trainer }, gap: { ...fresh().gap, ...s.gap } };
    } catch { /* first visit, or storage is off */ }
    return fresh();
  }
  let state = load();
  const save = () => {
    try { localStorage.setItem(KEY, JSON.stringify(state)); } catch { /* storage is off */ }
  };

  const engine = new Metronome(state);
  const tapper = new TapTempo();

  // ---- drawing ----
  const bpmInput = $<HTMLInputElement>("bpm-input");
  const bpmRange = $<HTMLInputElement>("bpm-range");
  const fill = (el: HTMLInputElement) => el.style.setProperty("--fill", `${((+el.value - +el.min) / (+el.max - +el.min)) * 100}%`);

  function drawTempo() {
    bpmInput.value = String(state.bpm);
    bpmRange.value = String(state.bpm);
    fill(bpmRange);
    $("name").textContent = tempoName(state.bpm);
    $("stat-bpm").textContent = String(state.bpm);
    $("weight").style.top = `${8 + ((state.bpm - 20) / 280) * 62}%`;
  }

  function drawBeats() {
    const box = $("beats");
    box.replaceChildren();
    state.accents.forEach((level, i) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "mt-beat";
      b.dataset.level = String(level);
      b.setAttribute("aria-label", `Beat ${i + 1}: ${["silent", "normal", "accent"][level]}. Press to change.`);
      b.addEventListener("click", () => {
        state.accents[i] = (level + 2) % 3; // accent -> normal -> silent -> accent
        drawBeats();
        save();
      });
      box.appendChild(b);
    });
  }

  function drawChoices() {
    document.querySelectorAll<HTMLButtonElement>("[data-sig]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sig === state.sig)));
    document.querySelectorAll<HTMLButtonElement>("[data-sub]").forEach((b) => b.setAttribute("aria-pressed", String(+(b.dataset.sub ?? 0) === state.sub)));
    document.querySelectorAll<HTMLButtonElement>("[data-sound]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sound === state.sound)));
    $("sig-label").textContent = state.sig;
    const volume = $<HTMLInputElement>("volume");
    volume.value = String(Math.round(state.volume * 100));
    fill(volume);
    $("volume-out").textContent = `${volume.value}%`;
    $<HTMLInputElement>("trainer-on").checked = state.trainer.on;
    $<HTMLInputElement>("trainer-step").value = String(state.trainer.step);
    $<HTMLInputElement>("trainer-every").value = String(state.trainer.every);
    $<HTMLInputElement>("trainer-target").value = String(state.trainer.target);
    $<HTMLInputElement>("gap-on").checked = state.gap.on;
    $<HTMLInputElement>("gap-play").value = String(state.gap.play);
    $<HTMLInputElement>("gap-mute").value = String(state.gap.mute);
    $("trainer-fields").classList.toggle("off", !state.trainer.on);
    $("gap-fields").classList.toggle("off", !state.gap.on);
  }

  function apply(next: Saved) {
    state = next;
    engine.settings = state;
    drawTempo();
    drawBeats();
    drawChoices();
    save();
  }

  function setBpm(bpm: number) {
    state.bpm = clampBpm(bpm);
    drawTempo();
    save();
  }

  // ---- tempo controls ----
  bpmInput.addEventListener("change", () => setBpm(Number(bpmInput.value) || state.bpm));
  bpmInput.addEventListener("keydown", (e) => {
    if (e.key === "Enter") bpmInput.blur();
  });
  bpmRange.addEventListener("input", () => setBpm(Number(bpmRange.value)));
  document.querySelectorAll<HTMLButtonElement>("[data-nudge]").forEach((b) => b.addEventListener("click", () => setBpm(state.bpm + Number(b.dataset.nudge))));
  document.querySelectorAll<HTMLButtonElement>("[data-bpm]").forEach((b) => b.addEventListener("click", () => setBpm(Number(b.dataset.bpm))));

  // holding + or − keeps going
  function holdRepeat(id: string, delta: number) {
    const el = $<HTMLButtonElement>(id);
    let wait = 0;
    let repeat = 0;
    const stop = () => {
      window.clearTimeout(wait);
      window.clearInterval(repeat);
    };
    el.addEventListener("pointerdown", (e) => {
      e.preventDefault();
      setBpm(state.bpm + delta);
      wait = window.setTimeout(() => (repeat = window.setInterval(() => setBpm(state.bpm + delta), 70)), 420);
    });
    ["pointerup", "pointerleave", "pointercancel"].forEach((t) => el.addEventListener(t, stop));
    el.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        setBpm(state.bpm + delta);
      }
    });
  }
  holdRepeat("bpm-minus", -1);
  holdRepeat("bpm-plus", 1);

  $("tap").addEventListener("pointerdown", () => {
    const bpm = tapper.tap();
    if (bpm) setBpm(bpm);
  });
  $("tap").addEventListener("keydown", (e) => {
    if ((e as KeyboardEvent).key === "Enter") {
      const bpm = tapper.tap();
      if (bpm) setBpm(bpm);
    }
  });

  // ---- choices ----
  document.querySelectorAll<HTMLButtonElement>("[data-sig]").forEach((b) =>
    b.addEventListener("click", () => {
      const [beats, unit] = (b.dataset.sig ?? "4/4").split("/").map(Number);
      state.sig = b.dataset.sig ?? "4/4";
      state.beats = beats;
      state.accents = defaultAccents(beats, unit);
      drawBeats();
      drawChoices();
      save();
    }),
  );
  document.querySelectorAll<HTMLButtonElement>("[data-sub]").forEach((b) => b.addEventListener("click", () => { state.sub = Number(b.dataset.sub) as Settings["sub"]; drawChoices(); save(); }));
  document.querySelectorAll<HTMLButtonElement>("[data-sound]").forEach((b) => b.addEventListener("click", () => { state.sound = b.dataset.sound as Settings["sound"]; drawChoices(); save(); }));
  $<HTMLInputElement>("volume").addEventListener("input", (e) => { state.volume = Number((e.target as HTMLInputElement).value) / 100; drawChoices(); save(); });

  const num = (id: string, min: number, max: number, fallback: number) => Math.min(max, Math.max(min, Math.round(Number($<HTMLInputElement>(id).value) || fallback)));
  $<HTMLInputElement>("trainer-on").addEventListener("change", (e) => { state.trainer.on = (e.target as HTMLInputElement).checked; drawChoices(); save(); });
  for (const [id, key, min, max] of [["trainer-step", "step", 1, 30], ["trainer-every", "every", 1, 32], ["trainer-target", "target", 30, 300]] as const)
    $<HTMLInputElement>(id).addEventListener("change", () => { state.trainer[key] = num(id, min, max, state.trainer[key]); drawChoices(); save(); });
  $<HTMLInputElement>("gap-on").addEventListener("change", (e) => { state.gap.on = (e.target as HTMLInputElement).checked; drawChoices(); save(); });
  for (const [id, key] of [["gap-play", "play"], ["gap-mute", "mute"]] as const)
    $<HTMLInputElement>(id).addEventListener("change", () => { state.gap[key] = num(id, 1, 16, state.gap[key]); drawChoices(); save(); });

  engine.onBpm = (bpm) => {
    drawTempo();
    save();
    if (bpm >= state.trainer.target) toast({ icon: "🏁", title: `Reached ${bpm} BPM`, text: "The speed trainer has gone as fast as you asked.", ms: 4000 });
  };

  // ---- saved settings ----
  type Preset = { name: string; s: Saved };
  const presets = (): Preset[] => {
    try { return JSON.parse(localStorage.getItem(PRESETS) || "[]"); } catch { return []; }
  };
  function drawPresets() {
    const list = presets();
    const box = $("presets");
    box.replaceChildren();
    $("preset-count").textContent = list.length ? `${list.length} saved` : "";
    list.forEach((p, i) => {
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = `${p.name} · ${p.s.bpm} · ${p.s.sig}`;
      b.title = "Press to use. Right-click or long-press to delete.";
      b.addEventListener("click", () => apply({ ...fresh(), ...p.s }));
      const remove = () => {
        const next = presets().filter((_, j) => j !== i);
        try { localStorage.setItem(PRESETS, JSON.stringify(next)); } catch { /* storage is off */ }
        drawPresets();
      };
      b.addEventListener("contextmenu", (e) => { e.preventDefault(); if (confirm(`Delete “${p.name}”?`)) remove(); });
      let hold = 0;
      b.addEventListener("pointerdown", (e) => { if (e.pointerType === "touch") hold = window.setTimeout(() => { if (confirm(`Delete “${p.name}”?`)) remove(); }, 700); });
      ["pointerup", "pointerleave", "pointercancel"].forEach((t) => b.addEventListener(t, () => window.clearTimeout(hold)));
      box.appendChild(b);
    });
    if (!list.length) box.innerHTML = '<p class="tk-hint" style="margin:0">Nothing saved yet. Set up the tempo, time signature and practice options you like, then name and save them.</p>';
  }
  $("preset-form").addEventListener("submit", (e) => {
    e.preventDefault();
    const input = $<HTMLInputElement>("preset-name");
    const name = input.value.trim() || `Setting ${presets().length + 1}`;
    const next = [...presets(), { name, s: structuredClone(state) }].slice(-10);
    try { localStorage.setItem(PRESETS, JSON.stringify(next)); } catch { /* storage is off */ }
    input.value = "";
    drawPresets();
    toast({ icon: "💾", title: "Saved", text: name, ms: 2500 });
  });

  // ---- running ----
  let wake: { release(): Promise<void> } | null = null;
  let startedAt = 0;
  let raf = 0;
  let side = 1;
  let first = true;
  const arm = $("arm");
  const glow = $("glow");

  function swing(to: number, seconds: number) {
    arm.style.transition = seconds > 0 ? `transform ${seconds}s cubic-bezier(.4,0,.6,1)` : "none";
    arm.style.transform = `rotate(${to * 22}deg)`;
  }

  function frame() {
    for (const tick of engine.due()) {
      if (tick.sub === 0) {
        document.querySelectorAll<HTMLElement>(".mt-beat").forEach((b, i) => {
          b.classList.toggle("now", i === tick.beat);
          b.classList.toggle("silent", !tick.audible);
        });
        $("stat-bar").textContent = String(tick.bar + 1);
        if (tick.audible && tick.level > 0) {
          glow.classList.add("hit");
          window.setTimeout(() => glow.classList.remove("hit"), 60);
        }
        // the arm is at one end when a beat sounds, and is sent to the other end for the next
        if (first) {
          swing(-1, 0);
          void arm.offsetWidth;
          first = false;
          side = 1;
        } else side = -side;
        swing(side, engine.beatSeconds * 0.98);
      }
    }
    $("stat-time").textContent = clock((performance.now() - startedAt) / 1000);
    raf = requestAnimationFrame(frame);
  }
  const clock = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, "0")}`;

  async function start() {
    if (!gate.allowed()) return;
    await engine.start();
    startedAt = performance.now();
    first = true;
    $("stat-bar").textContent = "1";
    $("play-text").textContent = "Stop";
    $("play-icon").setAttribute("d", "M4.5 4.5h9v9h-9z");
    $("play").setAttribute("aria-pressed", "true");
    raf = requestAnimationFrame(frame);
    try { wake = await (navigator as unknown as { wakeLock?: { request(t: string): Promise<{ release(): Promise<void> }> } }).wakeLock?.request("screen") ?? null; } catch { /* the screen may dim, which is fine */ }
  }
  function stop() {
    engine.stop();
    cancelAnimationFrame(raf);
    $("play-text").textContent = "Start";
    $("play-icon").setAttribute("d", "M5 3.2v11.6L15 9z");
    $("play").setAttribute("aria-pressed", "false");
    document.querySelectorAll(".mt-beat").forEach((b) => b.classList.remove("now", "silent"));
    $("stat-bar").textContent = "–";
    swing(-1, 0.3);
    void wake?.release();
    wake = null;
  }
  const toggle = () => (engine.running ? stop() : void start());
  $("play").addEventListener("click", toggle);
  document.addEventListener("visibilitychange", () => { if (document.visibilityState === "visible" && engine.running && !wake) void (navigator as unknown as { wakeLock?: { request(t: string): Promise<{ release(): Promise<void> }> } }).wakeLock?.request("screen").then((w) => (wake = w)).catch(() => {}); });

  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    if (["INPUT", "SELECT", "TEXTAREA", "BUTTON"].includes(target.tagName) || e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === " ") { e.preventDefault(); toggle(); }
    else if (e.key === "ArrowUp") { e.preventDefault(); setBpm(state.bpm + 1); }
    else if (e.key === "ArrowDown") { e.preventDefault(); setBpm(state.bpm - 1); }
    else if (e.key === "ArrowRight") { e.preventDefault(); setBpm(state.bpm + 5); }
    else if (e.key === "ArrowLeft") { e.preventDefault(); setBpm(state.bpm - 5); }
    else if (e.key.toLowerCase() === "t") { const bpm = tapper.tap(); if (bpm) setBpm(bpm); }
  });

  apply(state);
  drawPresets();
  window.addEventListener("pagehide", () => engine.stop());
</script>
