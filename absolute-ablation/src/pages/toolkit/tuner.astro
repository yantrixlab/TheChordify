---
import ToolShell from "../../components/ToolShell.astro";
import { INSTRUMENTS } from "../../lib/tools/pitch";
---

<ToolShell
  title="Free Online Guitar Tuner — Chord Suno"
  description="A free online guitar tuner with a string-by-string display for guitar, bass, ukulele, violin, mandolin and banjo, with alternate tunings, a reference tone and an adjustable A4."
  heading="Tuner"
  sub="Pluck a string and watch it on the board. The string you play lights up and vibrates, its note slides up when you are sharp and down when you are flat, and each string is captured once it holds in tune."
  feature="tuner"
  tool="tuner"
  crumb="Tuner"
>
  <div class="tk-layout">
    <section class="tk-console tn" aria-label="Tuner">
      <div class="tn-top">
        <span class="tn-status" id="status" role="status">Press Start, then play a string</span>
        <div class="tn-progress" id="progress" hidden>
          <span id="progress-text">0 of 6 tuned</span>
          <i><b id="progress-fill"></b></i>
          <button type="button" id="reset" aria-label="Clear the tuned strings">Reset</button>
        </div>
      </div>

      <div class="tn-board" id="board" role="group" aria-label="Strings"></div>

      <div class="tn-readout" aria-live="polite">
        <div class="tn-note" id="note"><b>–</b><sup></sup></div>
        <div class="tn-side">
          <div class="tn-cents" id="cents">&nbsp;</div>
          <div class="tn-hz" id="hz">&nbsp;</div>
        </div>
      </div>
      <div class="tn-hint" id="hint">&nbsp;</div>
      <div class="tn-led" id="led" aria-hidden="true"></div>

      <div class="tn-pick" role="group" aria-label="Which string to tune">
        <button type="button" id="mode-auto" aria-pressed="true">Auto-detect the string</button>
        <button type="button" id="mode-manual" aria-pressed="false">I choose the string</button>
      </div>

      <div class="tn-meter" aria-hidden="true"><i id="level"></i></div>
      <p class="mic-name" id="mic-name"></p>
      <select id="mic-select" class="tk-select mic-select" aria-label="Microphone" hidden></select>
      <p class="mic-warn" id="mic-warn" hidden role="alert"></p>
      <div class="tn-actions">
        <button id="listen" class="tk-btn amber tn-listen" type="button" aria-pressed="false">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor"></rect><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"></path></svg>
          <span id="listen-text">Start</span>
        </button>
      </div>
      <p class="tk-error" id="error" hidden role="alert"></p>
    </section>

    <div>
      <section class="tk-card">
        <h2>Instrument</h2>
        <div class="tk-seg" id="instruments" role="group" aria-label="Instrument">
          {INSTRUMENTS.map((i) => (<button type="button" data-instrument={i.id} aria-pressed="false">{i.name}</button>))}
        </div>
        <div class="tk-field" style="margin-top:16px" id="tuning-field">
          <label class="tk-label" for="tuning">Tuning</label>
          <select id="tuning" class="tk-select"></select>
        </div>
        <p class="tk-hint" id="mode-hint">Tap a string to hear its note.</p>
      </section>

      <section class="tk-card">
        <h2>Settings</h2>
        <div class="tk-field">
          <label class="tk-label" for="a4">Concert pitch (A4) <output id="a4-out">440 Hz</output></label>
          <input id="a4" class="tk-range" type="range" min="415" max="466" step="1" value="440" />
          <p class="tk-hint">440 Hz is standard. Some orchestras use 442, and baroque music 415.</p>
        </div>
        <div class="tk-field">
          <p class="tk-label">How close is in tune?</p>
          <div class="tk-seg" id="tolerance" role="group" aria-label="Tolerance">
            <button type="button" data-tol="2" aria-pressed="false">Strict ±2</button>
            <button type="button" data-tol="5" aria-pressed="false">Normal ±5</button>
            <button type="button" data-tol="10" aria-pressed="false">Relaxed ±10</button>
          </div>
          <p class="tk-hint">Measured in cents, a hundredth of a semitone.</p>
        </div>
        <div class="tk-field">
          <label class="tk-label" for="sens">Microphone sensitivity <output id="sens-out">Medium</output></label>
          <input id="sens" class="tk-range" type="range" min="0" max="100" value="55" />
          <p class="tk-hint">Turn it up in a quiet room or for a soft instrument, down if the room is noisy.</p>
        </div>
      </section>

      <section class="tk-card">
        <h2>Tips</h2>
        <ul class="tn-tips">
          <li>Pluck one string at a time and let it ring.</li>
          <li>Tune up to the note: if you are sharp, loosen below it, then tighten up to it.</li>
          <li>A string turns green and is ticked once it has held in tune. Reset clears the ticks.</li>
          <li>Your sound is analysed on your device and never recorded.</li>
        </ul>
      </section>
    </div>
  </div>
</ToolShell>

<style is:global>
  .tn { padding: 20px 20px 22px; text-align: center; }
  .tn-top { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 10px; min-height: 34px; flex-wrap: wrap; }
  .tn-status { padding: 5px 12px; font: 600 12.5px var(--font-sans); color: #e9ddff; background: #ffffff14; border: 1px solid #ffffff22; border-radius: 99px; transition: color 0.3s, border-color 0.3s; }
  .tn.live .tn-status { color: #6ee7b7; border-color: #34d39966; }
  .tn-progress { display: inline-flex; align-items: center; gap: 10px; font: 600 12.5px var(--font-sans); color: #d6c7f2; animation: tn-in 0.4s ease-out; }
  .tn-progress[hidden] { display: none; }
  .tn-progress i { display: block; width: 74px; height: 6px; overflow: hidden; border-radius: 6px; background: #ffffff1f; }
  .tn-progress b { display: block; width: 0; height: 100%; border-radius: 6px; background: linear-gradient(90deg, #34d399, #6ee7b7); transition: width 0.5s cubic-bezier(.3,.9,.3,1); }
  .tn-progress button { padding: 3px 10px; font: 600 12px var(--font-sans); color: #d6c7f2; background: transparent; border: 1px solid #ffffff2e; border-radius: 99px; cursor: pointer; transition: background-color 0.2s; }
  .tn-progress button:hover { background: #ffffff1c; }
  @keyframes tn-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes tn-pop { 0% { transform: translate(-50%, var(--y, -50%)) scale(1); } 45% { transform: translate(-50%, var(--y, -50%)) scale(1.28); } 100% { transform: translate(-50%, var(--y, -50%)) scale(1); } }
  @keyframes tn-ripple { from { opacity: 0.8; transform: translate(-50%, -50%) scale(0.6); } to { opacity: 0; transform: translate(-50%, -50%) scale(2.4); } }
  @keyframes tn-glow { 0%, 100% { box-shadow: 0 0 0 0 #34d39900; } 50% { box-shadow: 0 0 40px 4px #34d39966; } }

  /* the strings */
  .tn-board { --node: 58px; --k: 2.2px; position: relative; display: flex; justify-content: center; gap: clamp(6px, 2.6vw, 22px); height: 330px; margin: 14px auto 6px; max-width: 520px; padding: 0 6px; }
  .tn-board::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: repeating-linear-gradient(90deg, #ffffff33 0 6px, transparent 6px 12px); pointer-events: none; }
  .tn-board.all-ok { animation: tn-glow 1.6s ease-in-out 2; border-radius: 28px; }
  .tn-str { position: relative; flex: 1 1 0; max-width: 78px; min-width: 0; height: 100%; }
  .tn-wire { position: absolute; inset: 0; width: 100%; height: 100%; color: #8f78d0; transition: color 0.35s ease; pointer-events: none; }
  .tn-wire path { fill: none; stroke: currentColor; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .tn-wire .tn-glow { stroke-opacity: 0; transition: stroke-opacity 0.4s ease; }
  .tn-str.near .tn-wire { color: #fbbf24; }
  .tn-str.near .tn-glow { stroke-opacity: 0.28; }
  .tn-str.ok .tn-wire, .tn-str.done .tn-wire { color: #6ee7b7; }
  .tn-str.ok .tn-glow { stroke-opacity: 0.34; }
  .tn-zone { position: absolute; left: 50%; top: 50%; width: calc(var(--node) + 8px); transform: translate(-50%, -50%); border-radius: 99px; background: #34d3991f; border: 1px solid #34d39933; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
  .tn-str.near .tn-zone, .tn-str.ok .tn-zone, .tn-board.manual .tn-str.target .tn-zone { opacity: 1; }
  .tn-node { --y: -50%; position: absolute; left: 50%; top: 50%; display: grid; place-content: center; width: var(--node); height: var(--node); padding: 0; font: inherit; color: #efe6ff; background: #1f0b45; border: 3px solid #ffffff2e; border-radius: 50%; cursor: pointer; transform: translate(-50%, var(--y)); will-change: transform; transition: border-color 0.35s ease, background-color 0.35s ease, box-shadow 0.35s ease, color 0.35s ease; }
  .tn-node b { display: block; font: 800 20px/1 var(--font-sans); letter-spacing: -0.02em; }
  .tn-node small { display: block; margin-top: 2px; font: 600 10px/1 var(--font-mono); color: #a78bd0; }
  .tn-node:hover { border-color: #ffffff66; background: #2c1160; }
  .tn-node:focus-visible { outline: 2px solid #fbbf24; outline-offset: 3px; }
  .tn-str.near .tn-node { border-color: #fbbf24; background: #3a1b05; box-shadow: 0 0 26px #f59e0b66; }
  .tn-str.ok .tn-node { border-color: #34d399; background: #053d2c; color: #d1fae5; box-shadow: 0 0 30px #10b98199; }
  .tn-str.done .tn-node { border-color: #34d399; background: #064e3b; color: #d1fae5; }
  .tn-str.done .tn-node::after { content: "✓"; position: absolute; top: -8px; right: -8px; display: grid; place-items: center; width: 22px; height: 22px; font: 800 12px var(--font-sans); color: #064e3b; background: #6ee7b7; border-radius: 50%; box-shadow: 0 4px 10px #00000055; animation: tn-pop-badge 0.4s cubic-bezier(.3,1.6,.5,1); }
  @keyframes tn-pop-badge { from { transform: scale(0); } to { transform: scale(1); } }
  .tn-board.manual .tn-str.target .tn-node { border-color: #fff; box-shadow: 0 0 0 4px #7c3aedcc; }
  .tn-node.pop { animation: tn-pop 0.45s ease-out; }
  .tn-node.ripple::before { content: ""; position: absolute; left: 50%; top: 50%; width: 100%; height: 100%; border: 2px solid #6ee7b7; border-radius: 50%; animation: tn-ripple 0.8s ease-out forwards; pointer-events: none; }

  /* the readout */
  .tn-readout { display: flex; align-items: center; justify-content: center; gap: 22px; margin-top: 6px; }
  .tn-note { font: 800 72px/1 var(--font-sans); letter-spacing: -0.05em; color: #fff; text-shadow: 0 6px 30px #7c3aed99; transition: color 0.25s; min-width: 1.1em; }
  .tn-note sup { margin-left: 4px; font: 700 24px var(--font-sans); color: #b9a3df; letter-spacing: 0; vertical-align: top; position: relative; top: 6px; }
  .tn.ok .tn-note { color: #6ee7b7; text-shadow: 0 6px 34px #10b981aa; }
  .tn-side { text-align: left; min-width: 110px; }
  .tn-cents { font: 800 26px/1.1 var(--font-mono); color: #fbbf24; font-variant-numeric: tabular-nums; transition: color 0.25s; }
  .tn.ok .tn-cents { color: #6ee7b7; }
  .tn-hz { margin-top: 4px; font: 600 13px var(--font-mono); color: #b9a3df; }
  .tn-hint { min-height: 24px; margin-top: 4px; font: 600 14px var(--font-sans); color: #c4b0e0; }
  .tn-led { display: flex; justify-content: center; gap: 4px; max-width: 360px; height: 18px; margin: 8px auto 14px; }
  .tn-led i { flex: 1; border-radius: 3px; background: #ffffff18; transition: background-color 0.12s, transform 0.12s, box-shadow 0.12s; }
  .tn-led i.mid { background: #34d3992b; }
  .tn-led i.on { background: #fbbf24; transform: scaleY(1.35); box-shadow: 0 0 12px #f59e0baa; }
  .tn-led i.trail { background: #fbbf2455; }
  .tn.ok .tn-led i.on { background: #6ee7b7; box-shadow: 0 0 14px #10b981cc; }
  .tn-pick { display: inline-flex; gap: 4px; padding: 4px; margin-bottom: 14px; background: #ffffff10; border: 1px solid #ffffff1c; border-radius: 99px; }
  .tn-pick button { padding: 7px 14px; font: 600 12.5px var(--font-sans); color: #c4b0e0; background: transparent; border: 0; border-radius: 99px; cursor: pointer; transition: background-color 0.2s, color 0.2s; }
  .tn-pick button[aria-pressed="true"] { color: #1a0533; background: #fbbf24; }
  .tn-meter { position: relative; height: 6px; max-width: 280px; margin: 0 auto 14px; overflow: hidden; border-radius: 6px; background: #ffffff1c; }
  .tn-meter i { display: block; height: 100%; width: 0; border-radius: 6px; background: linear-gradient(90deg, #34d399, #fbbf24); transition: width 0.08s linear; }
  .tn-meter i:not(.open) { opacity: 0.45; }
  .tn-actions { position: relative; }
  .tn-listen { min-width: 170px; min-height: 54px; font-size: 17px; border-radius: 18px; }
  .tn .tk-error { text-align: left; }
  .tn-tips { margin: 0; padding-left: 18px; list-style: disc; font-size: 14px; line-height: 1.7; color: var(--color-body); }
  @media (max-width: 520px) {
    .tn { padding: 16px 12px 18px; }
    .tn-board { --node: 48px; height: 290px; }
    .tn-node b { font-size: 17px; }
    .tn-note { font-size: 60px; }
  }
</style>

<script>
  import { INSTRUMENTS, detectPitch, matchString, pickFundamental, freqFromMidi, midiFromName, noteFromFreq, noteLabel, type Instrument } from "../../lib/tools/pitch";
  import { MicError, NoiseGate, SILENT_MIC_TEXT, SilenceWatch, audioContext, fillMicPicker, levelPercent, openMic, resumeAudio, rms, type Mic } from "../../lib/tools/audio";
  import { StringTracker } from "../../lib/tools/tracker";
  import { initGate } from "../../lib/tools/gate";
  import { toast } from "../../lib/toast";

  const gate = initGate("tuner", "tuner");
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const all = <T extends HTMLElement>(selector: string) => [...document.querySelectorAll<T>(selector)];

  interface Prefs { instrument: string; tuning: number; a4: number; tol: number; sens: number }
  const KEY = "cs-tuner";
  let prefs: Prefs = { instrument: "guitar", tuning: 0, a4: 440, tol: 5, sens: 55 };
  try { prefs = { ...prefs, ...JSON.parse(localStorage.getItem(KEY) || "{}") }; } catch { /* first visit */ }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(prefs)); } catch { /* storage is off */ } };

  const instrument = (): Instrument => INSTRUMENTS.find((i) => i.id === prefs.instrument) ?? INSTRUMENTS[0];
  const strings = (): number[] => (instrument().tunings[prefs.tuning] ?? instrument().tunings[0]).notes.map(midiFromName);
  const NAMES_PRETTY = (name: string) => name.replace("#", "♯");

  let target: number | null = null; // a string chosen by hand; null is automatic
  let done: boolean[] = []; // strings that have held in tune
  let held: number[] = []; // readings in a row in tune, per string
  let off: number[] = []; // readings in a row out of tune, per string
  let announced = false;

  // ---- the board: a string for each string of the instrument ----
  interface Lane { root: HTMLElement; node: HTMLButtonElement; path: SVGPathElement; glow: SVGPathElement; midi: number | null; amp: number; width: number; hz: number }
  let lanes: Lane[] = [];
  const SVGNS = "http://www.w3.org/2000/svg";

  function buildBoard() {
    const board = $("board");
    const list = strings();
    const items = list.length ? list : [null];
    board.classList.toggle("manual", target !== null);
    board.classList.remove("all-ok");
    lanes = items.map((midi, i) => {
      const root = document.createElement("div");
      root.className = "tn-str";
      const svg = document.createElementNS(SVGNS, "svg");
      svg.setAttribute("class", "tn-wire");
      svg.setAttribute("viewBox", "0 0 40 330");
      svg.setAttribute("preserveAspectRatio", "none");
      const path = document.createElementNS(SVGNS, "path");
      const width = midi === null ? 3 : Math.max(1.6, Math.min(5, 5.4 - (midi - 40) * 0.1));
      path.setAttribute("stroke-width", String(width));
      path.setAttribute("d", "M20 0 L20 330");
      const glow = document.createElementNS(SVGNS, "path");
      glow.setAttribute("class", "tn-glow");
      glow.setAttribute("stroke-width", String(width + 9));
      glow.setAttribute("d", "M20 0 L20 330");
      svg.append(glow, path);
      const zone = document.createElement("span");
      zone.className = "tn-zone";
      const node = document.createElement("button");
      node.type = "button";
      node.className = "tn-node";
      if (midi !== null) {
        node.innerHTML = `<b>${NAMES_PRETTY(noteLabel(midi).replace(/\d/, ""))}</b><small>${noteLabel(midi).match(/\d/)?.[0] ?? ""}</small>`;
        node.setAttribute("aria-label", `String ${i + 1}, ${noteLabel(midi)}. Press to hear it and tune this string.`);
        node.addEventListener("click", () => {
          target = midi;
          setMode();
          void playTone(freqFromMidi(midi, prefs.a4));
          node.classList.remove("pop");
          void node.offsetWidth;
          node.classList.add("pop");
        });
      } else {
        node.innerHTML = "<b>–</b>";
        node.setAttribute("aria-label", "The note you play");
        node.tabIndex = -1;
      }
      root.append(svg, zone, node);
      board.appendChild(root);
      return { root, node, path, glow, midi, amp: 0, width, hz: 9 + (midi === null ? 12 : (midi - 40) * 0.32) };
    });
    done = lanes.map(() => false);
    held = lanes.map(() => 0);
    off = lanes.map(() => 0);
    announced = false;
    sizeZones();
    drawProgress();
  }
  function rebuild() {
    $("board").replaceChildren();
    buildBoard();
    disp.length = 0;
    vel.length = 0;
    syncTracker();
  }
  const pxPerCent = () => ($("board").clientHeight * 0.36) / 50;
  function sizeZones() {
    const h = prefs.tol * 2 * pxPerCent();
    lanes.forEach((l) => ((l.root.querySelector(".tn-zone") as HTMLElement).style.height = `${Math.max(14, h)}px`));
  }

  function drawProgress() {
    const n = lanes.filter((l) => l.midi !== null).length;
    const d = done.filter(Boolean).length;
    $("progress").hidden = n === 0 || (d === 0 && !mic);
    $("progress-text").textContent = `${d} of ${n} tuned`;
    $("progress-fill").style.width = n ? `${(d / n) * 100}%` : "0";
    lanes.forEach((l, i) => l.root.classList.toggle("done", done[i]));
  }
  $("reset").addEventListener("click", () => {
    done = lanes.map(() => false);
    held = lanes.map(() => 0);
    off = lanes.map(() => 0);
    announced = false;
    $("board").classList.remove("all-ok");
    drawProgress();
  });

  // ---- the digital bar under the board ----
  const SEGMENTS = 21;
  function buildLed() {
    $("led").replaceChildren(...Array.from({ length: SEGMENTS }, (_, i) => Object.assign(document.createElement("i"), { className: i === 10 ? "mid" : "" })));
  }
  function drawLed(cents: number | null) {
    const segs = [...$("led").children];
    const at = cents === null ? -1 : Math.round(Math.max(-50, Math.min(50, cents)) / 5) + 10;
    segs.forEach((s, i) => {
      s.classList.toggle("on", i === at);
      s.classList.toggle("trail", at >= 0 && i !== at && ((i > 10 && i < at) || (i < 10 && i > at)));
    });
  }

  // ---- moving things ----
  // Nothing here jumps. The string being tuned follows the pitch with a smooth glide, glides back to the middle when the sound
  // stops, and only the string being played moves, vibrates or lights up.
  const tracker = new StringTracker({ strings: [], target: null, tol: 5 });
  const disp: number[] = []; // where each note is drawn, in cents
  const vel: number[] = []; // and how fast it is moving
  /** A critically damped spring: eases into the move, glides, and settles without overshooting or jittering. */
  function glide(current: number, goal: number, v: number, seconds: number, dt: number): [number, number] {
    const w = 2 / seconds;
    const x = w * dt;
    const e = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x);
    const change = current - goal;
    const temp = (v + w * change) * dt;
    return [goal + (change + temp) * e, (v - w * temp) * e];
  }
  let signal = 0; // how loud the string being played is, for the vibration
  let anim = 0;
  let lastFrame = 0;
  let readoutAt = 0;
  let ledAt = -2;

  function syncTracker() {
    tracker.opts = { strings: strings(), target, tol: prefs.tol };
    tracker.release();
    paintStates();
  }
  function paintStates() {
    const lock = tracker.lock;
    lanes.forEach((l, i) => {
      l.root.classList.toggle("near", i === lock && !tracker.ok);
      l.root.classList.toggle("ok", i === lock && tracker.ok);
    });
    root.classList.toggle("ok", lock >= 0 && tracker.ok);
  }
  const cache = new WeakMap<Element, string>();
  function put(el: Element, html: string) {
    if (cache.get(el) === html) return;
    cache.set(el, html);
    el.innerHTML = html;
  }
  function placeholders() {
    put($("note"), "<b>–</b><sup></sup>");
    put($("cents"), "&nbsp;");
    put($("hz"), "&nbsp;");
    put($("hint"), announced ? "All strings in tune!" : "&nbsp;");
    ledAt = -2;
    drawLed(null);
  }
  function drawReadout() {
    const lock = tracker.lock;
    if (lock < 0) return;
    const goal = tracker.goal()!;
    const c = tracker.cents;
    const shown = noteFromFreq(freqFromMidi(goal, prefs.a4), prefs.a4);
    put($("note"), `<b>${NAMES_PRETTY(shown.name)}</b><sup>${shown.octave}</sup>`);
    put($("cents"), `${c > 0.5 ? "+" : c < -0.5 ? "−" : ""}${Math.abs(Math.round(c))} ¢`);
    put($("hz"), `${freqFromMidi(goal + c / 100, prefs.a4).toFixed(1)} Hz`);
    put($("hint"), tracker.ok ? "In tune ✓" : c < 0 ? "A little low: tune up ↑" : "A little high: tune down ↓");
    if (lanes[lock].midi === null) put(lanes[lock].node, `<b>${NAMES_PRETTY(shown.name)}</b>`);
  }
  function frame(t: number) {
    const dt = lastFrame ? Math.min(0.1, (t - lastFrame) / 1000) : 0.016;
    lastFrame = t;
    const lock = tracker.lock;
    const k = pxPerCent();
    lanes.forEach((l, i) => {
      const active = i === lock;
      const [next, speed] = glide(disp[i] ?? 0, active ? tracker.cents : 0, vel[i] ?? 0, active ? 0.2 : 0.45, dt);
      disp[i] = next;
      vel[i] = speed;
      l.node.style.setProperty("--y", `calc(-50% + ${(-Math.max(-50, Math.min(50, next)) * k).toFixed(2)}px)`);
      l.amp += ((active ? Math.min(1, signal * 14) : 0) - l.amp) * (1 - Math.exp(-dt / 0.12));
      const wobble = l.amp * (l.width < 2.4 ? 11 : 8) * Math.sin((t / 1000) * l.hz * Math.PI * 2);
      const d = l.amp < 0.01 ? "M20 0 L20 330" : `M20 0 Q ${(20 + wobble).toFixed(2)} 165 20 330`;
      l.path.setAttribute("d", d);
      l.glow.setAttribute("d", d);
    });
    const at = lock >= 0 ? Math.round(Math.max(-50, Math.min(50, disp[lock] ?? 0)) / 5) + 10 : -1;
    if (at !== ledAt) {
      ledAt = at;
      drawLed(at < 0 ? null : (at - 10) * 5);
    }
    if (t - readoutAt > 90) {
      readoutAt = t;
      drawReadout();
    }
    anim = requestAnimationFrame(frame);
  }

  // ---- the settings ----
  function drawInstrument() {
    all<HTMLButtonElement>("[data-instrument]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.instrument === prefs.instrument)));
    const inst = instrument();
    const select = $<HTMLSelectElement>("tuning");
    select.replaceChildren(...inst.tunings.map((t, i) => Object.assign(document.createElement("option"), { value: String(i), textContent: t.name, selected: i === prefs.tuning })));
    $("tuning-field").style.display = inst.tunings.length < 2 ? "none" : "";
    $("mode-hint").textContent = strings().length ? "Tap a string to hear its note and tune that one." : "Play any note and the tuner names it and shows how far off it is.";
    $("mode-auto").parentElement!.style.display = strings().length ? "" : "none";
    rebuild();
  }
  function setMode() {
    $("mode-auto").setAttribute("aria-pressed", String(target === null));
    $("mode-manual").setAttribute("aria-pressed", String(target !== null));
    $("board").classList.toggle("manual", target !== null);
    lanes.forEach((l) => l.root.classList.toggle("target", l.midi !== null && l.midi === target));
    syncTracker();
  }
  $("mode-auto").addEventListener("click", () => { target = null; setMode(); });
  $("mode-manual").addEventListener("click", () => {
    if (target === null) target = strings()[0] ?? null;
    setMode();
  });

  all<HTMLButtonElement>("[data-instrument]").forEach((b) =>
    b.addEventListener("click", () => {
      prefs.instrument = b.dataset.instrument ?? "guitar";
      prefs.tuning = 0;
      target = null;
      save();
      drawInstrument();
      setMode();
      if (mic) mic.analyser.fftSize = instrument().fmin < 50 ? 8192 : 4096;
    }),
  );
  $<HTMLSelectElement>("tuning").addEventListener("change", (e) => { prefs.tuning = Number((e.target as HTMLSelectElement).value); target = null; save(); rebuild(); setMode(); });

  const a4 = $<HTMLInputElement>("a4");
  const fill = (el: HTMLInputElement) => el.style.setProperty("--fill", `${((+el.value - +el.min) / (+el.max - +el.min)) * 100}%`);
  a4.value = String(prefs.a4);
  const drawA4 = () => { fill(a4); $("a4-out").textContent = `${prefs.a4} Hz`; };
  a4.addEventListener("input", () => { prefs.a4 = Number(a4.value); drawA4(); save(); });
  drawA4();

  const drawTol = () => all<HTMLButtonElement>("[data-tol]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.tol) === prefs.tol)));
  all<HTMLButtonElement>("[data-tol]").forEach((b) => b.addEventListener("click", () => { prefs.tol = Number(b.dataset.tol); tracker.opts.tol = prefs.tol; save(); drawTol(); sizeZones(); }));
  drawTol();

  const sens = $<HTMLInputElement>("sens");
  sens.value = String(prefs.sens);
  $("mic-warn").textContent = SILENT_MIC_TEXT;
  const noiseGate = new NoiseGate(prefs.sens);
  const silence = new SilenceWatch();
  const drawSens = () => { fill(sens); $("sens-out").textContent = prefs.sens < 35 ? "Low" : prefs.sens < 70 ? "Medium" : "High"; };
  sens.addEventListener("input", () => { prefs.sens = Number(sens.value); noiseGate.sensitivity = prefs.sens; drawSens(); save(); });
  drawSens();

  // ---- a reference tone ----
  let tone: { stop(): void } | null = null;
  async function playTone(freq: number) {
    const ctx = await resumeAudio();
    tone?.stop();
    const out = ctx.createGain();
    const now = ctx.currentTime;
    out.gain.setValueAtTime(0.0001, now);
    out.gain.exponentialRampToValueAtTime(0.28, now + 0.05);
    out.gain.exponentialRampToValueAtTime(0.0001, now + 2.6);
    out.connect(ctx.destination);
    const oscs = [1, 2, 3].map((h) => {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = "sine";
      o.frequency.value = freq * h;
      g.gain.value = [1, 0.35, 0.12][h - 1];
      o.connect(g);
      g.connect(out);
      o.start(now);
      o.stop(now + 2.7);
      return o;
    });
    tone = { stop() { out.gain.cancelScheduledValues(ctx.currentTime); out.gain.setTargetAtTime(0.0001, ctx.currentTime, 0.03); oscs.forEach((o) => { try { o.stop(ctx.currentTime + 0.2); } catch { /* already stopped */ } }); } };
  }

  // ---- listening ----
  let mic: Mic | null = null;
  let timer = 0;
  let buf = new Float32Array(0);
  let lastHeard = 0;
  const root = document.querySelector<HTMLElement>(".tn")!;
  const CAPTURE = 12; // readings in tune in a row (about 0.6 s) before a string counts as tuned

  function release() {
    tracker.release();
    paintStates();
    placeholders();
  }

  /** A string is captured once it holds in tune, and let go again if it is played badly out of tune afterwards. */
  function capture() {
    const gi = tracker.lock;
    if (gi < 0 || lanes[gi].midi === null) return;
    held[gi] = tracker.ok ? held[gi] + 1 : 0;
    off[gi] = Math.abs(tracker.cents) > Math.max(15, prefs.tol * 3) ? off[gi] + 1 : 0;
    if (!done[gi] && held[gi] >= CAPTURE) {
      done[gi] = true;
      const node = lanes[gi].node;
      node.classList.remove("ripple", "pop");
      void node.offsetWidth;
      node.classList.add("ripple", "pop");
      window.setTimeout(() => node.classList.remove("ripple", "pop"), 900);
      drawProgress();
      if (done.every(Boolean) && !announced) {
        announced = true;
        $("board").classList.add("all-ok");
        toast({ icon: "🎸", title: "All strings in tune", text: "Nicely done. Time to play.", ms: 4000 });
      }
    } else if (done[gi] && off[gi] >= 20) {
      done[gi] = false;
      announced = false;
      $("board").classList.remove("all-ok");
      drawProgress();
    }
  }

  function consider(m: number, clarity: number) {
    const lock = tracker.lock;
    const wasOk = tracker.ok;
    tracker.push(m, clarity);
    if (tracker.lock !== lock || tracker.ok !== wasOk) {
      paintStates();
      if (tracker.ok && !wasOk && "vibrate" in navigator) navigator.vibrate?.(20);
    }
    capture();
  }

  function tick() {
    if (!mic) return;
    const inst = instrument();
    const sr = audioContext().sampleRate;
    if (buf.length !== mic.analyser.fftSize) buf = new Float32Array(mic.analyser.fftSize);
    mic.analyser.getFloatTimeDomainData(buf);
    const level = rms(buf);
    const now = performance.now();
    const open = noiseGate.update(level, now);
    $("level").style.width = `${levelPercent(level)}%`;
    $("level").classList.toggle("open", open);
    $("mic-warn").hidden = !silence.feed(level, now);
    signal = open ? level : 0;
    let pitch = open ? detectPitch(buf, sr, inst.fmin, inst.fmax) : null;
    if (pitch && pitch.clarity < 0.75) pitch = null;
    if (pitch) {
      lastHeard = now;
      put($("status"), "Listening");
      // which string is sounding comes from the spectrum, so a string ringing in sympathy cannot take over
      const list = strings();
      let m = list.length ? matchString(buf, sr, list, prefs.a4, pitch.freq, target) : null;
      if (m === null) m = 69 + 12 * Math.log2(pickFundamental(buf, sr, pitch.freq, inst.fmin, inst.fmax) / prefs.a4);
      consider(m, pitch.clarity);
    } else if (tracker.lock >= 0 && now - lastHeard > 700) {
      release();
      put($("status"), "Listening… play a string");
    }
  }

  async function start() {
    if (!gate.allowed()) return;
    const error = $("error");
    error.hidden = true;
    try {
      mic = await openMic(instrument().fmin < 50 ? 8192 : 4096);
    } catch (err) {
      error.textContent = err instanceof MicError ? err.message : "The microphone could not be started.";
      error.hidden = false;
      return;
    }
    $("mic-warn").hidden = true;
    $("mic-name").textContent = mic.label ? `Microphone: ${mic.label}` : "";
    void fillMicPicker($<HTMLSelectElement>("mic-select"), mic.deviceId, () => { stop(); void start(); });
    root.classList.add("live");
    put($("status"), "Listening… play a string");
    $("listen-text").textContent = "Stop";
    $("listen").setAttribute("aria-pressed", "true");
    syncTracker();
    timer = window.setInterval(tick, 50);
    cancelAnimationFrame(anim);
    lastFrame = 0;
    anim = requestAnimationFrame(frame);
    drawProgress();
  }
  function stop() {
    window.clearInterval(timer);
    mic?.stop();
    mic = null;
    signal = 0;
    release();
    root.classList.remove("live");
    put($("status"), "Press Start, then play a string");
    $("listen-text").textContent = "Start";
    $("listen").setAttribute("aria-pressed", "false");
    $("level").style.width = "0";
    $("mic-warn").hidden = true;
    drawProgress();
    // keep animating for a moment so the note glides back to the middle and the string settles
    window.setTimeout(() => { if (!mic) cancelAnimationFrame(anim); }, 1200);
  }
  $("listen").addEventListener("click", () => (mic ? stop() : void start()));
  window.addEventListener("pagehide", stop);
  window.addEventListener("resize", sizeZones);

  buildLed();
  drawInstrument();
  setMode();
</script>
