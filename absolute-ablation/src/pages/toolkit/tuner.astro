---
import ToolShell from "../../components/ToolShell.astro";
---

<ToolShell
  title="Free Online Guitar Tuner — Chord Suno"
  description="A free online tuner for acoustic and electric guitar, bass, ukulele, violin, mandolin and banjo: it names the string you play, shows how far off it is in cents, and has alternate tunings, a reference tone and an adjustable A4."
  heading="Tuner"
  sub="Play a string and the tuner finds it, names the note and shows how far it is from perfect, down to a single cent. Tune up or down until the bubble sits on the line and turns green."
  feature="tuner"
  tool="tuner"
  crumb="Tuner"
>
  <div class="tt" id="tt">
    <div class="tt-main">
      <aside class="tt-panel" aria-label="Instrument and tuning">
        <div class="tt-panel-head">
          <button type="button" class="tt-back" id="tt-back" aria-label="Choose another instrument" hidden>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg>
          </button>
          <button type="button" class="tt-title" id="tt-title" aria-expanded="false" aria-controls="tt-list">
            <span id="tt-title-text">Guitar 6-String</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
          </button>
        </div>
        <div class="tt-list" id="tt-list" role="radiogroup" aria-label="Tuning"></div>
      </aside>

      <section class="tt-stage" id="tt-stage" aria-label="Tuner">
        <div class="tt-bar">
          <div class="tt-seg" id="tt-kind" role="group" aria-label="Type of guitar" hidden>
            <button type="button" data-kind="acoustic" aria-pressed="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
              Acoustic
            </button>
            <button type="button" data-kind="electric" aria-pressed="false">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"></path></svg>
              Electric
            </button>
          </div>
          <div class="tt-bar-right">
            <span class="tt-progress" id="tt-progress" hidden><span id="tt-progress-text">0 of 6 tuned</span><button type="button" id="tt-reset">Reset</button></span>
            <button type="button" class="tt-mic" id="tt-mic" aria-pressed="false">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor"></rect><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"></path></svg>
              <span id="tt-mic-text">Start</span>
            </button>
            <label class="tt-auto" id="tt-auto-wrap">
              <span>Auto</span>
              <input type="checkbox" role="switch" id="tt-auto" checked />
              <i aria-hidden="true"></i>
            </label>
          </div>
        </div>

        <p class="tt-hint" id="tt-hint" role="status" aria-live="polite">Press Start, then play a string.</p>

        <div class="tt-board" id="tt-board">
          <div class="tt-gauge" aria-hidden="true">
            <canvas class="tt-trail" id="tt-trail"></canvas>
            <div class="tt-track"></div>
            <div class="tt-zone" id="tt-zone"></div>
            <span class="tt-end tt-end-l">♭</span>
            <span class="tt-end tt-end-r">♯</span>
            <div class="tt-line"></div>
            <div class="tt-bubble idle" id="tt-bubble"><span class="tt-tag" id="tt-tag"></span><b id="tt-cents"></b></div>
          </div>
          <div class="tt-note" id="tt-note" aria-hidden="true"></div>
          <div class="tt-hz" id="tt-hz" aria-hidden="true">&nbsp;</div>
          <div class="tt-art" id="tt-art"></div>
          <svg class="tt-over" id="tt-over" aria-hidden="true"></svg>
          <div class="tt-strings" id="tt-strings" role="group" aria-label="Strings"></div>
          <button type="button" class="tt-start" id="tt-start">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" fill="currentColor"></rect><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"></path></svg>
            Start tuning
          </button>
        </div>

        <div class="tt-foot">
          <div class="tt-level" aria-hidden="true"><i id="tt-level"></i></div>
          <p class="mic-name" id="mic-name"></p>
          <select id="mic-select" class="tk-select mic-select" aria-label="Microphone" hidden></select>
          <p class="mic-warn" id="mic-warn" hidden role="alert"></p>
          <p class="tk-error" id="error" hidden role="alert"></p>
          <p class="tt-privacy">Your sound is analysed on your device and is never recorded or sent.</p>
        </div>
      </section>
    </div>

    <section class="tk-card tt-settings" aria-label="Settings">
      <h2>Settings</h2>
      <div class="tt-settings-grid">
        <div class="tk-field">
          <label class="tk-label" for="a4">Concert pitch (A4) <output id="a4-out">440 Hz</output></label>
          <input id="a4" class="tk-range" type="range" min="415" max="466" step="1" value="440" />
          <p class="tk-hint">440 Hz is standard. Some orchestras use 442, and baroque music 415.</p>
        </div>
        <div class="tk-field">
          <p class="tk-label">How close is in tune?</p>
          <div class="tk-seg" id="tolerance" role="group" aria-label="Tolerance">
            <button type="button" data-tol="2" aria-pressed="false">Strict ±2</button>
            <button type="button" data-tol="3" aria-pressed="false">Normal ±3</button>
            <button type="button" data-tol="5" aria-pressed="false">Relaxed ±5</button>
            <button type="button" data-tol="10" aria-pressed="false">Loose ±10</button>
          </div>
          <p class="tk-hint">Measured in cents, a hundredth of a semitone.</p>
        </div>
        <div class="tk-field">
          <label class="tk-label" for="sens">Microphone sensitivity <output id="sens-out">Medium</output></label>
          <input id="sens" class="tk-range" type="range" min="0" max="100" value="55" />
          <p class="tk-hint">Turn it up in a quiet room or for a soft instrument, down if the room is noisy.</p>
        </div>
        <div class="tk-field">
          <p class="tk-label">Sound when a string is in tune</p>
          <div class="tk-seg" id="sound" role="group" aria-label="Success sound">
            <button type="button" data-sound="on" aria-pressed="true">On</button>
            <button type="button" data-sound="off" aria-pressed="false">Off</button>
          </div>
          <p class="tk-hint">A short chime when a string holds in tune, and a longer one when every string is done.</p>
        </div>
      </div>
    </section>
  </div>
</ToolShell>

<style is:global>
  /* ---- the whole tuner: a list of tunings beside the stage ---- */
  .tt { --u: 0.8px; display: grid; gap: 18px; }
  .tt-main { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 18px; align-items: start; }

  /* the tunings */
  .tt-panel { position: sticky; top: 90px; display: flex; flex-direction: column; max-height: min(760px, calc(100vh - 110px)); padding: 14px 12px 12px; color: #e8eaf6; border-radius: 22px; background: linear-gradient(180deg, #14172b, #0e1020); border: 1px solid #ffffff14; box-shadow: 0 24px 50px -30px #000c; }
  .tt-panel-head { display: flex; align-items: center; gap: 4px; margin: 0 2px 8px; }
  .tt-back { display: grid; place-items: center; width: 32px; height: 32px; padding: 0; border: 0; border-radius: 10px; background: #ffffff12; color: #a7f3d0; cursor: pointer; }
  .tt-back[hidden] { display: none; }
  .tt-back:hover { background: #ffffff24; }
  .tt-title { display: inline-flex; align-items: center; gap: 8px; flex: 1; min-height: 34px; padding: 0 8px; border: 0; border-radius: 10px; background: transparent; font: 700 14px var(--font-sans); letter-spacing: 0.01em; color: #6ee7b7; cursor: pointer; text-align: left; }
  .tt-title:hover { background: #ffffff0f; }
  .tt-title svg { margin-left: auto; opacity: 0.8; transition: transform 0.2s; }
  .tt-title[aria-expanded="true"] svg { transform: rotate(180deg); }
  .tt-list { overflow-y: auto; padding: 2px 2px 4px; scrollbar-width: thin; scrollbar-color: #ffffff30 transparent; }
  .tt-group { margin: 12px 8px 6px; font: 700 10.5px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #8d93b4; }
  .tt-group:first-child { margin-top: 4px; }
  .tt-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 10px; width: 100%; min-height: 40px; padding: 6px 10px; border: 0; border-radius: 12px; background: transparent; font: 600 13.5px var(--font-sans); color: #d7daf0; text-align: left; cursor: pointer; transition: background-color 0.12s; }
  .tt-row:hover { background: #ffffff10; }
  .tt-row small { font: 500 11px var(--font-mono); letter-spacing: 0.02em; color: #8d93b4; white-space: nowrap; }
  .tt-row[aria-checked="true"] { background: #34d3991f; color: #6ee7b7; }
  .tt-row[aria-checked="true"] small { color: #86efac; }
  .tt-row:focus-visible, .tt-title:focus-visible, .tt-back:focus-visible, .tt-str:focus-visible, .tt-mic:focus-visible, .tt-start:focus-visible, .tt-seg button:focus-visible, .tt-progress button:focus-visible { outline: 3px solid #fbbf24; outline-offset: 2px; }

  /* ---- the stage ---- */
  .tt-stage { position: relative; overflow: hidden; padding: 16px 18px 14px; color: #fff; border-radius: 28px; background: radial-gradient(ellipse 70% 45% at 50% 0%, #3b4fe040, transparent 70%), radial-gradient(ellipse 60% 40% at 50% 100%, #7c3aed2e, transparent 70%), linear-gradient(180deg, #0f1430, #0a0d20); border: 1px solid #ffffff14; box-shadow: 0 30px 60px -34px #000d; }
  .tt-stage::before { content: ""; position: absolute; inset: 0; pointer-events: none; background-image: linear-gradient(#ffffff0a 1px, transparent 1px), linear-gradient(90deg, #ffffff0a 1px, transparent 1px); background-size: 32px 32px; mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, #000 30%, transparent 100%); }
  .tt-stage > * { position: relative; }
  .tt-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px 14px; flex-wrap: wrap; min-height: 40px; }
  .tt-bar-right { display: flex; align-items: center; gap: 10px; margin-left: auto; flex-wrap: wrap; justify-content: flex-end; }
  .tt-seg { display: inline-flex; gap: 2px; padding: 3px; border-radius: 999px; background: #ffffff12; border: 1px solid #ffffff17; }
  .tt-seg[hidden] { display: none; }
  .tt-seg button { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 14px; border: 0; border-radius: 999px; background: transparent; font: 650 12.5px var(--font-sans); color: #aab0d6; cursor: pointer; transition: background-color 0.15s, color 0.15s; }
  .tt-seg button svg { opacity: 0; width: 0; transition: width 0.15s, opacity 0.15s; }
  .tt-seg button[aria-pressed="true"] { background: #34d3992b; color: #6ee7b7; }
  .tt-seg button[aria-pressed="true"] svg { opacity: 1; width: 14px; }
  .tt-mic { display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 14px; border: 1px solid #ffffff22; border-radius: 999px; background: #ffffff12; font: 650 12.5px var(--font-sans); color: #e4e7ff; cursor: pointer; transition: background-color 0.15s, border-color 0.15s, color 0.15s; }
  .tt-mic:hover { background: #ffffff20; }
  .tt-mic[aria-pressed="true"] { color: #6ee7b7; border-color: #34d39966; background: #34d3991a; }
  .tt-mic[aria-pressed="true"] svg { animation: tt-pulse 1.6s ease-in-out infinite; }
  @keyframes tt-pulse { 50% { opacity: 0.5; } }
  .tt-progress { display: inline-flex; align-items: center; gap: 8px; font: 600 12.5px var(--font-sans); color: #c7cdf2; }
  .tt-progress[hidden] { display: none; }
  .tt-progress button { padding: 3px 10px; border: 1px solid #ffffff2e; border-radius: 999px; background: transparent; font: 600 12px var(--font-sans); color: #c7cdf2; cursor: pointer; }
  .tt-progress button:hover { background: #ffffff1c; }
  .tt-auto { display: inline-flex; align-items: center; gap: 9px; font: 700 11.5px var(--font-sans); letter-spacing: 0.1em; text-transform: uppercase; color: #cfd4f5; cursor: pointer; user-select: none; }
  .tt-auto[hidden] { display: none; }
  .tt-auto input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .tt-auto i { position: relative; width: 38px; height: 22px; border-radius: 999px; background: #ffffff2e; transition: background-color 0.15s; }
  .tt-auto i::after { content: ""; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px #0006; transition: transform 0.15s; }
  .tt-auto input:checked + i { background: #10b981; }
  .tt-auto input:checked + i::after { transform: translateX(16px); }
  .tt-auto input:focus-visible + i { outline: 3px solid #fbbf24; outline-offset: 2px; }
  .tt-hint { min-height: 22px; margin: 12px 0 0; text-align: center; font: 500 13.5px var(--font-sans); color: #b4bae0; }

  /* ---- the board: everything is placed in a 700-unit-wide drawing that scales with the screen (--u is one unit in pixels) ---- */
  .tt-board { position: relative; width: 100%; max-width: 700px; margin: 0 auto; overflow: hidden; overflow: clip; aspect-ratio: 700 / var(--bh, 900); user-select: none; }
  .tt-board > * { position: absolute; }
  .tt-gauge { left: 0; top: 0; width: 100%; height: calc(var(--head, 205) / var(--bh, 900) * 100%); pointer-events: none; }
  .tt-gauge > * { position: absolute; }
  .tt-trail { left: 0; top: 0; width: 100%; height: 100%; }
  .tt-track { left: calc(100 / 700 * 100%); width: calc(500 / 700 * 100%); top: calc(var(--gy) / var(--head) * 100%); height: 2px; border-radius: 2px; background: repeating-linear-gradient(90deg, #ffffff40 0 2px, transparent 2px calc(25 * var(--u))); transform: translateY(-50%); opacity: 0.55; }
  .tt-zone { top: calc(var(--gy) / var(--head) * 100%); height: calc(54 * var(--u)); left: 50%; width: calc(var(--zone, 50) * 1px); transform: translate(-50%, -50%); border-radius: 999px; background: #10b9811f; border: 1px solid #10b98138; }
  .tt-end { top: calc(var(--gy) / var(--head) * 100%); transform: translateY(-50%); font: 700 calc(15 * var(--u)) var(--font-sans); color: #7d86c4; }
  .tt-end { font-size: max(12px, calc(20 * var(--u))); }
  .tt-end-l { left: calc(54 / 700 * 100%); }
  .tt-end-r { right: calc(54 / 700 * 100%); }
  .tt-line { left: 50%; top: 0; bottom: 0; width: 2px; transform: translateX(-50%); background: #c3c8ea; opacity: 0.5; border-radius: 2px; -webkit-mask-image: linear-gradient(180deg, transparent, #000 14%); mask-image: linear-gradient(180deg, transparent, #000 14%); transition: background-color 0.25s, opacity 0.25s, box-shadow 0.25s; }
  .tt.ok .tt-line { background: #34d399; opacity: 1; box-shadow: 0 0 12px 1px #10b981aa; }
  .tt-bubble { left: 50%; top: calc(var(--gy) / var(--head) * 100%); display: grid; place-items: center; width: max(44px, calc(60 * var(--u))); height: max(44px, calc(60 * var(--u))); margin: 0; border-radius: 50%; background: #0b1020; border: 3px solid #fff; box-shadow: 0 8px 22px -6px #000a, 0 0 0 0 transparent; transform: translate(-50%, -50%); will-change: left, transform; transition: border-color 0.2s, background-color 0.2s, box-shadow 0.2s; }
  .tt-bubble::after { content: ""; position: absolute; left: 50%; top: 100%; width: 0; height: 0; margin: 2px 0 0 -7px; border-left: 7px solid transparent; border-right: 7px solid transparent; border-top: 10px solid var(--ring, #ffffffd9); transition: border-top-color 0.2s; }
  .tt-bubble b { font: 800 max(14px, calc(21 * var(--u))) / 1 var(--font-sans); color: #fff; font-variant-numeric: tabular-nums; letter-spacing: -0.02em; }
  .tt-bubble { --ring: #ffffffd9; border-color: var(--ring); }
  .tt-bubble.far { --ring: #ef4444; box-shadow: 0 0 22px -2px #ef444488; }
  .tt-bubble.near { --ring: #f59e0b; box-shadow: 0 0 22px -2px #f59e0b88; }
  .tt-bubble.ok { --ring: #34d399; box-shadow: 0 0 24px -2px #10b981aa; }
  .tt-bubble.done { --ring: #10b981; background: #10b981; box-shadow: 0 0 34px 2px #10b981aa; }
  .tt-bubble.done b::before { content: "✓"; font-size: 1.15em; }
  .tt-bubble.done b { font-size: max(20px, calc(30 * var(--u))); }
  .tt-tag { position: absolute; bottom: calc(100% + 10px); left: 50%; padding: 3px 11px; border-radius: 999px; background: #0b1020d9; border: 1px solid #ffffff2b; font: 650 max(11px, calc(15 * var(--u))) var(--font-sans); color: #e9ecff; white-space: nowrap; transform: translateX(-50%); }
  .tt-tag:empty { display: none; }
  .tt-note { left: 50%; top: calc((var(--gy) + 74) / var(--bh) * 100%); transform: translateX(-50%); font: 800 max(30px, calc(62 * var(--u))) / 1 var(--font-sans); letter-spacing: -0.04em; color: #fff; text-shadow: 0 6px 30px #6366f180; white-space: nowrap; transition: color 0.2s; }
  .tt-note sub { margin-left: 3px; font: 700 0.42em var(--font-sans); letter-spacing: 0; color: #aab0d6; vertical-align: baseline; position: relative; top: 0.1em; }
  .tt-note.ok { color: #6ee7b7; text-shadow: 0 6px 30px #10b981aa; }
  .tt-note.muted { color: #ffffff59; text-shadow: none; }
  .tt-hz { left: 50%; top: calc((var(--gy) + 74 + 66) / var(--bh) * 100%); transform: translateX(-50%); font: 600 max(11px, calc(15 * var(--u))) var(--font-mono); color: #8e96c9; white-space: nowrap; }

  /* the picture of the guitar, fading out at the bottom */
  .tt-art { inset: 0; overflow: hidden; overflow: clip; pointer-events: none; -webkit-mask-image: linear-gradient(180deg, #000 calc(100% - var(--fade, 14%)), transparent 100%); mask-image: linear-gradient(180deg, #000 calc(100% - var(--fade, 14%)), transparent 100%); }
  .tt-art > * { position: absolute; display: block; }
  .tt-art img, .tt-art picture, .tt-art .tt-drawn { width: 100%; height: auto; }
  .tt-art picture { width: auto; }
  .tt-art .tt-drawn { left: 0; top: 0; height: 100%; }
  .tt-art.dim { opacity: 0.94; }

  /* the lit string, its tuner, and the marker on the nut */
  .tt-over { inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .tt-over .s-line, .tt-over .s-glow { fill: none; stroke-linecap: round; opacity: 0; transition: opacity 0.25s, stroke 0.25s; }
  .tt-over .s-line { stroke: #fff; stroke-width: 3.2; }
  .tt-over .s-glow { stroke: #ffffff; stroke-width: 12; filter: blur(5px); }
  .tt-over .s-peg { fill: #fff; opacity: 0; filter: blur(9px); transition: opacity 0.25s, fill 0.25s; }
  .tt-over .s-nut { opacity: 0; transition: opacity 0.2s; }
  .tt-over .s-nut circle { fill: #fff; stroke: #00000040; stroke-width: 2; transition: fill 0.25s; }
  .tt-over .s-nut text { font: 800 21px var(--font-sans); fill: #0b1020; text-anchor: middle; dominant-baseline: central; }
  .tt-over g.on .s-line, .tt-over g.on .s-nut { opacity: 1; }
  .tt-over g.on .s-glow { opacity: 0.5; }
  .tt-over g.on .s-peg { opacity: 0.55; }
  .tt-over g.near .s-line { stroke: #fbbf24; }
  .tt-over g.near .s-glow, .tt-over g.near .s-peg { stroke: #fbbf24; fill: #fbbf24; }
  .tt-over g.near .s-nut circle { fill: #fde68a; }
  .tt-over g.ok .s-line { stroke: #6ee7b7; }
  .tt-over g.ok .s-glow { stroke: #34d399; }
  .tt-over g.ok .s-peg { fill: #34d399; }
  .tt-over g.ok .s-nut circle { fill: #6ee7b7; }

  /* the round buttons, one for each string */
  .tt-strings { inset: 0; pointer-events: none; }
  .tt-str { position: absolute; display: grid; place-items: center; width: max(34px, calc(50 * var(--u))); height: max(34px, calc(50 * var(--u))); padding: 0; border: 2px solid transparent; border-radius: 50%; background: #1a2352; color: #e9ecff; font: 650 max(14px, calc(22 * var(--u))) / 1 var(--font-sans); cursor: pointer; pointer-events: auto; transform: translate(-50%, -50%); box-shadow: 0 6px 14px -6px #000a; transition: background-color 0.18s, color 0.18s, border-color 0.18s, transform 0.18s, box-shadow 0.18s; }
  .tt-str:hover { background: #26307a; transform: translate(-50%, -50%) scale(1.06); }
  .tt-str.sel { background: #fff; color: #0b1020; box-shadow: 0 0 0 4px #ffffff33, 0 8px 18px -6px #000a; }
  .tt-str.near { background: #fde68a; color: #422006; box-shadow: 0 0 0 4px #fbbf2444; }
  .tt-str.ok { background: #6ee7b7; color: #052e1d; box-shadow: 0 0 0 4px #34d39955; }
  .tt-str.tuned { border-color: #2dd4bf; }
  .tt-str.tuned::after { content: "✓"; position: absolute; right: -6px; top: -6px; display: grid; place-items: center; width: 17px; height: 17px; border-radius: 50%; background: #2dd4bf; font: 800 10.5px var(--font-sans); color: #04332c; box-shadow: 0 2px 6px #0007; }
  .tt-str.pop { animation: tt-pop 0.5s ease-out; }
  @keyframes tt-pop { 0% { transform: translate(-50%, -50%) scale(1); } 40% { transform: translate(-50%, -50%) scale(1.22); } 100% { transform: translate(-50%, -50%) scale(1); } }

  /* the start button, until the microphone is on */
  .tt-board.no-strings .tt-art, .tt-board.no-strings .tt-over, .tt-board.no-strings .tt-strings { display: none; }
  .tt-board.no-strings .tt-start { top: 78%; }
  .tt-start { left: 50%; top: 76%; width: max-content; max-width: 92%; white-space: nowrap; display: inline-flex; align-items: center; gap: 10px; min-height: 56px; padding: 0 28px; border: 0; border-radius: 999px; background: linear-gradient(180deg, #fbbf24, #f59e0b); font: 800 17px var(--font-sans); color: #1a0533; cursor: pointer; transform: translate(-50%, -50%); box-shadow: 0 16px 34px -10px #f59e0bcc, 0 0 0 8px #fbbf2426; transition: transform 0.15s, box-shadow 0.15s; animation: tt-breathe 2.4s ease-in-out infinite; }
  .tt-start:hover { transform: translate(-50%, -50%) scale(1.04); }
  .tt-start[hidden] { display: none; }
  @keyframes tt-breathe { 50% { box-shadow: 0 16px 34px -10px #f59e0bcc, 0 0 0 14px #fbbf2414; } }
  .tt.live .tt-start { display: none; }

  .tt-foot { margin-top: 6px; text-align: center; }
  .tt-level { height: 5px; max-width: 260px; margin: 6px auto 10px; overflow: hidden; border-radius: 5px; background: #ffffff1a; }
  .tt-level i { display: block; width: 0; height: 100%; border-radius: 5px; background: linear-gradient(90deg, #34d399, #fbbf24); transition: width 0.08s linear; }
  .tt-level i:not(.open) { opacity: 0.4; }
  .tt-privacy { margin: 10px 0 0; font: 500 12px var(--font-sans); color: #7d86c4; }
  .tt .tk-error { text-align: left; }

  /* the settings */
  .tt-settings-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .tt-settings-grid .tk-field { margin: 0; }

  @media (max-width: 980px) {
    .tt-main { grid-template-columns: minmax(0, 1fr); }
    .tt-panel { position: static; max-height: none; padding: 10px; }
    .tt-list { max-height: 0; overflow: hidden; padding: 0; transition: max-height 0.25s ease; }
    .tt-panel.open .tt-list { max-height: 460px; overflow-y: auto; padding: 4px 2px 4px; }
    .tt-settings-grid { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  }
  @media (min-width: 981px) { .tt-title svg { display: none; } .tt-title { cursor: default; } .tt-title:hover { background: transparent; } }
  @media (max-width: 560px) { .tt-start { min-height: 50px; padding: 0 22px; font-size: 16px; } .tt-stage { padding: 12px 8px 12px; border-radius: 22px; } .tt-bar { padding: 0 4px; } .tt-seg button { padding: 0 11px; } }
  @media (prefers-reduced-motion: reduce) { .tt-start, .tt-mic[aria-pressed="true"] svg, .tt-str.pop { animation: none; } .tt-bubble, .tt-str, .tt-over * { transition: none; } }
</style>

<script>
  import { INSTRUMENTS, analysisSize, detectPitch, matchString, pickFundamental, freqFromMidi, midiFromName, noteFromFreq, type Instrument } from "../../lib/tools/pitch";
  import { MicError, NoiseGate, SILENT_MIC_TEXT, SilenceWatch, audioContext, fillMicPicker, levelPercent, openMic, resumeAudio, rms, type Mic } from "../../lib/tools/audio";
  import { StringTracker } from "../../lib/tools/tracker";
  import { initGate } from "../../lib/tools/gate";
  import { AXIS_X, BOARD_W, GAUGE_Y, HEAD_TOP, buttonNote, instrumentTitle, layoutFor, tuningRows, type Layout } from "../../lib/tools/tunerLayout";
  import { toast } from "../../lib/toast";

  const gate = initGate("tuner", "tuner");
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const all = <T extends HTMLElement>(selector: string) => [...document.querySelectorAll<T>(selector)];
  const SVGNS = "http://www.w3.org/2000/svg";
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

  interface Prefs { instrument: string; tuning: number; a4: number; tol: number; sens: number; head: "acoustic" | "electric"; auto: boolean; sound: boolean }
  const KEY = "cs-tuner";
  let prefs: Prefs = { instrument: "guitar", tuning: 0, a4: 440, tol: 3, sens: 55, head: "acoustic", auto: true, sound: true };
  try { prefs = { ...prefs, ...JSON.parse(localStorage.getItem(KEY) || "{}") }; } catch { /* first visit */ }
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(prefs)); } catch { /* storage is off */ } };

  const instrument = (): Instrument => INSTRUMENTS.find((i) => i.id === prefs.instrument) ?? INSTRUMENTS[0];
  const tuning = () => instrument().tunings[prefs.tuning] ?? instrument().tunings[0];
  const strings = (): number[] => tuning().notes.map(midiFromName);

  const root = $("tt");
  const board = $("tt-board");
  let layout: Layout = layoutFor(instrument(), tuning(), prefs.head);
  let target: number | null = null; // a string chosen by hand (Auto off); null lets the tuner find the string
  let done: boolean[] = []; // strings that have held in tune
  let held: number[] = []; // readings in a row in tune, per string
  let off: number[] = []; // readings in a row out of tune, per string
  let announced = false;

  // ---- the board ------------------------------------------------------------------------------------------------------------
  interface Spot { button: HTMLButtonElement; group: SVGGElement; nutText: SVGTextElement; midi: number }
  let spots: Spot[] = [];
  const pctX = (x: number) => `${(x / BOARD_W) * 100}%`;
  const pctY = (y: number) => `${(y / layout.height) * 100}%`;

  function buildBoard() {
    layout = layoutFor(instrument(), tuning(), prefs.head);
    const list = strings();
    board.style.setProperty("--bh", String(layout.height));
    board.style.setProperty("--head", String(HEAD_TOP));
    board.style.setProperty("--gy", String(GAUGE_Y));
    board.style.setProperty("--fade", `${Math.round((150 / layout.height) * 100)}%`);
    board.dataset.kind = layout.kind;

    // the picture
    const art = $("tt-art");
    art.replaceChildren();
    if (layout.picture) {
      const p = layout.picture;
      const picture = document.createElement("picture");
      const source = document.createElement("source");
      source.type = "image/avif";
      source.srcset = p.avif;
      const img = document.createElement("img");
      img.src = p.webp;
      img.alt = "";
      img.width = p.w;
      img.height = p.h;
      img.decoding = "async";
      picture.style.cssText = `left:${pctX(p.x)};top:${pctY(p.y)};width:${(p.w / BOARD_W) * 100}%`;
      picture.append(source, img);
      art.append(picture);
    } else if (layout.drawn) {
      art.insertAdjacentHTML("beforeend", layout.drawn);
    }

    // the lit strings and the markers on the nut
    const over = $("tt-over");
    over.setAttribute("viewBox", `0 0 ${BOARD_W} ${layout.height}`);
    over.replaceChildren();
    const host = $("tt-strings");
    host.replaceChildren();
    spots = layout.strings.map((s, i) => {
      const midi = list[i];
      const { name } = buttonNote(midi);
      const g = document.createElementNS(SVGNS, "g");
      g.innerHTML =
        `<path class="s-glow" d="M${s.post.x} ${s.post.y} L${s.nut.x} ${s.nut.y}"/>` +
        `<path class="s-line" d="M${s.post.x} ${s.post.y} L${s.nut.x} ${s.nut.y}"/>` +
        `<circle class="s-peg" cx="${s.peg.x}" cy="${s.peg.y}" r="34"/>` +
        `<g class="s-nut"><circle cx="${s.nut.x}" cy="${s.nut.y}" r="19"/><text x="${s.nut.x}" y="${s.nut.y + 1}">${name}</text></g>`;
      over.append(g);
      const button = document.createElement("button");
      button.type = "button";
      button.className = "tt-str";
      button.style.left = pctX(s.button.x);
      button.style.top = pctY(s.button.y);
      button.textContent = name;
      button.dataset.i = String(i);
      const full = buttonNote(midi);
      button.setAttribute("aria-label", `String ${i + 1}, ${full.name}${full.octave}. Press to hear it${prefs.auto ? "" : " and tune this string"}.`);
      button.addEventListener("click", () => pickString(i));
      host.append(button);
      return { button, group: g as SVGGElement, nutText: g.querySelector("text") as SVGTextElement, midi };
    });
    done = spots.map(() => false);
    held = spots.map(() => 0);
    off = spots.map(() => 0);
    announced = false;
    sizeBoard();
    drawProgress();
    drawTargetHints();
  }

  function sizeBoard() {
    const w = board.clientWidth || 600;
    board.style.setProperty("--u", `${(w / BOARD_W).toFixed(4)}px`);
    board.style.setProperty("--zone", String(Math.max(16, prefs.tol * 2 * (250 / 50) * (w / BOARD_W))));
    const canvas = $<HTMLCanvasElement>("tt-trail");
    const ratio = window.devicePixelRatio || 1;
    const h = (HEAD_TOP / layout.height) * board.clientHeight;
    canvas.width = Math.round(w * ratio);
    canvas.height = Math.round(h * ratio);
  }
  new ResizeObserver(sizeBoard).observe(board);

  /** A string was pressed: it is heard, and in manual mode it becomes the one to tune. */
  function pickString(i: number) {
    const midi = spots[i].midi;
    if (!prefs.auto) {
      target = midi;
      syncTracker();
      drawTargetHints();
    }
    void playTone(freqFromMidi(midi, prefs.a4));
    const b = spots[i].button;
    b.classList.remove("pop");
    void b.offsetWidth;
    b.classList.add("pop");
    if (!mic) setHint(prefs.auto ? "Press Start, then play a string." : "Press Start, then play the string you chose.");
  }

  /** Marks the string chosen by hand (and the note under the bubble, which names it before any sound is heard). */
  function drawTargetHints() {
    paintStates();
  }

  // ---- the gauge: a bubble that slides along the line, a trail of where it has been ---------------------------------------------
  const tracker = new StringTracker({ strings: [], target: null, tol: 5 });
  const bubble = $("tt-bubble");
  const tag = $("tt-tag");
  const centsEl = $("tt-cents");
  const noteEl = $("tt-note");
  const hzEl = $("tt-hz");
  let shown = 0; // where the bubble is drawn, in cents
  let speed = 0;
  let signal = 0;
  let lastFrame = 0;
  let anim = 0;
  const trail: { c: number; t: number }[] = [];
  let lastTrail = 0;
  let tunedFor = 0; // readings in a row in tune: the bubble turns into a tick after a moment

  /** A critically damped spring: the bubble eases into a move and settles without overshooting or jittering. */
  function glide(current: number, goal: number, v: number, seconds: number, dt: number): [number, number] {
    const w = 2 / seconds;
    const x = w * dt;
    const e = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x);
    const change = current - goal;
    const temp = (v + w * change) * dt;
    return [goal + (change + temp) * e, (v - w * temp) * e];
  }

  const SPAN = 250; // board units from the line to either end of the gauge (for 50 cents)
  const centsAt = (c: number) => Math.max(-50, Math.min(50, c));
  const bubbleLeft = (c: number) => `${((AXIS_X + centsAt(c) * (SPAN / 50)) / BOARD_W) * 100}%`;

  const cache = new WeakMap<Element, string>();
  function put(el: Element, html: string) {
    if (cache.get(el) === html) return;
    cache.set(el, html);
    el.innerHTML = html;
  }
  const setHint = (text: string) => put($("tt-hint"), text);

  /** The note under the bubble: the string being tuned (heard, or chosen by hand) with its octave, or a dash. */
  function paintNote() {
    const lock = tracker.lock;
    let midi: number | null = null;
    if (lock >= 0) midi = tracker.goal();
    else if (!prefs.auto && target !== null) midi = target;
    if (midi === null || !Number.isFinite(midi)) {
      put(noteEl, "");
      noteEl.classList.remove("ok");
      return;
    }
    const n = noteFromFreq(freqFromMidi(midi, prefs.a4), prefs.a4);
    put(noteEl, `<b>${n.name.replace("#", "♯")}</b><sub>${n.octave}</sub>`);
    noteEl.classList.toggle("muted", lock < 0); // chosen by hand but not heard yet: dim
    noteEl.classList.toggle("ok", lock >= 0 && tracker.ok);
  }

  function paintStates() {
    const lock = tracker.lock;
    spots.forEach((s, i) => {
      const lit = i === lock;
      const manual = !prefs.auto && s.midi === target;
      s.group.classList.toggle("on", lit || manual);
      s.group.classList.toggle("ok", lit && tracker.ok);
      s.group.classList.toggle("near", lit && !tracker.ok);
      s.button.classList.toggle("sel", lit || manual);
      s.button.classList.toggle("ok", lit && tracker.ok);
      s.button.classList.toggle("near", lit && !tracker.ok);
    });
    root.classList.toggle("ok", lock >= 0 && tracker.ok);
    paintNote();
  }

  function drawReadout() {
    const lock = tracker.lock;
    if (lock < 0) {
      bubble.className = "tt-bubble idle";
      put(centsEl, "");
      put(tag, "");
      put(hzEl, "&nbsp;");
      tunedFor = 0;
      return;
    }
    const goal = tracker.goal()!;
    const c = tracker.cents;
    const abs = Math.abs(c);
    const tuned = tracker.ok && tunedFor >= 10;
    bubble.className = `tt-bubble ${tuned ? "done" : tracker.ok ? "ok" : abs <= Math.max(prefs.tol * 4, 15) ? "near" : "far"}`;
    put(centsEl, tuned ? "" : `${c > 0.5 ? "+" : c < -0.5 ? "−" : ""}${Math.round(abs)}`);
    put(tag, tracker.ok ? "" : c < 0 ? "Tune up" : "Tune down");
    put(hzEl, `${freqFromMidi(goal + c / 100, prefs.a4).toFixed(1)} Hz`);
    setHint(tracker.ok ? "In tune. Hold it there." : "&nbsp;");
  }

  // ---- the trail: a small mark for each reading falls away from the bubble, so a steady string draws a straight line -----------
  function drawTrail(t: number) {
    const canvas = $<HTMLCanvasElement>("tt-trail");
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    if (reduced || trail.length === 0) return;
    const ratio = canvas.width / (board.clientWidth || 1);
    const gy = (GAUGE_Y / HEAD_TOP) * canvas.height;
    const unit = canvas.width / BOARD_W;
    const life = 2200;
    for (let i = trail.length - 1; i >= 0; i--) {
      const age = t - trail[i].t;
      if (age > life) {
        trail.splice(0, i + 1);
        break;
      }
      const k = age / life;
      const x = (AXIS_X + centsAt(trail[i].c) * (SPAN / 50)) * unit;
      const y = gy + 34 * unit + k * (canvas.height - gy - 34 * unit);
      const abs = Math.abs(trail[i].c);
      ctx.strokeStyle = abs <= prefs.tol ? "#34d399" : abs <= Math.max(prefs.tol * 4, 15) ? "#fbbf24" : "#f87171";
      ctx.globalAlpha = (1 - k) * 0.85;
      ctx.lineWidth = Math.max(1.5, 2.4 * ratio * 0.5);
      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(x, y + 18 * unit * (1 - k * 0.6));
      ctx.stroke();
    }
    ctx.globalAlpha = 1;
  }

  let readoutAt = 0;
  function frame(t: number) {
    const dt = lastFrame ? Math.min(0.1, (t - lastFrame) / 1000) : 0.016;
    lastFrame = t;
    const lock = tracker.lock;
    const goal = lock >= 0 ? tracker.cents : 0;
    [shown, speed] = reduced ? [goal, 0] : glide(shown, goal, speed, lock >= 0 ? 0.3 : 0.5, dt);
    bubble.style.left = bubbleLeft(shown);
    if (lock >= 0 && signal > 0 && t - lastTrail > 38) {
      lastTrail = t;
      trail.push({ c: tracker.cents, t });
    }
    drawTrail(t);
    if (t - readoutAt > 70) {
      readoutAt = t;
      drawReadout();
    }
    anim = requestAnimationFrame(frame);
  }

  function syncTracker() {
    tracker.opts = { strings: strings(), target: prefs.auto ? null : target, tol: prefs.tol };
    tracker.release();
    paintStates();
  }
  const progressEl = $("tt-progress");
  function drawProgress() {
    const n = spots.length;
    const d = done.filter(Boolean).length;
    progressEl.hidden = n === 0 || (d === 0 && !mic);
    $("tt-progress-text").textContent = `${d} of ${n} tuned`;
    spots.forEach((s, i) => s.button.classList.toggle("tuned", done[i]));
  }
  $("tt-reset").addEventListener("click", () => {
    done = spots.map(() => false);
    held = spots.map(() => 0);
    off = spots.map(() => 0);
    announced = false;
    drawProgress();
  });

  // ---- the panel of tunings and instruments --------------------------------------------------------------------------------
  let panelView: "tunings" | "instruments" = "tunings";
  function drawPanel() {
    const inst = instrument();
    const list = $("tt-list");
    $("tt-title-text").textContent = panelView === "instruments" ? "Choose an instrument" : instrumentTitle(inst, tuning());
    $("tt-back").hidden = panelView === "instruments";
    list.replaceChildren();
    const row = (checked: boolean, name: string, notes: string, on: () => void) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "tt-row";
      b.setAttribute("role", "radio");
      b.setAttribute("aria-checked", String(checked));
      const label = document.createElement("span");
      label.textContent = name;
      const small = document.createElement("small");
      small.textContent = notes;
      b.append(label, small);
      b.addEventListener("click", on);
      return b;
    };
    const heading = (text: string) => Object.assign(document.createElement("div"), { className: "tt-group", textContent: text });
    if (panelView === "instruments") {
      list.append(heading("Instruments"));
      for (const i of INSTRUMENTS) {
        list.append(row(i.id === prefs.instrument, i.id === "chromatic" ? "Any note" : instrumentTitle(i, i.tunings[0]), i.tunings[0].notes.length ? `${i.tunings[0].notes.length} strings` : "chromatic", () => chooseInstrument(i.id)));
      }
      return;
    }
    const rows = tuningRows(inst);
    if (inst.id === "chromatic" || rows.every((r) => r.notes.length === 0)) {
      list.append(heading("Any note"), Object.assign(document.createElement("p"), { className: "tt-group", style: "text-transform:none;letter-spacing:0;font:500 13px var(--font-sans);line-height:1.5", textContent: "Play any note and the tuner names it and shows how far off it is." }));
      return;
    }
    let group = "";
    for (const r of rows) {
      if (r.group !== group) {
        group = r.group;
        if (rows.length > 1) list.append(heading(r.group));
      }
      list.append(row(r.index === prefs.tuning, r.name, r.notes.join(" "), () => chooseTuning(r.index)));
    }
  }
  function chooseInstrument(id: string) {
    prefs.instrument = id;
    prefs.tuning = 0;
    target = null;
    panelView = "tunings";
    save();
    after();
    if (mic) mic.analyser.fftSize = analysisSize(instrument().fmin);
  }
  function chooseTuning(index: number) {
    prefs.tuning = index;
    target = null;
    save();
    after();
    closePanelOnPhone();
  }
  /** Redraws everything that depends on the instrument or the tuning. */
  function after() {
    const inst = instrument();
    const hasStrings = tuning().notes.length > 0;
    $("tt-kind").hidden = !(inst.id === "guitar" && tuning().notes.length === 6);
    $("tt-auto-wrap").hidden = !hasStrings;
    if (!hasStrings) prefs.auto = true;
    ($("tt-auto") as HTMLInputElement).checked = prefs.auto;
    board.classList.toggle("no-strings", !hasStrings);
    buildBoard();
    drawPanel();
    syncTracker();
    placeholders();
    setHint(idleHint());
  }
  $("tt-back").addEventListener("click", () => {
    panelView = "instruments";
    drawPanel();
  });
  const panelEl = document.querySelector<HTMLElement>(".tt-panel")!;
  const titleBtn = $("tt-title");
  function closePanelOnPhone() {
    if (matchMedia("(max-width: 980px)").matches) {
      panelEl.classList.remove("open");
      titleBtn.setAttribute("aria-expanded", "false");
    }
  }
  titleBtn.addEventListener("click", () => {
    if (!matchMedia("(max-width: 980px)").matches) return;
    const open = panelEl.classList.toggle("open");
    titleBtn.setAttribute("aria-expanded", String(open));
  });

  // the guitar's picture: acoustic or electric
  all<HTMLButtonElement>("#tt-kind button").forEach((b) =>
    b.addEventListener("click", () => {
      prefs.head = (b.dataset.kind as "acoustic" | "electric") ?? "acoustic";
      save();
      drawKind();
      buildBoard();
      syncTracker();
    }),
  );
  const drawKind = () => all<HTMLButtonElement>("#tt-kind button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.kind === prefs.head)));

  // Auto finds the string by itself; switched off, the string is the one chosen by hand
  $<HTMLInputElement>("tt-auto").addEventListener("change", (e) => {
    prefs.auto = (e.target as HTMLInputElement).checked;
    if (prefs.auto) target = null;
    else target = tracker.lock >= 0 ? strings()[tracker.lock] : (target ?? strings()[0] ?? null);
    save();
    syncTracker();
    drawTargetHints();
    spots.forEach((s, i) => s.button.setAttribute("aria-label", `String ${i + 1}, ${buttonNote(s.midi).name}${buttonNote(s.midi).octave}. Press to hear it${prefs.auto ? "" : " and tune this string"}.`));
    setHint(idleHint());
  });

  // ---- the settings ----------------------------------------------------------------------------------------------------------
  const a4 = $<HTMLInputElement>("a4");
  const fill = (el: HTMLInputElement) => el.style.setProperty("--fill", `${((+el.value - +el.min) / (+el.max - +el.min)) * 100}%`);
  a4.value = String(prefs.a4);
  const drawA4 = () => { fill(a4); $("a4-out").textContent = `${prefs.a4} Hz`; };
  a4.addEventListener("input", () => { prefs.a4 = Number(a4.value); drawA4(); save(); paintNote(); });
  drawA4();

  const drawTol = () => all<HTMLButtonElement>("[data-tol]").forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.tol) === prefs.tol)));
  all<HTMLButtonElement>("[data-tol]").forEach((b) => b.addEventListener("click", () => { prefs.tol = Number(b.dataset.tol); tracker.opts.tol = prefs.tol; save(); drawTol(); sizeBoard(); }));
  drawTol();

  const sens = $<HTMLInputElement>("sens");
  sens.value = String(prefs.sens);
  $("mic-warn").textContent = SILENT_MIC_TEXT;
  const noiseGate = new NoiseGate(prefs.sens);
  const silence = new SilenceWatch();
  const drawSens = () => { fill(sens); $("sens-out").textContent = prefs.sens < 35 ? "Low" : prefs.sens < 70 ? "Medium" : "High"; };
  sens.addEventListener("input", () => { prefs.sens = Number(sens.value); noiseGate.sensitivity = prefs.sens; drawSens(); save(); });
  drawSens();

  const drawSound = () => all<HTMLButtonElement>("[data-sound]").forEach((b) => b.setAttribute("aria-pressed", String((b.dataset.sound === "on") === prefs.sound)));
  all<HTMLButtonElement>("[data-sound]").forEach((b) => b.addEventListener("click", () => { prefs.sound = b.dataset.sound === "on"; save(); drawSound(); if (prefs.sound) void chime(false); }));
  drawSound();

  // ---- the success chime: a short two-note ring when a string holds in tune, a longer rising run when every string is done -----
  let quietUntil = 0; // the microphone ignores the speakers for a moment so it does not hear the chime as a note
  async function chime(all: boolean) {
    if (!prefs.sound) return;
    try {
      const ctx = await resumeAudio();
      const notes = all ? [523.25, 659.25, 783.99, 1046.5] : [783.99, 1046.5];
      const gap = all ? 0.1 : 0.11;
      const master = ctx.createGain();
      master.gain.value = 0.2;
      master.connect(ctx.destination);
      const t0 = ctx.currentTime + 0.02;
      notes.forEach((f, i) => {
        const at = t0 + i * gap;
        const last = i === notes.length - 1;
        const len = last ? (all ? 1.1 : 0.7) : 0.35;
        [[1, 1], [2, 0.18], [3, 0.06]].forEach(([h, a]) => {
          const o = ctx.createOscillator();
          const g = ctx.createGain();
          o.type = "sine";
          o.frequency.value = f * h;
          g.gain.setValueAtTime(0.0001, at);
          g.gain.exponentialRampToValueAtTime(a, at + 0.012);
          g.gain.exponentialRampToValueAtTime(0.0001, at + len);
          o.connect(g);
          g.connect(master);
          o.start(at);
          o.stop(at + len + 0.05);
        });
      });
      quietUntil = performance.now() + (notes.length - 1) * gap * 1000 + (all ? 1500 : 1000);
    } catch { /* no audio: the tuner works without the chime */ }
  }

  // ---- a reference tone ------------------------------------------------------------------------------------------------------
  let tone: { stop(): void } | null = null;
  async function playTone(freq: number) {
    const ctx = await resumeAudio();
    tone?.stop();
    const out = ctx.createGain();
    const now = ctx.currentTime;
    out.gain.setValueAtTime(0.0001, now);
    out.gain.exponentialRampToValueAtTime(0.28, now + 0.05);
    out.gain.exponentialRampToValueAtTime(0.0001, now + 2.6);
    out.connect(ctx.destination);
    const oscs = [1, 2, 3].map((h) => {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = "sine";
      o.frequency.value = freq * h;
      g.gain.value = [1, 0.35, 0.12][h - 1];
      o.connect(g);
      g.connect(out);
      o.start(now);
      o.stop(now + 2.7);
      return o;
    });
    tone = { stop() { out.gain.cancelScheduledValues(ctx.currentTime); out.gain.setTargetAtTime(0.0001, ctx.currentTime, 0.03); oscs.forEach((o) => { try { o.stop(ctx.currentTime + 0.2); } catch { /* already stopped */ } }); } };
  }

  // ---- listening ---------------------------------------------------------------------------------------------------------------
  let mic: Mic | null = null;
  let timer = 0;
  let buf = new Float32Array(0);
  let lastHeard = 0;
  const CAPTURE = 12; // readings in tune in a row (about 0.6 s) before a string counts as tuned

  function placeholders() {
    drawReadout();
    paintNote();
  }
  function release() {
    tracker.release();
    tunedFor = 0;
    paintStates();
    placeholders();
  }

  /** A string is captured once it holds in tune, and let go again if it is played badly out of tune afterwards. */
  function capture() {
    const gi = tracker.lock;
    tunedFor = tracker.ok ? tunedFor + 1 : 0;
    if (tunedFor === 10) void chime(false); // together with the tick that appears on the bubble
    if (gi < 0 || !spots.length) return; // (any-note mode has no strings to tick off)
    held[gi] = tracker.ok ? held[gi] + 1 : 0;
    off[gi] = Math.abs(tracker.cents) > Math.max(15, prefs.tol * 3) ? off[gi] + 1 : 0;
    if (!done[gi] && held[gi] >= CAPTURE) {
      done[gi] = true;
      const b = spots[gi].button;
      b.classList.remove("pop");
      void b.offsetWidth;
      b.classList.add("pop");
      drawProgress();
      if (done.every(Boolean) && !announced) {
        announced = true;
        window.setTimeout(() => void chime(true), 450);
        setHint("All strings in tune!");
        toast({ icon: "🎸", title: "All strings in tune", text: "Nicely done. Time to play.", ms: 4000 });
      }
    } else if (done[gi] && off[gi] >= 20) {
      done[gi] = false;
      announced = false;
      drawProgress();
    }
  }

  /** What to say while nothing is being heard. */
  function idleHint(): string {
    const n = strings().length;
    if (!mic) return n ? (prefs.auto ? "Press Start, then play a string." : "Press Start, then play the string you chose.") : "Press Start, then play any note.";
    return n ? (prefs.auto ? "Start tuning by playing any string." : "Play the string you chose.") : "Play any note.";
  }

  function consider(m: number, clarity: number) {
    const lock = tracker.lock;
    const wasOk = tracker.ok;
    const goal = tracker.goal();
    tracker.push(m, clarity);
    if (tracker.lock !== lock || tracker.ok !== wasOk || tracker.goal() !== goal) {
      paintStates();
      if (tracker.ok && !wasOk && "vibrate" in navigator) navigator.vibrate?.(20);
    }
    capture();
  }

  function tick() {
    if (!mic) return;
    const inst = instrument();
    const sr = audioContext().sampleRate;
    if (buf.length !== mic.analyser.fftSize) buf = new Float32Array(mic.analyser.fftSize);
    mic.analyser.getFloatTimeDomainData(buf);
    const level = rms(buf);
    const now = performance.now();
    const open = noiseGate.update(level, now);
    if (now < quietUntil) {
      lastHeard = now; // the chime is playing: hear nothing, and do not let go of the string
      return;
    }
    $("tt-level").style.width = `${levelPercent(level)}%`;
    $("tt-level").classList.toggle("open", open);
    $("mic-warn").hidden = !silence.feed(level, now);
    signal = open ? level : 0;
    let pitch = open ? detectPitch(buf, sr, inst.fmin, inst.fmax) : null;
    if (pitch && pitch.clarity < 0.75) pitch = null;
    if (pitch) {
      lastHeard = now;
      // which string is sounding comes from the spectrum, so a string ringing in sympathy cannot take over
      const list = strings();
      let m = list.length ? matchString(buf, sr, list, prefs.a4, pitch.freq, prefs.auto ? null : target) : null;
      if (m === null) m = 69 + 12 * Math.log2(pickFundamental(buf, sr, pitch.freq, inst.fmin, inst.fmax) / prefs.a4);
      consider(m, pitch.clarity);
    } else if (tracker.lock >= 0 && now - lastHeard > 700) {
      release();
      setHint(announced ? "All strings in tune!" : idleHint());
    }
  }

  async function start() {
    if (!gate.allowed()) return;
    const error = $("error");
    error.hidden = true;
    try {
      mic = await openMic(analysisSize(instrument().fmin));
    } catch (err) {
      error.textContent = err instanceof MicError ? err.message : "The microphone could not be started.";
      error.hidden = false;
      return;
    }
    $("mic-warn").hidden = true;
    $("mic-name").textContent = mic.label ? `Microphone: ${mic.label}` : "";
    void fillMicPicker($<HTMLSelectElement>("mic-select"), mic.deviceId, () => { stop(); void start(); });
    root.classList.add("live");
    setHint(idleHint());
    $("tt-mic-text").textContent = "Stop";
    $("tt-mic").setAttribute("aria-pressed", "true");
    syncTracker();
    timer = window.setInterval(tick, 50);
    cancelAnimationFrame(anim);
    lastFrame = 0;
    anim = requestAnimationFrame(frame);
    drawProgress();
  }
  function stop() {
    window.clearInterval(timer);
    mic?.stop();
    mic = null;
    signal = 0;
    release();
    root.classList.remove("live");
    setHint(idleHint());
    $("tt-mic-text").textContent = "Start";
    $("tt-mic").setAttribute("aria-pressed", "false");
    $("tt-level").style.width = "0";
    $("mic-warn").hidden = true;
    drawProgress();
    // keep animating for a moment so the bubble glides back to the middle
    window.setTimeout(() => { if (!mic) cancelAnimationFrame(anim); }, 1500);
  }
  $("tt-start").addEventListener("click", () => void start());
  $("tt-mic").addEventListener("click", () => (mic ? stop() : void start()));
  window.addEventListener("pagehide", stop);

  // ---- go ------------------------------------------------------------------------------------------------------------------------
  drawKind();
  if (!INSTRUMENTS.some((i) => i.id === prefs.instrument)) prefs.instrument = "guitar";
  after();
  // draw once so the bubble and the note are in place before the microphone is on
  lastFrame = 0;
  requestAnimationFrame((t) => { frame(t); if (!mic) window.setTimeout(() => cancelAnimationFrame(anim), 400); });
</script>
