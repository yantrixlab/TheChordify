---
import ToolShell from "../../components/ToolShell.astro";
import { TOOLS } from "../../lib/tools/catalog";
---

<ToolShell
  title="Toolkit — Chord Suno"
  description="Free-to-try practice tools for guitar and more: a metronome, a tuner, chord practice drills and live chord detection."
  eyebrow="Toolkit"
  heading="Everything for your practice session"
  sub="A metronome, a tuner, chord drills and live chord detection, built into Chord Suno. They run on your device and work with your guitar, ukulele, piano and voice."
>
  <div class="tkh-grid">
    {TOOLS.map((t) => (
      <a class="tkh-card" href={t.href} data-feature={t.feature} style={`--c1:${t.cover[0]};--c2:${t.cover[1]}`}>
        <span class="tkh-cover">
          <svg class="tkh-wave" viewBox="0 0 400 240" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 122C58 86 128 72 206 100s152 30 194-8V240H0Z" fill="var(--c2)"></path>
          </svg>
          <span class="tkh-orb"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} /></span>
          <span class="tkh-crown" hidden aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M3 8.5 7.4 12 12 5l4.6 7L21 8.5 19 18H5z" fill="currentColor" /><path d="M5.6 20.5h12.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </span>
        </span>
        <span class="tkh-body">
          <h2>{t.name}</h2>
          <p>{t.blurb}</p>
          <span class="tkh-cta" data-cta>Open {t.name.toLowerCase().startsWith("practice") ? "the drills" : "it"} <span aria-hidden="true">→</span></span>
        </span>
      </a>
    ))}
  </div>

  <aside class="tkh-note">
    <strong>Your sound stays with you.</strong>
    The tuner, chord detection and practice drills listen through your microphone, and the sound is analysed on your device. It is never recorded, uploaded or stored.
  </aside>
</ToolShell>

<style is:global>
  .tkh-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
  .tkh-card { position: relative; display: flex; flex-direction: column; padding: 10px; text-decoration: none; color: var(--color-ink); background: #fff; border: 1px solid var(--color-hairline); border-radius: 22px; box-shadow: 0 1px 2px #1a053308, 0 14px 30px -20px #1a053333; transition: transform 0.22s cubic-bezier(0.3, 0.7, 0.2, 1), box-shadow 0.22s, border-color 0.22s; }
  .tkh-card:hover, .tkh-card:focus-visible { transform: translateY(-5px); border-color: var(--c1); box-shadow: 0 2px 4px #1a05330a, 0 26px 44px -22px color-mix(in srgb, var(--c2) 55%, transparent); }
  .tkh-card:focus-visible { outline: 3px solid color-mix(in srgb, var(--c2) 45%, transparent); outline-offset: 2px; }
  .tkh-cover { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 15px; background: var(--c1); isolation: isolate; }
  .tkh-wave { position: absolute; left: -6%; bottom: 0; width: 112%; height: 100%; z-index: 0; transition: transform 0.6s cubic-bezier(0.3, 0.7, 0.2, 1); }
  .tkh-card:hover .tkh-wave { transform: translateX(3%) scaleY(1.06); transform-origin: bottom; }
  .tkh-orb { position: absolute; z-index: 1; left: 50%; top: 50%; display: grid; place-items: center; width: 27%; aspect-ratio: 1; min-width: 56px; border-radius: 50%; background: #fff; color: var(--c2); box-shadow: 0 10px 22px -8px color-mix(in srgb, var(--c2) 70%, #000 0%), 0 0 0 7px #ffffff40; transform: translate(-50%, -50%); transition: transform 0.3s cubic-bezier(0.3, 0.9, 0.3, 1.3); }
  .tkh-card:hover .tkh-orb { transform: translate(-50%, -50%) scale(1.1) rotate(-4deg); }
  .tkh-orb svg { width: 46%; height: 46%; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .tkh-crown { position: absolute; z-index: 2; top: 0; right: 0; display: grid; place-items: center; width: 38px; height: 34px; border-radius: 0 0 0 14px; background: #fff; color: var(--c2); }
  .tkh-crown[hidden] { display: none; }
  .tkh-crown svg { width: 20px; height: 20px; }
  .tkh-body { display: flex; flex: 1; flex-direction: column; align-items: center; padding: 14px 8px 8px; text-align: center; }
  .tkh-card h2 { margin: 0 0 6px; font-size: 18px; font-weight: 800; letter-spacing: -0.025em; line-height: 1.2; }
  .tkh-card p { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin: 0 0 14px; font-size: 13.5px; line-height: 1.5; color: var(--color-body); }
  .tkh-cta { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 999px; background: color-mix(in srgb, var(--c1) 22%, #fff); font: 700 13px var(--font-sans); color: var(--color-ink); transition: background-color 0.2s, color 0.2s; }
  .tkh-card:hover .tkh-cta { background: var(--c2); color: #fff; }
  .tkh-card.is-locked .tkh-cover { filter: saturate(0.75); }
  .tkh-note { margin: 34px auto 0; max-width: 720px; padding: 16px 20px; text-align: center; font-size: 14.5px; line-height: 1.6; color: var(--color-body); background: #fff; border: 1px dashed var(--color-hairline-strong); border-radius: 18px; }
  .tkh-note strong { color: var(--color-ink); }
  @media (max-width: 1023px) { .tkh-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) {
    .tkh-grid { gap: 12px; }
    .tkh-card { padding: 7px; border-radius: 18px; }
    .tkh-cover { border-radius: 12px; }
    .tkh-card h2 { font-size: 15.5px; }
    .tkh-card p { display: none; }
    .tkh-body { padding: 10px 4px 6px; }
    .tkh-cta { padding: 6px 12px; font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .tkh-card, .tkh-wave, .tkh-orb, .tkh-cta { transition: none; } .tkh-card:hover { transform: none; } }
</style>

<script>
  import { can, loadPlan } from "../../lib/plan";
  import { track } from "../../lib/analytics";

  const cards = document.querySelectorAll<HTMLAnchorElement>(".tkh-card");
  const mark = () => {
    cards.forEach((card) => {
      const open = can(card.dataset.feature ?? "");
      card.classList.toggle("is-locked", !open);
      const cta = card.querySelector<HTMLElement>("[data-cta]");
      if (cta && !card.dataset.label) card.dataset.label = cta.innerHTML;
      if (cta) cta.innerHTML = open ? (card.dataset.label ?? "") : "Upgrade to unlock <span aria-hidden=\"true\">→</span>";
      const crown = card.querySelector<HTMLElement>(".tkh-crown");
      if (crown) crown.hidden = open; // a crown on the tools the plan does not include
    });
  };
  window.addEventListener("plan-change", mark);
  void loadPlan();
  track("toolkit_open");
</script>
