---
// The ukulele chord chart: a diagram for every chord a song uses, for all twelve notes, drawn when the site is built from the same shapes
// the player shows (lib/chordShapes.ts), so the page and the player never disagree. It answers the searches "uke chords" and "ukulele
// chord" with the shapes themselves.
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { chordNotes, getUkuleleShapes } from "../lib/chordShapes";
import { diagramSvg } from "../lib/tools/diagram";

const url = "https://chordsuno.com/ukulele-chord-chart/";
const title = "Ukulele Chord Chart: Every Uke Chord with Diagrams — Chord Suno";
const description = "A ukulele chord chart with a diagram for every major, minor, 7th, major 7th, minor 7th, suspended, diminished and augmented chord, for all twelve notes. Free.";

// the twelve notes as the site names them (sharps), with the other name each black key has
const NOTES: { name: string; label: string }[] = [
  { name: "C", label: "C" },
  { name: "C#", label: "C♯ / D♭" },
  { name: "D", label: "D" },
  { name: "D#", label: "D♯ / E♭" },
  { name: "E", label: "E" },
  { name: "F", label: "F" },
  { name: "F#", label: "F♯ / G♭" },
  { name: "G", label: "G" },
  { name: "G#", label: "G♯ / A♭" },
  { name: "A", label: "A" },
  { name: "A#", label: "A♯ / B♭" },
  { name: "B", label: "B" },
];

// the kinds of chord, in the order people learn them
const KINDS: { id: string; suffix: string; heading: string; text: string }[] = [
  { id: "major", suffix: "", heading: "Major chords", text: "The bright, plain chord: the root, the third and the fifth. Most songs are built on these." },
  { id: "minor", suffix: "m", heading: "Minor chords", text: "The same, with a lowered third: a sadder, softer sound. Written with a small “m”." },
  { id: "seventh", suffix: "7", heading: "Dominant 7th chords", text: "A major chord with a flat seventh added: bluesy, and it pulls toward the next chord." },
  { id: "major7", suffix: "maj7", heading: "Major 7th chords", text: "A major chord with the seventh a half step below the root: smooth and dreamy." },
  { id: "minor7", suffix: "m7", heading: "Minor 7th chords", text: "A minor chord with a flat seventh added: mellow, common in soul and jazz." },
  { id: "sus4", suffix: "sus4", heading: "Suspended 4th chords", text: "The third is replaced by the fourth: open and unsettled, and it usually settles back to the major chord." },
  { id: "dim", suffix: "dim", heading: "Diminished chords", text: "Two stacked minor thirds: tense, used to move between chords." },
  { id: "aug", suffix: "aug", heading: "Augmented chords", text: "A major chord with a raised fifth: dreamy and restless." },
];

const sections = KINDS.map((kind) => ({
  ...kind,
  chords: NOTES.map((note) => {
    const chord = `${note.name}${kind.suffix}`;
    const shape = getUkuleleShapes(chord)[0];
    return {
      chord,
      label: note.label.split(" / ").map((n) => `${n}${kind.suffix}`).join(" / "),
      notes: chordNotes(chord).map((n) => n.replace("#", "♯")).join(" "),
      svg: shape ? diagramSvg(shape) : "",
      frets: shape ? shape.frets.join(" ") : "",
    };
  }).filter((c) => c.svg),
}));

const faq = [
  { q: "What are the basic ukulele chords?", a: "C, Am, F and G cover a very large number of songs, followed by Dm, Em, D, A and the 7th chords C7, G7 and A7. They are the first shapes in the major, minor and 7th sections of this chart." },
  { q: "How do I read a ukulele chord diagram?", a: "The four vertical lines are the strings, left to right G, C, E, A in standard tuning. The horizontal lines are frets, with the thick line at the top being the nut. A dot is where a finger presses, the number on it is the finger (1 is the index finger), and a circle above a string means it is played open. A number on the left shows the fret the shape starts at when it is higher up the neck." },
  { q: "What tuning are these ukulele chords in?", a: "Standard ukulele tuning: G C E A, with the G string tuned above the C (re-entrant tuning). Soprano, concert and tenor ukuleles all use it. Baritone ukuleles are tuned D G B E and use the guitar shapes for the top four strings." },
  { q: "Are there other ways to play each chord?", a: "Yes. Every chord can be played in several places on the neck. This chart shows the usual shape for each one. In the player, choose Ukulele and every chord of a song is drawn with other ways to play it." },
  { q: "How can I find the ukulele chords of a song?", a: "Paste a YouTube link or search for the song on Chord Suno. Every chord is shown on the beat with its key and tempo, and the chord names are the same on a ukulele. Look the shapes up here, or choose Ukulele in the player to see them drawn." },
];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", name: title, description, url, isPartOf: { "@type": "WebSite", name: "Chord Suno", url: "https://chordsuno.com/" } },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Chord Suno", item: "https://chordsuno.com/" },
      { "@type": "ListItem", position: 2, name: "Ukulele chords", item: "https://chordsuno.com/ukulele-chords/" },
      { "@type": "ListItem", position: 3, name: "Ukulele chord chart", item: url },
    ],
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Nav />
  <main id="main-content" class="uc">
    <header class="uc-hero">
      <div class="uc-in">
        <p class="uc-eyebrow">Ukulele chord chart</p>
        <h1>Ukulele chord chart: every uke chord with a diagram</h1>
        <p class="uc-lead">
          A diagram for every major, minor, 7th, major 7th, minor 7th, suspended, diminished and augmented chord, for all twelve notes, in standard G C E A tuning.
          Looking for the chords of a particular song? <a href="/#find">Find them in about a minute</a>, then look up the shapes here, or see the
          <a href="/ukulele-chords/">ukulele chords for any song</a>.
        </p>
        <nav class="uc-jump" aria-label="Kinds of chord">
          {sections.map((s) => <a href={`#${s.id}`}>{s.heading.replace(" chords", "")}</a>)}
        </nav>
      </div>
    </header>

    <section class="uc-in uc-read" id="read">
      <h2>How to read a ukulele chord diagram</h2>
      <p>
        The four vertical lines are the strings, left to right <b>G, C, E, A</b>. The horizontal lines are the frets, and the thick line at the top is the nut.
        A dot shows where to press and its number is the finger (1 is the index finger); a circle above a string means play it open. When a shape sits higher up
        the neck, a number on the left says which fret it starts at.
      </p>
    </section>

    {
      sections.map((s) => (
        <section class="uc-in uc-kind" id={s.id}>
          <h2>{s.heading}</h2>
          <p class="uc-kind-text">{s.text}</p>
          <div class="uc-grid">
            {s.chords.map((c) => (
              <figure class="uc-card">
                <div class="uc-art" set:html={c.svg} />
                <figcaption>
                  <strong>{c.label}</strong>
                  <small>{c.notes}</small>
                  <span class="uc-frets" title="The fret on each string: G C E A (x is muted)">{c.frets}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))
    }

    <section class="uc-in uc-faq">
      <h2>Ukulele chord questions</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <section class="uc-in uc-cta">
      <h2>Play your favourite song on ukulele</h2>
      <p>Get its chords in about a minute, then choose Ukulele in the player to see every chord drawn, with other ways to play it.</p>
      <a class="uc-btn" href="/#find">Find chords for a song</a>
      <a class="uc-btn is-ghost" href="/ukulele-chords/">Ukulele chords for any song</a>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .uc { background: var(--color-canvas); color: var(--color-body); }
  .uc-in { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .uc-hero { padding: 64px 0 28px; background: linear-gradient(180deg, #f4efff, transparent); }
  .uc-eyebrow { margin: 0 0 10px; font: 700 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-violet-deep); }
  .uc h1 { margin: 0 0 14px; max-width: 760px; font-size: clamp(30px, 5vw, 46px); line-height: 1.08; letter-spacing: -0.03em; color: var(--color-ink); }
  .uc-lead { max-width: 720px; margin: 0 0 22px; font-size: 17px; line-height: 1.65; }
  .uc a { color: var(--color-violet-deep); }
  .uc-jump { display: flex; flex-wrap: wrap; gap: 8px; }
  .uc-jump a { padding: 7px 14px; border-radius: 999px; background: #fff; border: 1px solid var(--color-hairline); font-weight: 600; font-size: 14px; text-decoration: none; }
  .uc-jump a:hover { border-color: var(--color-violet); }
  .uc h2 { margin: 0 0 8px; font-size: 26px; letter-spacing: -0.02em; color: var(--color-ink); }
  .uc-read { padding-top: 24px; padding-bottom: 8px; }
  .uc-read p { max-width: 760px; margin: 0; line-height: 1.7; }
  .uc-kind { padding-top: 44px; scroll-margin-top: 80px; }
  .uc-kind-text { max-width: 700px; margin: 0 0 20px; line-height: 1.6; color: var(--color-mute); }
  .uc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(138px, 1fr)); gap: 14px; }
  .uc-card { margin: 0; padding: 12px 10px 14px; border-radius: 16px; background: #fff; border: 1px solid var(--color-hairline); box-shadow: 0 1px 2px #1a05330a; text-align: center; }
  .uc-art svg { display: block; width: 100%; max-width: 104px; height: auto; margin: 0 auto; font-family: var(--font-sans); }
  .uc-card figcaption { display: grid; gap: 2px; margin-top: 4px; }
  .uc-card strong { font-size: 17px; color: var(--color-ink); }
  .uc-card small { font-size: 12.5px; color: var(--color-mute); }
  .uc-frets { font: 600 11.5px var(--font-mono); letter-spacing: 0.08em; color: var(--color-violet-deep); }
  .uc-faq { padding-top: 56px; max-width: 860px; }
  .uc-faq details { padding: 14px 0; border-bottom: 1px solid var(--color-hairline); }
  .uc-faq summary { cursor: pointer; font-weight: 700; color: var(--color-ink); }
  .uc-faq p { margin: 10px 0 0; line-height: 1.7; }
  .uc-cta { padding-top: 56px; padding-bottom: 80px; }
  .uc-cta p { max-width: 640px; margin: 0 0 18px; line-height: 1.65; }
  .uc-btn { display: inline-block; margin: 0 10px 10px 0; padding: 12px 22px; border-radius: 999px; background: linear-gradient(135deg, #7c3aed, #5b21b6); color: #fff !important; font-weight: 700; text-decoration: none; }
  .uc-btn.is-ghost { background: var(--color-violet-soft); color: var(--color-violet-deep) !important; }
  @media (max-width: 560px) {
    .uc-in { padding: 0 16px; }
    .uc-hero { padding-top: 40px; }
    .uc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  }
</style>
