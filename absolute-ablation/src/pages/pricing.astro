---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const faqs = [
  ["Do I need to pay to start?", "No. Everybody starts on the Free plan the moment they sign in with Google, and you can use Chord Suno without an account too. Paid plans add more on top."],
  ["Can I cancel anytime?", "Yes. Cancel from this page whenever you like. You keep your plan until the end of the period you already paid for, then you are back on Free. Your library, favourites and XP stay."],
  ["How do I pay?", "Payments are handled by Razorpay, so you can use UPI, cards, net banking or wallets. Your card details go to Razorpay only; Chord Suno never sees or stores them."],
  ["Can I change plans?", "Yes. Cancel your current plan, and subscribe to the new one when it ends, or any time after. Pick monthly or yearly on each plan."],
  ["What can I do without paying?", "A lot. Everybody starts on the Free plan, with or without an account: you can find the chords of a song, open songs others have already chordified, and use the chord library and the lessons. The plan cards above show exactly what Free includes and what each paid plan adds."],
  ["Are the tuner, metronome and the other tools included?", "It depends on the plan. Each plan card lists the Toolkit tools it includes, and the Toolkit marks the tools your plan does not include with a lock."],
  ["Does Chord Suno show lyrics or ads?", "Chord Suno shows chords, key and tempo, and does not show lyrics. It does not show advertising."],
  ["How does Chord Suno compare with other chord finders?", "Read the honest comparison with Chordify at chordsuno.com/chord-suno-vs-chordify/: what each does better, and which suits you."],
  ["What does “Soon” mean next to a feature?", "It is on the way and included in the plan, but not built yet. You will get it as soon as it ships, with no extra charge."],
];

const jsonLd = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Chord Suno", item: "https://chordsuno.com/" },
    { "@type": "ListItem", position: 2, name: "Pricing", item: "https://chordsuno.com/pricing/" },
  ] },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
  },
];
---

<Layout title="Chord Suno Pricing: Free Plan and Paid Plans" description="Chord Suno plans: start free, then upgrade for more songs a day, more tools and more ways to play. See what each plan includes. Cancel anytime." jsonLd={jsonLd} themeable>
  <Nav />
  <main id="main-content" class="pg">
    <div class="pg-wrap">
      <header class="pg-head">
        <p class="pg-eyebrow">Pricing</p>
        <h1>Pick the plan that plays like you do</h1>
        <p class="pg-sub">Start free, and move up when you want more songs, more tools and more ways to practise. Cancel anytime.</p>
      </header>

      <div id="plans" aria-live="polite" aria-busy="true">
        <div class="pg-ghosts" aria-hidden="true"><div></div><div></div><div></div></div>
      </div>

      <p class="pg-legal">
        Payments are processed securely by Razorpay. By subscribing you agree to our <a href="/terms/">Terms of Service</a> and the <a href="/refunds/">Refund &amp; Cancellation Policy</a>. Questions? <a href="/contact/">Contact us</a>.
      </p>

      <section class="pr-guide" aria-labelledby="guide-title">
        <h2 id="guide-title">How the plans work</h2>
        <p>Everybody starts on Free, with or without an account. Sign in with Google to keep your library, favourites and XP. A paid plan adds more on top, and you can cancel it whenever you like.</p>
        <div class="pr-guide-grid">
          <div>
            <h3>Songs and chords</h3>
            <p>How many new songs you can have chordified each day, full chord detail (sevenths, suspended and slash chords), other ways to play each chord, transpose and capo, and uploading your own audio. A song somebody else has already chordified is quick to open.</p>
          </div>
          <div>
            <h3>Playing</h3>
            <p>Slow a song down and loop a section while you practise. Chord Suno does not show advertising on any plan.</p>
          </div>
          <div>
            <h3>The Toolkit</h3>
            <p>The <a href="/toolkit/tuner/">tuner</a>, the <a href="/toolkit/metronome/">metronome</a>, <a href="/toolkit/practice/">chord practice drills</a> and <a href="/toolkit/chord-detector/">live chord detection</a>, which names the chord you play.</p>
          </div>
          <div>
            <h3>Export</h3>
            <p>Download a song's chords as a printable PDF chord sheet, or as MIDI.</p>
          </div>
        </div>
        <p>Not sure yet? <a href="/#find">Find the chords of a song</a> on the Free plan first, read <a href="/about/">about Chord Suno</a>, or see <a href="/chord-suno-vs-chordify/">how it compares with Chordify</a>.</p>
      </section>

      <section class="pr-faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Questions, answered</h2>
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  .pr-guide { max-width: 900px; margin: 80px auto 0; font-size: 16px; line-height: 1.7; color: var(--color-body); }
  .pr-guide h2 { margin: 0 0 12px; text-align: center; font-size: clamp(24px, 3.4vw, 34px); font-weight: 800; letter-spacing: -0.035em; color: var(--color-ink); }
  .pr-guide > p { margin: 0 auto 22px; max-width: 700px; text-align: center; }
  .pr-guide a { color: var(--color-violet-deep); font-weight: 600; }
  .pr-guide-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin: 0 0 24px; }
  .pr-guide-grid > div { padding: 18px 20px; border-radius: 16px; background: #fff; border: 1px solid var(--color-hairline); }
  .pr-guide-grid h3 { margin: 0 0 6px; font-size: 16.5px; font-weight: 800; color: var(--color-ink); }
  .pr-guide-grid p { margin: 0; font-size: 14.5px; line-height: 1.65; }
  html[data-theme="dark"] .pr-guide-grid > div { background: #131116; }
  .pg { padding: 56px 20px 100px; background: radial-gradient(ellipse 70% 38% at 50% -4%, #7c3aed26, transparent 70%), radial-gradient(ellipse 50% 30% at 90% 20%, #f59e0b1c, transparent 70%), linear-gradient(180deg, #fbf7ff, #fff 60%); }
  .pg-wrap { max-width: 1160px; margin: 0 auto; }
  .pg-head { max-width: 680px; margin: 0 auto 36px; text-align: center; }
  .pg-eyebrow { margin: 0 0 12px; font: 700 12px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-violet); }
  .pg-head h1 { margin: 0 0 14px; font-size: clamp(32px, 5.4vw, 54px); font-weight: 800; letter-spacing: -0.045em; line-height: 1.05; color: var(--color-ink); }
  .pg-legal { max-width: 640px; margin: 36px auto 0; text-align: center; font-size: 13.5px; line-height: 1.6; color: var(--color-mute); }
  .pg-legal a { color: var(--color-violet-deep); font-weight: 600; }
  .pg-sub { margin: 0; font-size: 17px; line-height: 1.6; color: var(--color-body); }
  .pg-ghosts { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 20px; max-width: 1000px; margin: 0 auto; }
  .pg-ghosts div { height: 520px; border-radius: 26px; background: linear-gradient(100deg, #f3eeff 30%, #fbf9ff 50%, #f3eeff 70%); background-size: 200% 100%; animation: pg-shimmer 1.4s linear infinite; }
  @keyframes pg-shimmer { to { background-position: -200% 0; } }
  html[data-theme="dark"] .pg { background: radial-gradient(ellipse 70% 38% at 50% -4%, #7c3aed38, transparent 70%), radial-gradient(ellipse 50% 30% at 90% 20%, #f59e0b14, transparent 70%), linear-gradient(180deg, #0f0d12, #0d0c10 60%); }
  html[data-theme="dark"] .pg-eyebrow { color: #a78bfa; }
  html[data-theme="dark"] .pg-ghosts div { background: linear-gradient(100deg, #18161d 30%, #201d25 50%, #18161d 70%); background-size: 200% 100%; }
  @media (prefers-reduced-motion: reduce) { .pg-ghosts div { animation: none; } }
  @media (max-width: 640px) { .pg { padding: 36px 14px 72px; } }
</style>

<script>
  import { fetchPricing, renderPricing } from "../lib/pricingUi";

  const root = document.getElementById("plans")!;
  fetchPricing().then((data) => {
    root.setAttribute("aria-busy", "false");
    if (!data) {
      root.replaceChildren(Object.assign(document.createElement("p"), { className: "pr-empty", textContent: "We could not load the plans right now. Please refresh in a moment." }));
      return;
    }
    renderPricing(root, data);
    if (location.hash === "#compare") document.getElementById("compare")?.scrollIntoView();
  });
</script>
