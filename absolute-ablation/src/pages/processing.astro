---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Listening… — Chord Suno" noindex>
  <Nav />
  <main id="main-content" class="gradient-hero" style="min-height:100vh;padding:140px var(--space-lg);">
    <div class="max-w-2xl mx-auto" style="text-align:center;">
      <div
        class="rounded-2xl shadow-float mx-auto"
        style="background:var(--color-canvas);padding:48px 32px;border:1px solid var(--color-hairline);max-width:480px;"
      >
        <div
          class="rounded-full mx-auto mb-6"
          style="width:56px;height:56px;border:4px solid var(--color-hairline);border-top-color:var(--color-violet);animation: spin 0.9s linear infinite;"
        ></div>

        <h1 class="display-md" style="color:var(--color-ink);margin-bottom:8px;">
          Listening<span id="dots">…</span>
        </h1>
        <p id="stage-label" style="font-size:14px;color:var(--color-mute);margin-bottom:24px;">
          Getting started
        </p>

        <div class="rounded-full" style="height:8px;background:var(--color-canvas-soft-2);overflow:hidden;">
          <div
            id="progress-bar"
            class="rounded-full"
            style="height:100%;width:0%;background:linear-gradient(90deg, var(--color-violet), var(--color-accent));transition:width 0.3s ease;"
          ></div>
        </div>
        <p id="progress-pct" style="font-family:var(--font-mono);font-size:13px;color:var(--color-violet-deep);margin-top:10px;font-weight:600;">
          0%
        </p>
      </div>

      <div id="error-box" class="hidden mt-6">
        <p style="color:var(--color-error);font-size:15px;margin-bottom:12px;" id="error-text"></p>
        <a href="/" style="color:var(--color-violet);text-decoration:underline;font-size:14px;">Back to home</a>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { getJobStatus, getApiErrorMessage, ApiError } from "../lib/api";

  const params = new URLSearchParams(window.location.search);
  const sessionId = params.get("session");

  const progressBar = document.getElementById("progress-bar")!;
  const progressPct = document.getElementById("progress-pct")!;
  const stageLabel = document.getElementById("stage-label")!;
  const errorBox = document.getElementById("error-box")!;
  const errorText = document.getElementById("error-text")!;
  const card = document.querySelector("main .rounded-2xl") as HTMLElement;

  function setProgress(pct: number, stage: string) {
    progressBar.style.width = `${pct}%`;
    progressPct.textContent = `${pct}%`;
    stageLabel.textContent = stage;
  }

  function fail(message: string) {
    card.style.display = "none";
    errorBox.classList.remove("hidden");
    errorText.textContent = message;
  }

  // A restart of the server (a deploy, or the machine running out of memory) answers 502/503/504 or not at all for a
  // little while. Keep trying for a couple of minutes instead of giving up on the first failure.
  const RECONNECT_FOR_MS = 2 * 60 * 1000;
  let offlineSince = 0;

  async function poll() {
    if (!sessionId) {
      fail("No song was submitted. Go back and paste a link or upload a song.");
      return;
    }

    try {
      const job = await getJobStatus(sessionId);
      offlineSince = 0;

      if (job.status === "error") {
        fail(job.error || "Something went wrong while listening to this song.");
        return;
      }

      const stageText =
        job.status === "downloading"
          ? "Fetching audio"
          : job.stage || (job.status === "queued" ? "Queued" : "Working on it");

      setProgress(job.progress ?? 0, stageText);

      if (job.status === "done") {
        setProgress(100, "Done");
        window.location.href = `/play?session=${sessionId}`;
        return;
      }

      setTimeout(poll, 900);
    } catch (err) {
      const status = err instanceof ApiError ? err.status : 0;
      if (status === 404) {
        // the server came back without the job: its progress lives in memory, so a restart loses it
        fail("The server restarted while your song was being analysed. Please start it again.");
        return;
      }
      const transient = status === 0 || status === 502 || status === 503 || status === 504;
      offlineSince ||= Date.now();
      if (transient && Date.now() - offlineSince < RECONNECT_FOR_MS) {
        stageLabel.textContent = "Reconnecting to the server…";
        setTimeout(poll, 3000);
        return;
      }
      fail(getApiErrorMessage(err, "Lost connection while listening to your song."));
    }
  }

  poll();
</script>
