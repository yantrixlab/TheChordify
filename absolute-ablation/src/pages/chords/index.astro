---
// /chords/: every chord chart, the reference of all the kinds of chord, and the lessons.
import ChordShell from "../../components/chords/ChordShell.astro";
import ChHero from "../../components/chords/ChHero.astro";
import NoteKeys from "../../components/chords/NoteKeys.astro";
import { GROUPS, INSTRUMENTS, KINDS, kindsOf, spellOnC } from "../../lib/chordCatalog";
import { voicingsFor } from "../../lib/chordCharts";
import { INSTRUMENT_ICONS } from "../../lib/instrumentIcons";
import { LESSONS } from "../../lib/lessons";

const title = "Chord Charts for Guitar, Piano, Ukulele and Mandolin — Chord Suno";
const description = "Every chord on guitar, piano, ukulele and mandolin: a chord chart with diagrams for all twelve notes, a page for each note, and short lessons to learn them.";
const jsonLd = [
  { "@context": "https://schema.org", "@type": "CollectionPage", name: title, description, url: "https://chordsuno.com/chords/" },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Chord Suno", item: "https://chordsuno.com/" },
      { "@type": "ListItem", position: 2, name: "Chord charts", item: "https://chordsuno.com/chords/" },
    ],
  },
];
const describe: Record<string, string> = {
  guitar: "Six strings, E A D G B E. Open chords, barre chords and every other shape, up to three ways to play each.",
  piano: "Keyboard diagrams with the keys named, in root position and every inversion.",
  ukulele: "Four strings, G C E A. Easy open shapes and others further up the neck.",
  mandolin: "Four pairs of strings, G D A E, tuned in fifths like a violin.",
};
const art = INSTRUMENTS.map((i) => ({ svg: voicingsFor(i.key, "C", 1)[0]?.svg ?? "", label: i.name, sub: "C major", keys: i.key === "piano" })).filter((a) => a.svg);
---

<ChordShell title={title} description={description} jsonLd={jsonLd}>
  <ChHero
    eyebrow="Chord charts"
    title="Every chord,"
    accent="on every instrument"
    lead={`${KINDS.length} kinds of chord on twelve notes make ${KINDS.length * 12} chords, and every one has a diagram on guitar, piano, ukulele and mandolin. Pick an instrument for its chart, then a note for all of its chords.`}
    art={art}
    stats={[{ n: 336, label: "chords" }, { n: 4, label: "instruments" }, { n: 8, label: "lessons" }]}
  >
    <a class="ch-btn" href="/#find">Find chords for a song <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
    <a class="ch-btn is-ghost" href="/learn/">Learn chords</a>
  </ChHero>

  <section class="ch-in ch-sec">
    <span class="ch-kicker" data-reveal>Choose</span>
    <h2 data-reveal style="--i: 1">An instrument</h2>
    <p data-reveal style="--i: 2">Each chart shows the chords most songs use on all twelve notes, with a grid that links every chord to its diagram.</p>
    <div class="ch-links">
      {
        INSTRUMENTS.map((i, n) => (
          <a class="ch-link" href={i.chartPath} data-reveal style={`--i: ${n}`}>
            <span class="ch-ico"><svg viewBox="0 0 24 24" set:html={INSTRUMENT_ICONS[i.key]} /></span>
            <strong>{i.name} chord chart</strong>
            <span>{describe[i.key]}</span>
            <em class="ch-go" style="font-style: normal">Open the chart</em>
          </a>
        ))
      }
    </div>
  </section>

  <section class="ch-in ch-sec">
    <span class="ch-kicker" data-reveal>Jump straight in</span>
    <h2 data-reveal style="--i: 1">Find a note</h2>
    <p data-reveal style="--i: 2">Press a key for every chord that starts on that note.</p>
    <div class="nk-grid">
      {INSTRUMENTS.map((i, n) => <div data-reveal style={`--i: ${n}`}><h3 style="margin: 0 0 10px">{i.name}</h3><NoteKeys instrument={i.key} /></div>)}
    </div>
  </section>

  <section class="ch-in ch-sec" id="kinds">
    <span class="ch-kicker" data-reveal>The reference</span>
    <h2 data-reveal style="--i: 1">Every kind of chord</h2>
    <p data-reveal style="--i: 2">The formula says which notes of the major scale make the chord. The example is built on C; the same kind works on every note.</p>
    {
      GROUPS.map((g) => (
        <div class="ch-grid-block" data-g={g.id} data-reveal>
          <div class="ch-gh"><h3>{g.title}</h3></div>
          <p class="ch-muted" style="margin: 0 0 12px; font-size: 14.5px">{g.text}</p>
          <div class="cg-wrap">
            <table class="cg">
              <thead><tr><th scope="col">Chord</th><th scope="col">Symbol</th><th scope="col">Formula</th><th scope="col">Notes on C</th><th scope="col" style="text-align:left">Sound</th></tr></thead>
              <tbody>
                {kindsOf(g.id).map((k) => (
                  <tr>
                    <th scope="row">{k.name.replace(/^./, (x) => x.toUpperCase())}</th>
                    <td style="font-weight: 800; color: var(--g)">C{k.suffix.replace("b", "♭").replace("#", "♯")}</td>
                    <td style="font-family: var(--font-mono); font-size: 13px">{k.formula}</td>
                    <td>{spellOnC(k.formula)}</td>
                    <td style="text-align:left; white-space: normal; min-width: 280px">{k.text}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }
  </section>

  <section class="ch-in ch-sec">
    <span class="ch-kicker" data-reveal>Keep learning</span>
    <h2 data-reveal style="--i: 1">Lessons</h2>
    <div class="ch-links">
      {
        LESSONS.map((l, i) => (
          <a class="ch-link" href={`/learn/${l.slug}/`} data-reveal style={`--i: ${i}`}>
            <span class="ch-num">{String(i + 1).padStart(2, "0")}</span>
            <strong>{l.title}</strong>
            <span>{l.summary}</span>
            <em class="ch-go" style="font-style: normal">Read the lesson</em>
          </a>
        ))
      }
    </div>
  </section>

  <div class="ch-in ch-cta-wrap">
    <div class="ch-cta-in" data-reveal>
      <h2>Play along with a song</h2>
      <p>Search for a song on Chord Suno and see every chord on the beat, drawn for the instrument you choose.</p>
      <a class="ch-btn" href="/#find">Find chords for a song</a>
    </div>
  </div>
</ChordShell>
