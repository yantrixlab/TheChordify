---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="My library — Chord Suno" description="Your played songs, favourites, level and badges on Chord Suno." noindex>
  <Nav />
  <main id="main-content" class="lb">
    <div class="lb-wrap">
      <section id="gate" class="lb-gate" hidden>
        <div class="lb-gate-mark" aria-hidden="true">🎸</div>
        <h1>Your library, level and badges</h1>
        <p>Sign in with Google to keep every song you play, favourite the ones you love, and earn XP, levels and badges as you play.</p>
        <button id="gate-signin" type="button" class="lb-btn">Continue with Google</button>
      </section>

      <div id="app" hidden>
        <section class="lb-hero" aria-label="Your progress">
          <div class="lb-who">
            <span id="avatar" class="lb-avatar"></span>
            <div class="lb-names">
              <h1 id="name">Your library</h1>
              <p id="level-line" class="lb-level"></p>
            </div>
          </div>
          <div class="lb-xp">
            <div class="lb-xp-top"><span id="xp-label"></span><span id="xp-next"></span></div>
            <div class="lb-bar" role="progressbar" aria-label="Progress to the next level" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><i id="xp-fill"></i></div>
            <p id="next-reward" class="lb-next"></p>
          </div>
          <ul class="lb-stats" id="stats"></ul>
        </section>

        <div class="lb-tabs" role="tablist" aria-label="Library sections">
          <button role="tab" id="tab-history" aria-selected="true" data-tab="history" type="button">History <span id="n-history"></span></button>
          <button role="tab" id="tab-favorites" aria-selected="false" data-tab="favorites" type="button">Favourites <span id="n-favorites"></span></button>
          <button role="tab" id="tab-badges" aria-selected="false" data-tab="badges" type="button">Badges <span id="n-badges"></span></button>
          <button role="tab" id="tab-rewards" aria-selected="false" data-tab="rewards" type="button">Rewards</button>
        </div>
        <p id="note" class="lb-note" role="status" hidden></p>
        <div id="panel" role="tabpanel" aria-live="polite"></div>
        <div class="lb-more"><button id="more" type="button" class="lb-btn ghost" hidden>Show more</button></div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  .lb { min-height: calc(100vh - 64px); padding: 40px 20px 80px; background: radial-gradient(ellipse 80% 40% at 50% -6%, #7c3aed22, transparent 70%), linear-gradient(180deg, #fbf7ff, #fff 60%); }
  .lb-wrap { max-width: 1100px; margin: 0 auto; }
  .lb [hidden] { display: none !important; }
  .lb-btn { height: 44px; padding: 0 22px; border: 0; border-radius: 14px; cursor: pointer; color: #fff; font: 700 15px var(--font-sans); background: linear-gradient(135deg, #7c3aed, #5b21b6); box-shadow: 0 10px 20px -10px #5b21b6cc; }
  .lb-btn.ghost { color: var(--color-violet-deep); background: var(--color-violet-soft); box-shadow: none; }
  .lb-btn:focus-visible, .lb-tabs button:focus-visible, .lb-card:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 3px; }

  .lb-gate { max-width: 460px; margin: 8vh auto 0; padding: 40px 28px; border-radius: 26px; background: #fff; border: 1px solid var(--color-hairline); box-shadow: 0 30px 60px -34px #5b21b690; text-align: center; }
  .lb-gate-mark { display: grid; place-items: center; width: 64px; height: 64px; margin: 0 auto 16px; border-radius: 20px; background: var(--color-violet-soft); font-size: 30px; }
  .lb-gate h1 { margin: 0 0 8px; font-size: 24px; font-weight: 800; letter-spacing: -0.03em; color: var(--color-ink); }
  .lb-gate p { margin: 0 auto 22px; max-width: 340px; font-size: 15px; line-height: 1.6; color: var(--color-body); }

  /* the progress card */
  .lb-hero { display: grid; grid-template-columns: auto minmax(220px, 1fr) auto; gap: 22px 32px; align-items: center; padding: 26px 28px; border-radius: 26px; color: #fff;
    background: radial-gradient(circle at 12% 0%, #7c3aed88, transparent 55%), radial-gradient(circle at 100% 100%, #f59e0b44, transparent 50%), linear-gradient(135deg, #2a0a52, #12032a); box-shadow: 0 30px 60px -30px #1a0533cc; }
  .lb-who { display: flex; align-items: center; gap: 16px; min-width: 0; }
  .lb-avatar { flex: none; --lr-track: #ffffff26; filter: drop-shadow(0 8px 18px #0006); }
  .lb-avatar .lr-lv { box-shadow: 0 0 0 3px #1a0533, 0 4px 10px -2px #0008; }
  .lb-names { min-width: 0; }
  .lb-names h1 { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24px; font-weight: 800; letter-spacing: -0.03em; }
  .lb-level { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; margin: 6px 0 0; font-size: 15px; font-weight: 700; color: #e9defc; }
  .lb-lv { font: 800 22px/1 var(--font-mono); letter-spacing: 0.05em; color: #fcd34d; text-shadow: 0 0 18px #f59e0b99; }
  .lb-xp { min-width: 0; }
  .lb-xp-top { display: flex; justify-content: space-between; gap: 12px; font: 600 13px var(--font-sans); color: #d8c8f5; }
  .lb-xp-top span:first-child { color: #fff; font-weight: 700; }
  .lb-bar { position: relative; height: 16px; margin: 8px 0 0; border-radius: 999px; background: #ffffff22; overflow: hidden; }
  .lb-bar::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 calc(10% - 3px), #1a0533 calc(10% - 3px) 10%); } /* ten steps, like a game */
  .lb-bar i { display: block; width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #a78bfa, #ec4899, #f59e0b); box-shadow: 0 0 14px #f59e0b88; transition: width 1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.2s; }
  .lb-next { margin: 10px 0 0; font-size: 13px; color: #b9a6e0; }
  .lb-stats { display: flex; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .lb-stats li { min-width: 78px; padding: 10px 12px; border-radius: 16px; background: #ffffff14; text-align: center; }
  .lb-stats strong { display: block; font-size: 22px; font-weight: 800; font-variant-numeric: tabular-nums; }
  .lb-stats span { font: 600 11px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: #b9a6e0; }

  .lb-tabs { display: flex; gap: 6px; margin: 26px 0 18px; padding: 5px; border-radius: 16px; background: #fff; border: 1px solid var(--color-hairline); overflow-x: auto; scrollbar-width: none; }
  .lb-tabs button { flex: 1 0 auto; height: 40px; padding: 0 16px; border: 0; border-radius: 12px; background: none; cursor: pointer; white-space: nowrap; font: 700 14px var(--font-sans); color: var(--color-body); }
  .lb-tabs button span { margin-left: 4px; padding: 1px 7px; border-radius: 999px; background: #f3eeff; font: 700 11.5px var(--font-mono); color: var(--color-violet-deep); }
  .lb-tabs button:empty { display: none; }
  .lb-tabs button[aria-selected="true"] { color: #fff; background: linear-gradient(135deg, #7c3aed, #5b21b6); }
  .lb-tabs button[aria-selected="true"] span { background: #ffffff33; color: #fff; }
  .lb-note { margin: 0 0 14px; padding: 10px 14px; border-radius: 12px; background: #fef2f2; color: var(--color-error); font-size: 14px; }

  /* songs */
  .lb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(236px, 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .lb-item { position: relative; }
  .lb-card { all: unset; box-sizing: border-box; display: flex; flex-direction: column; width: 100%; height: 100%; padding: 10px; border-radius: 18px; background: #fff; border: 1px solid var(--color-hairline); box-shadow: 0 1px 2px #1a05330a; cursor: pointer; transition: border-color 0.18s, box-shadow 0.18s, transform 0.18s; }
  .lb-card:hover { border-color: #cdbbee; box-shadow: 0 18px 32px -20px #5b21b6a0; transform: translateY(-2px); }
  .lb-card[aria-busy="true"] { cursor: progress; opacity: 0.75; }
  .lb-art { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 12px; background: linear-gradient(135deg, #ede9fe, #fde68a); }
  .lb-art img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .lb-art .time { position: absolute; right: 8px; bottom: 8px; padding: 2px 7px; border-radius: 6px; background: #0d0019cc; color: #fff; font: 600 11px/1.5 var(--font-mono); }
  .lb-art .plays { position: absolute; left: 8px; top: 8px; padding: 3px 9px; border-radius: 999px; background: #fff; color: var(--color-violet-deep); font: 700 11.5px/1.5 var(--font-sans); box-shadow: 0 4px 10px -4px #1a053366; }
  .lb-body { display: flex; flex: 1; flex-direction: column; padding: 11px 4px 4px; }
  .lb-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin: 0; min-height: 2.7em; font-size: 14.5px; font-weight: 700; line-height: 1.35; color: var(--color-ink); }
  .lb-by { margin: 3px 0 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 13px; color: var(--color-body); }
  .lb-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 10px; min-height: 30px; }
  .lb-chords { display: flex; gap: 4px; }
  .lb-chords span { padding: 2px 7px; border-radius: 6px; background: #f3eeff; color: var(--color-ink); font: 700 11.5px/1.4 var(--font-mono); }
  .lb-when { font-size: 12px; color: var(--color-mute); white-space: nowrap; }
  .lb-empty { padding: 56px 20px; text-align: center; border-radius: 22px; background: #fff; border: 1px dashed #d9cdf0; }
  .lb-empty h2 { margin: 0 0 6px; font-size: 19px; font-weight: 800; color: var(--color-ink); }
  .lb-empty p { margin: 0 auto 18px; max-width: 360px; font-size: 14.5px; line-height: 1.6; color: var(--color-body); }
  .lb-empty a { display: inline-grid; place-items: center; height: 42px; padding: 0 20px; border-radius: 12px; background: linear-gradient(135deg, #7c3aed, #5b21b6); color: #fff; font: 700 14px var(--font-sans); text-decoration: none; }
  .lb-more { display: grid; place-items: center; margin-top: 22px; }
  .lb-ghost { aspect-ratio: auto; height: 250px; border-radius: 18px; background: linear-gradient(100deg, #f3eeff 30%, #fbf9ff 50%, #f3eeff 70%); background-size: 200% 100%; animation: lb-shimmer 1.4s linear infinite; }
  @keyframes lb-shimmer { to { background-position: -200% 0; } }

  /* badges */
  .lb-badges { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none; }
  .lb-badge { padding: 18px 16px; border-radius: 20px; background: #fff; border: 1px solid var(--color-hairline); text-align: center; }
  .lb-badge.is-earned { border-color: #f6d58e; background: linear-gradient(180deg, #fffaf0, #fff); box-shadow: 0 14px 28px -22px #f59e0b; }
  .lb-badge .icon { display: grid; place-items: center; width: 62px; height: 62px; margin: 0 auto 10px; border-radius: 50%; background: #f3eeff; font-size: 30px; }
  .lb-badge.is-earned .icon { background: linear-gradient(135deg, #fef3c7, #fcd34d); }
  .lb-badge:not(.is-earned) .icon { filter: grayscale(1); opacity: 0.45; }
  .lb-badge h3 { margin: 0; font-size: 15px; font-weight: 800; color: var(--color-ink); }
  .lb-badge p { margin: 4px 0 0; font-size: 13px; line-height: 1.45; color: var(--color-body); }
  .lb-badge .meter { height: 6px; margin: 12px 4px 4px; border-radius: 999px; background: #f1eaf9; overflow: hidden; }
  .lb-badge .meter i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #a78bfa, #7c3aed); }
  .lb-badge small { display: block; margin-top: 6px; font: 600 11.5px var(--font-mono); color: var(--color-mute); }
  .lb-badge.is-earned small { color: #b45309; }

  /* rewards */
  .lb-rewards { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .lb-reward { display: flex; align-items: center; gap: 16px; padding: 14px 18px; border-radius: 18px; background: #fff; border: 1px solid var(--color-hairline); }
  .lb-reward.is-locked { opacity: 0.62; }
  .lb-reward .swatch { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border-radius: 50%; background: #f3eeff; font-size: 22px; color: #f59e0b; }
  .lb-reward .swatch.ring { background: linear-gradient(135deg, #7c3aed, #ec4899); box-shadow: 0 0 0 3px #fff, 0 0 0 6px var(--ring); }
  .lb-reward h3 { margin: 0; font-size: 15px; font-weight: 800; color: var(--color-ink); }
  .lb-reward p { margin: 2px 0 0; font-size: 13px; color: var(--color-body); }
  .lb-reward .lvl { margin-left: auto; padding: 4px 12px; border-radius: 999px; background: #f3eeff; font: 700 12px var(--font-mono); color: var(--color-violet-deep); white-space: nowrap; }
  .lb-reward.is-unlocked .lvl { background: #d1fae5; color: #065f46; }

  @media (max-width: 1040px) {
    .lb-hero { grid-template-columns: auto minmax(0, 1fr); }
    .lb-stats { grid-column: 1 / -1; }
    .lb-stats li { flex: 1; }
  }
  @media (max-width: 880px) {
    .lb-hero { grid-template-columns: 1fr; padding: 22px 20px; }
    .lb-stats { flex-wrap: wrap; }
    .lb-stats li { flex: 1; }
  }
  @media (max-width: 560px) {
    .lb { padding: 24px 14px 64px; }
    .lb-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .lb-card { padding: 8px; }
    .lb-title { font-size: 13.5px; }
    .lb-when { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .lb-ghost { animation: none; } .lb-bar i { transition: none; } .lb-card, .lb-card:hover { transition: none; transform: none; } }
</style>

<script>
  import { startExtractFromYoutube, getApiErrorMessage } from "../lib/api";
  import { cachedUser, getMe } from "../lib/auth";
  import { openSignIn } from "../lib/authUi";
  import { levelRing } from "../lib/levelRing";
  import { clock } from "../lib/format";
  import { goToProcessing } from "../lib/backNav";
  import { getLibrary, getProfile, heartButton, LibraryError } from "../lib/library";
  import type { LibraryItem, Profile } from "../lib/library";

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  const PAGE = 48;
  let tab: "history" | "favorites" | "badges" | "rewards" = "history";
  let profile: Profile | null = null;
  let loadedItems: LibraryItem[] = [];
  let total = 0;
  let shownFor: string | null = null; // whose library is on screen, so a repeat "signed in" message does not reload it
  let version = 0; // so a slow answer for a tab the person has left is ignored

  const ago = (seconds: number | null) => {
    if (!seconds) return "";
    const diff = Math.max(0, Date.now() / 1000 - seconds);
    if (diff < 90) return "just now";
    if (diff < 3600) return `${Math.round(diff / 60)} min ago`;
    if (diff < 86400) return `${Math.round(diff / 3600)} h ago`;
    if (diff < 86400 * 30) return `${Math.round(diff / 86400)} d ago`;
    return new Date(seconds * 1000).toLocaleDateString([], { dateStyle: "medium" });
  };
  const num = (n: number) => n.toLocaleString();

  // ---- the progress card ---------------------------------------------------------------------------------------------

  function drawProfile(p: Profile) {
    const user = cachedUser();
    const ring = levelRing(
      { name: user?.name, email: user?.email, picture: user?.picture, level: p.level, ring: p.ring, intoLevel: p.intoLevel, levelSpan: p.levelSpan },
      112,
    );
    $("avatar").replaceChildren(ring.el);
    $("name").textContent = user?.name || user?.email || "Your library";
    const stars = p.stars > 0 ? ` ${"★".repeat(Math.min(p.stars, 8))}${p.stars > 8 ? `+${p.stars - 8}` : ""}` : "";
    $("level-line").replaceChildren(el("b", "lb-lv", `LEVEL ${p.level}`), el("span", "", `${p.title}${stars}`));
    $("xp-label").textContent = `${num(p.xp)} XP`;
    $("xp-next").textContent = `${num(p.nextLevelXp - p.xp)} XP to level ${p.level + 1}`;
    const percent = p.levelSpan > 0 ? Math.round((100 * p.intoLevel) / p.levelSpan) : 0;
    $("xp-fill").style.width = "0%";
    requestAnimationFrame(() => requestAnimationFrame(() => ($("xp-fill").style.width = `${percent}%`)));
    $("xp-fill").parentElement!.setAttribute("aria-valuenow", String(percent));
    $("next-reward").textContent = p.nextReward ? `Next reward: ${p.nextReward.name} at level ${p.nextReward.nextAt}` : "You have every reward there is. More levels, more stars.";
    $("stats").replaceChildren(
      ...[
        [p.streak, p.streak === 1 ? "Day streak" : "Day streak"],
        [p.songs, "Songs"],
        [p.plays, "Plays"],
        [p.favorites, "Favourites"],
      ].map(([value, label]) => {
        const li = el("li");
        li.append(el("strong", "", num(Number(value))), el("span", "", String(label)));
        return li;
      }),
    );
    $("n-badges").textContent = `${p.badges.filter((b) => b.earned).length}/${p.badges.length}`;
  }

  // ---- songs ---------------------------------------------------------------------------------------------------------

  const spinner = "Opening…";

  async function open(item: LibraryItem, card: HTMLButtonElement) {
    if (!item.videoId) {
      window.location.href = `/play?session=${encodeURIComponent(item.sessionId)}`; // an uploaded song: its analysis is kept
      return;
    }
    card.setAttribute("aria-busy", "true");
    const label = card.querySelector(".lb-title");
    const original = label?.textContent ?? "";
    if (label) label.textContent = spinner;
    try {
      const { sessionId } = await startExtractFromYoutube(`https://www.youtube.com/watch?v=${item.videoId}`, {
        title: item.title,
        artist: item.artist,
        thumbnail: item.thumbnail,
        duration: item.duration,
      });
      goToProcessing(sessionId);
    } catch (err) {
      card.removeAttribute("aria-busy");
      if (label) label.textContent = original;
      $("note").textContent = getApiErrorMessage(err, "Could not open that song. Please try again.");
      $("note").hidden = false;
    }
  }

  function card(item: LibraryItem): HTMLElement {
    const li = el("li", "lb-item");
    const button = el("button", "lb-card");
    button.type = "button";
    button.setAttribute("aria-label", `Open ${item.title}${item.artist ? ` by ${item.artist}` : ""}`);
    const art = el("div", "lb-art");
    if (item.thumbnail) {
      const img = el("img");
      img.alt = "";
      img.loading = "lazy";
      img.referrerPolicy = "no-referrer";
      img.src = item.thumbnail;
      art.append(img);
    }
    if (item.duration > 0) art.append(el("span", "time", clock(item.duration)));
    if (item.plays > 0) art.append(el("span", "plays", `Played ${item.plays}×`));
    const body = el("div", "lb-body");
    body.append(el("p", "lb-title", item.title), el("p", "lb-by", item.artist));
    const foot = el("div", "lb-foot");
    const chips = el("div", "lb-chords");
    item.chords.slice(0, 4).forEach((chord) => chips.append(el("span", "", chord)));
    foot.append(chips, el("span", "lb-when", ago(tab === "favorites" ? item.favoritedAt : item.lastPlayedAt)));
    body.append(foot);
    button.append(art, body);
    button.addEventListener("click", () => open(item, button));
    li.append(button, heartButton({ sessionId: item.sessionId, title: item.title, artist: item.artist, thumbnail: item.thumbnail, duration: item.duration }, "hb hb-card"));
    return li;
  }

  function empty(title: string, text: string): HTMLElement {
    const box = el("div", "lb-empty");
    const link = el("a", "", "Find a song");
    link.href = "/#find";
    box.append(el("h2", "", title), el("p", "", text), link);
    return box;
  }

  function grid(): HTMLElement {
    const list = el("ul", "lb-grid");
    list.id = "grid";
    return list;
  }

  async function showSongs(kind: "history" | "favorites", more = false) {
    const mine = ++version;
    $("note").hidden = true;
    if (!more) {
      loadedItems = [];
      $("panel").replaceChildren(...Array.from({ length: 6 }, () => el("div", "lb-ghost")).map((g) => g));
      $("panel").className = "lb-grid";
    }
    try {
      const data = await getLibrary(kind, loadedItems.length, PAGE);
      if (mine !== version) return;
      total = data.total;
      loadedItems = [...loadedItems, ...data.items];
      $(kind === "history" ? "n-history" : "n-favorites").textContent = String(total);
      $("panel").className = "";
      if (loadedItems.length === 0) {
        $("panel").replaceChildren(
          kind === "history"
            ? empty("Nothing played yet", "Every song you play on Chord Suno shows up here, so you can pick it up again any time.")
            : empty("No favourites yet", "Tap the heart on any song to keep it here."),
        );
      } else {
        const list = grid();
        list.append(...loadedItems.map(card));
        $("panel").replaceChildren(list);
      }
      $("more").hidden = loadedItems.length >= total;
    } catch (err) {
      if (mine !== version) return;
      handleError(err);
    }
  }

  // ---- badges and rewards ------------------------------------------------------------------------------------------

  function showBadges(p: Profile) {
    $("more").hidden = true;
    const list = el("ul", "lb-badges");
    p.badges.forEach((badge) => {
      const li = el("li", `lb-badge${badge.earned ? " is-earned" : ""}`);
      li.append(el("div", "icon", badge.icon), el("h3", "", badge.name), el("p", "", badge.description));
      if (badge.earned) {
        li.append(el("small", "", `Earned ${new Date((badge.earnedAt ?? 0) * 1000).toLocaleDateString([], { dateStyle: "medium" })}${badge.bonusXp ? ` · +${badge.bonusXp} XP` : ""}`));
      } else {
        const meter = el("div", "meter");
        const fill = el("i");
        fill.style.width = `${Math.round((100 * badge.progress) / badge.threshold)}%`;
        meter.append(fill);
        li.append(meter, el("small", "", `${num(badge.progress)} / ${num(badge.threshold)}`));
      }
      list.append(li);
    });
    $("panel").className = "";
    $("panel").replaceChildren(list);
  }

  function showRewards(p: Profile) {
    $("more").hidden = true;
    const list = el("ul", "lb-rewards");
    p.rewards.forEach((reward) => {
      const li = el("li", `lb-reward ${reward.unlocked ? "is-unlocked" : "is-locked"}`);
      const swatch = el("div", reward.kind === "ring" ? "swatch ring" : "swatch", reward.kind === "star" ? "★" : reward.kind === "perk" ? "🎁" : "");
      if (reward.kind === "ring") swatch.style.setProperty("--ring", reward.value);
      const text = el("div");
      const extra = reward.repeatEvery > 0 ? ` Comes again every ${reward.repeatEvery} levels.` : reward.kind === "perk" && reward.value ? ` ${reward.value}.` : "";
      text.append(el("h3", "", reward.count > 1 ? `${reward.name} ×${reward.count}` : reward.name), el("p", "", `${reward.description}${extra}`));
      const level = el("span", "lvl", reward.unlocked ? (reward.repeatEvery > 0 ? `Next: level ${reward.nextAt}` : "Unlocked") : `Level ${reward.level}`);
      li.append(swatch, text, level);
      list.append(li);
    });
    $("panel").className = "";
    $("panel").replaceChildren(list);
  }

  // ---- tabs, loading, and being signed out -------------------------------------------------------------------------

  function select(next: typeof tab) {
    tab = next;
    document.querySelectorAll<HTMLButtonElement>(".lb-tabs button").forEach((b) => b.setAttribute("aria-selected", String(b.dataset.tab === next)));
    history.replaceState(null, "", next === "history" ? "/library/" : `/library/#${next}`);
    if (next === "history" || next === "favorites") void showSongs(next);
    else if (profile) (next === "badges" ? showBadges : showRewards)(profile);
  }

  function handleError(err: unknown) {
    if (err instanceof LibraryError && err.status === 401) {
      showGate();
      return;
    }
    $("note").textContent = err instanceof Error ? err.message : "Something went wrong.";
    $("note").hidden = false;
  }

  function showGate() {
    shownFor = null;
    $("app").hidden = true;
    $("gate").hidden = false;
  }

  let starting = false; // the page is loading: asking again (the menu hears from the server too) would load everything twice
  async function start() {
    if (starting) return;
    starting = true;
    try {
      const user = await getMe();
      if (!user) return showGate();
      shownFor = user.id;
      $("gate").hidden = true;
      $("app").hidden = false;
      try {
        profile = await getProfile();
        drawProfile(profile);
      } catch (err) {
        return handleError(err);
      }
      const wanted = location.hash.slice(1) as typeof tab;
      select(["favorites", "badges", "rewards"].includes(wanted) ? wanted : "history");
      // the other count, so the tab shows it before it is opened
      getLibrary(tab === "history" ? "favorites" : "history", 0, 1).then((d) => ($(tab === "history" ? "n-favorites" : "n-history").textContent = String(d.total))).catch(() => {});
    } finally {
      starting = false;
    }
  }

  document.querySelectorAll<HTMLButtonElement>(".lb-tabs button").forEach((b) => b.addEventListener("click", () => select(b.dataset.tab as typeof tab)));
  $("more").addEventListener("click", () => showSongs(tab as "history" | "favorites", true));
  $("gate-signin").addEventListener("click", () => openSignIn());
  window.addEventListener("auth-change", (event) => {
    const user = (event as CustomEvent).detail as { id: string } | null;
    if ((user?.id ?? null) === shownFor) return;
    if (user) void start();
    else showGate();
  });
  void start();
</script>
