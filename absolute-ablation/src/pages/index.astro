---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Trending from "../components/Trending.astro";
import LogoStrip from "../components/LogoStrip.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ChordPlayer from "../components/ChordPlayer.astro";
import Instruments from "../components/Instruments.astro";
import Features from "../components/Features.astro";
import Pricing from "../components/Pricing.astro";
import CTABand from "../components/CTABand.astro";
import Footer from "../components/Footer.astro";

// What the search result shows (about 60 and 155 characters: longer is cut off). The words people type most are at the front.
const title = "Chord Finder: Get the Chords of Any Song, Free — Chord Suno";
const description = "Find the chords of any song, free. Search a song or upload audio for every chord synced to the beat, with guitar, piano and ukulele diagrams, key and tempo.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Chord Suno",
    url: "https://chordsuno.com/",
    description: "Get the chords of any song by searching for it or uploading an audio file, synced to the beat, with guitar chord diagrams.",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Chord Suno",
    legalName: "Yantrix Labs",
    url: "https://chordsuno.com/",
    logo: "https://chordsuno.com/icon-512.png",
    email: "yantrixlab@gmail.com",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "Chord Suno",
    url: "https://chordsuno.com/",
    applicationCategory: "MusicApplication",
    operatingSystem: "Any (runs in the browser)",
    description:
      "Listens to a song you search for, or an audio file you upload, and writes out every chord, synced to the beat, with guitar chord diagrams, the key and the tempo. Includes a tuner, metronome, chord practice drills and live chord detection.",
    offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd} themeable>
  <Nav />
  <main>
    <Hero />
    <Trending />
    <LogoStrip />
    <HowItWorks />
    <ChordPlayer />
    <Instruments />
    <Features />
    <Pricing />
    <CTABand />
  </main>
  <Footer />
</Layout>
