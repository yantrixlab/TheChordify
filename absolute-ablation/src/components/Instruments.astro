---
const instruments = [
  {
    id: "guitar",
    href: "/guitar-chord-finder/",
    name: "Guitar",
    description: "Standard, drop-D, open tunings. Chord shapes for every level from beginner to advanced.",
    features: ["Standard & alternate tunings", "Capo support", "Barre chord diagrams", "Beginner-friendly shapes"],
    icon: `<svg viewBox="0 0 24 24"><g transform="rotate(40 12 12)"><path d="M12 1.8v5M10.6 1.8h2.8"/><path d="M9.2 9.6C9.2 8.2 10.4 7 12 7s2.8 1.2 2.8 2.6c0 1.2-.6 1.7-.9 2.5-.2.7 1.8 1 1.8 3.4 0 2.8-2 5-4.7 5s-4.7-2.2-4.7-5c0-2.4 2-2.7 1.8-3.4-.3-.8-.9-1.3-.9-2.5z"/><circle cx="12" cy="15" r="1.3"/></g></svg>`,
  },
  {
    id: "piano",
    name: "Piano",
    description: "Full keyboard view with highlighted keys. See exactly which notes to play, left and right hand.",
    features: ["88-key visual display", "Left & right hand split", "Inversions shown", "Velocity hints"],
    icon: `<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M9 13.5V19M15 13.5V19M7.5 5v8.5h3V5M13.5 5v8.5h3V5"/></svg>`,
  },
  {
    id: "ukulele",
    href: "/ukulele-chords/",
    name: "Ukulele",
    description: "Soprano, concert, and baritone tunings. Clean chord grids optimised for 4-string players.",
    features: ["GCEA & ADF#B tunings", "Re-entrant tuning", "Chord inversions", "Easy-first suggestions"],
    icon: `<svg viewBox="0 0 24 24"><g transform="rotate(40 12 12)"><path d="M12 2.5v6.5M10.7 2.5h2.6"/><circle cx="12" cy="14.8" r="5"/><circle cx="12" cy="14.8" r="1.5"/><path d="M10 18.9h4"/></g></svg>`,
  },
  {
    id: "mandolin",
    href: "/mandolin-chords/",
    name: "Mandolin",
    description: "The only chord tool with full mandolin support. GDAE tuning with authentic 8-string chord shapes.",
    features: ["GDAE tuning", "Authentic 8-string shapes", "Fiddle-tune keys", "Bluegrass voicings"],
    icon: `<svg viewBox="0 0 24 24"><g transform="rotate(40 12 12)"><path d="M12 1.6v6M10.4 1.6h3.2"/><path d="M12 7.2c3.2 0 5.4 3.3 5.4 7 0 3.3-2.3 6.2-5.4 6.2s-5.4-2.9-5.4-6.2c0-3.7 2.2-7 5.4-7z"/><path d="M9.6 14.2c0-1 .6-1.8 1.4-1.8M14.4 14.2c0-1-.6-1.8-1.4-1.8M9.4 17.6h5.2"/></g></svg>`,
  },
];
---

<section id="instruments" class="hs">
  <div class="hs-in">
    <div class="hs-head">
      <div class="hs-eyebrow">4 instruments</div>
      <h2 class="hs-title">Whatever you play, <em>we've got you covered.</em></h2>
      <p class="hs-lead">
        The only chord tool on the web with native mandolin support alongside guitar, piano and ukulele.
      </p>
    </div>

    <div class="in-grid">
      {
        instruments.map((inst) => (
          <article class="hs-card in-card">
            <span class="hs-ico" set:html={inst.icon} />
            <h3>{inst.href ? <a href={inst.href}>{inst.name}</a> : inst.name}</h3>
            <p>{inst.description}</p>
            <ul>
              {inst.features.map((f) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3.6 8.4 2.9 2.9 5.9-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  {f}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="in-note">
      Bass guitar, banjo &amp; violin support coming soon. <a href="/contact/">Tell us what you play →</a>
    </p>
  </div>
</section>

<style>
  .in-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .in-card { display: flex; flex-direction: column; padding: 26px; }
  .in-card .hs-ico { margin-bottom: 22px; }
  .in-card h3 { margin: 0 0 8px; font-size: 20px; font-weight: 650; letter-spacing: -0.02em; color: var(--color-ink); }
  .in-card h3 a { color: inherit; text-decoration: none; }
  .in-card h3 a:hover { color: var(--color-violet-deep); }
  .in-card p { margin: 0 0 20px; font-size: 14.5px; line-height: 1.6; color: var(--color-body); }
  .in-card ul { display: grid; gap: 10px; margin: auto 0 0; padding: 18px 0 0; border-top: 1px solid #f0ecf7; list-style: none; }
  .in-card li { display: flex; align-items: center; gap: 9px; font-size: 13.5px; color: var(--color-body); }
  .in-card li svg { flex: none; color: var(--color-violet); }
  .in-note { margin: 34px 0 0; text-align: center; font-size: 14px; color: var(--color-mute); }
  .in-note a { margin-left: 6px; font-weight: 600; color: var(--color-violet-deep); text-decoration: none; }
  .in-note a:hover { text-decoration: underline; }
  @media (max-width: 1023px) { .in-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .in-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
