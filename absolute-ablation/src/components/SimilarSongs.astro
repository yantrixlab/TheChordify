---
// Songs like the one in the player, in a grid under it. The server picks them (/api/similar/<session>): songs already chordified that
// are alike, then more by the same artist, then the most played songs. Each says why it is there. Nothing shows until there are some.
---

<section id="similar" class="ss" aria-labelledby="ss-title" hidden>
  <div class="ss-head">
    <p class="ss-eyebrow">Keep playing</p>
    <h2 id="ss-title" class="ss-title">Songs like this one</h2>
    <p class="ss-sub">Songs from the same movie or album, and songs with a similar mood and language. Pick one to get its chords.</p>
  </div>
  <p id="ss-note" class="ss-note" role="alert" hidden></p>
  <ul id="ss-grid" class="ss-grid" role="list"></ul>
</section>

<style is:global>
  .ss { margin: 28px 0 0; color: #fff; }
  .ss[hidden] { display: none; }
  .ss-head { margin-bottom: 22px; }
  .ss-eyebrow { margin: 0 0 8px; font: 700 11.5px/1 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: #b9a1ff; }
  .ss-title { margin: 0 0 8px; font-size: clamp(22px, 3vw, 30px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; color: #fff; }
  .ss-sub { margin: 0; max-width: 560px; font-size: 14.5px; line-height: 1.6; color: #b7acd0; }
  .ss-note { margin: 0 0 16px; padding: 10px 14px; border-radius: 12px; background: #3b0a1a; color: #fecaca; font-size: 14px; }
  .ss-note[hidden] { display: none; }
  .ss-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; margin: 0; padding: 0; list-style: none; }

  .ss-card { all: unset; box-sizing: border-box; display: flex; flex-direction: column; width: 100%; height: 100%; padding: 9px; border-radius: 16px; cursor: pointer;
    background: #ffffff0d; border: 1px solid #ffffff17; transition: background-color 0.18s, border-color 0.18s, transform 0.18s, box-shadow 0.18s; }
  .ss-card:hover, .ss-card:focus-visible { background: #ffffff17; border-color: #a78bfa88; transform: translateY(-2px); box-shadow: 0 18px 30px -20px #000; }
  .ss-card:focus-visible { outline: 2px solid #c4b5fd; outline-offset: 2px; }
  .ss-card[disabled] { cursor: progress; opacity: 0.7; }
  .ss-card[aria-busy="true"] { opacity: 1; border-color: #a78bfa; }
  .ss-art { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 10px; background: linear-gradient(135deg, #3b1d7a, #7c3aed66); }
  .ss-art img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ss-art.cover img.back { position: absolute; inset: -12px; width: calc(100% + 24px); height: calc(100% + 24px); filter: blur(16px) saturate(1.2); opacity: 0.7; }
  .ss-art.cover img.front { position: relative; width: auto; height: 100%; margin: 0 auto; aspect-ratio: 1; border-radius: 6px; box-shadow: 0 6px 18px -6px #0008; }
  .ss-time { position: absolute; right: 7px; bottom: 7px; padding: 2px 6px; border-radius: 6px; background: #0d0019cc; font: 600 11px/1.5 var(--font-mono); color: #fff; }
  .ss-go { position: absolute; inset: 0; display: grid; place-items: center; background: #1a053399; font: 700 13.5px var(--font-sans); color: #fff; opacity: 0; transition: opacity 0.18s; }
  .ss-card:hover .ss-go, .ss-card:focus-visible .ss-go, .ss-card[aria-busy="true"] .ss-go { opacity: 1; }
  .ss-body { display: flex; flex: 1; flex-direction: column; gap: 3px; padding: 10px 3px 3px; }
  .ss-name { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; margin: 0; min-height: 2.6em; font-size: 14px; font-weight: 700; line-height: 1.3; color: #fff; }
  .ss-by { margin: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 12.5px; color: #b7acd0; }
  .ss-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 5px; margin-top: auto; padding-top: 9px; }
  .ss-why { padding: 2px 8px; border-radius: 999px; background: #7c3aed40; font: 650 11px/1.5 var(--font-sans); color: #d9ccff; }
  .ss-chord { padding: 2px 6px; border-radius: 6px; background: #ffffff14; font: 700 11px/1.5 var(--font-mono); color: #e4dcf5; }

  @media (max-width: 640px) {
    .ss { margin-top: 24px; }
    .ss-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .ss-card { padding: 7px; }
    .ss-name { font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) { .ss-card { transition: none; } .ss-card:hover, .ss-card:focus-visible { transform: none; } }
</style>

<script>
  import { getSimilar, startExtractFromYoutube, getApiErrorMessage } from "../lib/api";
  import type { SongHit } from "../lib/api";
  import { clock } from "../lib/format";
  import { rememberSong } from "../lib/recent";

  const section = document.getElementById("similar") as HTMLElement;
  const grid = document.getElementById("ss-grid") as HTMLElement;
  const note = document.getElementById("ss-note") as HTMLElement;
  const session = new URLSearchParams(window.location.search).get("session");

  type Similar = SongHit & { why?: string };

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] => {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  };

  function art(song: Similar): HTMLElement {
    const wide = !song.thumbnail || /ytimg\.com/.test(song.thumbnail);
    const box = el("div", wide ? "ss-art" : "ss-art cover");
    const image = (className: string) => {
      const img = el("img", className);
      img.alt = "";
      img.loading = "lazy";
      img.decoding = "async";
      img.referrerPolicy = "no-referrer";
      img.src = song.thumbnail || `https://i.ytimg.com/vi/${song.videoId}/mqdefault.jpg`;
      return img;
    };
    if (wide) box.append(image(""));
    else box.append(image("back"), image("front"));
    if (song.duration > 0) box.append(el("span", "ss-time", clock(song.duration)));
    box.append(el("span", "ss-go", song.chords && song.chords.length > 0 ? "Open chords" : "Get chords"));
    return box;
  }

  function card(song: Similar): HTMLElement {
    const item = el("li");
    const button = el("button", "ss-card");
    button.type = "button";
    button.setAttribute("aria-label", `${song.chords && song.chords.length > 0 ? "Open chords for" : "Get chords for"} ${song.title}${song.artist ? ` by ${song.artist}` : ""}`);
    const body = el("div", "ss-body");
    body.append(el("p", "ss-name", song.title), el("p", "ss-by", song.artist || song.album));
    const foot = el("div", "ss-foot");
    if (song.why) foot.append(el("span", "ss-why", song.why));
    (song.chords ?? []).slice(0, 3).forEach((chord) => foot.append(el("span", "ss-chord", chord)));
    body.append(foot);
    button.append(art(song), body);
    button.addEventListener("click", () => choose(song, button));
    item.append(button);
    return item;
  }

  async function choose(song: Similar, button: HTMLButtonElement) {
    rememberSong(song);
    grid.querySelectorAll<HTMLButtonElement>(".ss-card").forEach((b) => (b.disabled = true));
    button.setAttribute("aria-busy", "true");
    const go = button.querySelector(".ss-go");
    if (go) go.textContent = "Starting…";
    note.hidden = true;
    try {
      const { sessionId } = await startExtractFromYoutube(`https://www.youtube.com/watch?v=${song.videoId}`, {
        title: song.title,
        artist: song.artist,
        album: song.album,
        thumbnail: song.thumbnail,
        duration: song.duration,
      });
      window.location.href = `/processing?session=${sessionId}`;
    } catch (err) {
      grid.querySelectorAll<HTMLButtonElement>(".ss-card").forEach((b) => {
        b.disabled = false;
        b.removeAttribute("aria-busy");
      });
      if (go) go.textContent = song.chords && song.chords.length > 0 ? "Open chords" : "Get chords";
      note.textContent = getApiErrorMessage(err, "Could not start that song. Please try again.");
      note.hidden = false;
    }
  }

  async function load() {
    if (!session) return;
    let songs: Similar[] = [];
    try {
      songs = await getSimilar(session);
    } catch {
      songs = [];
    }
    if (songs.length === 0) return; // nothing to show is better than an empty box
    grid.replaceChildren(...songs.map(card));
    section.hidden = false;
  }

  // Wait until the song itself has loaded (the page shows it a moment after it opens), then fetch; the shelf is not what the visitor came for.
  const player = document.getElementById("player-state");
  if (player && !player.classList.contains("hidden")) void load();
  else if (player) {
    const watcher = new MutationObserver(() => {
      if (!player.classList.contains("hidden")) {
        watcher.disconnect();
        void load();
      }
    });
    watcher.observe(player, { attributes: true, attributeFilter: ["class"] });
  }
</script>
