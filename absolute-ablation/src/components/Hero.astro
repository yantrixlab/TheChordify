---
// The home page's hero: copy and the search card on the left, a photo of two people playing on the right with a chord card floating
// beside it, soft glows and music notes behind, and four things the site does along the bottom. Dark (a black gradient with violet, pink
// and amber light) when the visitor's theme is dark, and a light version of the same picture otherwise. Everything that moves is
// transform and opacity, and none of it moves for a visitor who asks for reduced motion.
import { getGuitarShape, diagramSvg } from "../lib/tools/diagram";

const instruments = [
  { id: "guitar", label: "Guitar", icon: "🎸" },
  { id: "piano", label: "Piano", icon: "🎹" },
  { id: "ukulele", label: "Ukulele", icon: "🪗" },
  { id: "mandolin", label: "Mandolin", icon: "🎵" },
];

// The chord card beside the photo is a real diagram, drawn here from the same shapes as the player.
const shape = getGuitarShape("G");
const chordSvg = shape
  ? diagramSvg(shape, { title: "G chord on guitar", ink: "currentColor", line: "color-mix(in srgb, currentColor 30%, transparent)" })
  : "";

const features = [
  { title: "Instant Chords", text: "Find chords instantly", icon: "M13 2 4 14h7l-1 8 9-12h-7z" },
  { title: "Sync with Beat", text: "Play along perfectly", icon: "M9 18V5l11-2v13M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0zM20 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" },
  { title: "Chord Diagrams", text: "Learn with ease", icon: "M4 4h16v16H4zM4 9.3h16M4 14.6h16M9.3 4v16M14.6 4v16" },
  { title: "Multiple Instruments", text: "Guitar, Piano & more", icon: "m12 3 2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-3-5.4 3 1.1-6-4.5-4.2 6.1-.8z" },
];
---

<section id="main-content" class="hero">
  <!-- Atmosphere (decorative) -->
  <div class="bg" aria-hidden="true">
    <span class="glow g1"></span>
    <span class="glow g2"></span>
    <span class="glow g3"></span>
    <span class="spot"></span>
    <span class="dots"></span>
  </div>
  <svg class="swoosh" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="sw1" x1="0" x2="1"><stop offset="0" stop-color="#7c3aed" stop-opacity="0" /><stop offset="0.35" stop-color="#8b5cf6" /><stop offset="1" stop-color="#ec4899" stop-opacity="0" /></linearGradient>
      <linearGradient id="sw2" x1="0" x2="1"><stop offset="0" stop-color="#f59e0b" stop-opacity="0" /><stop offset="0.6" stop-color="#f59e0b" /><stop offset="1" stop-color="#fb923c" stop-opacity="0" /></linearGradient>
    </defs>
    <path class="sw-a" d="M-20 190C220 120 380 214 640 176S1060 60 1460 120" fill="none" stroke="url(#sw1)" stroke-width="2.2" />
    <path class="sw-b" d="M-20 214C260 150 420 224 700 200S1100 100 1460 170" fill="none" stroke="url(#sw2)" stroke-width="1.6" />
    <path class="sw-c" d="M-20 170C300 110 460 190 760 150S1120 40 1460 90" fill="none" stroke="url(#sw1)" stroke-width="1" opacity="0.6" />
  </svg>

  <div class="wrap">
    <div class="copy">
      <!-- Eyebrow -->
      <div class="eyebrow rise" style="--i:0">
        <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <a href="/toolkit/"><strong>New</strong> Tuner, metronome and chord practice</a>
      </div>

      <h1 class="title rise" style="--i:1">
        Hear every chord.<br />
        <span class="title-grad">Play every song.</span>
      </h1>

      <p class="lede rise" style="--i:2">
        Search for any song, or upload your own. Chord Suno listens and writes out every chord, synced to the beat, with
        guitar chord diagrams and the key and tempo of the song.
      </p>

      <!-- Input card -->
      <div id="find" class="card rise" style="--i:3">
        <span class="card-glow" aria-hidden="true"><i class="tw"></i></span>
        <span class="card-ring" aria-hidden="true"><i class="tw"></i></span>
        <div class="card-body">
          <div class="tabs" role="tablist" aria-label="Input method">
            <button id="tab-search" class="tab" role="tab" aria-selected="true" aria-controls="panel-search" type="button">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="5.2" stroke="currentColor" stroke-width="1.6" />
                <path d="m12 12 3.2 3.2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
              Search songs
            </button>
            <button id="tab-upload" class="tab" role="tab" aria-selected="false" aria-controls="panel-upload" type="button">
              <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 11V2.5M4.5 5.5 8 2l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M2.5 11v1.5a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
              Upload song
            </button>
          </div>

          <!-- Search panel: songs only, results on their own page -->
          <div id="panel-search" role="tabpanel" aria-labelledby="tab-search">
            <form id="hero-search" class="row" action="/search" method="get" role="search" autocomplete="off">
              <label for="hero-q" class="sr-only">Song or artist</label>
              <div class="field">
                <svg class="field-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.7" />
                  <path d="m13.5 13.5 3.5 3.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
                <input id="hero-q" type="search" name="q" placeholder="Song name or artist…" maxlength="100" enterkeyhint="search" />
              </div>
              <button id="search-btn" class="go" type="submit">
                <span>Find chords</span>
                <svg width="16" height="16" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8M7 3l4 4-4 4" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </form>
            <p id="search-status" class="status hidden" role="status" aria-live="polite"></p>
          </div>

          <!-- Upload panel -->
          <div id="panel-upload" role="tabpanel" aria-labelledby="tab-upload" class="hidden">
            <label class="drop" id="dropzone">
              <input id="audio-file-input" type="file" accept=".mp3,.wav,.flac,.m4a" class="sr-only" name="audio-file" />
              <span class="drop-icon">
                <svg id="upload-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 16V4M7 8.5 12 3.5l5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
                <svg id="upload-spinner" class="hidden spin" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7" stroke-opacity="0.3" />
                  <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                </svg>
              </span>
              <p id="upload-label">
                <strong>Click to upload</strong> or drag &amp; drop
                <span class="muted"> · MP3, WAV, FLAC, M4A</span>
              </p>
            </label>
            <p id="upload-status" class="status hidden" role="status" aria-live="polite"></p>
          </div>

          <!-- Instrument quick-select -->
          <fieldset class="chips">
            <legend>Chords for</legend>
            {
              instruments.map((inst, i) => (
                <button type="button" class="chip-btn instrument-btn" data-inst={inst.id} aria-pressed={i === 0 ? "true" : "false"}>
                  <span aria-hidden="true">{inst.icon}</span> {inst.label}
                </button>
              ))
            }
          </fieldset>
        </div>
      </div>

      <p class="trust rise" style="--i:4">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7l3 3 7-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Free to start · No credit card · Works on any device
      </p>
    </div>

    <!-- The photo -->
    <div class="art" id="hero-art">
      <span class="floor" aria-hidden="true"></span>
      <div class="art-in">
        <img
          class="photo"
          src="/hero-players.webp"
          srcset="/hero-players-720.webp 720w, /hero-players.webp 1200w"
          sizes="(max-width: 880px) 92vw, 52vw"
          width="1200"
          height="800"
          alt="A smiling woman and a boy sitting side by side, each playing an acoustic guitar"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="fc" aria-hidden="true">
        <div class="fc-in">
          <strong>G</strong>
          <div class="fc-svg" set:html={chordSvg} />
        </div>
      </div>
      <div class="floaters" id="floaters" aria-hidden="true"></div>
    </div>
  </div>

  <ul class="features rise" style="--i:5" aria-label="What Chord Suno does">
    {
      features.map((f) => (
        <li>
          <span class="f-ico" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={f.icon} /></svg>
          </span>
          <span class="f-text"><strong>{f.title}</strong><small>{f.text}</small></span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .hero {
    /* light version of the picture */
    --h-bg: linear-gradient(180deg, #f8f3ff 0%, #fdf9ff 55%, #ffffff 100%);
    --h-ink: #0d001f;
    --h-body: #4a3d6a;
    --h-mute: #6b5f8a;
    --h-glass: rgba(255, 255, 255, 0.82);
    --h-card: rgba(255, 255, 255, 0.95);
    --h-glass-line: #e1d4f7;
    --h-field: #fbf9ff;
    --h-tabs: #f3eeff;
    --h-chip: #ffffff;
    --h-feature: rgba(255, 255, 255, 0.78);
    --h-glow: 0.5;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 108px 24px 40px;
    background: var(--h-bg);
  }
  :global(html[data-theme="dark"]) .hero {
    /* a black gradient with a little violet in it, not navy */
    --h-bg: radial-gradient(1100px 620px at 78% 8%, #2a0f52cc, transparent 62%), radial-gradient(800px 520px at 4% 100%, #3b1a0a99, transparent 60%), linear-gradient(180deg, #0a090e 0%, #050507 55%, #020203 100%);
    --h-ink: #ffffff;
    --h-body: #cfc7e0;
    --h-mute: #9a90b3;
    --h-glass: rgba(14, 12, 20, 0.86);
    --h-card: rgba(10, 8, 15, 0.95);
    --h-glass-line: #ffffff1c;
    --h-field: #0f0d16;
    --h-tabs: #17131f;
    --h-chip: #14111c;
    --h-feature: rgba(16, 13, 24, 0.7);
    --h-glow: 1;
  }
  .hidden { display: none !important; }

  /* ── atmosphere ── */
  .bg { position: absolute; inset: 0; z-index: -3; overflow: hidden; pointer-events: none; }
  .glow { position: absolute; border-radius: 50%; filter: blur(80px); will-change: transform; }
  .g1 { width: 560px; height: 560px; right: -60px; top: -40px; background: #7c3aed; opacity: calc(0.34 * var(--h-glow)); animation: drift-a 20s ease-in-out infinite alternate; }
  .g2 { width: 420px; height: 420px; right: 30%; top: 38%; background: #ec4899; opacity: calc(0.18 * var(--h-glow)); animation: drift-b 24s ease-in-out infinite alternate; }
  .g3 { width: 460px; height: 460px; right: -80px; bottom: -120px; background: #f59e0b; opacity: calc(0.22 * var(--h-glow)); animation: drift-a 28s ease-in-out infinite alternate-reverse; }
  .spot { position: absolute; right: 4%; top: 10%; width: 58%; height: 78%; background: radial-gradient(closest-side, #a78bfa66, transparent 72%); opacity: var(--h-glow); animation: breathe 7s ease-in-out infinite; }
  .dots {
    position: absolute; inset: 0;
    background-image: radial-gradient(#8b5cf62e 1px, transparent 1.3px); background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse 65% 60% at 70% 40%, #000 15%, transparent 72%);
    mask-image: radial-gradient(ellipse 65% 60% at 70% 40%, #000 15%, transparent 72%);
  }
  .swoosh { position: absolute; left: 0; right: 0; bottom: 70px; width: 100%; height: 190px; z-index: -2; pointer-events: none; opacity: 0.55; }
  .swoosh path { stroke-dasharray: 1800; stroke-dashoffset: 1800; animation: draw 2.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s forwards; }
  .swoosh .sw-b { animation-delay: 0.6s; }
  .swoosh .sw-c { animation-delay: 0.9s; }

  /* ── layout ── */
  .wrap { position: relative; display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr); gap: 8px; align-items: center; max-width: 1240px; margin: 0 auto; }
  .copy { position: relative; z-index: 2; min-width: 0; }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 10px; margin-bottom: 24px;
    padding: 6px 16px 6px 10px; border-radius: 999px;
    font-size: 13px; font-weight: 500; color: var(--h-body);
    background: var(--h-glass); border: 1px solid var(--h-glass-line);
    box-shadow: 0 8px 24px -14px #7c3aed88;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  }
  .eyebrow strong { font-weight: 700; color: var(--h-ink); }
  .eyebrow a { color: inherit; text-decoration: none; }
  .eyebrow a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .eq { display: inline-flex; align-items: flex-end; gap: 2px; height: 16px; padding: 3px 6px; border-radius: 999px; background: #1a0533; }
  .eq i { width: 2.5px; height: 100%; border-radius: 2px; background: #fbbf24; transform-origin: bottom; animation: eq 1.1s ease-in-out infinite; }
  .eq i:nth-child(2) { animation-delay: -0.35s; background: #fff; }
  .eq i:nth-child(3) { animation-delay: -0.7s; }
  .eq i:nth-child(4) { animation-delay: -0.15s; background: #fff; }

  .title { margin: 0 0 20px; color: var(--h-ink); font-size: clamp(42px, 5.2vw, 74px); font-weight: 800; line-height: 1.02; letter-spacing: -0.045em; text-wrap: balance; }
  .title-grad {
    display: inline-block; padding-bottom: 0.08em;
    background: linear-gradient(100deg, #f59e0b 0%, #fb7185 38%, #c026d3 72%, #8b5cf6 100%);
    background-size: 160% 100%; animation: shine 9s ease-in-out infinite alternate;
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
  .lede { max-width: 540px; margin: 0 0 32px; font-size: clamp(16px, 1.7vw, 18.5px); line-height: 1.65; color: var(--h-body); text-wrap: pretty; }

  /* ── input card: glass, with a slowly turning gradient edge ── */
  .card { position: relative; max-width: 600px; padding: 2px; border-radius: 26px; scroll-margin-top: 120px; /* clear of the fixed menu */ }
  /* the edge: a dim ring in four colours, and a bright stroke that runs around it (the stroke is a gradient turning inside the clipped ring) */
  .card-ring { position: absolute; inset: 0; z-index: 0; border-radius: 26px; overflow: hidden; background: conic-gradient(from 0deg, #7c3aedb0, #ec4899b0, #f59e0bb0, #22d3eeb0, #7c3aedb0); box-shadow: 0 30px 60px -30px #5b21b680; }
  .card-glow { position: absolute; inset: 14px 24px -22px; z-index: -1; border-radius: 40px; overflow: hidden; filter: blur(32px); opacity: calc(0.38 * var(--h-glow) + 0.14); }
  .card-ring i, .card-glow i {
    position: absolute; left: 50%; top: 50%; width: 150%; aspect-ratio: 1; border-radius: 50%; will-change: transform;
    background: conic-gradient(from 0deg, transparent 0 42%, #22d3ee 60%, #8b5cf6 74%, #ec4899 86%, #fbbf24 96%, #fff 99%, transparent 100%);
    transform: translate(-50%, -50%); animation: ring 6.5s linear infinite;
  }
  .card-glow i { animation-duration: 6.5s; }
  .card-body { position: relative; z-index: 1; padding: 14px; border-radius: 24px; background: var(--h-card); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); }

  .tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-bottom: 12px; padding: 4px; border-radius: 16px; background: var(--h-tabs); }
  .tab {
    display: flex; align-items: center; justify-content: center; gap: 8px; height: 42px; border: 0; border-radius: 12px; cursor: pointer;
    font: 600 14px/1 var(--font-sans); color: var(--h-mute); background: transparent;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s;
  }
  .tab:hover { color: var(--h-ink); }
  .tab.is-locked { opacity: 0.6; }
  .tab.is-locked::after { content: "🔒"; font-size: 12px; }
  .tab[aria-selected="true"] { color: #fff; background: linear-gradient(135deg, #7c3aed, #5b21b6); box-shadow: 0 8px 18px -8px #7c3aedcc, inset 0 1px 0 #ffffff33; }

  .row { display: flex; gap: 10px; }
  .field { position: relative; flex: 1; min-width: 0; }
  .field-icon { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--h-mute); pointer-events: none; transition: color 0.18s; }
  .field input {
    width: 100%; height: 56px; padding: 0 16px 0 46px; border-radius: 16px; outline: none;
    font: 500 16px/1 var(--font-sans); color: var(--h-ink);
    background: var(--h-field); border: 1.5px solid var(--h-glass-line);
    transition: border-color 0.18s, box-shadow 0.18s, background-color 0.18s;
  }
  .field input::placeholder { color: var(--h-mute); }
  .field input:focus { border-color: #8b5cf6; box-shadow: 0 0 0 4px #7c3aed33; }
  .field:focus-within .field-icon { color: #a78bfa; }

  .go {
    position: relative; flex: none; display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 56px; padding: 0 26px;
    border: 0; border-radius: 16px; cursor: pointer; overflow: hidden; white-space: nowrap;
    font: 700 16px/1 var(--font-sans); color: #fff;
    background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 60%, #4c1d95 120%);
    box-shadow: 0 12px 26px -10px #7c3aedcc, inset 0 1px 0 #ffffff40;
    transition: transform 0.18s, box-shadow 0.18s, filter 0.18s;
  }
  .go::after { content: ""; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 30%, #ffffff40 50%, transparent 70%); transform: translateX(-120%); transition: transform 0.6s; }
  .go:hover { transform: translateY(-1px); box-shadow: 0 16px 30px -10px #8b5cf6e6, inset 0 1px 0 #ffffff40; }
  .go:hover::after { transform: translateX(120%); }
  .go:active { transform: translateY(0); }
  .go:disabled { cursor: progress; filter: saturate(0.7) brightness(0.95); transform: none; }
  .spin { animation: spin 0.7s linear infinite; }

  .drop {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: 124px; padding: 18px; border-radius: 16px; cursor: pointer; text-align: center;
    border: 2px dashed var(--h-glass-line); background: var(--h-field); color: var(--h-body);
    transition: border-color 0.18s, background-color 0.18s, transform 0.18s;
  }
  .drop:hover, .drop.drag { border-color: #8b5cf6; }
  .drop.drag { transform: scale(1.01); }
  .drop-icon { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; color: #a78bfa; background: var(--h-chip); box-shadow: 0 0 0 1px var(--h-glass-line); }
  .drop p { margin: 0; font-size: 14.5px; color: var(--h-body); }
  .drop strong { color: #a78bfa; }
  .muted { color: var(--h-mute); }
  .status { margin: 10px 4px 0; font-size: 13.5px; }

  .chips { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin: 14px 4px 2px; padding: 0; border: 0; }
  .chips legend { float: left; margin-right: 4px; padding: 0; font: 600 11px/28px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--h-mute); }
  .chip-btn {
    height: 32px; padding: 0 13px; border-radius: 999px; cursor: pointer;
    font: 600 13px/1 var(--font-sans); color: var(--h-body); background: var(--h-chip); border: 1px solid var(--h-glass-line);
    transition: background-color 0.18s, color 0.18s, border-color 0.18s, transform 0.18s;
  }
  .chip-btn:hover { border-color: #8b5cf6; color: var(--h-ink); transform: translateY(-1px); }
  .chip-btn.is-locked { opacity: 0.7; }
  .chip-btn[aria-pressed="true"] { color: #fff; border-color: transparent; background: linear-gradient(135deg, #8b5cf6, #6d28d9); box-shadow: 0 8px 16px -8px #7c3aedcc; }

  .trust { display: flex; align-items: center; gap: 8px; margin: 20px 0 0; font-size: 13.5px; color: var(--h-mute); }
  .trust svg { flex: none; color: #34d399; }

  /* ── the photo ── */
  /* the whole picture (photo, chord card, notes) shrinks towards its feet as the page scrolls: see the script */
  .art { position: relative; min-width: 0; align-self: end; transform-origin: 50% 100%; will-change: transform; }
  .art-in { position: relative; z-index: 1; margin: 0 -13% 0 -10%; will-change: transform; transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); animation: art-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.15s both; }
  .photo { display: block; width: 100%; height: auto; filter: drop-shadow(0 34px 50px #0000008c) drop-shadow(0 0 60px #7c3aed55); }
  .floor { position: absolute; left: 4%; right: 0; bottom: -2%; height: 22%; z-index: 0; border-radius: 50%; background: radial-gradient(closest-side, #f59e0b88, #ec489944 55%, transparent 100%); filter: blur(18px); opacity: var(--h-glow); animation: breathe 6s ease-in-out infinite; }

  .fc { position: absolute; z-index: 3; right: 1%; top: -40%; width: 25%; min-width: 118px; animation: fc-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.7s both; }
  .fc-in {
    display: grid; justify-items: center; gap: 2px; padding: 10px 12px 8px; border-radius: 20px; color: #cbbcf5;
    background: linear-gradient(160deg, #ffffff26, #ffffff0d); border: 1px solid #ffffff38;
    box-shadow: 0 24px 50px -20px #000c, 0 0 40px -8px #8b5cf666, inset 0 1px 0 #ffffff40;
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    transform: rotate(6deg); animation: bob 6s ease-in-out infinite alternate;
  }
  .fc-in strong { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; color: #fff; }
  .fc-svg { width: 100%; }
  .fc-svg :global(svg) { display: block; width: 100%; height: auto; }
  :global(html:not([data-theme="dark"])) .fc-in { color: #5b21b6; background: linear-gradient(160deg, #ffffffee, #f3ecffcc); border-color: #e1d4f7; box-shadow: 0 24px 40px -22px #5b21b6aa, inset 0 1px 0 #fff; }
  :global(html:not([data-theme="dark"])) .fc-in strong { color: #1a0533; }
  :global(html:not([data-theme="dark"])) .fc-svg :global(svg) { --dg-dot: #7c3aed; }

  /* depth: --depth goes from 0 (full size) to 1 (the camera has pulled back as far as it goes); what is nearer the camera moves more */
  .fc { transform-origin: 85% 0%; transform: scale(calc(1 + var(--depth, 0) * 0.16)); }
  .floaters { transform-origin: 50% 58%; transform: scale(calc(1 + var(--depth, 0) * 0.26)); }
  /* chords and notes that appear at random places, stay a while and fade away (the script chooses where, what, when and how long) */
  .floaters { position: absolute; inset: -18% -10% -6% -14%; z-index: 2; pointer-events: none; }
  /* (made by the script, so they carry no scoping mark: global) */
  :global(.fl) { position: absolute; left: 0; top: 0; opacity: 0; transform: scale(0.82); transition: opacity var(--in, 1s) ease, transform var(--in, 1s) cubic-bezier(0.2, 0.7, 0.2, 1); }
  :global(.fl.on) { opacity: var(--peak, 1); transform: scale(1); }
  :global(.fl-in) { display: inline-block; transform: rotate(var(--r, 0deg)); animation: fl-float var(--f, 6s) ease-in-out infinite alternate; }
  :global(.fl-chip) { padding: 6px 13px; border-radius: 12px; font: 600 14px/1 var(--font-mono); color: color-mix(in srgb, var(--c) 70%, var(--h-ink)); background: color-mix(in srgb, var(--c) 12%, var(--h-chip)); border: 1px solid color-mix(in srgb, var(--c) 45%, transparent); box-shadow: 0 0 22px -4px var(--c); }
  :global(.fl-note) { font-size: var(--s, 26px); line-height: 1; color: var(--c); text-shadow: 0 0 18px var(--c); }

  /* ── what the site does ── */
  .features {
    position: relative; z-index: 2; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; max-width: 1040px; margin: 34px auto 0; padding: 14px 8px; list-style: none;
    border-radius: 24px; background: var(--h-feature); border: 1px solid var(--h-glass-line);
    backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: 0 30px 50px -36px #000;
  }
  .features li { display: flex; align-items: center; gap: 14px; padding: 6px 22px; }
  .features li + li { border-left: 1px solid var(--h-glass-line); }
  .f-ico { display: grid; place-items: center; flex: none; width: 46px; height: 46px; border-radius: 50%; color: #fbbf24; background: radial-gradient(circle at 30% 25%, #ffffff1f, #ffffff08); border: 1px solid var(--h-glass-line); transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.3s; }
  .features li:nth-child(2) .f-ico { color: #c4b5fd; }
  .features li:nth-child(3) .f-ico { color: #f9a8d4; }
  .features li:hover .f-ico { transform: translateY(-3px) scale(1.06); box-shadow: 0 12px 24px -10px currentColor; }
  .f-text { display: grid; gap: 2px; min-width: 0; }
  .f-text strong { font-size: 14.5px; font-weight: 700; color: var(--h-ink); }
  .f-text small { font-size: 12.5px; color: var(--h-mute); }
  :global(html:not([data-theme="dark"])) .f-ico { color: #7c3aed; background: #f5efff; }
  :global(html:not([data-theme="dark"])) .features li:nth-child(1) .f-ico { color: #d97706; background: #fff7e0; }
  :global(html:not([data-theme="dark"])) .features li:nth-child(3) .f-ico { color: #db2777; background: #ffeef7; }

  /* ── entrance and motion ── */
  .rise { animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i, 0) * 90ms + 60ms) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(22px); } }
  @keyframes art-in { from { opacity: 0; transform: translateY(26px) scale(0.96); } }
  @keyframes fc-in { from { opacity: 0; transform: translateY(-16px) scale(0.9); } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes breathe { 0%, 100% { transform: scale(1); opacity: var(--h-glow); } 50% { transform: scale(1.06); opacity: calc(var(--h-glow) * 0.72); } }
  @keyframes drift-a { to { transform: translate(60px, 40px) scale(1.12); } }
  @keyframes drift-b { to { transform: translate(-50px, 50px) scale(0.92); } }
  @keyframes bob { from { transform: translateY(-6px) rotate(5deg); } to { transform: translateY(8px) rotate(7.5deg); } }
  @keyframes fl-float { from { transform: translateY(8px) rotate(var(--r, 0deg)); } to { transform: translateY(-14px) rotate(calc(var(--r, 0deg) + 6deg)); } }
  @keyframes eq { 0%, 100% { transform: scaleY(0.35); } 50% { transform: scaleY(1); } }
  @keyframes shine { to { background-position: 100% 0; } }
  @keyframes ring { to { transform: translate(-50%, -50%) rotate(1turn); } }
  @keyframes spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .rise, .art-in, .fc { animation: none; }
    .glow, .spot, .floor, .eq i, .title-grad, .fc-in { animation: none; }
    .swoosh path { animation: none; stroke-dashoffset: 0; }
    .art-in { transition: none; }
    /* the edge of the card keeps its slow sweep of light, and the chords and notes still fade in and out where they are: only travelling motion stops */
    .card-ring i, .card-glow i { animation-duration: 18s; }
    :global(.fl) { transform: none; transition: opacity var(--in, 1s) ease; }
    :global(.fl-in) { animation: none; }
  }

  /* ── smaller screens ── */
  @media (max-width: 1100px) {
    .features li { padding: 6px 14px; gap: 10px; }
    .f-ico { width: 40px; height: 40px; }
  }
  @media (max-width: 880px) {
    .hero { padding: 92px 18px 32px; }
    .wrap { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .card { max-width: none; }
    .floaters { inset: -12% -4% -4% -6%; }
    .lede { max-width: none; }
    .art { max-width: 560px; margin: 52px auto 0; width: 100%; }
    .art-in { margin: 0 -4%; }
    .fc { right: 3%; top: -22%; width: 21%; min-width: 0; }
    .fc-in { padding: 6px 7px 5px; border-radius: 14px; }
    .fc-in strong { font-size: 15px; }
    .star:nth-child(n + 3) { display: none; }
    .features { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 0; padding: 10px 6px; margin-top: 22px; }
    .features li { padding: 8px 14px; }
    .features li:nth-child(odd) { border-left: 0; }
    .features li:nth-child(n + 3) { border-top: 1px solid var(--h-glass-line); }
    .features li + li { border-left: 1px solid var(--h-glass-line); }
    .features li:nth-child(3) { border-left: 0; }
    .glow { filter: blur(60px); }
    .swoosh { bottom: 120px; opacity: 0.4; }
  }
  @media (max-width: 560px) {
    .row { flex-direction: column; }
    .go { width: 100%; }
    .card-body { padding: 10px; }
    .f-text small { display: none; }
    .features li { gap: 10px; padding: 8px 10px; }
  }
</style>

<script>
  import { startExtractFromUpload, getApiErrorMessage } from "../lib/api";
  import { can, loadPlan, nudge } from "../lib/plan";
  import { INSTRUMENTS, instrumentFor, setInstrument } from "../lib/instrument";
  import { goToProcessing } from "../lib/backNav";

  // Tab switching (the look follows aria-selected)
  const tabSearch = document.getElementById("tab-search") as HTMLButtonElement;
  const tabUp = document.getElementById("tab-upload") as HTMLButtonElement;
  const panelSearch = document.getElementById("panel-search")!;
  const panelUp = document.getElementById("panel-upload")!;

  function setTab(active: "search" | "upload") {
    const isSearch = active === "search";
    tabSearch.setAttribute("aria-selected", String(isSearch));
    tabUp.setAttribute("aria-selected", String(!isSearch));
    panelSearch.classList.toggle("hidden", !isSearch);
    panelUp.classList.toggle("hidden", isSearch);
  }

  // The "Discover" link in the menu lands here (/#find): open the search tab and put the cursor in the box.
  function arriveAtSearch() {
    if (window.location.hash !== "#find") return;
    setTab("search");
    (document.getElementById("hero-q") as HTMLInputElement | null)?.focus({ preventScroll: true });
  }
  window.addEventListener("hashchange", arriveAtSearch);
  arriveAtSearch();

  tabSearch.addEventListener("click", () => setTab("search"));
  // Uploading is a plan feature: where the plan leaves it out the tab says so instead of opening.
  tabUp.addEventListener("click", () => {
    if (!can("upload_song")) {
      setTab("search");
      nudge("Uploading your own songs");
      return;
    }
    setTab("upload");
  });
  function applyUploadLock() {
    const locked = !can("upload_song");
    tabUp.classList.toggle("is-locked", locked);
    tabUp.setAttribute("title", locked ? "Not included in your plan" : "");
    if (locked) setTab("search");
  }
  window.addEventListener("plan-change", applyUploadLock);
  void loadPlan();

  // Instrument selector: "Chords for". It is the person's own choice, kept on their account and this device, and it is what the player,
  // the song pages and the app show, so choosing here changes every song they open next.
  const instrumentButtons = document.querySelectorAll<HTMLButtonElement>(".instrument-btn");
  function showInstrument() {
    const shown = instrumentFor(can);
    instrumentButtons.forEach((b) => {
      const info = INSTRUMENTS.find((i) => i.id === b.dataset.inst);
      b.setAttribute("aria-pressed", String(b.dataset.inst === shown));
      b.classList.toggle("is-locked", !!info?.feature && !can(info.feature));
    });
  }
  instrumentButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const info = INSTRUMENTS.find((i) => i.id === btn.dataset.inst);
      if (!info) return;
      if (info.feature && !can(info.feature)) {
        nudge(`The ${info.label.toLowerCase()} view`);
        return;
      }
      setInstrument(info.id);
    });
  });
  window.addEventListener("instrument-change", showInstrument);
  window.addEventListener("plan-change", showInstrument);
  showInstrument();

  // Search: the results (songs only) open on their own page.
  const searchForm = document.getElementById("hero-search") as HTMLFormElement;
  const searchInput = document.getElementById("hero-q") as HTMLInputElement;
  const searchStatus = document.getElementById("search-status") as HTMLParagraphElement;

  searchForm.addEventListener("submit", (e) => {
    e.preventDefault();
    const query = searchInput.value.trim().replace(/\s+/g, " ");
    if (query.length < 2) {
      searchStatus.textContent = "Type a song name or an artist to search.";
      searchStatus.style.color = "var(--color-error)";
      searchStatus.classList.remove("hidden");
      searchInput.focus();
      return;
    }
    window.location.href = `/search?q=${encodeURIComponent(query)}`;
  });

  // Upload flow
  const fileInput = document.getElementById("audio-file-input") as HTMLInputElement;
  const dropzone = document.getElementById("dropzone")!;
  const uploadIcon = document.getElementById("upload-icon")!;
  const uploadSpinner = document.getElementById("upload-spinner")!;
  const uploadLabel = document.getElementById("upload-label")!;
  const uploadStatus = document.getElementById("upload-status") as HTMLParagraphElement;
  const uploadIdle = uploadLabel.innerHTML;

  function showUploadStatus(message: string, tone: "error" | "info") {
    uploadStatus.textContent = message;
    uploadStatus.style.color = tone === "error" ? "var(--color-error)" : "var(--color-violet-deep)";
    uploadStatus.classList.remove("hidden");
  }

  async function upload(file: File) {
    if (!can("upload_song")) {
      nudge("Uploading your own songs");
      return;
    }
    uploadIcon.classList.add("hidden");
    uploadSpinner.classList.remove("hidden");
    uploadLabel.textContent = "Analyzing your song…";
    uploadStatus.classList.add("hidden");

    try {
      const { sessionId } = await startExtractFromUpload(file);
      goToProcessing(sessionId);
    } catch (err) {
      uploadIcon.classList.remove("hidden");
      uploadSpinner.classList.add("hidden");
      uploadLabel.innerHTML = uploadIdle;
      showUploadStatus(getApiErrorMessage(err, "Something went wrong analyzing that file. Try again."), "error");
      fileInput.value = "";
    }
  }

  fileInput.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) void upload(file);
  });

  // Drag and drop onto the drop zone
  ["dragenter", "dragover"].forEach((type) =>
    dropzone.addEventListener(type, (e) => {
      e.preventDefault();
      dropzone.classList.add("drag");
    }),
  );
  ["dragleave", "drop"].forEach((type) => dropzone.addEventListener(type, () => dropzone.classList.remove("drag")));
  dropzone.addEventListener("drop", (e) => {
    e.preventDefault();
    const file = (e as DragEvent).dataTransfer?.files?.[0];
    if (file) void upload(file);
  });

  // The photo leans a little towards the pointer (a mouse only, and not for a visitor who asks for less motion).
  const art = document.getElementById("hero-art");
  const photo = art?.querySelector<HTMLElement>(".art-in");
  if (art && photo && matchMedia("(hover: hover) and (pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let queued = false;
    let tx = 0;
    let ty = 0;
    const hero = document.querySelector<HTMLElement>(".hero")!;
    hero.addEventListener("pointermove", (event) => {
      const box = hero.getBoundingClientRect();
      tx = ((event.clientX - box.left) / box.width - 0.5) * -14;
      ty = ((event.clientY - box.top) / box.height - 0.5) * -8;
      if (!queued) {
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          photo.style.transform = `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, 0)`;
        });
      }
    });
    hero.addEventListener("pointerleave", () => (photo.style.transform = ""));
  }

  // Chords and music notes appear at random places around the photo, stay for a random while and fade away, each on its own random
  // timing; the chord, the colour and the size change every time. They keep clear of the people, the chord card and the writing.
  const layer = document.getElementById("floaters");
  if (layer && art) {
    const CHORDS = ["Am", "Em", "C", "G", "D7", "F", "Dm", "Bm", "E7", "Cmaj7", "F#m", "B7", "A", "Gsus4", "Asus2", "D"];
    const NOTES = ["♪", "♫", "♩", "♬", "♭", "♯"];
    const COLOURS = ["#8b5cf6", "#ec4899", "#f59e0b", "#22d3ee", "#a78bfa", "#fb7185", "#34d399"];
    const pick = <T,>(list: T[]): T => list[Math.floor(Math.random() * list.length)];
    const between = (a: number, b: number) => a + Math.random() * (b - a);
    const narrow = matchMedia("(max-width: 880px)");
    const heroEl = document.querySelector<HTMLElement>(".hero")!;
    const copyEl = document.querySelector<HTMLElement>(".copy");
    const photoEl = art.querySelector<HTMLElement>(".photo");
    const cardEl = art.querySelector<HTMLElement>(".fc");
    let active = true;

    // a place for one: not on the people in the photo, not on the chord card, not on the writing
    function place(el: HTMLElement, w: number, h: number): boolean {
      const box = layer!.getBoundingClientRect();
      if (!box.width || !box.height || !photoEl) return false;
      const p = photoEl.getBoundingClientRect();
      const c = cardEl?.getBoundingClientRect();
      const t = copyEl?.getBoundingClientRect();
      const cx = p.left + p.width * 0.5;
      const cy = p.top + p.height * 0.6;
      const rx = p.width * 0.44;
      const ry = p.height * 0.44;
      for (let tries = 0; tries < 40; tries++) {
        const x = between(0, box.width - w);
        const y = between(0, box.height - h);
        const mx = box.left + x + w / 2;
        const my = box.top + y + h / 2;
        if (((mx - cx) / (rx + w / 2)) ** 2 + ((my - cy) / (ry + h / 2)) ** 2 < 1) continue; // on the people
        if (c && mx > c.left - 14 - w / 2 && mx < c.right + 14 + w / 2 && my > c.top - 14 - h / 2 && my < c.bottom + 14 + h / 2) continue; // on the chord card
        if (t && mx > t.left - w / 2 && mx < t.right + w / 2 && my > t.top - h / 2 && my < t.bottom + h / 2) continue; // on the writing
        const hb = heroEl.getBoundingClientRect();
        if (my < hb.top + 78) continue; // under the menu
        el.style.left = `${((x / box.width) * 100).toFixed(2)}%`;
        el.style.top = `${((y / box.height) * 100).toFixed(2)}%`;
        return true;
      }
      return false;
    }

    function run(el: HTMLElement, inner: HTMLElement, kind: "chord" | "note") {
      const next = (ms: number, fn: () => void) => window.setTimeout(fn, ms);
      const show = () => {
        if (!active) return void next(800, show); // not while the page is hidden or the hero is off screen
        const size = kind === "note" ? Math.round(between(18, 38)) : 0;
        inner.textContent = kind === "note" ? pick(NOTES) : pick(CHORDS);
        el.style.setProperty("--c", pick(COLOURS));
        el.style.setProperty("--s", `${size}px`);
        el.style.setProperty("--r", `${Math.round(between(-14, 14))}deg`);
        el.style.setProperty("--f", `${between(4, 8).toFixed(1)}s`);
        el.style.setProperty("--in", `${between(0.7, 1.5).toFixed(2)}s`);
        el.style.setProperty("--peak", String(kind === "note" ? between(0.55, 0.95).toFixed(2) : between(0.8, 1).toFixed(2)));
        const w = kind === "note" ? size : 54;
        const h = kind === "note" ? size : 30;
        if (!place(el, w, h)) return void next(500, show);
        el.classList.add("on");
        next(between(2200, 5600), hide); // stays a random while
      };
      const hide = () => {
        el.classList.remove("on");
        next(between(1100, 1700) + between(250, 3400), show); // fades out, then a random wait
      };
      next(between(150, 4200), show); // each starts at its own moment
    }

    const total = narrow.matches ? 7 : 13;
    for (let i = 0; i < total; i++) {
      const kind = i % 2 === 0 ? "chord" : "note";
      const el = document.createElement("span");
      el.className = "fl tw"; // "tw": the site's reduced-motion rule leaves these gentle fades and sweeps alone
      const inner = document.createElement("span");
      inner.className = `fl-in ${kind === "chord" ? "fl-chip" : "fl-note"}`;
      el.append(inner);
      layer.append(el);
      run(el, inner, kind);
    }
    // nothing starts while the page is in another tab or the hero has been scrolled away
    const check = () => (active = !document.hidden && heroVisible);
    let heroVisible = true;
    if ("IntersectionObserver" in window) new IntersectionObserver((entries) => { heroVisible = entries[0]?.isIntersecting ?? true; check(); }).observe(heroEl);
    document.addEventListener("visibilitychange", check);
  }

  // The picture is a camera that pulls back as the page scrolls down and comes forward again as it scrolls up. The people shrink towards
  // the ground they sit on (never below 0.86 of their size) and, as in a real shot, they stay in the frame: they travel up the screen
  // more slowly than the page does, so after a link (Discover) has scrolled down to the search box they are shown whole. The chord card
  // and the notes are nearer the camera, so they shrink less and drift outwards. The size and place follow the scroll position only, and
  // glide there with a little inertia instead of jumping, also when a link scrolls to the search box in one go.
  if (art) {
    const NAV = 64; // the fixed menu
    const MIN = 0.86;
    const state = { scale: 1, down: 0 }; // what is drawn: the size, and how far it has been held back (px)
    const aimed = { scale: 1, down: 0 }; // what it is gliding to
    let running = false;
    let stamp = 0;
    let scheduled = 0; // when a frame was last asked for: if frames stopped coming (a hidden tab), the next scroll asks again
    const paint = () => {
      const depth = Math.min(1, Math.max(0, (1 - state.scale) / (1 - MIN)));
      art.style.setProperty("--depth", depth.toFixed(4));
      const lift = (1 - state.scale) * art.offsetHeight * 0.06; // the feet rise a little towards the horizon
      const y = state.down - lift;
      art.style.transform = state.scale >= 0.9995 && Math.abs(y) < 0.05 ? "" : `translate3d(0, ${y.toFixed(2)}px, 0) scale(${state.scale.toFixed(4)})`;
    };
    const aim = () => {
      const h = art.offsetHeight;
      if (!h) return;
      const wide = innerWidth > 880;
      // where the feet would be with nothing applied: the bottom edge as drawn, less what was added to it
      const lift = (1 - state.scale) * h * 0.06;
      const bottom = art.getBoundingClientRect().bottom - (state.down - lift);
      const pageBottom = bottom + scrollY;
      const vh = innerHeight;
      const start = Math.max(0, pageBottom - h - vh * (wide ? 0.6 : 0.22)); // where the page is when the pull-back begins: at once on a desktop, later on a phone
      let p = Math.min(1, Math.max(0, (scrollY - start) / (vh * 0.7)));
      p = p * p * (3 - 2 * p);
      aimed.scale = 1 - (1 - MIN) * p;
      // held back: it climbs the screen at about half the speed of the page, up to a limit, so it stays in the frame
      aimed.down = wide ? Math.min(150, Math.max(0, (scrollY - start) * 0.42)) : 0;
      // and if the top would still be under the menu, a little smaller (but not below the least size)
      const top = bottom + aimed.down - h * aimed.scale - (1 - aimed.scale) * h * 0.06;
      if (top < NAV + 14) aimed.scale = Math.max(MIN, aimed.scale - (NAV + 14 - top) / h);
      if (!running || performance.now() - scheduled > 300) {
        running = true;
        stamp = 0;
        scheduled = performance.now();
        requestAnimationFrame(glide);
      }
    };
    // a critically damped glide: about a tenth of a second to close most of the gap, and no overshoot
    function glide(now: number) {
      const dt = stamp ? Math.min(64, now - stamp) : 16;
      stamp = now;
      const k = 1 - Math.exp(-dt / 110);
      state.scale += (aimed.scale - state.scale) * k;
      state.down += (aimed.down - state.down) * k;
      if (Math.abs(aimed.scale - state.scale) < 0.0006 && Math.abs(aimed.down - state.down) < 0.1) {
        state.scale = aimed.scale;
        state.down = aimed.down;
      }
      paint();
      if (state.scale !== aimed.scale || state.down !== aimed.down) {
        scheduled = performance.now();
        requestAnimationFrame(glide);
      } else running = false;
    }
    addEventListener("scroll", aim, { passive: true });
    addEventListener("resize", aim);
    addEventListener("load", aim);
    const img = art.querySelector<HTMLImageElement>(".photo");
    if (img && !img.complete) img.addEventListener("load", aim, { once: true });
    aim();
    state.scale = aimed.scale; // no glide on the first look at the page
    state.down = aimed.down;
    paint();
  }
</script>
