---
const stats = [
  { value: "Any song", label: "YouTube link or audio file" },
  { value: "4", label: "Instruments" },
  { value: "On the beat", label: "Chords synced to the tempo" },
  { value: "Free", label: "To start, no card needed" },
];
---

<section class="hs-stats" aria-label="Chord Suno at a glance">
  <dl class="hs-stats-in">
    {
      stats.map((stat) => (
        <div class="hs-stat">
          <dt>{stat.value}</dt>
          <dd>{stat.label}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hs-stats { background: #fff; border-top: 1px solid #eeeaf5; border-bottom: 1px solid #eeeaf5; padding: 34px 24px; }
  .hs-stats-in { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); max-width: 1120px; margin: 0 auto; }
  .hs-stat { padding: 4px 24px; text-align: center; }
  .hs-stat + .hs-stat { border-left: 1px solid #eeeaf5; }
  .hs-stat dt { font-size: clamp(22px, 2.6vw, 30px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; color: var(--color-ink); }
  .hs-stat dd { margin: 6px 0 0; font-size: 13.5px; color: var(--color-mute); }
  @media (max-width: 760px) {
    .hs-stats { padding: 26px 18px; }
    .hs-stats-in { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 22px; }
    .hs-stat:nth-child(odd) { border-left: 0; }
    .hs-stat:nth-child(3) { border-left: 0; }
    .hs-stat { padding: 2px 12px; }
  }
</style>
