---
const steps = [
  {
    number: "01",
    title: "Paste a link or upload",
    description: "Drop any YouTube, SoundCloud URL — or upload your MP3, WAV, FLAC. We handle the rest.",
    icon: `<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m10 9.5 5 2.5-5 2.5z"/></svg>`,
  },
  {
    number: "02",
    title: "AI extracts every chord",
    description:
      "Our neural model analyses the audio, usually in about a minute, detecting chord names, timing and transitions, then fitting them to the song's beat.",
    icon: `<svg viewBox="0 0 24 24"><path d="M4 12h2.5M8.5 7v10M12.5 4v16M16.5 8v8M20 11v2"/></svg>`,
  },
  {
    number: "03",
    title: "Play along in real-time",
    description:
      "Chords scroll in sync with the music. See the guitar chord diagrams and the strumming pattern as the song plays.",
    icon: `<svg viewBox="0 0 24 24"><path d="M9 18V6l11-2.5V15"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="15" r="3"/></svg>`,
  },
];
---

<section id="how-it-works" class="hs is-soft">
  <div class="hs-in">
    <div class="hs-head">
      <div class="hs-eyebrow">How it works</div>
      <h2 class="hs-title">From song to chords <em>in about a minute.</em></h2>
      <p class="hs-lead">No more squinting at tabs. No more pausing and rewinding. Just play.</p>
    </div>

    <ol class="hw-grid">
      {
        steps.map((step) => (
          <li class="hs-card hw-card">
            <div class="hw-top">
              <span class="hs-ico" set:html={step.icon} />
              <span class="hw-num">Step {step.number}</span>
            </div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hw-grid { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0; list-style: none; }
  .hw-card { padding: 28px; }
  .hw-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
  .hw-num { font: 600 12px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-mute); }
  .hw-card h3 { margin: 0 0 8px; font-size: 19px; font-weight: 650; letter-spacing: -0.02em; color: var(--color-ink); }
  .hw-card p { margin: 0; font-size: 15px; line-height: 1.65; color: var(--color-body); }
  @media (max-width: 860px) { .hw-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
