---
const songs = [
  { title: "Hotel California", artist: "Eagles", key: "Bm", difficulty: "Intermediate", chords: "Bm F# A E G D Em F#", cover: "🎸" },
  { title: "Wonderwall", artist: "Oasis", key: "G", difficulty: "Beginner", chords: "Em7 G Dsus4 A7sus4", cover: "🎸" },
  { title: "Clocks", artist: "Coldplay", key: "Eb", difficulty: "Intermediate", chords: "Eb Bb Fm Cm", cover: "🎹" },
  { title: "Somewhere Over the Rainbow", artist: "Israel Kamakawiwoʻole", key: "C", difficulty: "Beginner", chords: "C Em F Am", cover: "🪗" },
  { title: "Blackbird", artist: "The Beatles", key: "G", difficulty: "Advanced", chords: "G Am7 G/B C G", cover: "🎸" },
  { title: "Autumn Leaves", artist: "Jazz Standard", key: "Am", difficulty: "Intermediate", chords: "Am Dm G7 Cmaj7", cover: "🎹" },
];

const difficultyColor: Record<string, { color: string; bg: string }> = {
  Beginner: { color: "#059669", bg: "#d1fae5" },
  Intermediate: { color: "#d97706", bg: "#fef3c7" },
  Advanced: { color: "#dc2626", bg: "#fee2e2" },
};
---

<section
  id="discover"
  style="
    background:var(--color-canvas-soft-2);
    padding: var(--space-5xl) var(--space-lg);
  "
>
  <div class="max-w-6xl mx-auto">
    <div class="flex items-end justify-between mb-10 flex-wrap gap-4">
      <div>
        <div
          class="inline-block rounded-full mb-4"
          style="
            padding:4px 12px;
            background:var(--color-accent-soft);
            border:1px solid #fde68a;
            font-size:12px;
            font-weight:600;
            color:var(--color-accent-deep);
            font-family:var(--font-mono);
            text-transform:uppercase;
            letter-spacing:0.08em;
          "
        >
          Discover
        </div>
        <h2 class="display-lg" style="color:var(--color-ink);margin:0;">
          Trending songs<br />
          <span class="gradient-accent-text">right now.</span>
        </h2>
      </div>
      <a
        href="#"
        class="inline-flex items-center gap-2 rounded-full font-medium"
        style="
          height:40px;
          padding:0 var(--space-md);
          font-size:14px;
          color:var(--color-primary);
          background:var(--color-canvas);
          border:1px solid var(--color-hairline);
          text-decoration:none;
          transition:border-color 0.15s;
        "
        onmouseover="this.style.borderColor='var(--color-primary)'"
        onmouseout="this.style.borderColor='var(--color-hairline)'"
      >
        Browse all songs
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- Filter tabs -->
    <div class="flex gap-2 mb-8 flex-wrap">
      {
        ["All", "Guitar", "Piano", "Ukulele", "Mandolin", "Beginner", "Trending"].map(
          (tab, i) => (
            <button
              class="rounded-full font-medium transition-all duration-150 discover-tab"
              style={`
                height:32px;
                padding:0 14px;
                font-size:13px;
                cursor:pointer;
                border:1px solid ${i === 0 ? "var(--color-primary)" : "var(--color-hairline)"};
                background:${i === 0 ? "var(--color-primary)" : "var(--color-canvas)"};
                color:${i === 0 ? "var(--color-on-primary)" : "var(--color-body)"};
              `}
              onclick={`
                document.querySelectorAll('.discover-tab').forEach(b=>{
                  b.style.background='var(--color-canvas)';
                  b.style.color='var(--color-body)';
                  b.style.borderColor='var(--color-hairline)';
                });
                this.style.background='var(--color-primary)';
                this.style.color='var(--color-on-primary)';
                this.style.borderColor='var(--color-primary)';
              `}
            >
              {tab}
            </button>
          )
        )
      }
    </div>

    <!-- Song grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        songs.map((song) => {
          const diff = difficultyColor[song.difficulty];
          return (
            <a
              href="#"
              class="flex items-center gap-4 rounded-xl transition-all duration-200 shadow-card group"
              style="
                background:var(--color-canvas);
                padding:var(--space-md);
                border:1px solid var(--color-hairline);
                text-decoration:none;
              "
              onmouseover="this.classList.replace('shadow-card','shadow-card-hover');this.style.borderColor='var(--color-hairline-strong)'"
              onmouseout="this.classList.replace('shadow-card-hover','shadow-card');this.style.borderColor='var(--color-hairline)'"
            >
              <!-- Cover -->
              <div
                class="flex items-center justify-center rounded-lg flex-shrink-0"
                style="
                  width:52px;height:52px;
                  background:var(--color-canvas-soft-2);
                  font-size:24px;
                "
              >
                {song.cover}
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <div
                  class="font-semibold truncate"
                  style="font-size:15px;color:var(--color-ink);margin-bottom:2px;"
                >
                  {song.title}
                </div>
                <div style="font-size:13px;color:var(--color-body);margin-bottom:6px;">
                  {song.artist}
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                  <span
                    class="rounded-full font-mono"
                    style="
                      padding:1px 7px;
                      font-size:11px;
                      background:var(--color-primary);
                      color:var(--color-accent);
                      font-weight:600;
                    "
                  >
                    Key of {song.key}
                  </span>
                  <span
                    class="rounded-full"
                    style={`
                      padding:1px 7px;
                      font-size:11px;
                      background:${diff.bg};
                      color:${diff.color};
                      font-weight:600;
                    `}
                  >
                    {song.difficulty}
                  </span>
                </div>
              </div>

              <!-- Arrow -->
              <svg
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                class="flex-shrink-0 opacity-30 group-hover:opacity-100 transition-opacity"
                style="color:var(--color-ink);"
              >
                <path d="M4 8h8M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
