---
import Logo from "./Logo.astro";

const columns = [
  {
    heading: "Product",
    links: [
      { label: "Chord Extractor", href: "#" },
      { label: "Live Detection", href: "#" },
      { label: "Discover", href: "#" },
      { label: "My Library", href: "#" },
      { label: "Pricing", href: "#pricing" },
      { label: "Changelog", href: "#" },
    ],
  },
  {
    heading: "Instruments",
    links: [
      { label: "Guitar Chords", href: "#" },
      { label: "Piano Chords", href: "#" },
      { label: "Ukulele Chords", href: "#" },
      { label: "Mandolin Chords", href: "#" },
      { label: "Chord Library", href: "#" },
    ],
  },
  {
    heading: "Learn",
    links: [
      { label: "Beginner Songs", href: "#" },
      { label: "Chord Theory", href: "#" },
      { label: "How It Works", href: "#" },
      { label: "Blog", href: "#" },
      { label: "Community", href: "#" },
    ],
  },
  {
    heading: "Company",
    links: [
      { label: "About", href: "#" },
      { label: "Careers", href: "#" },
      { label: "Press", href: "#" },
      { label: "Privacy Policy", href: "#" },
      { label: "Terms of Service", href: "#" },
      { label: "Contact", href: "#" },
    ],
  },
];
---

<footer
  style="
    background:var(--color-canvas);
    border-top:1px solid var(--color-hairline);
    padding: var(--space-4xl) var(--space-lg) var(--space-xl);
  "
>
  <div class="max-w-6xl mx-auto">
    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-10 mb-12">
      <!-- Brand column -->
      <div class="lg:col-span-1">
        <a href="/" class="mb-4 inline-block" style="text-decoration:none;" aria-label="Chord Suno — home">
          <Logo size={32} />
        </a>
        <p style="font-size:13px;color:var(--color-body);line-height:1.6;max-width:210px;margin-bottom:20px;">
          Suno means listen. Hear every chord, play every song.
        </p>
        <!-- Social links -->
        <div class="flex gap-2">
          {
            [
              { label: "Twitter", icon: `<path d="M2 2l12 12M14 2L2 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>` },
              { label: "Instagram", icon: `<rect x="2" y="2" width="12" height="12" rx="3" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="4" r="1" fill="currentColor"/>` },
              { label: "YouTube", icon: `<rect x="1" y="3" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M6 6l4 2-4 2V6z" fill="currentColor"/>` },
            ].map((s) => (
              <a
                href="#"
                aria-label={s.label}
                class="flex items-center justify-center rounded-md transition-colors"
                style="
                  width:32px;height:32px;
                  background:var(--color-canvas-soft);
                  border:1px solid var(--color-hairline);
                  color:var(--color-body);
                "
                onmouseover="this.style.borderColor='var(--color-hairline-strong)';this.style.color='var(--color-ink)'"
                onmouseout="this.style.borderColor='var(--color-hairline)';this.style.color='var(--color-body)'"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" set:html={s.icon}/>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Nav columns -->
      {
        columns.map((col) => (
          <div>
            <div
              style="
                font-family:var(--font-mono);
                font-size:11px;
                font-weight:600;
                color:var(--color-ink);
                text-transform:uppercase;
                letter-spacing:0.1em;
                margin-bottom:14px;
              "
            >
              {col.heading}
            </div>
            <ul class="flex flex-col gap-2" style="list-style:none;padding:0;margin:0;">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    style="
                      font-size:14px;
                      color:var(--color-body);
                      text-decoration:none;
                      transition:color 0.1s;
                    "
                    onmouseover="this.style.color='var(--color-ink)'"
                    onmouseout="this.style.color='var(--color-body)'"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom bar -->
    <div
      class="flex items-center justify-between flex-wrap gap-4 pt-6"
      style="border-top:1px solid var(--color-hairline);"
    >
      <p style="font-size:13px;color:var(--color-mute);margin:0;">
        © 2026 Chord Suno · chordsuno.com
      </p>
      <div class="flex items-center gap-4">
        {
          ["Privacy", "Terms", "Cookies"].map((item) => (
            <a
              href="#"
              style="font-size:13px;color:var(--color-mute);text-decoration:none;"
              onmouseover="this.style.color='var(--color-body)'"
              onmouseout="this.style.color='var(--color-mute)'"
            >
              {item}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
