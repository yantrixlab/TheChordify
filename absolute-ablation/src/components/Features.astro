---
const features = [
  {
    title: "AI Chord Detection",
    description:
      "A neural chord model with beat-aware timing. Core chords by default, with 7ths and slash chords one tap away.",
    icon: `<svg viewBox="0 0 24 24"><path d="M4 12h2.5M8.5 7v10M12.5 4v16M16.5 8v8M20 11v2"/></svg>`,
    badge: "AI-powered",
  },
  {
    title: "Live Microphone Detection",
    description:
      "Pick up your instrument and play — Chord Suno listens and shows you the chord you're playing live, in real time.",
    icon: `<svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"/></svg>`,
    badge: "New",
  },
  {
    title: "Smart Key Detection",
    description:
      "Instantly identifies the song's key and scale. Suggests the most natural capo position for guitarists.",
    icon: `<svg viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m14.5 14.5 5 5M10 7.5v5M7.5 10h5"/></svg>`,
  },
  {
    title: "Transposition",
    description:
      "Shift any song up or down by semitones. Instantly re-calculates all chord diagrams for your target key.",
    icon: `<svg viewBox="0 0 24 24"><path d="M7 4v13m0 0-3-3m3 3 3-3M17 20V7m0 0-3 3m3-3 3 3"/></svg>`,
  },
  {
    title: "Practice Loop",
    description:
      "Mark any A–B section to loop. Combine with 0.5× speed to master complex chord transitions without breaking a sweat.",
    icon: `<svg viewBox="0 0 24 24"><path d="M17 3.5 20 6.5l-3 3M4 12.5v-1.5a4.5 4.5 0 0 1 4.5-4.5H20M7 20.5 4 17.5l3-3M20 11.5V13a4.5 4.5 0 0 1-4.5 4.5H4"/></svg>`,
  },
  {
    title: "Export to MIDI & PDF",
    description:
      "Download a chord sheet as PDF to print or share, or grab the MIDI file to drop straight into your DAW.",
    icon: `<svg viewBox="0 0 24 24"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19.5h14"/></svg>`,
    badge: "Premium",
    dark: true,
  },
  {
    title: "Chord Progression Analysis",
    description:
      "See the roman numeral analysis of any song. Understand why those chords work together and apply it to your own writing.",
    icon: `<svg viewBox="0 0 24 24"><path d="m4 17 5-6 4 3.5L20 6M15 6h5v5"/></svg>`,
    badge: "New",
  },
  {
    title: "Community Corrections",
    description:
      "Every chord chart can be fine-tuned by the community. Crowd-sourced accuracy means your charts get better over time.",
    icon: `<svg viewBox="0 0 24 24"><circle cx="9" cy="8.5" r="3"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 5.8a3 3 0 0 1 0 5.4M17.5 14.2a5.5 5.5 0 0 1 3 4.8"/></svg>`,
  },
  {
    title: "Difficulty Rating",
    description:
      "Songs are automatically rated beginner / intermediate / advanced based on chord complexity. Find your next challenge.",
    icon: `<svg viewBox="0 0 24 24"><path d="M5 19.5v-4M10 19.5v-8M15 19.5v-12M20 19.5V4"/></svg>`,
  },
];
---

<section id="features" class="hs is-soft">
  <div class="hs-in">
    <div class="hs-head">
      <div class="hs-eyebrow">Everything you need</div>
      <h2 class="hs-title">Built for players, <em>not just listeners.</em></h2>
    </div>

    <div class="ft-grid">
      {
        features.map((feat) => (
          <article class="hs-card ft-card">
            <div class="ft-top">
              <span class="hs-ico" set:html={feat.icon} />
              {feat.badge && <span class={`hs-tag ${feat.dark ? "is-dark" : ""}`}>{feat.badge}</span>}
            </div>
            <h3>{feat.title}</h3>
            <p>{feat.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ft-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .ft-card { padding: 26px; }
  .ft-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; }
  .ft-card h3 { margin: 0 0 8px; font-size: 18px; font-weight: 650; letter-spacing: -0.02em; color: var(--color-ink); }
  .ft-card p { margin: 0; font-size: 14.5px; line-height: 1.65; color: var(--color-body); }
  @media (max-width: 1023px) { .ft-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .ft-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
