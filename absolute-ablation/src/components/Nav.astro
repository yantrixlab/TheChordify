---
import Logo from "./Logo.astro";

const navLinks = [
  { label: "Discover", href: "#discover" },
  { label: "Features", href: "#features" },
  { label: "Instruments", href: "#instruments" },
  { label: "Pricing", href: "#pricing" },
];
---

<!-- Skip link -->
<a class="skip-link" href="#main-content">Skip to content</a>

<nav
  class="nav-blur fixed top-0 left-0 right-0 z-50 border-b"
  style="border-color: var(--color-hairline);"
  aria-label="Main navigation"
>
  <div
    class="max-w-7xl mx-auto flex items-center justify-between"
    style="padding: 0 var(--space-lg); height: 64px;"
  >
    <!-- Logo -->
    <a href="/" style="text-decoration:none;" aria-label="Chord Suno — home">
      <Logo size={34} />
    </a>

    <!-- Nav links – desktop -->
    <div class="hidden md:flex items-center gap-1" role="list">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            role="listitem"
            class="rounded-full"
            style="
              padding: var(--space-xs) var(--space-sm);
              font-size: 14px;
              color: var(--color-body);
              text-decoration: none;
              font-weight: 500;
              transition: background-color 0.15s, color 0.15s;
            "
            onmouseover="this.style.background='var(--color-canvas-soft-2)';this.style.color='var(--color-ink)'"
            onmouseout="this.style.background='transparent';this.style.color='var(--color-body)'"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- CTA cluster -->
    <div class="flex items-center gap-2">
      <a
        href="#"
        class="hidden sm:inline-flex items-center"
        style="
          height:32px;
          padding: 0 var(--space-sm);
          font-size:14px;
          font-weight:500;
          color:var(--color-ink);
          background:var(--color-canvas);
          border:1px solid var(--color-hairline);
          border-radius:var(--radius-sm);
          text-decoration:none;
          transition: border-color 0.15s;
        "
        onmouseover="this.style.borderColor='var(--color-hairline-strong)'"
        onmouseout="this.style.borderColor='var(--color-hairline)'"
      >
        Log in
      </a>
      <a
        href="#"
        class="inline-flex items-center"
        style="
          height:32px;
          padding: 0 var(--space-sm);
          font-size:14px;
          font-weight:600;
          color:var(--color-on-primary);
          background:var(--color-primary);
          border-radius:var(--radius-sm);
          text-decoration:none;
          transition: background-color 0.15s;
        "
        onmouseover="this.style.background='var(--color-primary-deep)'"
        onmouseout="this.style.background='var(--color-primary)'"
      >
        Start free
      </a>

      <!-- Mobile hamburger -->
      <button
        id="hamburger-btn"
        class="md:hidden flex items-center justify-center rounded-md"
        style="width:36px;height:36px;border:1px solid var(--color-hairline);background:var(--color-canvas);cursor:pointer;"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="hamburger-icon"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path d="M2 4h12M2 8h12M2 12h12" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg
          id="close-icon"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="hidden"
        >
          <path d="M3 3l10 10M13 3L3 13" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu overlay -->
<div id="mobile-menu" role="dialog" aria-label="Mobile navigation" aria-modal="true">
  {
    navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link rounded-lg"
        style="
          display:block;
          padding: var(--space-sm) var(--space-md);
          font-size:18px;
          font-weight:600;
          color:var(--color-ink);
          text-decoration:none;
          transition: background-color 0.15s;
        "
        onmouseover="this.style.background='var(--color-canvas-soft-2)'"
        onmouseout="this.style.background='transparent'"
      >
        {link.label}
      </a>
    ))
  }
  <div class="flex flex-col gap-2" style="margin-top:auto;padding-top:var(--space-xl);">
    <a
      href="#"
      class="flex items-center justify-center rounded-lg font-semibold"
      style="height:48px;background:var(--color-canvas-soft);border:1px solid var(--color-hairline);color:var(--color-ink);text-decoration:none;font-size:16px;"
    >
      Log in
    </a>
    <a
      href="#"
      class="flex items-center justify-center rounded-lg font-semibold"
      style="height:48px;background:var(--color-primary);color:var(--color-on-primary);text-decoration:none;font-size:16px;"
    >
      Start free
    </a>
  </div>
</div>

<!-- spacer -->
<div style="height:64px;" aria-hidden="true"></div>

<script>
  const btn = document.getElementById("hamburger-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const hamIcon = document.getElementById("hamburger-icon")!;
  const closeIcon = document.getElementById("close-icon")!;

  function openMenu() {
    menu.classList.add("open");
    btn.setAttribute("aria-expanded", "true");
    btn.setAttribute("aria-label", "Close menu");
    hamIcon.classList.add("hidden");
    closeIcon.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu.classList.remove("open");
    btn.setAttribute("aria-expanded", "false");
    btn.setAttribute("aria-label", "Open menu");
    hamIcon.classList.remove("hidden");
    closeIcon.classList.add("hidden");
    document.body.style.overflow = "";
  }

  btn.addEventListener("click", () => {
    menu.classList.contains("open") ? closeMenu() : openMenu();
  });

  // Close when a link is clicked
  menu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu.classList.contains("open")) {
      closeMenu();
      btn.focus();
    }
  });
</script>
