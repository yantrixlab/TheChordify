---
import Logo from "./Logo.astro";

const navLinks = [
  { label: "Discover", href: "/#find" },
  { label: "Features", href: "#features" },
  { label: "Instruments", href: "#instruments" },
  { label: "Toolkit", href: "/toolkit/" },
  { label: "Pricing", href: "/pricing/" },
];
---

<!-- Skip link -->
<a class="skip-link" href="#main-content">Skip to content</a>

<nav
  class="nav-blur fixed top-0 left-0 right-0 z-50 border-b"
  style="border-color: var(--color-hairline);"
  aria-label="Main navigation"
>
  <div
    class="max-w-7xl mx-auto flex items-center justify-between"
    style="padding: 0 var(--space-lg); height: 64px;"
  >
    <!-- Logo -->
    <a href="/" style="text-decoration:none;" aria-label="Chord Suno — home">
      <Logo size={34} />
    </a>

    <!-- Nav links – desktop -->
    <div class="hidden md:flex items-center gap-1" role="list">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            role="listitem"
            class="rounded-full"
            style="
              padding: var(--space-xs) var(--space-sm);
              font-size: 14px;
              color: var(--color-body);
              text-decoration: none;
              font-weight: 500;
              transition: background-color 0.15s, color 0.15s;
            "
            onmouseover="this.style.background='var(--color-canvas-soft-2)';this.style.color='var(--color-ink)'"
            onmouseout="this.style.background='transparent';this.style.color='var(--color-body)'"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- CTA cluster -->
    <div class="flex items-center gap-2">
      <!-- Search: a bar on a computer, a button that opens a full-width bar on a phone or tablet -->
      <div id="ns" class="ns">
        <form id="ns-form" class="ns-form" role="search" autocomplete="off">
          <input
            id="ns-input"
            type="text"
            inputmode="search"
            enterkeyhint="search"
            maxlength="100"
            placeholder="Search songs…"
            aria-label="Search songs"
            role="combobox"
            aria-expanded="false"
            aria-controls="ns-panel"
            aria-autocomplete="list"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          />
          <kbd class="ns-key" aria-hidden="true">/</kbd>
          <button id="ns-submit" type="submit" class="ns-submit" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none"><circle cx="9" cy="9" r="5.8" stroke="currentColor" stroke-width="1.8" /><path d="m13.5 13.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
          </button>
          <button id="ns-close" type="button" class="ns-close" aria-label="Close search">Cancel</button>
        </form>
        <div id="ns-panel" class="ns-panel" role="listbox" aria-label="Search suggestions" hidden></div>
      </div>
      <button id="ns-open" type="button" class="ns-open" aria-label="Search songs">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="9" cy="9" r="5.8" stroke="currentColor" stroke-width="1.8" /><path d="m13.5 13.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
      <div data-auth-guest class="flex items-center gap-2">
      <button type="button" data-auth="open"
        class="hidden sm:inline-flex items-center"
        style="
          height:32px;
          padding: 0 var(--space-sm);
          font-size:14px;
          font-weight:500;
          color:var(--color-ink);
          background:var(--color-canvas);
          border:1px solid var(--color-hairline);
          border-radius:var(--radius-sm);
          text-decoration:none;
          transition: border-color 0.15s;
        "
        onmouseover="this.style.borderColor='var(--color-hairline-strong)'"
        onmouseout="this.style.borderColor='var(--color-hairline)'"
      >Log in</button>
      <button type="button" data-auth="open"
        class="inline-flex items-center"
        style="
          height:32px;
          padding: 0 var(--space-sm);
          font-size:14px;
          font-weight:600;
          color:var(--color-on-primary);
          background:var(--color-primary);
          border-radius:var(--radius-sm);
          text-decoration:none;
          transition: background-color 0.15s;
        "
        onmouseover="this.style.background='var(--color-primary-deep)'"
        onmouseout="this.style.background='var(--color-primary)'"
      >Start free</button>
      </div>
      <div data-auth-slot class="relative"></div>

      <!-- Mobile hamburger -->
      <button
        id="hamburger-btn"
        class="md:hidden flex items-center justify-center rounded-md"
        style="width:36px;height:36px;border:1px solid var(--color-hairline);background:var(--color-canvas);cursor:pointer;"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="hamburger-icon"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path d="M2 4h12M2 8h12M2 12h12" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <svg
          id="close-icon"
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
          class="hidden"
        >
          <path d="M3 3l10 10M13 3L3 13" stroke="var(--color-ink)" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile menu overlay -->
<div id="mobile-menu" role="dialog" aria-label="Mobile navigation" aria-modal="true">
  {
    navLinks.map((link) => (
      <a
        href={link.href}
        class="mobile-nav-link rounded-lg"
        style="
          display:block;
          padding: var(--space-sm) var(--space-md);
          font-size:18px;
          font-weight:600;
          color:var(--color-ink);
          text-decoration:none;
          transition: background-color 0.15s;
        "
        onmouseover="this.style.background='var(--color-canvas-soft-2)'"
        onmouseout="this.style.background='transparent'"
      >
        {link.label}
      </a>
    ))
  }
  <div data-auth-mobile class="flex flex-col gap-2" style="margin-top:auto;padding-top:var(--space-xl);"></div>
  <div data-auth-guest class="flex flex-col gap-2" style="padding-top:var(--space-md);">
    <button type="button" data-auth="open"
      class="flex items-center justify-center rounded-lg font-semibold"
      style="height:48px;background:var(--color-canvas-soft);border:1px solid var(--color-hairline);color:var(--color-ink);text-decoration:none;font-size:16px;"
    >Log in</button>
    <button type="button" data-auth="open"
      class="flex items-center justify-center rounded-lg font-semibold"
      style="height:48px;background:var(--color-primary);color:var(--color-on-primary);text-decoration:none;font-size:16px;"
    >Start free</button>
  </div>
</div>

<!-- spacer -->
<div style="height:64px;" aria-hidden="true"></div>

<script>
  import { initAuthUi } from "../lib/authUi";
  import { initNavSearch } from "../lib/navSearch";
  initAuthUi();
  initNavSearch();

  const btn = document.getElementById("hamburger-btn")!;
  const menu = document.getElementById("mobile-menu")!;
  const hamIcon = document.getElementById("hamburger-icon")!;
  const closeIcon = document.getElementById("close-icon")!;

  function openMenu() {
    menu.classList.add("open");
    btn.setAttribute("aria-expanded", "true");
    btn.setAttribute("aria-label", "Close menu");
    hamIcon.classList.add("hidden");
    closeIcon.classList.remove("hidden");
    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu.classList.remove("open");
    btn.setAttribute("aria-expanded", "false");
    btn.setAttribute("aria-label", "Open menu");
    hamIcon.classList.remove("hidden");
    closeIcon.classList.add("hidden");
    document.body.style.overflow = "";
  }

  btn.addEventListener("click", () => {
    menu.classList.contains("open") ? closeMenu() : openMenu();
  });

  // Close when a link is clicked
  menu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu.classList.contains("open")) {
      closeMenu();
      btn.focus();
    }
  });
</script>

<style is:global>
  [data-auth-guest][hidden] { display: none !important; }
  nav button[data-auth] { white-space: nowrap; }
  @media (max-width: 420px) { nav[aria-label="Main navigation"] > div { padding-left: 14px !important; padding-right: 14px !important; } }
  nav button[data-auth], #mobile-menu button[data-auth] { border: 1px solid transparent; font-family: inherit; cursor: pointer; }

  /* the account menu */
  .au-menu { position: relative; }
  .au-trigger { position: relative; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: none; cursor: pointer; transition: transform 0.15s; }
  .au-trigger:hover, .au-trigger[aria-expanded="true"] { transform: scale(1.06); }
  .au-trigger:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 2px; }
  .au-panel { position: absolute; right: 0; top: calc(100% + 8px); z-index: 60; width: 292px; max-width: calc(100vw - 24px); padding: 8px; border-radius: 18px; background: #fff; border: 1px solid var(--color-hairline); box-shadow: 0 24px 48px -20px #1a053380, 0 4px 12px #1a053314; }
  .au-panel[hidden] { display: none; }
  .au-item { display: block; width: 100%; padding: 9px 10px; border: 0; border-radius: 10px; background: none; text-align: left; font: 600 14px var(--font-sans); color: var(--color-body); text-decoration: none; cursor: pointer; }
  .au-item:hover, .au-item:focus-visible { background: var(--color-violet-soft); color: var(--color-violet-deep); outline: none; }
  .au-mobile-link { display: block; width: 100%; padding: 14px 16px; border: 1px solid var(--color-hairline); border-radius: 12px; background: var(--color-canvas-soft); text-align: center; font: 600 16px var(--font-sans); color: var(--color-ink); text-decoration: none; cursor: pointer; }

  /* the game-style card at the top of the account menu */
  .au-hud { padding: 14px; margin-bottom: 6px; border-radius: 14px; color: #fff; background: radial-gradient(circle at 0% 0%, #7c3aed99, transparent 60%), radial-gradient(circle at 100% 100%, #f59e0b33, transparent 55%), linear-gradient(135deg, #2a0a52, #12032a); }
  .au-hud-top { display: flex; align-items: center; gap: 12px; }
  .au-hud-who { display: grid; min-width: 0; }
  .au-hud-who strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 15px; }
  .au-hud-who span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; color: #c9b8ec; }
  .au-hud-rank { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-top: 12px; }
  .au-hud-level { font: 800 20px/1 var(--font-mono); letter-spacing: 0.04em; color: #fcd34d; text-shadow: 0 0 14px #f59e0b88; }
  .au-hud-title { font-size: 13px; font-weight: 700; color: #e9defc; }
  .au-xp { position: relative; height: 12px; margin-top: 8px; border-radius: 999px; background: #ffffff1f; overflow: hidden; }
  .au-xp i { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #a78bfa, #ec4899, #f59e0b); box-shadow: 0 0 12px #f59e0b88; transition: width 0.9s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .au-xp::after { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 calc(10% - 2px), #1a0533 calc(10% - 2px) 10%); } /* ten steps, like a game's XP bar */
  .au-xp-nums { display: flex; justify-content: space-between; gap: 8px; margin-top: 6px; font-size: 12px; color: #c9b8ec; }
  .au-xp-nums b { color: #fff; font-variant-numeric: tabular-nums; }
  .au-streak { display: inline-block; margin-top: 10px; padding: 3px 10px; border-radius: 999px; background: #ffffff1a; font-size: 12px; font-weight: 700; color: #ffd9a0; }
  .au-plan { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 12px; padding-top: 10px; border-top: 1px solid #ffffff1f; font-size: 12.5px; font-weight: 700; color: #e9defc; }
  .au-upgrade { padding: 4px 11px; border-radius: 999px; background: linear-gradient(135deg, #fcd34d, #f59e0b); color: #1a0533; font-weight: 800; text-decoration: none; }
  .au-upgrade:hover { filter: brightness(1.06); }
  .au-hud[hidden], .au-hud [hidden] { display: none; }
  .au-hud-mobile { margin: 8px 0 10px; padding: 16px; }
  @media (prefers-reduced-motion: reduce) { .au-xp i, .au-trigger { transition: none; } }

  /* the search bar and its suggestions */
  .ns { position: relative; }
  .ns-form { position: relative; display: flex; align-items: center; width: 232px; height: 40px; border-radius: 999px; background: var(--color-canvas-soft-2); border: 1.5px solid transparent; transition: width 0.22s cubic-bezier(0.3, 0.7, 0.2, 1), background-color 0.15s, border-color 0.15s, box-shadow 0.15s; }
  .ns-form:hover { background: #ebe3fb; }
  .ns.is-focus .ns-form { width: 340px; background: #fff; border-color: var(--color-violet); box-shadow: 0 0 0 4px #7c3aed1f; }
  .ns-submit { display: grid; place-items: center; flex: none; width: 32px; height: 32px; margin-right: 3px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--color-ink); cursor: pointer; transition: background-color 0.15s, color 0.15s; }
  .ns-submit:hover { background: #fff; color: var(--color-violet-deep); }
  .ns.is-focus .ns-submit { background: var(--color-violet); color: #fff; }
  .ns.is-focus .ns-submit:hover { background: var(--color-violet-deep); }
  .ns-submit:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 2px; }
  .ns-form input { flex: 1; min-width: 0; height: 100%; padding: 0 0 0 16px; border: 0; outline: 0; background: transparent; font: 500 14.5px var(--font-sans); color: var(--color-ink); }
  .ns-form input::placeholder { color: #9a8fb5; }
  .ns-key { display: grid; place-items: center; flex: none; width: 22px; height: 22px; margin-right: 6px; border-radius: 6px; border: 1px solid var(--color-hairline-strong); background: #fff; font: 600 12px var(--font-mono); color: var(--color-mute); }
  .ns.is-focus .ns-key { display: none; }
  .ns-close, .ns-open { display: none; }
  .ns-panel { position: absolute; right: 0; top: calc(100% + 10px); z-index: 70; width: 440px; max-width: calc(100vw - 24px); max-height: min(560px, calc(100vh - 100px)); overflow-y: auto; padding: 8px; border-radius: 20px; background: #fff; border: 1px solid var(--color-hairline); box-shadow: 0 30px 60px -24px #1a053388, 0 6px 16px #1a05331a; overscroll-behavior: contain; animation: ns-in 0.16s ease-out; }
  .ns-panel[hidden] { display: none; }
  .ns-head { display: flex; align-items: center; justify-content: space-between; padding: 10px 10px 6px; font: 700 11px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-mute); }
  .ns-link { border: 0; background: none; cursor: pointer; font: 700 12px var(--font-sans); letter-spacing: 0; text-transform: none; color: var(--color-violet-deep); }
  .ns-link:hover { text-decoration: underline; }
  .ns-row { display: flex; align-items: center; gap: 12px; padding: 8px 10px; border-radius: 14px; cursor: pointer; transition: background-color 0.1s; }
  .ns-row.is-active, .ns-row:hover { background: var(--color-violet-soft); }
  .ns-row.is-busy { opacity: 0.7; cursor: progress; }
  .ns-art { flex: none; width: 46px; height: 46px; overflow: hidden; border-radius: 12px; background: linear-gradient(135deg, #ede9fe, #fde68a); }
  .ns-art img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ns-text { display: grid; flex: 1; min-width: 0; gap: 1px; }
  .ns-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 600 14.5px var(--font-sans); color: var(--color-ink); }
  .ns-title mark { background: none; color: var(--color-violet-deep); font-weight: 800; }
  .ns-sub { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12.5px; color: var(--color-mute); }
  .ns-ready { display: flex; align-items: center; gap: 4px; margin-top: 3px; }
  .ns-ready b { padding: 1px 6px; border-radius: 6px; background: #fff; border: 1px solid var(--color-hairline); font: 700 11px/1.4 var(--font-mono); color: var(--color-ink); }
  .ns-ready em { margin-left: 4px; font: 700 11.5px var(--font-sans); font-style: normal; color: var(--color-violet-deep); }
  .ns-go { display: inline-flex; align-items: center; gap: 6px; flex: none; font: 700 12.5px var(--font-sans); color: var(--color-violet-deep); opacity: 0; transition: opacity 0.1s; }
  .ns-row.is-active .ns-go, .ns-row:hover .ns-go, .ns-row.is-busy .ns-go { opacity: 1; }
  .ns-x { display: grid; place-items: center; flex: none; width: 30px; height: 30px; border: 0; border-radius: 50%; background: none; cursor: pointer; color: var(--color-mute); }
  .ns-x:hover { background: #fff; color: var(--color-error); }
  .ns-row-query { padding: 10px; }
  .ns-row-query .ns-title, .ns-all .ns-title { flex: 1; min-width: 0; }
  .ns-mark { display: grid; place-items: center; flex: none; width: 46px; color: var(--color-mute); }
  .ns-row-query .ns-mark { width: 30px; }
  .ns-all { margin-top: 4px; border-top: 1px solid var(--color-hairline); border-radius: 0 0 14px 14px; padding: 12px 10px; }
  .ns-all .ns-mark { color: var(--color-violet); }
  .ns-all .ns-go { opacity: 1; }
  .ns-all .ns-title strong { color: var(--color-violet-deep); }
  .ns-empty { margin: 0; padding: 18px 12px; text-align: center; font-size: 13.5px; line-height: 1.5; color: var(--color-mute); }
  .ns-error { margin: 0 0 6px; padding: 8px 12px; border-radius: 10px; background: #fef2f2; color: var(--color-error); font-size: 13px; }
  .ns-ghost { height: 62px; margin: 4px 0; border-radius: 14px; background: linear-gradient(100deg, #f3eeff 30%, #fbf9ff 50%, #f3eeff 70%); background-size: 200% 100%; animation: ns-shimmer 1.3s linear infinite; }
  .ns-spin { animation: ns-turn 0.7s linear infinite; }
  @keyframes ns-in { from { opacity: 0; transform: translateY(-6px); } }
  @keyframes ns-shimmer { to { background-position: -200% 0; } }
  @keyframes ns-turn { to { transform: rotate(360deg); } }

  /* below a laptop there is no room for the bar: a button opens it as a sheet across the top of the screen */
  @media (max-width: 1023px) {
    .ns { display: none; }
    .ns-open { display: grid; place-items: center; width: 36px; height: 36px; padding: 0; border: 1px solid var(--color-hairline); border-radius: 50%; background: var(--color-canvas); color: var(--color-ink); cursor: pointer; }
    .ns.is-sheet { position: fixed; z-index: 90; left: 0; right: 0; top: 0; display: block; padding: 10px 12px; background: #fff; box-shadow: 0 8px 24px -12px #1a053366; }
    .ns.is-sheet .ns-form { width: 100%; height: 46px; background: var(--color-canvas-soft-2); }
    .ns.is-sheet .ns-form input { font-size: 16px; } /* 16px keeps phones from zooming into the field */
    .ns.is-sheet .ns-key { display: none; }
    .ns.is-sheet .ns-close { display: block; flex: none; padding: 0 14px; border: 0; background: none; font: 700 14px var(--font-sans); color: var(--color-violet-deep); cursor: pointer; }
    .ns-panel { position: fixed; left: 8px; right: 8px; top: 64px; width: auto; max-width: none; max-height: calc(100vh - 76px); max-height: calc(100dvh - 76px); }
    .ns-go { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .ns-form, .ns-panel, .ns-ghost, .ns-spin { animation: none; transition: none; } }

  /* the sign-in window */
  .au-backdrop { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; padding: 16px; background: #0d001f99; backdrop-filter: blur(4px); animation: au-fade 0.18s ease-out; }
  .au-dialog { position: relative; width: 100%; max-width: 400px; padding: 36px 28px 26px; border-radius: 24px; background: #fff; text-align: center; box-shadow: 0 40px 80px -30px #1a0533cc; animation: au-rise 0.22s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .au-close { position: absolute; right: 14px; top: 14px; display: grid; place-items: center; width: 34px; height: 34px; border: 0; border-radius: 50%; background: none; color: var(--color-mute); cursor: pointer; }
  .au-close:hover, .au-close:focus-visible { background: var(--color-violet-soft); color: var(--color-violet-deep); outline: none; }
  .au-mark { display: grid; place-items: center; width: 54px; height: 54px; margin: 0 auto 16px; border-radius: 16px; background: linear-gradient(135deg, #7c3aed, #5b21b6); box-shadow: 0 12px 24px -10px #5b21b6aa; }
  .au-title { margin: 0 0 8px; font-size: 22px; font-weight: 800; letter-spacing: -0.03em; color: var(--color-ink); }
  .au-sub { margin: 0 auto 22px; max-width: 300px; font-size: 14.5px; line-height: 1.55; color: var(--color-body); }
  .au-button { display: flex; justify-content: center; min-height: 44px; }
  .au-status { min-height: 20px; margin: 12px 0 0; font-size: 13.5px; color: var(--color-mute); }
  .au-status.bad { color: var(--color-error); }
  .au-fine { margin: 14px 0 0; font-size: 12px; line-height: 1.5; color: var(--color-mute); }
  .au-rv { margin: 0 0 6px; text-align: left; }
  .au-rv-form { display: grid; gap: 10px; }
  .au-rv-title { margin: 0; font: 700 11px var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-mute); text-align: center; }
  .au-rv-form input { width: 100%; height: 44px; padding: 0 14px; border-radius: 12px; border: 1.5px solid var(--color-hairline); font: 500 15px var(--font-sans); color: var(--color-ink); outline: none; }
  .au-rv-form input:focus { border-color: var(--color-violet); box-shadow: 0 0 0 3px #7c3aed1f; }
  .au-rv-btn { height: 46px; border: 0; border-radius: 12px; cursor: pointer; color: #fff; font: 800 15px var(--font-sans); background: linear-gradient(135deg, #7c3aed, #5b21b6); box-shadow: 0 10px 20px -10px #5b21b6cc; }
  .au-rv-btn:disabled { opacity: 0.6; cursor: progress; }
  .au-rv-btn:focus-visible { outline: 2px solid var(--color-violet); outline-offset: 2px; }
