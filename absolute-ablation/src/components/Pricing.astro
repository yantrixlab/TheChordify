---
// The plans on the home page. They are the same live plans as the pricing page (the admin's changes show at once), drawn compactly.
---

<section id="pricing" class="hp" aria-labelledby="hp-title" hidden>
  <div class="hp-wrap">
    <p class="hp-eyebrow">Pricing</p>
    <h2 id="hp-title">Simple, honest pricing.</h2>
    <p class="hp-sub">Start free. Upgrade when you are ready. Cancel anytime.</p>
    <div id="hp-plans"></div>
    <p class="hp-link"><a href="/pricing/#compare">Compare every feature →</a></p>
  </div>
</section>

<style is:global>
  .hp { padding: 96px 20px; background: var(--color-canvas-soft); }
  .hp[hidden] { display: none; }
  .hp-wrap { max-width: 1120px; margin: 0 auto; text-align: center; }
  .hp-eyebrow { display: inline-block; margin: 0 0 14px; padding: 4px 12px; border-radius: 999px; background: var(--color-violet-soft); border: 1px solid #c4b5fd; font: 600 12px var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-violet-deep); }
  .hp h2 { margin: 0 0 10px; font-size: clamp(30px, 4.4vw, 46px); font-weight: 800; letter-spacing: -0.04em; color: var(--color-ink); }
  .hp-sub { margin: 0 auto 38px; max-width: 460px; font-size: 17px; color: var(--color-body); }
  .hp .pr-card { text-align: left; }
  .hp-link { margin: 30px 0 0; }
  .hp-link a { font-weight: 700; color: var(--color-violet-deep); text-decoration: none; }
  .hp-link a:hover { text-decoration: underline; }
  @media (max-width: 640px) { .hp { padding: 64px 14px; } }
</style>

<script>
  import { fetchPricing, renderPricing } from "../lib/pricingUi";

  const section = document.getElementById("hp-plans")!.closest("section") as HTMLElement;
  // Drawn when it is about to be seen, and left out altogether if the plans cannot be loaded.
  const start = () =>
    fetchPricing().then((data) => {
      if (!data || data.plans.length === 0) return;
      section.hidden = false;
      renderPricing(document.getElementById("hp-plans")!, data, { compact: true });
    });
  if ("IntersectionObserver" in window) {
    const marker = document.createElement("div");
    section.before(marker);
    const watcher = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        watcher.disconnect();
        void start();
      }
    }, { rootMargin: "700px 0px" });
    watcher.observe(marker);
  } else {
    void start();
  }
</script>
