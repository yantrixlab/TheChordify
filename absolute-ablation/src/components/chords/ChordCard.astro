---
// One chord on a chart. "compact" is a card with its usual shape, linked to the chord's place on its note's page (the charts, a grid of
// cards); the full form is a card with the chord's name, notes and formula, how it sounds, and every way to play it (the page of a note).
// A colour marks the family of chord (basic, 6ths, 7ths, suspended, extended) and is the same everywhere.
import type { ChartChord } from "../../lib/chordCharts";
import { chordPath, type InstrumentKey, type Kind, type Root } from "../../lib/chordCatalog";

interface Props {
  instrument: InstrumentKey;
  chord: ChartChord;
  kind: Kind;
  root: Root;
  compact?: boolean;
  index?: number; // its place in a row, so a row of cards appears one after another
}
const { instrument, chord, kind, root, compact = false, index = 0 } = Astro.props;
const keys = instrument === "piano";
const first = chord.voicings[0];
const heading = `${root.short} ${kind.name} `;
---

{
  compact ? (
    first && (
      <a class={`cc-card${keys ? " is-keys" : ""}`} href={chordPath(instrument, root, kind)} data-g={kind.group} data-reveal style={`--i: ${index % 12}`} aria-label={`${chord.label}: ${chord.notes}. All ways to play it`}>
        <div class="cc-voicing" data-easy={first.easy ? "1" : "0"}>
          <div class="cc-art" set:html={first.svg} />
        </div>
        <div class="cc-cap">
          <strong>{chord.label}</strong>
          <small>{chord.notes}</small>
          {first.frets && <span class="cc-frets" title="The fret on each string, low to high (x is not played)">{first.frets}</span>}
        </div>
      </a>
    )
  ) : (
    <article class={`cc-chord${keys ? " cc-keys" : ""}`} id={kind.id} data-g={kind.group} data-reveal>
      <header>
        <h3>{heading}<span class="cc-sym">{chord.label}</span></h3>
        <a class="cc-open" href={chordPath(instrument, root, kind)} aria-label={`The full ${chord.label} page: notes, fingering and chords that go with it`}>Full page <span aria-hidden="true">→</span></a>
      </header>
      <p class="cc-facts">
        {chord.notes.split(" ").map((n) => <span class="cc-note">{n}</span>)}
        <span class="cc-deg" title="The notes of the major scale it is built from">{chord.formula}</span>
      </p>
      <p class="cc-text">{kind.text}</p>
      <div class="cc-voicings">
        {chord.voicings.map((v) => (
          <figure class="cc-voicing" data-easy={v.easy ? "1" : "0"}>
            <div class="cc-art" set:html={v.svg} />
            <figcaption>
              <span class="cc-vl">{v.label}</span>
              {v.frets && <span class="cc-frets" title="The fret on each string, low to high (x is not played)">{v.frets}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </article>
  )
}
