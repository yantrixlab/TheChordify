---
// One lesson of the Learn section, made from its blocks (lib/lessons.ts): the chord diagrams in it are drawn here, when the site is built.
// A bar across the top fills as the lesson is read, and a contents list beside it follows the section on screen.
import ChordShell from "./ChordShell.astro";
import ChHero from "./ChHero.astro";
import { LESSONS, type Lesson } from "../../lib/lessons";
import { voicingsFor } from "../../lib/chordCharts";
import { INSTRUMENTS } from "../../lib/chordCatalog";

interface Props {
  lesson: Lesson;
}
const { lesson } = Astro.props;
const url = `https://chordsuno.com/learn/${lesson.slug}/`;
const related = lesson.related.map((slug) => LESSONS.find((l) => l.slug === slug)).filter(Boolean) as Lesson[];
const arrows = new Map([
  ["-", ""],
  ["D", "↓"],
  ["U", "↑"],
]);
const COUNT = ["1", "&", "2", "&", "3", "&", "4", "&"];
const label = (chord: string) => chord.replace("#", "♯");
// the headings become the contents list: each gets an address of its own
let headings = 0;
const contents = lesson.blocks.filter((b) => b.type === "h").map((b, i) => ({ id: `part-${i + 1}`, text: (b as { text: string }).text }));
const jsonLd = [
  { "@context": "https://schema.org", "@type": "Article", headline: lesson.title, description: lesson.description, url, author: { "@type": "Organization", name: "Chord Suno" }, publisher: { "@type": "Organization", name: "Chord Suno" } },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Chord Suno", item: "https://chordsuno.com/" },
      { "@type": "ListItem", position: 2, name: "Learn", item: "https://chordsuno.com/learn/" },
      { "@type": "ListItem", position: 3, name: lesson.title, item: url },
    ],
  },
];
const number = LESSONS.findIndex((l) => l.slug === lesson.slug) + 1;
---

<ChordShell title={`${lesson.title} — Chord Suno`} description={lesson.description} jsonLd={jsonLd}>
  <div class="ls-bar" id="ls-bar" aria-hidden="true"></div>
  <ChHero
    eyebrow={`Lesson ${number} · ${lesson.level} · ${lesson.minutes} min read`}
    title={lesson.title}
    lead={lesson.summary}
    crumbs={[{ label: "Learn", href: "/learn/" }, { label: lesson.title }]}
  >
    <a class="ch-btn is-ghost" href="/learn/">All lessons</a>
  </ChHero>

  <div class="ls-wrap">
    <article class="ls">
      {
        lesson.blocks.map((b) => {
          if (b.type === "p") return <p>{b.text}</p>;
          if (b.type === "h") {
            headings += 1;
            return <h2 id={`part-${headings}`}>{b.text}</h2>;
          }
          if (b.type === "list") return <ul>{b.items.map((i) => <li>{i}</li>)}</ul>;
          if (b.type === "chords") {
            return (
              <figure class="ls-chords" data-reveal>
                <div class="ls-row">
                  {b.chords.map((c) => {
                    const v = voicingsFor(b.instrument, c, 1)[0];
                    return v ? (
                      <div class={`ls-chord${b.instrument === "piano" ? " is-keys" : ""}`}>
                        <div class="cc-art" set:html={v.svg} />
                        <strong>{label(c)}</strong>
                      </div>
                    ) : null;
                  })}
                </div>
                {b.caption && <figcaption>{b.caption}</figcaption>}
              </figure>
            );
          }
          if (b.type === "table") {
            return (
              <div class="ls-table" data-reveal>
                <div class="cg-wrap">
                  <table class="cg">
                    <thead><tr>{b.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                    <tbody>{b.rows.map((r) => <tr>{r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>)}</tbody>
                  </table>
                </div>
                {b.caption && <p class="ls-cap">{b.caption}</p>}
              </div>
            );
          }
          return (
            <div class="ls-strum">
              {b.rows.map((r, n) => (
                <div class="ls-pat" data-reveal style={`--i: ${n}`}>
                  <strong>{r.name}</strong>
                  <div class="ls-tiles" role="img" aria-label={`${r.name}: ${r.slots.map((s, i) => `${COUNT[i]} ${s === "D" ? "down" : s === "U" ? "up" : "rest"}`).join(", ")}`}>
                    {r.slots.map((s, i) => (
                      <span class={`ls-tile${s === "D" ? " is-down" : s === "U" ? " is-up" : ""}`}>
                        <b>{arrows.get(s)}</b>
                        <i>{COUNT[i]}</i>
                      </span>
                    ))}
                  </div>
                  <p>{r.note}</p>
                </div>
              ))}
            </div>
          );
        })
      }
    </article>
    <aside class="ls-toc" aria-label="In this lesson">
      <strong>In this lesson</strong>
      <ol>{contents.map((c) => <li><a href={`#${c.id}`}>{c.text}</a></li>)}</ol>
    </aside>
  </div>

  <section class="ch-in ch-sec">
    <span class="ch-kicker" data-reveal>Next</span>
    <h2 data-reveal style="--i: 1">Keep going</h2>
    <div class="ch-links">
      {related.map((l, i) => <a class="ch-link" href={`/learn/${l.slug}/`} data-reveal style={`--i: ${i}`}><strong>{l.title}</strong><span>{l.summary}</span><em class="ch-go" style="font-style: normal">Read the lesson</em></a>)}
      {INSTRUMENTS.filter((i) => lesson.instruments.length === 0 || lesson.instruments.includes(i.key)).slice(0, 2).map((i, n) => (
        <a class="ch-link" href={i.chartPath} data-reveal style={`--i: ${related.length + n}`}><strong>{i.name} chord chart</strong><span>Every {i.name.toLowerCase()} chord with a diagram.</span><em class="ch-go" style="font-style: normal">Open the chart</em></a>
      ))}
    </div>
  </section>

  <div class="ch-in ch-cta-wrap">
    <div class="ch-cta-in" data-reveal>
      <h2>Practise with a real song</h2>
      <p>Search for a song on Chord Suno and play along: every chord is shown on the beat, and you can slow the song down and loop the part you are learning.</p>
      <a class="ch-btn" href="/#find">Find chords for a song</a>
      <a class="ch-btn is-ghost" href="/learn/">All lessons</a>
    </div>
  </div>
</ChordShell>
