---
// Chord Suno logo: the guitar-pick mark and the name beside it, set as real text (so it stays sharp at any size and takes the page's
// colours). tone="dark" is for dark backgrounds: the name is white.
interface Props {
  size?: number; // the height of the logo's text line in px; the mark is a little taller
  wordmark?: boolean;
  tone?: "light" | "dark"; // dark = for dark backgrounds
}

const { size = 34, wordmark = true, tone = "light" } = Astro.props;
const height = Math.round(size * 1.15);
const width = Math.round((height * 171) / 192); // the mark's own proportions are 171 x 192
---

<span class="logo" style={`--s:${size}px`}>
  <img class="logo-mark" src="/logo-mark.png" alt={wordmark ? "" : "Chord Suno"} width={width} height={height} decoding="async" />
  {
    wordmark && (
      <span class={`logo-word ${tone}`}>
        Chord<span class="logo-suno">Suno</span>
      </span>
    )
  }
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; line-height: 1; }
  .logo-mark { display: block; flex: none; height: calc(var(--s) * 1.15); width: auto; filter: drop-shadow(0 3px 6px rgba(120, 60, 0, 0.28)); }
  .logo-word { font-size: calc(var(--s) * 0.68); font-weight: 800; letter-spacing: -0.035em; color: var(--color-ink); white-space: nowrap; }
  .logo-word.dark { color: #fff; }
  .logo-suno {
    margin-left: 0.16em;
    background: linear-gradient(120deg, #b45309 0%, #d97706 55%, #f59e0b 130%);
    -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  }
</style>
